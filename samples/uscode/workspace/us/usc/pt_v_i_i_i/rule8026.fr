edition 2
module "/us/usc/ptVIII/rule8026" {
  within "/us/usc/ptVIII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVIII/rule8026" courtRule {
    num "8026" "Rule 8026."
    heading "Making and Amending Local Rules; Procedure When There Is No Controlling Law"
    provision "/us/usc/ptVIII/rule8026/a" subsection {
      num "a" "(a)"
      heading "Local Rules."
      provision "/us/usc/ptVIII/rule8026/a/1" paragraph {
        num "1" "(1)"
        chapeau "Making and Amending Local Rules."
        provision "/us/usc/ptVIII/rule8026/a/1/A" subparagraph {
          num "A" "(A)"
          content "BAP Local Rules. A circuit council that has authorized a BAP under 28 U.S.C. § 158(b) may make and amend local rules governing the practice and procedure on appeal to the BAP from a bankruptcy court’s judgment, order, or decree."
          hash "26bc789808105ed8fc0c71a3096e6c50d3a812f869911035a904571b769c94cc"
        }
        provision "/us/usc/ptVIII/rule8026/a/1/B" subparagraph {
          num "B" "(B)"
          content "District-Court Local Rules. A district court may make and amend local rules governing the practice and procedure on appeal to the district court from a bankruptcy court’s judgment, order, or decree."
          hash "110903aa3505bb245c94d9e77660763c5087361c5d98c3b109254c032d21533c"
        }
        provision "/us/usc/ptVIII/rule8026/a/1/C" subparagraph {
          num "C" "(C)"
          content "Procedure. Fed. R. Civ. P. 83 governs the procedure for making and amending local rules. A local rule must be consistent with—but not duplicate—an Act of Congress and these Part VIII rules."
          hash "59b70514f7004d2b24c1db5c715cea2f8c9b50bc7f03a3e892522536b550e577"
        }
        hash "6259e6512beccf6ade8a681b3971b26f80ed31eaf5eed1056a75f370572fa6a2"
      }
      provision "/us/usc/ptVIII/rule8026/a/2" paragraph {
        num "2" "(2)"
        content "Numbering. Local rules must conform to any uniform numbering system prescribed by the Judicial Conference of the United States."
        hash "930e839f46af4870ef72b44ab886b83808f335ae54b02c50c421e08338eb44ff"
      }
      provision "/us/usc/ptVIII/rule8026/a/3" paragraph {
        num "3" "(3)"
        content "Limitation on Enforcing a Local Rule Relating to Form. A local rule imposing a requirement of form must not be enforced in a way that causes a party to lose any right because of a nonwillful failure to comply."
        hash "dd5e15dc2a186b13a341ec8bdd9e1594b7bb067f43c3d3c350645416f3757d0a"
      }
      hash "de731a94dd0308021795621d10a5647788d613a1322d3d79102f55d5910f1f49"
    }
    provision "/us/usc/ptVIII/rule8026/b" subsection {
      num "b" "(b)"
      heading "Procedure When There Is No Controlling Law."
      content "A judge may regulate practice in any manner consistent with federal law, these rules, the Official Forms, and the district’s local rules. For any requirement set out elsewhere, a sanction or other disadvantage may be imposed for noncompliance only if the alleged violator was given actual notice of the requirement in the particular case."
      hash "2ac290b2785f40095f77131c7262da5b4fca09f9f1749ab36819b4c8acce9b18"
    }
    hash "9f0fdf4a6464397ded4b92b71b67edf66f355e459f25ae5f848999c73ccc5708"
  }
  credit "(Added Apr. 25, 2014, eff. Dec. 1, 2014; amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVIII/rule8026/note/ungrouped/nolaw/committee-notes-on-rules-2014" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2014"
    p "This rule is derived from former Rule 8018. The changes to the former rule are stylistic."
    p "Changes Made After Publication and Comment. No changes were made after publication and comment."
    hash "ccc34daa02e0f9976c6b35e02bb7666b95a20ff8f6df86826c2e2432fbf6b53b"
  }
  note "/us/usc/ptVIII/rule8026/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 8026 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "ffc7375dbf324e6cb437652bab01a39c7f19702ef6b3912783566d6c117a33a7"
  }
  note "/us/usc/ptVIII/rule8026/note/ungrouped/nolaw/references-in-text" enacted {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in subd. (a)(1)(C), are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "725f2b7ddeca3c944fdbcc555b1729e0dcfeedc04961340c417ccd944d66ee5c"
  }
  layers {
    operative "9f0fdf4a6464397ded4b92b71b67edf66f355e459f25ae5f848999c73ccc5708"
    enacted "27735ec93847c73ea46ffd5c7dcbf45629fd4b9aec520b40db0aa5eeeb764dfb"
    editorial "8406643165c1e6a0c1babe581c07642b3ad49e77784d8477067174f0e49f814d"
  }
}
