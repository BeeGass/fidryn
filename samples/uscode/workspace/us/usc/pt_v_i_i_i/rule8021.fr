edition 2
module "/us/usc/ptVIII/rule8021" {
  within "/us/usc/ptVIII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVIII/rule8021" courtRule {
    num "8021" "Rule 8021."
    heading "Costs"
    provision "/us/usc/ptVIII/rule8021/a" subsection {
      num "a" "(a)"
      heading "Against Whom Assessed."
      chapeau "The following rules apply unless the law provides or the district court or BAP orders otherwise:"
      provision "/us/usc/ptVIII/rule8021/a/1" paragraph {
        num "1" "(1)"
        content "if an appeal is dismissed, costs are taxed against the appellant, unless the parties agree otherwise;"
        hash "dbf1545de631e3472d735a3bbc1890f36a8db45e5bf4c1b28cf6b567cd9baf8b"
      }
      provision "/us/usc/ptVIII/rule8021/a/2" paragraph {
        num "2" "(2)"
        content "if a judgment is affirmed, costs are taxed against the appellant;"
        hash "82ade62072218aa60a13501715fd3b3ebd35abd4eb9fc4ea338870201b6a6656"
      }
      provision "/us/usc/ptVIII/rule8021/a/3" paragraph {
        num "3" "(3)"
        content "if a judgment is reversed, costs are taxed against the appellee;"
        hash "b3330b625ce39645f25b3a0489a58f7766434091977293f47baf8268a2f3e40a"
      }
      provision "/us/usc/ptVIII/rule8021/a/4" paragraph {
        num "4" "(4)"
        content "if a judgment is affirmed or reversed in part, modified, or vacated, costs are taxed only as the district court or BAP orders."
        hash "92348b7fe10b5fd88f9f82e832210f40935e12100fc93f106b4ee69b34f87db9"
      }
      hash "1e4ea582bde3f74e10f1f87edcac5afc9940616377b3fa1e2f5e0fc55b3b60eb"
    }
    provision "/us/usc/ptVIII/rule8021/b" subsection {
      num "b" "(b)"
      heading "Costs for and Against the United States."
      content "Costs for or against the United States, its agency, or its officer may be assessed under (a) only if authorized by law."
      hash "5b08a1bb006c78d42d127dcb084877164c5f6e328ea00dff3c98bc46e84b584b"
    }
    provision "/us/usc/ptVIII/rule8021/c" subsection {
      num "c" "(c)"
      heading "Costs on Appeal Taxable in the Bankruptcy Court."
      chapeau "The following costs on appeal are taxable in the bankruptcy court for the benefit of the party entitled to costs under this rule:"
      provision "/us/usc/ptVIII/rule8021/c/1" paragraph {
        num "1" "(1)"
        content "producing any required copies of a brief, appendix, exhibit, or the record;"
        hash "1cbe6e3027f71831644677309d5d7a24e3a0d95020093a96167033ea86ea30c6"
      }
      provision "/us/usc/ptVIII/rule8021/c/2" paragraph {
        num "2" "(2)"
        content "preparing and sending the record;"
        hash "a60e9e5585f887282e726ae968be069caaeb6f1f2ca8341eac305eb07d837263"
      }
      provision "/us/usc/ptVIII/rule8021/c/3" paragraph {
        num "3" "(3)"
        content "the reporter’s transcript, if needed to determine the appeal;"
        hash "f09c1da23fb0b699e72c3273f874c6e2825ee7c1fda44b1ae7a87aa3d93496f5"
      }
      provision "/us/usc/ptVIII/rule8021/c/4" paragraph {
        num "4" "(4)"
        content "premiums paid for a bond or other security to preserve rights pending appeal; and"
        hash "3459f23423a822fc8aec792abc296f64cee6ed01d0b917d50562577f3e27b3a5"
      }
      provision "/us/usc/ptVIII/rule8021/c/5" paragraph {
        num "5" "(5)"
        content "the fee for filing the notice of appeal."
        hash "2f4c51eae34393a3a9fba69ef0916112b37367c5b26dec235d06dbebb0e9190c"
      }
      hash "a7c9233053358f1e3b6c3ed98108a59aa25902b5b309d9bcc863c7439bb9988a"
    }
    provision "/us/usc/ptVIII/rule8021/d" subsection {
      num "d" "(d)"
      heading "Bill of Costs; Objections."
      content "A party who wants costs taxed must, within 14 days after a judgment on appeal is entered, file with the bankruptcy clerk and serve an itemized and verified bill of costs. Objections must be filed within 14 days after the bill of costs is served, unless the bankruptcy court extends the time."
      hash "f3436725981bce1be473f0011035507a4c4829b42f6ecef9a21fa17433a0690f"
    }
    hash "d4ff0c713ee7429cf3e7c5f1a49b3e3e37c7eb76554f5175a6fcbbb6f51613db"
  }
  credit "(Added Apr. 25, 2014, eff. Dec. 1, 2014; amended Apr. 26, 2018, eff. Dec. 1, 2018; Apr. 27, 2020, eff. Dec. 1, 2020; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVIII/rule8021/note/ungrouped/nolaw/committee-notes-on-rules-2014" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2014"
    p "This rule is derived from former Rule 8014 and F.R.App.P. 39. It retains the former rule’s authorization for taxing appellate costs against the losing party and its specification of the costs that may be taxed. The rule also incorporates some of the additional details regarding the taxing of costs contained in F.R.App.P. 39. Consistent with former Rule 8014, the bankruptcy clerk has the responsibility for taxing all costs. Subdivision (b), derived from F.R.App.P. 39(b), clarifies that additional authority is required for the taxation of costs by or against federal governmental parties."
    p "Changes Made After Publication and Comment. No changes were made after publication and comment."
    hash "099ec9b2b5c06c03d423c49f6cc861beb238268b680b6144de5e685611d361d6"
  }
  note "/us/usc/ptVIII/rule8021/note/ungrouped/nolaw/committee-notes-on-rules-2018-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2018 Amendment"
    p "The amendment of subdivision (c) conforms this rule with the amendment of F.R.Civ.P. 62, which is made applicable in adversary proceedings by Rule 7062. Rule 62 formerly required a party to provide a “supersedeas bond” to obtain a stay of the judgment and proceedings to enforce the judgment. As amended, Rule 62(b) allows a party to obtain a stay by providing a “bond or other security.”"
    hash "59c878da05b979a0bfeda8ccc79ef51215ce54538ac65a0b542f94777e572678"
  }
  note "/us/usc/ptVIII/rule8021/note/ungrouped/nolaw/committee-notes-on-rules-2020-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2020 Amendment"
    p "Subdivision (d) is amended to delete the reference to proof of service. This change reflects the recent amendment to Rule 8011(d) that eliminated the requirement of proof of service when filing and service are completed using a court’s electronic-filing system."
    hash "869be0b97008632db5bc30aefa043db3d72b4b9cc0046472a6a3771a28cae7a6"
  }
  note "/us/usc/ptVIII/rule8021/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 8021 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "229d834c1bafd4b9fb0703a69ee0e18d9b56aaeba8aa9daa825dc8d838ca1f96"
  }
  layers {
    operative "d4ff0c713ee7429cf3e7c5f1a49b3e3e37c7eb76554f5175a6fcbbb6f51613db"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "3bb13b295c50fd41a5a3562afd3ebd69051b2cc07dcb5c4251277f852396bd38"
  }
}
