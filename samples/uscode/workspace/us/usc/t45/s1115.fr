edition 2
module "/us/usc/t45/s1115" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1115" section {
    num "1115" "§ 1115."
    heading "Redemption of stock"
    content "For the purpose of computing the amount for which certificates of value shall be redeemable under " ["section 746 of this title" -> "/us/usc/t45/s746"] ", the series B preferred stock and the common stock conveyed to the Secretary under section 1107" mark "1" 1 " of this title shall be deemed to be without fair market value unless in a proceeding brought under " ["section 1105(a)(4) of this title" -> "/us/usc/t45/s1105/a/4"] " the special court shall have determined that such securities had a value and shall have entered a judgment against the United States for that value. In such an event, the securities shall for purposes of " ["section 746 of this title" -> "/us/usc/t45/s746"] " be deemed to have that value found by the special court."
    hash "8b7a848bc740acdfe75daa1e85da70be7851b1d2c4553c7d1bbea5354d073aa1"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1167(b)" -> "/us/pl/97/35/tXI/s1167/b"] ", Aug. 13, 1981, " ["95 Stat. 686" -> "/us/stat/95/686"] ".)"
  note "/us/usc/t45/s1115/note/editorialNotes/pl.99.509/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 1107 of this title" -> "/us/usc/t45/s1107"] ", referred to in text, was repealed by " ["Pub. L. 99–509, title IV, § 4033(c)(1)(C)(i)(I)" -> "/us/pl/99/509/tIV/s4033/c/1/C/i/I"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "."
    hash "6dfcaf4efa2b4fe6e2001fb3234ecc0194501cb21ef552c2f685826b4ba34438"
  }
  note "/us/usc/t45/s1115/note/editorialNotes/pl.97.35/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Section is comprised of subsec. (b) of " ["section 1167 of Pub. L. 97–35" -> "/us/pl/97/35/s1167"] ". Subsec. (a) of section 1167 amended " ["section 743 of this title" -> "/us/usc/t45/s743"] ". Subsec. (c) of section 1167, which was set out as subsec. (b) of this section and which provided that the clerk of the special court convey to the Secretary certain series B preferred stock and common stock of Conrail on deposit with the court, and authorized the Secretary to hold and exercise all rights to such Conrail securities, was repealed by " ["Pub. L. 99–509, title IV, § 4033(c)(1)(C)(i)(IV)" -> "/us/pl/99/509/tIV/s4033/c/1/C/i/IV"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "."
    hash "9309eeca8bd23569000368901ad1a3747d9bdc13e8ca08f587cd26a935a6bd21"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "8b7a848bc740acdfe75daa1e85da70be7851b1d2c4553c7d1bbea5354d073aa1"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "4eb70bfe80ed7fe2ff0e12ede5d4f41d076227ea5a04be76f7abf93a9f502d84"
  }
}
