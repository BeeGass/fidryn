  note "/us/usc/t45/s714/note/editorialNotes/pl.93.236/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Section, " ["Pub. L. 93–236, title II, § 204" -> "/us/pl/93/236/tII/s204"] ", Jan. 2, 1974, " ["87 Stat. 993" -> "/us/stat/87/993"] ", directed the Secretary, within 30 days after Jan. 2, 1974, to prepare a report, with recommendations, with respect to the geographic zones within the region in which said service should be provided, to submit the report to the Office, the Association, the Governor, and the public utilities commission of each State studied in the report and to local governments, consumer organizations, environmental groups, the public, and to Congress, and to publish the report in the Federal Register."
    hash "cf0e4ad170032ec0965a7b2658740fedb57751b89008a9d6623777d2a0f41677"
  }
  note "/us/usc/t45/s714/note/statutoryNotes/pl.94.555/delaware-maryland-virginia-peninsula-rail-study-report-to-co" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Delaware-Maryland-Virginia Peninsula Rail Study; Report to Congress"
    p ["Pub. L. 94–555, title III, § 302" -> "/us/pl/94/555/tIII/s302"] ", Oct. 19, 1976, " ["90 Stat. 2631" -> "/us/stat/90/2631"] ", directed Interstate Commerce Commission to submit a report to Congress, within six months of Oct. 19, 1976, regarding problems of and need for rail transportation services on Delaware-Maryland-Virginia peninsula."
    hash "f7976f11937d4a1988376acebc9593e559c57042e8b6538a50c4d75952decc56"
  }
