  provision "/us/usc/t45/s59" section {
    num "59" "§ 59."
    heading "Survival of right of action of person injured"
    content "Any right of action given by this chapter to a person suffering injury shall survive to his or her personal representative, for the benefit of the surviving widow or husband and children of such employee, and, if none, then of such employee’s parents; and, if none, then of the next of kin dependent upon such employee, but in such cases there shall be only one recovery for the same injury."
    hash "80b853ce13fcc0b5adc72b428528a4d5b4b95b437f00934a1ea5b8266983dc44"
  }
  credit "(" ["Apr. 22, 1908, ch. 149, § 9" -> "/us/act/1908-04-22/ch149/s9"] ", as added " ["Apr. 5, 1910, ch. 143, § 2" -> "/us/act/1910-04-05/ch143/s2"] ", " ["36 Stat. 291" -> "/us/stat/36/291"] ".)"
