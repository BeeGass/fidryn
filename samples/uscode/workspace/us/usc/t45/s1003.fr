edition 2
module "/us/usc/t45/s1003" {
  within "/us/usc/t45/ch19"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1003" section {
    num "1003" "§ 1003."
    heading "Service continuation"
    provision "/us/usc/t45/s1003/a" subsection {
      num "a" "(a)"
      heading "Situations requiring directed service; time period"
      chapeau "Notwithstanding the provisions of " ["Public Law 96–131" -> "/us/pl/96/131"] ", the Commission shall order directed service for a period of not to exceed 90 days over any line of the Rock Island Railroad if the Secretary finds and certifies to the Commission that—"
      provision "/us/usc/t45/s1003/a/1" paragraph {
        num "1" "(1)"
        content "a lack of rail service exists which cannot be resolved by a grant of interim operating authority over such line and grains or foods are ready to be shipped to market; or"
        hash "f9192af6b6a56a87a93b1d87cbd3837966bec6dda65b35de603ae8ebef38c121"
      }
      provision "/us/usc/t45/s1003/a/2" paragraph {
        num "2" "(2)"
        content "a lack of rail service exists which cannot be resolved by a grant of interim operating authority over such line and a rail carrier, shipper, State, or other interested party has expressed in writing to the Secretary an interest in purchasing, leasing, or rehabilitating the particular rail line or facility for purposes of providing rail services, and there is a reasonable expectation that such transaction will be consummated."
        hash "0573323f683095723f47944a449b0543b7e6a02cb394d626d228b5da685b3b7b"
      }
      hash "a4debd4fc7347c23a934cc1a568592a2d71c9718e21da607d32fea6f8b4cf0bf"
    }
    provision "/us/usc/t45/s1003/b" subsection {
      num "b" "(b)"
      heading "Availability of funds"
      provision "/us/usc/t45/s1003/b/1" paragraph {
        num "1" "(1)"
        content "Not more than $15,000,000 of the funds available for expenditure by the Secretary out of the Railroad Rehabilitation and Improvement Fund established under chapter 224 of title 49 may be made available by the Secretary to the Commission for purposes of providing directed service under this section."
        hash "95fae6362f6431cac686de39ceb4537d4cd5435b5e9404d9903cd6a28dae810e"
      }
      provision "/us/usc/t45/s1003/b/2" paragraph {
        num "2" "(2)"
        content "Funds may be made available for directed service under this section without regard to the findings of the Secretary required under chapter 224 of title 49, including section 22404 of such title, shall not apply to any directed service provided with such funds."
        hash "851f876aa33da1fa0a11475e2910e9ed3e886392153789e57ff1e2648dca41eb"
      }
      hash "9fb60beac6949232acb3202473b4c4862595130bbc97ccca858e6f5f0294e87d"
    }
    provision "/us/usc/t45/s1003/c" subsection {
      num "c" "(c)"
      heading "Continuation of compensation terms for trackage rights, joint facilities, etc."
      content "The terms of compensation for all trackage rights, joint facilities, and similar arrangements between other rail carriers and the trustee of the Rock Island Railroad which are in effect on or after March 15, 1980, on portions of the lines of the Rock Island Railroad involved in temporary emergency operations shall be continued in effect during the duration of the temporary emergency operating authority with the carrier providing temporary emergency service substituting for the trustee, except where the Rock Island Railroad has been given more favorable treatment by virtue of its bankruptcy. Such continuation shall not alter or affect the ultimate rights of other rail carriers under trackage rights, joint facilities, or similar arrangements nor prejudice the ultimate determination of any controversy or proceeding concerning rights of the parties with regard to assignment by the trustee of rights in or to the facilities or under the arrangements."
      hash "ec6b2580d0382b963ac4ef6717d220ebfc1444f5f15b6b4e6590189f3dc2c2e3"
    }
    hash "1c17e71c4e1c5a71ec0de5fae908d466eb020f57bb4c3998a67f5d2277860542"
  }
  credit "(" ["Pub. L. 96–254, title I, § 104" -> "/us/pl/96/254/tI/s104"] ", May 30, 1980, " ["94 Stat. 400" -> "/us/stat/94/400"] "; " ["Pub. L. 104–88, title III, § 329(1)" -> "/us/pl/104/88/tIII/s329/1"] ", Dec. 29, 1995, " ["109 Stat. 952" -> "/us/stat/109/952"] "; " ["Pub. L. 117–58, div. B, title I, § 21301(j)(3)(F)" -> "/us/pl/117/58/dB/tI/s21301/j/3/F"] ", Nov. 15, 2021, " ["135 Stat. 692" -> "/us/stat/135/692"] ".)"
  note "/us/usc/t45/s1003/note/editorialNotes/pl.96.131/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Public Law 96–131" -> "/us/pl/96/131"] ", referred to in subsec. (a), is " ["Pub. L. 96–131" -> "/us/pl/96/131"] ", Nov. 30, 1979, " ["93 Stat. 1023" -> "/us/stat/93/1023"] ", known as the Department of Transportation and Related Agencies Appropriation Act, 1980, which enacted provisions set out as notes under former " ["section 851 of this title" -> "/us/usc/t45/s851"] ", " ["section 501 of Title 14" -> "/us/usc/t14/s501"] ", Coast Guard, and section 106 and former " ["section 10344 of Title 49" -> "/us/usc/t49/s10344"] ", Transportation. For complete classification of this Act to the Code, see Tables."
    hash "cb5d5b480790fb8599560f41f3ea23e73b4a00b7f99c95af149b04cf0f9051f7"
  }
  note "/us/usc/t45/s1003/note/editorialNotes/pl.117.58/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2021—Subsec. (b)(1). " ["Pub. L. 117–58, § 21301(j)(3)(F)(i)" -> "/us/pl/117/58/s21301/j/3/F/i"] ", substituted “chapter 224 of title 49” for “title V of the Railroad Revitalization and Regulatory Reform Act of 1976 (" ["45 U.S.C. 821" -> "/us/usc/t45/s821"] " et seq.)” and struck out “and " ["section 916(b) of this title" -> "/us/usc/t45/s916/b"] "” before period at end."
    p "Subsec. (b)(2). " ["Pub. L. 117–58, § 21301(j)(3)(F)(ii)" -> "/us/pl/117/58/s21301/j/3/F/ii"] ", substituted “chapter 224 of title 49, including section 22404 of such title,” for “title V of the Railroad Revitalization and Regulatory Reform Act of 1976, and section 516 of such Act (" ["45 U.S.C. 836" -> "/us/usc/t45/s836"] ")”."
    p "1995—Subsec. (a). " ["Pub. L. 104–88" -> "/us/pl/104/88"] " substituted “the provisions of " ["Public Law 96–131" -> "/us/pl/96/131"] "” for “the provisions of " ["section 11125 of title 49" -> "/us/usc/t49/s11125"] " or " ["Public Law 96–131" -> "/us/pl/96/131"] "”."
    hash "2234291fe995fdbd3ffb6eba07c7c6a94364d81bb79ed6b4c115ee667b22408e"
  }
  note "/us/usc/t45/s1003/note/statutoryNotes/pl.104.88/effective-date-of-1995-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1995 Amendment"
    p "Amendment by " ["Pub. L. 104–88" -> "/us/pl/104/88"] " effective Jan. 1, 1996, see " ["section 2 of Pub. L. 104–88" -> "/us/pl/104/88/s2"] ", set out as an Effective Date note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ", Transportation."
    hash "16eb732b92d6b0fd94d8511c067f9406d87d2ddd14f399f38f5802eaed297332"
  }
  note "/us/usc/t45/s1003/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  layers {
    operative "1c17e71c4e1c5a71ec0de5fae908d466eb020f57bb4c3998a67f5d2277860542"
    enacted "5ad020da9ac18235ce9ec215188b8cdf8770dcbdce7fa4c927bb83c3b22e8edd"
    editorial "29ce2846b96417e80d82171f3f59659dd817a0d8ca807ba7fc59c44740166d75"
  }
}
