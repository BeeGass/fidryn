edition 2
module "/us/usc/t45/s1109" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1109" section {
    num "1109" "§ 1109."
    heading "Effectuation of cost reductions"
    content "Any cost reductions resulting from the provisions of or the amendments made by this subtitle shall not be used to limit the maximum level of any rate charged by Conrail for the provision of rail service, to limit the amount of any increase in any such rate (including rates maintained jointly by Conrail and other rail carriers), or to limit a surcharge or cancellation otherwise lawful under chapter 107" mark "1" 1 " of title 49."
    hash "5f8cea6e07430edf8aa136e9d3927f75d929a7a7ed9217fbdf72199b81d6a506"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1159" -> "/us/pl/97/35/tXI/s1159"] ", Aug. 13, 1981, " ["95 Stat. 682" -> "/us/stat/95/682"] ".)"
  note "/us/usc/t45/s1109/note/editorialNotes/pl.97.35/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This subtitle, referred to in text, is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", known as the Northeast Rail Service Act of 1981. For complete classification of this subtitle to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    p "Chapter 107 of title 49, referred to in text, was omitted and a new chapter 107 enacted in the general amendment of subtitle IV of Title 49, Transportation, by " ["Pub. L. 104–88, title I, § 102(a)" -> "/us/pl/104/88/tI/s102/a"] ", Dec. 29, 1995, " ["109 Stat. 804" -> "/us/stat/109/804"] ", 809."
    hash "03662b76eb52db2ae8a26d0e35fbe6ba792044ffccdd226875710ca5976c97d7"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "5f8cea6e07430edf8aa136e9d3927f75d929a7a7ed9217fbdf72199b81d6a506"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "4939f2cf43ef80bffd0ec6638b9e2b73560fc7e7896d73cc3341b4affa256f94"
  }
}
