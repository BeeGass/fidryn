edition 2
module "/us/usc/t45/s1009" {
  within "/us/usc/t45/ch19"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1009" section {
    num "1009" "§ 1009."
    heading "Expedited proceedings"
    provision "/us/usc/t45/s1009/a" subsection {
      num "a" "(a)"
      content "The Commission shall give all proceedings involving the Rock Island Railroad preference over all other pending proceedings related to rail carriers and make all of its decisions at the earliest practicable time."
      hash "aee5cddf6064c666a463e8ddb37c155a5f68cd0e031a012612c424bcc710f446"
    }
    provision "/us/usc/t45/s1009/b" subsection {
      num "b" "(b)"
      content "The Commission shall, within 100 days of the filing of an application (or such shorter period as the court may set) pursuant to " ["section 915 of this title" -> "/us/usc/t45/s915"] ", reach a decision on all proceedings filed after January 1, 1980, which involve a sale, transfer or lease of any line of the Rock Island Railroad to a solvent carrier."
      hash "0754a45c32fb95650c9fd8dffdd1c5005bb0b35db9338fb9d6450dd40a46003d"
    }
    hash "fd2dae2d9ec1df8d7215268095ca647c495832ca1571cf49a0162e1c03f13011"
  }
  credit "(" ["Pub. L. 96–254, title I, § 111" -> "/us/pl/96/254/tI/s111"] ", May 30, 1980, " ["94 Stat. 404" -> "/us/stat/94/404"] ".)"
  note "/us/usc/t45/s1009/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  layers {
    operative "fd2dae2d9ec1df8d7215268095ca647c495832ca1571cf49a0162e1c03f13011"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "1d5c5ac0eced73397ee8208b734ae018f881ee59275b90d4df562d9f26f3ced0"
  }
}
