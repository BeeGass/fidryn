edition 2
module "/us/usc/t45/s1208" {
  within "/us/usc/t45/ch21"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1208" section {
    num "1208" "§ 1208."
    heading "Future rights-of-way"
    provision "/us/usc/t45/s1208/a" subsection {
      num "a" "(a)"
      heading "Access across Federal lands; application approval"
      content "After January 14, 1983, the State or State-owned railroad may request the Secretary of the Interior or the Secretary of Agriculture, as appropriate under law, to expeditiously approve an application for a right-of-way in order that the Alaska Railroad or State-owned railroad may have access across Federal lands for transportation and related purposes. The State or State-owned railroad may also apply for a lease, permit, or conveyance of any necessary or convenient terminal and station grounds and material sites in the vicinity of the right-of-way for which an application has been submitted."
      hash "92db6ca9d04375d074d93ffe9bd242c8a9de0200fb0f74dba143e8952c919e77"
    }
    provision "/us/usc/t45/s1208/b" subsection {
      num "b" "(b)"
      heading "Consultative requirements prior to approval of application; conformance of rights-of-way, etc."
      content "Before approving a right-of-way application described in subsection (a) of this section, the Secretary of the Interior or the Secretary of Agriculture, as appropriate, shall consult with the Secretary. Approval of an application for a right-of-way, permit, lease, or conveyance described in subsection (a) of this section shall be pursuant to applicable law. Rights-of-way, grounds, and sites granted pursuant to this section and other applicable law shall conform, to the extent possible, to the standards provided in the Act of March 12, 1914 (" ["43 U.S.C. 975" -> "/us/usc/t43/s975"] " et seq.) and " ["section 1202(6) of this title" -> "/us/usc/t45/s1202/6"] ". Such conformance shall not be affected by the repeal of such Act under " ["section 615 of this title" -> "/us/usc/t45/s615"] "." mark "1" 1
      hash "9dda51e700edfbe010f7f7c5dfc66b1efa79b99ba383e4ce3895a6410ca1c267"
    }
    hash "e627daf7c6675b30dfc717058e42fbf8be59d359e78bb889104b6b589d9ffc37"
  }
  credit "(" ["Pub. L. 97–468, title VI, § 609" -> "/us/pl/97/468/tVI/s609"] ", Jan. 14, 1983, " ["96 Stat. 2574" -> "/us/stat/96/2574"] "; " ["Pub. L. 108–7, div. I, title III, § 345(5)" -> "/us/pl/108/7/dI/tIII/s345/5"] ", Feb. 20, 2003, " ["117 Stat. 418" -> "/us/stat/117/418"] ".)"
  note "/us/usc/t45/s1208/note/editorialNotes/act.1914-03-12.ch37/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Act of March 12, 1914 (" ["43 U.S.C. 975" -> "/us/usc/t43/s975"] " et seq.), referred to in subsec. (b), is " ["act Mar. 12, 1914, ch. 37" -> "/us/act/1914-03-12/ch37"] ", " ["38 Stat. 305" -> "/us/stat/38/305"] ", popularly known as the Alaska Railroad Act, which enacted " ["section 353a of Title 16" -> "/us/usc/t16/s353a"] ", Conservation, and sections 975 to 975g of Title 43, Public Lands, and which was repealed by " ["section 615(a)(1) of Pub. L. 97–468" -> "/us/pl/97/468/s615/a/1"] " effective on the date of transfer of Alaska Railroad to the State [Jan. 5, 1985], pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] "."
    p ["Section 615 of this title" -> "/us/usc/t45/s615"] ", referred to in subsec. (b), means " ["section 615 of title VI of Pub. L. 97–468" -> "/us/pl/97/468/tVI/s615"] ", Jan. 14, 1983, " ["96 Stat. 2577" -> "/us/stat/96/2577"] ". Title VI of " ["Pub. L. 97–468" -> "/us/pl/97/468"] " is known as the Alaska Railroad Transfer Act of 1982 and is classified principally to this chapter. Under section 615, the repeal is effective on the date of transfer to the State of Alaska (pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] ") or other disposition (pursuant to " ["section 1210 of this title" -> "/us/usc/t45/s1210"] "), whichever first occurs."
    hash "215f29f769ee714e8d201391f33e0093d3ca770df458284a531fa5b2e2a58415"
  }
  note "/us/usc/t45/s1208/note/editorialNotes/pl.108.7/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2003—Subsec. (c). " ["Pub. L. 108–7" -> "/us/pl/108/7"] " struck out subsec. (c) which read as follows: “Reversion to the United States of any portion of any right-of-way or exclusive-use easement granted to the State or State-owned railroad shall occur only as provided in " ["section 1209 of this title" -> "/us/usc/t45/s1209"] ". For purposes of such section, the date of the approval of any such right-of-way shall be deemed the ‘date of transfer’.”"
    hash "62507fed51af5d132cfed9af2c92951ecd56b20bf62671bdebf758a6b3226a2a"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "e627daf7c6675b30dfc717058e42fbf8be59d359e78bb889104b6b589d9ffc37"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "40944533dceb28faf2de5c24c0f3dfb74679b85101f965c564c5e93e418c1c3e"
  }
}
