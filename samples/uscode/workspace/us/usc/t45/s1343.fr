  provision "/us/usc/t45/s1343" section {
    num "1343" "§ 1343."
    heading "Charter amendment"
    content {
      p "Within 60 days after October 21, 1986, the Corporation shall amend its Articles of Incorporation to contain the following provision, which provision shall not be subject to amendment or repeal:"
      p "“It shall be a fundamental purpose of the Corporation to maintain continued rail service in its service area.”."
    }
