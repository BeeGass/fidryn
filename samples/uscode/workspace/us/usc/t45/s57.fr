  provision "/us/usc/t45/s57" section {
    num "57" "§ 57."
    heading "Who included in term “common carrier”"
    content "The term “common carrier” as used in this chapter shall include the receiver or receivers or other persons or corporations charged with the duty of the management and operation of the business of a common carrier."
    hash "8fe8d244a7b2c07e2ff6b2686d29db181c9cd9ae1f1553d77c6c82b1c200022f"
