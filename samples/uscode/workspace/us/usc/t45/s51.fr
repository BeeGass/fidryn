  note "/us/usc/t45/s51/note/statutoryNotes/act.1906-06-11.ch3073/short-title" enacted {
    group statutoryNotes
    topic "shortTitle"
    heading "Short Title"
    p "The Act of Apr. 22, 1908, as amended, which comprises this chapter, is popularly known as the “Employers’ Liability Act”."
    p "The following are also popularly known as Employers’ Liability Acts:"
    p ["June 11, 1906, ch. 3073" -> "/us/act/1906-06-11/ch3073"] ", " ["34 Stat. 232" -> "/us/stat/34/232"] " [Unconstitutional]."
    p ["Apr. 5, 1910, ch. 143" -> "/us/act/1910-04-05/ch143"] ", " ["36 Stat. 291" -> "/us/stat/36/291"] ". See sections 56 and 59 of this title."
    p ["Aug. 11, 1939, ch. 685" -> "/us/act/1939-08-11/ch685"] ", " ["53 Stat. 1404" -> "/us/stat/53/1404"] ". See sections 51, 54, 56, and 60 of this title."
    hash "d3fbf26c29a4506c631803a467b9024e591602f08f3908955cbc1184f7b71e3f"
  }
