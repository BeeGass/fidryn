edition 2
module "/us/usc/t45/s797j" {
  within "/us/usc/t45/ch16/schVII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s797j" section {
    num "797j" "§ 797j."
    heading "Preemption"
    content "No State may adopt or continue in force any law, rule, regulation, order, or standard requiring the Corporation to employ any specified number of persons to perform any particular task, function, or operation, or requiring the Corporation to pay protective benefits to employees, and no State in the Region may adopt or continue in force any such law, rule, regulation, order, or standard with respect to any railroad in the Region."
    hash "2f8656fcbfc7f726d2310ae9e5c562ac35b64e707e16c34b9c043bccf7133d2f"
  }
  credit "(" ["Pub. L. 93–236, title VII, § 711" -> "/us/pl/93/236/tVII/s711"] ", as added " ["Pub. L. 97–35, title XI, § 1143(a)" -> "/us/pl/97/35/tXI/s1143/a"] ", Aug. 13, 1981, " ["95 Stat. 667" -> "/us/stat/95/667"] "; amended " ["Pub. L. 103–272, § 7(b)" -> "/us/pl/103/272/s7/b"] ", July 5, 1994, " ["108 Stat. 1379" -> "/us/stat/108/1379"] ".)"
  note "/us/usc/t45/s797j/note/editorialNotes/pl.103.272/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1994—" ["Pub. L. 103–272" -> "/us/pl/103/272"] " struck out “, the National Railroad Passenger Corporation, or the Amtrak Commuter Services Corporation” before “to employ any”."
    hash "5ec142dcf98e5b530563caa1118c59f6532cc6d2ff27a4073a1a2b227d549de6"
  }
  layers {
    operative "2f8656fcbfc7f726d2310ae9e5c562ac35b64e707e16c34b9c043bccf7133d2f"
