  provision "/us/usc/t45/s231p" section {
    num "231p" "§ 231p."
    heading "Free transportation"
    content "It shall not be unlawful for carriers by railroad subject to this subchapter to furnish free transportation to individuals receiving annuities under this subchapter in the same manner as such transportation is furnished to employees in their service."
    hash "8f8f5257089655f303ea60d5016004aba6ccc7a42a4424086bf5dc370a56ecf9"
  }
