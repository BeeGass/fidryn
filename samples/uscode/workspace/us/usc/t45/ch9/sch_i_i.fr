  note "/us/usc/t45/ch9/schII/note/editorialNotes/act.1935-08-29.ch812/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "This subchapter was comprised of " ["act Aug. 29, 1935, ch. 812" -> "/us/act/1935-08-29/ch812"] ", §§ 1–14, " ["49 Stat. 967" -> "/us/stat/49/967"] " to 973, known as the Railroad Retirement Act of 1935, and was amended in its entirety and completely revised by " ["act June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", " ["50 Stat. 307" -> "/us/stat/50/307"] ". The act, as amended and revised, was redesignated the Railroad Retirement Act of 1937 and was classified to subchapter III of this chapter. The Railroad Retirement Act of 1935 continued in effect with respect to individuals granted annuities prior to enactment of the Railroad Retirement Act of 1937. It was specifically amended by " ["act June 11, 1940, ch. 307, § 2" -> "/us/act/1940-06-11/ch307/s2"] ", " ["54 Stat. 264" -> "/us/stat/54/264"] ", and by " ["act Aug. 13, 1940, ch. 664" -> "/us/act/1940-08-13/ch664"] ", §§ 2, 3, " ["54 Stat. 785" -> "/us/stat/54/785"] "."
    hash "5df6f9d3dc5a2156374efda4e29b02a0f507b3101290cd40adc83dfb98b639d1"
  }
  layers {
    operative "76c4c064f71559620a76a20fd94a1d4580a57b0f2ab3efc7ed9d592ad6319a3a"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
