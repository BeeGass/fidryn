  note "/us/usc/t45/ch9/schIII/note/editorialNotes/act.1935-08-29.ch812/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "This subchapter was comprised of " ["act Aug. 29, 1935, ch. 812" -> "/us/act/1935-08-29/ch812"] ", as restated by " ["act June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", " ["50 Stat. 307" -> "/us/stat/50/307"] ", known as the Railroad Retirement Act of 1937. The Railroad Retirement Act of 1937 was amended in its entirety and completely revised by " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1305" -> "/us/stat/88/1305"] ", effective Jan. 1, 1975. The act, as amended and revised by " ["Pub. L. 93–445" -> "/us/pl/93/445"] ", was redesignated the Railroad Retirement Act of 1974 and is classified to subchapter IV of this chapter."
    hash "e3a3684a66424c1ba6dce34e72a2cd25d1865b49f36b8f8a8b2c80612005e674"
  }
