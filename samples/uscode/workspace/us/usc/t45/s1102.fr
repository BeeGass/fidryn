edition 2
module "/us/usc/t45/s1102" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1102" section {
    num "1102" "§ 1102."
    heading "Statement of purpose"
    chapeau "It is therefore declared to be the purpose of the Congress in this subtitle to provide for—"
    provision "/us/usc/t45/s1102/1" paragraph {
      num "1" "(1)"
      content "the removal by a date certain of the Federal Government’s obligation to subsidize the freight operations of Conrail;"
      hash "1f30bcc4cec1091a0a8419d81da797d3c296c457859dc670a2e162adf89449fe"
    }
    provision "/us/usc/t45/s1102/2" paragraph {
      num "2" "(2)"
      content "transfer of Conrail commuter service responsibilities to one or more entities whose principal purpose is the provision of commuter service; and"
      hash "ae5f53477fcb19bc67f4c60eed2a1a699dfb644638593fb99ecc0477db008d4c"
    }
    provision "/us/usc/t45/s1102/3" paragraph {
      num "3" "(3)"
      content "an orderly return of Conrail freight service to the private sector."
      hash "d75ffdea086a474fa8e7c93dfb48ac679e9ad84d297e88fa309249710b2eea92"
    }
    hash "7a7cbe0aa1a58808bc0431eb87564faabaa40b1172c5b3be87fc06fb74b7e8c3"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1133" -> "/us/pl/97/35/tXI/s1133"] ", Aug. 13, 1981, " ["95 Stat. 644" -> "/us/stat/95/644"] ".)"
  note "/us/usc/t45/s1102/note/editorialNotes/pl.97.35/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This subtitle, referred to in text, is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", known as the Northeast Rail Service Act of 1981. For complete classification of this subtitle to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    hash "4226f20bde2035056f4e79fecc932d445a169b9fe19d689dede16bd1c468080a"
  }
  layers {
    operative "7a7cbe0aa1a58808bc0431eb87564faabaa40b1172c5b3be87fc06fb74b7e8c3"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "8767f1186cfeb0c5fdc1936b3827f2de981413d77c8f96f775974264ad12481d"
  }
}
