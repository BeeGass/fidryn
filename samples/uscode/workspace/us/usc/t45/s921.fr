  provision "/us/usc/t45/s921" section {
    num "921" "§ 921."
    heading "Office of Rail Public Counsel"
    content "The Office of Rail Public Counsel may appear and be heard in the case in the bankruptcy court involving the reorganization of the Milwaukee Railroad, for purposes of representing affected shippers, localities, and municipalities with respect to the proposed abandonment of any line of the Milwaukee Railroad."
    hash "a2bc33f4c33c8a9e759a3fb7f863dee94d4ce65434b0329a8dc6278a81735098"
