    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  note "/us/usc/t45/s719/note/statutoryNotes/pl.104.317/cases-pending-in-special-court" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Cases Pending in Special Court"
    p ["Pub. L. 104–317, title VI, § 605(d)" -> "/us/pl/104/317/tVI/s605/d"] ", Oct. 19, 1996, " ["110 Stat. 3859" -> "/us/stat/110/3859"] ", provided that:"
    quoted "/us/pl/104/317/tVI/s605/d" {
      p "“Effective 90 days after the date of enactment of this Act [Oct. 19, 1996], any case pending in the special court established under section 209(b) of the Regional Rail Reorganization Act of 1973 (" ["45 U.S.C. 719(b)" -> "/us/usc/t45/s719/b"] ") shall be assigned to the United States District Court for the District of Columbia as though the case had originally been filed in that court. The amendments made by subsection (b) of this section [amending this section and sections 743 and 1105 of this title] shall not apply to any final order or judgment entered by the special court for which—"
      level paragraph {
        num "1" "“(1)"
        content "a petition for writ of certiorari has been filed before the date on which the special court is abolished; or"
      }
      level paragraph {
        num "2" "“(2)"
        content "the time for filing a petition for writ of certiorari has not expired before that date.”"
      }
    }
    hash "7a005731e30be411d9c1f270188bc69e2270e8993e399c276901327b3850ed4d"
  }
  note "/us/usc/t45/s719/note/statutoryNotes/pl.94.210/applicability-of-national-environmental-policy-act" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Applicability of National Environmental Policy Act"
    p "Application of National Environmental Policy Act to actions of Commission not affected by title VI of " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", see " ["section 619 of Pub. L. 94–210" -> "/us/pl/94/210/s619"] ", set out as a note under " ["section 791 of this title" -> "/us/usc/t45/s791"] "."
    hash "7ce373698c822f6cf7cb1f07e93f5e378a6239d819a9e93ab08ae9f21b104a45"
  }
  note "/us/usc/t45/s719/note/courtRules/nolaw/rules-of-the-special-court-regional-rail-reorganization-act" enacted {
    group courtRules
    topic "miscellaneous"
    heading "Rules of the Special Court, Regional Rail Reorganization Act of 1973"
    p "Rules of the Special Court, Regional Rail Reorganization Act of 1973, formerly set out under this section, were omitted because the Special Court was abolished effective 90 days after Oct. 19, 1996. See subsec. (b)(2) of this section."
    hash "de83f75bf7b831aec6a0212c0fc4af4d68217f879068aaa219bc7cadd708f42d"
  }
  footnote 1 "1" {
    p "See Codification note below."
  }
