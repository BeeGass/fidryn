edition 2
module "/us/usc/t45/s159a" {
  within "/us/usc/t45/ch8/schI"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s159a" section {
    num "159a" "§ 159a."
    heading "Special procedure for commuter service"
    provision "/us/usc/t45/s159a/a" subsection {
      num "a" "(a)"
      heading "Applicability of provisions"
      content "Except as provided in section 590(h)" mark "1" 1 " of this title, the provisions of this section shall apply to any dispute subject to this chapter between a publicly funded and publicly operated carrier providing rail commuter service (including the Amtrak Commuter Services Corporation) and its employees."
      hash "2ca584aad97e04aac2ec9c129cb6ae27dd0eb7b664301e017cc3923b85706467"
    }
    provision "/us/usc/t45/s159a/b" subsection {
      num "b" "(b)"
      heading "Request for establishment of emergency board"
      content "If a dispute between the parties described in subsection (a) is not adjusted under the foregoing provisions of this chapter and the President does not, under " ["section 160 of this title" -> "/us/usc/t45/s160"] ", create an emergency board to investigate and report on such dispute, then any party to the dispute or the Governor of any State through which the service that is the subject of the dispute is operated may request the President to establish such an emergency board."
      hash "8903c83adfcb58609350d3d49cac1592462b87453777f36ce452c271b8ff57f8"
    }
    provision "/us/usc/t45/s159a/c" subsection {
      num "c" "(c)"
      heading "Establishment of emergency board"
      provision "/us/usc/t45/s159a/c/1" paragraph {
        num "1" "(1)"
        content "Upon the request of a party or a Governor under subsection (b), the President shall create an emergency board to investigate and report on the dispute in accordance with " ["section 160 of this title" -> "/us/usc/t45/s160"] ". For purposes of this subsection, the period during which no change, except by agreement, shall be made by the parties in the conditions out of which the dispute arose shall be 120 days from the day of the creation of such emergency board."
        hash "d26e38afea17fc73e8d295f632ddc70317bcc6ee7e0645e27a7c9a2fc7c3e1b4"
      }
      provision "/us/usc/t45/s159a/c/2" paragraph {
        num "2" "(2)"
        content "If the President, in his discretion, creates a board to investigate and report on a dispute between the parties described in subsection (a), the provisions of this section shall apply to the same extent as if such board had been created pursuant to paragraph (1) of this subsection."
        hash "8a39337cd238b8ed097456b236a2fab9c9a907b0d675c15dfbc1c7986a5645c5"
      }
      hash "3aefa281db313d48636fbde1538c6db1459d0898b511e32500ab2d51643f8db0"
    }
    provision "/us/usc/t45/s159a/d" subsection {
      num "d" "(d)"
      heading "Public hearing by National Mediation Board upon failure of emergency board to effectuate settlement of dispute"
      content "Within 60 days after the creation of an emergency board under this section, if there has been no settlement between the parties, the National Mediation Board shall conduct a public hearing on the dispute at which each party shall appear and provide testimony setting forth the reasons it has not accepted the recommendations of the emergency board for settlement of the dispute."
      hash "fb462d9414422d27f0a12591de05341e11326d7cb2bfc0ab5f7591ceb7b5b217"
    }
    provision "/us/usc/t45/s159a/e" subsection {
      num "e" "(e)"
      heading "Establishment of second emergency board"
      content "If no settlement in the dispute is reached at the end of the 120-day period beginning on the date of the creation of the emergency board, any party to the dispute or the Governor of any State through which the service that is the subject of the dispute is operated may request the President to establish another emergency board, in which case the President shall establish such emergency board."
      hash "277221143f5247ea4adce61063212badb681c0aee545d5f4ed752afdb5d1296b"
    }
    provision "/us/usc/t45/s159a/f" subsection {
      num "f" "(f)"
      heading "Submission of final offers to second emergency board by parties"
      content "Within 30 days after creation of a board under subsection (e), the parties to the dispute shall submit to the board final offers for settlement of the dispute."
      hash "66b70d7ce5acf3e90b04f66e2a417086e7e24a89a49aa8001bb7b14cf43cad19"
    }
    provision "/us/usc/t45/s159a/g" subsection {
      num "g" "(g)"
      heading "Report of second emergency board"
      content "Within 30 days after the submission of final offers under subsection (f), the emergency board shall submit a report to the President setting forth its selection of the most reasonable offer."
      hash "d492ec137e807b2f7fb5ea2d21a5bd2d502aed24426dde193fa92c07e870563a"
    }
    provision "/us/usc/t45/s159a/h" subsection {
      num "h" "(h)"
      heading "Maintenance of status quo during dispute period"
      content "From the time a request to establish a board is made under subsection (e) until 60 days after such board makes its report under subsection (g), no change, except by agreement, shall be made by the parties in the conditions out of which the dispute arose."
      hash "ee2485465303684687ab35dc9d3ea2324c736431d2a851c6c099972392154990"
    }
    provision "/us/usc/t45/s159a/i" subsection {
      num "i" "(i)"
      heading "Work stoppages by employees subsequent to carrier offer selected; eligibility of employees for benefits"
      content "If the emergency board selects the final offer submitted by the carrier and, after the expiration of the 60-day period described in subsection (h), the employees of such carrier engage in any work stoppage arising out of the dispute, such employees shall not be eligible during the period of such work stoppage for benefits under the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.]."
      hash "e370d73924a8300f25aa51878c3012604e5bfedd28a707757ae0c4c8cbd37204"
    }
    provision "/us/usc/t45/s159a/j" subsection {
      num "j" "(j)"
      heading "Work stoppages by employees subsequent to employees offer selected; eligibility of employer for benefits"
      content "If the emergency board selects the final offer submitted by the employees and, after the expiration of the 60-day period described in subsection (h), the carrier refuses to accept the final offer submitted by the employees and the employees of such carrier engage in any work stoppage arising out of the dispute, the carrier shall not participate in any benefits of any agreement between carriers which is designed to provide benefits to such carriers during a work stoppage."
      hash "bcde5d30e7673b6c9c9e875c94b9fc063b0f06ed0289d13702c7de5aa9591e5c"
    }
    hash "f1c0ff394b2ddc416f58ac106aeae641abbc0a521a43e0bb17eb17d411775ef1"
  }
  credit "(" ["May 20, 1926, ch. 347, § 9A" -> "/us/act/1926-05-20/ch347/s9A"] ", as added " ["Pub. L. 97–35, title XI, § 1157" -> "/us/pl/97/35/tXI/s1157"] ", Aug. 13, 1981, " ["95 Stat. 681" -> "/us/stat/95/681"] ".)"
  note "/us/usc/t45/s159a/note/editorialNotes/pl.103.272/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 590(h) of this title" -> "/us/usc/t45/s590/h"] ", referred to in subsec. (a), was repealed by " ["Pub. L. 103–272, § 7(b)" -> "/us/pl/103/272/s7/b"] ", July 5, 1994, " ["108 Stat. 1379" -> "/us/stat/108/1379"] "."
    p "The Railroad Unemployment Insurance Act, referred to in subsec. (i), is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to chapter 11 (§ 351 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "ccd878db3be442a284a4ddead51d1f03c0c69feea4991d2eab6e779895b7bbdc"
  }
  note "/us/usc/t45/s159a/note/statutoryNotes/pl.97.35/effective-date" editorial {
    group statutoryNotes
    topic "effectiveDate"
    heading "Effective Date"
    p "Section effective Aug. 13, 1981, see " ["section 1169 of Pub. L. 97–35" -> "/us/pl/97/35/s1169"] ", set out as a note under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] "."
    hash "c0941333df7fda0a7e45f1a15726e04b8f5639248b2b6fb747963faa50869950"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "f1c0ff394b2ddc416f58ac106aeae641abbc0a521a43e0bb17eb17d411775ef1"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "ad7eb4ae54f500112bb5a37c860dd350d380553a6ed53834833c92cf24787b02"
  }
}
