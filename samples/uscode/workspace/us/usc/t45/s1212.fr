edition 2
module "/us/usc/t45/s1212" {
  within "/us/usc/t45/ch21"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1212" section {
    num "1212" "§ 1212."
    heading "Applicability of other laws"
    provision "/us/usc/t45/s1212/a" subsection {
      num "a" "(a)"
      heading "Actions subject to other laws"
      content "The provisions of chapter 5 of title 5 (popularly known as the Administrative Procedure Act, and including provisions popularly known as the Government in the Sunshine Act), chapter 10 of title 5, division A of subtitle III of title 54, " ["section 303 of title 49" -> "/us/usc/t49/s303"] ", and the National Environmental Policy Act of 1969 (" ["42 U.S.C. 4321" -> "/us/usc/t42/s4321"] " et seq.) shall not apply to actions taken pursuant to this chapter, except to the extent that such laws may be applicable to granting of rights-of-way under " ["section 1208 of this title" -> "/us/usc/t45/s1208"] "."
      hash "40b35ed73f3e679595b408251957b2c75011bb9c3d9283b5818f9356d3aba778"
    }
    provision "/us/usc/t45/s1212/b" subsection {
      num "b" "(b)"
      heading "Federal surplus property disposal; withdrawal or reservation of land for use of Alaska Railroad"
      content "The enactment of this chapter, actions taken during the transition period as provided in " ["section 1204 of this title" -> "/us/usc/t45/s1204"] ", and transfer of the rail properties of the Alaska Railroad under authority of this chapter shall be deemed not to be the disposal of Federal surplus property under sections 541 to 555 of title 40 or the Act of October 3, 1944, popularly referred to as the “Surplus Property Act of 1944” (50 U.S.C. App. 1622)." mark "1" 1 " Such events shall not constitute or cause the revocation of any prior withdrawal or reservation of land for the use of the Alaska Railroad under the Act of March 12, 1914 (" ["43 U.S.C. 975" -> "/us/usc/t43/s975"] " et seq.), the Alaska Statehood Act (note preceding " ["48 U.S.C. 21" -> "/us/usc/t48/s21"] "), the Alaska Native Claims Settlement Act (" ["43 U.S.C. 1601" -> "/us/usc/t43/s1601"] " et seq.), the Act of January 2, 1976 (" ["Public Law 94–204" -> "/us/pl/94/204"] "; " ["89 Stat. 1145" -> "/us/stat/89/1145"] "), the Alaska National Interest Lands Conservation Act (" ["Public Law 96–487" -> "/us/pl/96/487"] "; " ["94 Stat. 2371" -> "/us/stat/94/2371"] "), and the general land and land management laws of the United States."
      hash "0bb91de3583386e8692ef31bfa212d841e2c3bdc4d6725dfbc07599138831df2"
    }
    provision "/us/usc/t45/s1212/c" subsection {
      num "c" "(c)"
      heading "Ceiling on Government contributions for Federal employees health benefits insurance premiums"
      content "Beginning on January 14, 1983, the ceiling on Government contributions for Federal employees health benefits insurance premiums under " ["section 8906(b)(2) of title 5" -> "/us/usc/t5/s8906/b/2"] " shall not apply to the Alaska Railroad."
      hash "a7014c9bf22d6a445340a392dbe3194487a92950037c469aedc2e9604f8dbaf0"
    }
    provision "/us/usc/t45/s1212/d" subsection {
      num "d" "(d)"
      heading "Acreage entitlement of State or Native Corporation"
      content "Nothing in this chapter is intended to enlarge or diminish the acreage entitlement of the State or any Native Corporation pursuant to existing law."
      hash "7ee7d2a822b49a5428fe1eec33ceb3a7fc132493b0aef176ddd3c2454f890cf1"
    }
    provision "/us/usc/t45/s1212/e" subsection {
      num "e" "(e)"
      heading "Judgments involving interests, etc., of Native Corporations"
      content "With respect to interests of Native Corporations under the Alaska Native Claims Settlement Act (" ["43 U.S.C. 1601" -> "/us/usc/t43/s1601"] " et seq.) and the Alaska National Interest Lands Conservation Act (" ["16 U.S.C. 3101" -> "/us/usc/t16/s3101"] " et seq.), except as provided in this chapter, nothing contained in this chapter shall be construed to deny, enlarge, grant, impair, or otherwise affect any judgment heretofore entered in a court of competent jurisdiction, or valid existing right or claim of valid existing right."
      hash "26914ac876ed761e0dddadb715d793a5feb70596712fea98f1ed8350b5071fa0"
    }
    hash "9648d52d15d6dbd5397cc391a9364d54cbde430b78109365eb379ce1b0296741"
  }
  credit "(" ["Pub. L. 97–468, title VI, § 613" -> "/us/pl/97/468/tVI/s613"] ", Jan. 14, 1983, " ["96 Stat. 2577" -> "/us/stat/96/2577"] "; " ["Pub. L. 113–287, § 5(m)(2)" -> "/us/pl/113/287/s5/m/2"] ", Dec. 19, 2014, " ["128 Stat. 3271" -> "/us/stat/128/3271"] "; " ["Pub. L. 117–286, § 4(a)(289)" -> "/us/pl/117/286/s4/a/289"] ", Dec. 27, 2022, " ["136 Stat. 4337" -> "/us/stat/136/4337"] ".)"
  note "/us/usc/t45/s1212/note/editorialNotes/act.1946-06-11.ch324/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Administrative Procedure Act, referred to in subsec. (a), is " ["act June 11, 1946, ch. 324" -> "/us/act/1946-06-11/ch324"] ", " ["60 Stat. 237" -> "/us/stat/60/237"] ", which was classified to sections 1001 to 1011 of former title 5 and which was repealed and reenacted as subchapter II (§ 551 et seq.) of chapter 5, and chapter 7 (§ 701 et seq.), of Title 5, Government Organization and Employees, by " ["Pub. L. 89–554" -> "/us/pl/89/554"] ", Sept. 6, 1966, " ["80 Stat. 378" -> "/us/stat/80/378"] "."
    p "The Government in the Sunshine Act, referred to in subsec. (a), is " ["Pub. L. 94–409" -> "/us/pl/94/409"] ", Sept. 13, 1976, " ["90 Stat. 1241" -> "/us/stat/90/1241"] ", which enacted " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] ", Government Organization and Employees, amended sections 551, 552, 556, and 557 of Title 5, " ["section 10 of Pub. L. 92–463" -> "/us/pl/92/463/s10"] ", formerly set out in the Appendix to Title 5, and " ["section 410 of Title 39" -> "/us/usc/t39/s410"] ", Postal Service, and enacted provisions set out as notes under " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] ". For complete classification of this Act to the Code, see Short Title of 1976 Amendment note set out under " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] " and Tables."
    p "The National Environmental Policy Act of 1969, referred to in subsec. (a), is " ["Pub. L. 91–190" -> "/us/pl/91/190"] ", Jan. 1, 1970, " ["83 Stat. 852" -> "/us/stat/83/852"] ", which is classified generally to chapter 55 (§ 4321 et seq.) of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see Short Title note set out under " ["section 4321 of Title 42" -> "/us/usc/t42/s4321"] " and Tables."
    p "Act of October 3, 1944, popularly referred to as the “Surplus Property Act of 1944”, referred to in subsec. (b), is " ["act Oct. 3, 1944, ch. 479" -> "/us/act/1944-10-03/ch479"] ", " ["58 Stat. 765" -> "/us/stat/58/765"] ", known as the Surplus Property Act of 1944, which was classified principally to sections 1611 to 1646 of the former Appendix to Title 50, War and National Defense, and was repealed effective July 1, 1949, with the exception of sections 1622, 1631, 1637, and 1641 of the former Appendix to Title 50 by " ["act June 30, 1949, ch. 288, title VI, § 602(a)(1)" -> "/us/act/1949-06-30/ch288/tVI/s602/a/1"] ", " ["63 Stat. 399" -> "/us/stat/63/399"] ", renumbered " ["Sept. 5, 1950, ch. 849, § 6(a)" -> "/us/act/1950-09-05/ch849/s6/a"] ", (b), " ["64 Stat. 583" -> "/us/stat/64/583"] ". Sections 1622 and 1641 were partially repealed by the 1949 act, and section 1622 was editorially reclassified and is set out as a note under " ["section 545 of Title 40" -> "/us/usc/t40/s545"] ", Public Buildings, Property, and Works. Section 1622(g) was repealed and reenacted as sections 47151 to 47153 of Title 49, Transportation, by " ["Pub. L. 103–272" -> "/us/pl/103/272"] ", §§ 1(e), 7(b), July 5, 1994, " ["108 Stat. 1278–1280" -> "/us/stat/108/1278-1280"] ", 1379. Section 1631 was repealed by " ["act June 7, 1939, ch. 190, § 6(e)" -> "/us/act/1939-06-07/ch190/s6/e"] ", as added by " ["act July 23, 1946, ch. 590" -> "/us/act/1946-07-23/ch590"] ", " ["60 Stat. 599" -> "/us/stat/60/599"] ", and is covered by sections 98 et seq. of Title 50. Section 1637 was repealed by " ["act June 25, 1948, ch. 645, § 21" -> "/us/act/1948-06-25/ch645/s21"] ", " ["62 Stat. 862" -> "/us/stat/62/862"] ", eff. Sept. 1, 1948, and is covered by " ["section 3287 of Title 18" -> "/us/usc/t18/s3287"] ", Crimes and Criminal Procedure. Provisions of section 1641 not repealed by the 1949 act were repealed by " ["Pub. L. 87–256, § 111(a)(1)" -> "/us/pl/87/256/s111/a/1"] ", Sept. 21, 1961, " ["75 Stat. 538" -> "/us/stat/75/538"] ", and are covered by chapter 33 (§ 2451 et seq.) of Title 22, Foreign Relations and Intercourse."
    p "Act of March 12, 1914, referred to in subsec. (b), is " ["act Mar. 12, 1914, ch. 37" -> "/us/act/1914-03-12/ch37"] ", " ["38 Stat. 305" -> "/us/stat/38/305"] ", popularly known as the Alaska Railroad Act, which enacted " ["section 353a of Title 16" -> "/us/usc/t16/s353a"] ", Conservation, and sections 975 to 975g of Title 43, Public Lands, and which was repealed by " ["section 615(a)(1) of Pub. L. 97–468" -> "/us/pl/97/468/s615/a/1"] " effective on the date of transfer of Alaska Railroad to the State [Jan. 5, 1985], pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] "."
    p "The Alaska Statehood Act, referred to in subsec. (b), is " ["Pub. L. 85–508" -> "/us/pl/85/508"] ", July 7, 1958, " ["72 Stat. 339" -> "/us/stat/72/339"] ", which is set out as a note preceding " ["section 21 of Title 48" -> "/us/usc/t48/s21"] ", Territories and Insular Possessions. For complete classification of this Act to the Code, see Tables."
    p "The Alaska Native Claims Settlement Act, referred to in subsecs. (b) and (e), is " ["Pub. L. 92–203" -> "/us/pl/92/203"] ", Dec. 18, 1971, " ["85 Stat. 688" -> "/us/stat/85/688"] ", which is classified generally to chapter 33 (§ 1601 et seq.) of Title 43, Public Lands. For complete classification of this Act to the Code, see Short Title note set out under " ["section 1601 of Title 43" -> "/us/usc/t43/s1601"] " and Tables."
    p "Act of January 2, 1976 (" ["Public Law 94–204" -> "/us/pl/94/204"] "; " ["89 Stat. 1145" -> "/us/stat/89/1145"] "), referred to in subsec. (b), amended the Alaska Native Claims Settlement Act (" ["43 U.S.C. 1601" -> "/us/usc/t43/s1601"] " et seq.). For complete classification of this Act to the Code, see Tables."
    p "The Alaska National Interest Lands Conservation Act, referred to in subsecs. (b) and (e), is " ["Pub. L. 96–487" -> "/us/pl/96/487"] ", Dec. 2, 1980, " ["94 Stat. 2371" -> "/us/stat/94/2371"] ". For complete classification of this Act to the Code, see Short Title note set out under " ["section 3101 of Title 16" -> "/us/usc/t16/s3101"] ", Conservation, and Tables."
    hash "9d4d8647c0cd27b1f054dab38ab27c59f1ff04c6b5bd0cf502fb8561e0289313"
  }
  note "/us/usc/t45/s1212/note/editorialNotes/pl.97.449/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "In subsec. (a), “" ["section 303 of title 49" -> "/us/usc/t49/s303"] "” substituted for “section 4(f) of the Department of Transportation Act (" ["49 U.S.C. 1653(f)" -> "/us/usc/t49/s1653/f"] ")” on authority of " ["Pub. L. 97–449, § 6(b)" -> "/us/pl/97/449/s6/b"] ", Jan. 12, 1983, " ["96 Stat. 2443" -> "/us/stat/96/2443"] ", the first section of which enacted subtitle I (§ 101 et seq.) and chapter 31 (§ 3101 et seq.) of subtitle II of Title 49, Transportation."
    p "In subsec. (b), “sections 541 to 555 of title 40” substituted for “the Federal Property and Administrative Services Act of 1949 (" ["40 U.S.C. 484" -> "/us/usc/t40/s484"] ")” on authority of " ["Pub. L. 107–217, § 5(c)" -> "/us/pl/107/217/s5/c"] ", Aug. 21, 2002, " ["116 Stat. 1303" -> "/us/stat/116/1303"] ", which Act enacted Title 40, Public Buildings, Property, and Works."
    hash "cd6a7980c7a086e4f6c13003770607c60c7228ee67cde6fe439cb2c131e307d7"
  }
  note "/us/usc/t45/s1212/note/editorialNotes/pl.117.286/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2022—Subsec. (a). " ["Pub. L. 117–286" -> "/us/pl/117/286"] " substituted “chapter 10 of title 5,” for “the Federal Advisory Committee Act (5 U.S.C. App. 1 et seq.),”."
    p "2014—Subsec. (a). " ["Pub. L. 113–287" -> "/us/pl/113/287"] " substituted “division A of subtitle III of title 54” for “the National Historic Preservation Act (" ["16 U.S.C. 470" -> "/us/usc/t16/s470"] " et seq.)”."
    hash "32cad750a3cc81acf747e457dc10df129441bfd2c7c8836330b377b8db59a12e"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "9648d52d15d6dbd5397cc391a9364d54cbde430b78109365eb379ce1b0296741"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "ac68aa763ffb550b0f209b5b085aa9bd1daee3b9fe63646ae5e77bb37fdc671e"
  }
}
