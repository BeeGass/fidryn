  note "/us/usc/t45/s745/note/statutoryNotes/nolaw/abolition-of-special-court-regional-rail-reorganization-act" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Special Court, Regional Rail Reorganization Act of 1973, and Transfer of Functions"
    p "Special court abolished and all jurisdiction and functions transferred to United States District Court for District of Columbia, see " ["section 719(b)(2) of this title" -> "/us/usc/t45/s719/b/2"] "."
    hash "b36896cd25152a2ad11f070c8b08b800c6cb73145cec88413adfe814d660133f"
  }
  note "/us/usc/t45/s745/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "8df987ce55ef91d27f02ab3e754938301447cac8bb0f6033019330c324c8ba4c"
  }
  note "/us/usc/t45/s745/note/statutoryNotes/pl.94.210/applicability-of-national-environmental-policy-act" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Applicability of National Environmental Policy Act"
    p "Application of National Environmental Policy Act to actions of Commission not affected by title VI of " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", see " ["section 619 of Pub. L. 94–210" -> "/us/pl/94/210/s619"] ", set out as a note under " ["section 791 of this title" -> "/us/usc/t45/s791"] "."
    hash "7ce373698c822f6cf7cb1f07e93f5e378a6239d819a9e93ab08ae9f21b104a45"
  }
  note "/us/usc/t45/s745/note/statutoryNotes/pl.94.210/rail-abandonment-and-discontinuance-of-service-report" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Rail Abandonment and Discontinuance of Service Report"
    p ["Pub. L. 94–210, title IX, § 904" -> "/us/pl/94/210/tIX/s904"] ", Feb. 5, 1976, " ["90 Stat. 148" -> "/us/stat/90/148"] ", directed Secretary to submit to Congress, within ninety days of Feb. 5, 1976, a report on anticipated effect of any abandonment of lines of railroad and any discontinuances of rail service in States outside the region as defined in " ["section 702 of this title" -> "/us/usc/t45/s702"] ", prior to repeal by " ["Pub. L. 103–272, § 7(b)" -> "/us/pl/103/272/s7/b"] ", July 5, 1994, " ["108 Stat. 1379" -> "/us/stat/108/1379"] "."
    hash "9259ced5d6b24adffd6c9654a9093af3bfe572bf262a6c24224ed1ffcfaa932e"
  }
