  }
  note "/us/usc/t45/s81...92/note/ungrouped/act.1948-06-25.ch646/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 87, R.S. § 5261; " ["June 25, 1948, ch. 646, § 4" -> "/us/act/1948-06-25/ch646/s4"] ", " ["62 Stat. 986" -> "/us/stat/62/986"] "; Apr. 2, 1982, " ["Pub. L. 97–164, title I, § 161(8)" -> "/us/pl/97/164/tI/s161/8"] ", " ["96 Stat. 49" -> "/us/stat/96/49"] "; Oct. 29, 1992, " ["Pub. L. 102–572, title IX, § 902(b)(2)" -> "/us/pl/102/572/tIX/s902/b/2"] ", " ["106 Stat. 4516" -> "/us/stat/106/4516"] ", provided that companies from whom payments for freight and transportation had been withheld under provisions of " ["section 86 of this title" -> "/us/usc/t45/s86"] " could sue in Court of Federal Claims."
    hash "f8494dcd30578179eeaed347d09048ac79ff32f8ca91d7a7f71183f06b802903"
  }
  note "/us/usc/t45/s81...92/note/ungrouped/act.1911-03-03.ch231/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 88, R.S. § 5262; " ["Mar. 3, 1911, ch. 231, § 291" -> "/us/act/1911-03-03/ch231/s291"] ", " ["36 Stat. 1167" -> "/us/stat/36/1167"] ", related to jurisdiction of proper United States district court to hear and determine all cases of mandamus to compel Union Pacific Railroad Company to operate its road."
    hash "2f297eab4b1dea615ea02ff0cc1e63436ce2bd82485de35acbc8cac24b498368"
  }
  note "/us/usc/t45/s81...92/note/ungrouped/act.1874-06-22.ch414/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 89, acts " ["June 22, 1874, ch. 414" -> "/us/act/1874-06-22/ch414"] ", " ["18 Stat. 200" -> "/us/stat/18/200"] "; " ["Mar. 3, 1911, ch. 231, § 291" -> "/us/act/1911-03-03/ch231/s291"] ", " ["36 Stat. 1167" -> "/us/stat/36/1167"] ", directed Secretary of the Treasury to require that railroad companies, their successors and assigns, pay United States a percentage of net earnings as provided for by law."
    hash "6dbef4111ee3ab20991b474b656b73bccdd1af6bc3a4b6b2fa4d68f1e1504e84"
  }
  note "/us/usc/t45/s81...92/note/ungrouped/act.1879-03-03.ch183/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 90, " ["act Mar. 3, 1879, ch. 183, § 1" -> "/us/act/1879-03-03/ch183/s1"] ", " ["20 Stat. 420" -> "/us/stat/20/420"] ", authorized Secretary of the Treasury to settle accounts of Union Pacific, Central Pacific, Kansas Pacific, Western Pacific, and Sioux City and Pacific Railroad Companies for services provided to Government in transporting the Army and mails."
