  }
  note "/us/usc/t45/s81...92/note/ungrouped/act.1864-07-02.ch216/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 83, acts " ["July 2, 1864, ch. 216, § 15" -> "/us/act/1864-07-02/ch216/s15"] ", " ["13 Stat. 362" -> "/us/stat/13/362"] "; " ["June 20, 1874, ch. 331" -> "/us/act/1874-06-20/ch331"] ", " ["18 Stat. 111" -> "/us/stat/18/111"] "; " ["Mar. 3, 1911, ch. 231, § 291" -> "/us/act/1911-03-03/ch231/s291"] ", " ["36 Stat. 1167" -> "/us/stat/36/1167"] ", provided that companies authorized by Pacific Railroad Acts to construct railroads were required to operate roads and telegraphs as one continuous line and to afford equal advantages and facilities as to rates, time, and transportation to the other companies without discrimination."
    hash "e9053b4e31a5dfc6241b01e06974d7bb321c81d5e3a32fa8dbab53e05278a84f"
  }
  note "/us/usc/t45/s81...92/note/ungrouped/nolaw/h.6e0894c11f81f072" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 84, R.S. § 5258, authorized interstate transport by railroads."
