  }
  note "/us/usc/t45/s81...92/note/ungrouped/nolaw/h.246f296d9975e3df" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 86, R.S. § 5260, related to withholding by Secretary of the Treasury of payments to certain railroads."
