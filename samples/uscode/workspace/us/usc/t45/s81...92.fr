  }
  note "/us/usc/t45/s81...92/note/ungrouped/nolaw/h.0a0133485ade7ac0" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 85, R.S. § 5259, related to compensation of directors, engineers, commissioners, or other agents appointed by the United States to examine roads or to act in conjunction with other officers of railroads or other corporations receiving land grants or other subsidies."
