edition 2
module "/us/usc/t45/s1116" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1116" section {
    num "1116" "§ 1116."
    heading "Applicability of other laws"
    provision "/us/usc/t45/s1116/a" subsection {
      num "a" "(a)"
      content "The provisions of chapters 5 and 7 of title 5 (popularly known as the Administrative Procedure Act and including provisions popularly known as the Government in the Sunshine Act), chapter 10 of title 5, section 102(2)(C) of the National Environmental Policy Act of 1969 [" ["42 U.S.C. 4332(2)(C)" -> "/us/usc/t42/s4332/2/C"] "], division A of subtitle III of title 54, and " ["section 303 of title 49" -> "/us/usc/t49/s303"] " are inapplicable to actions taken in negotiating, approving, or implementing service transfers under title IV of the Regional Rail Reorganization Act of 1973 [" ["45 U.S.C. 761" -> "/us/usc/t45/s761"] " et seq.]" mark "1" 1 " and to the implementation of the sale of the interest of the United States in Conrail under the Conrail Privatization Act [" ["45 U.S.C. 1301" -> "/us/usc/t45/s1301"] " et seq.]."
      hash "d380e6c5356a6391da1d1a652db0190b4ee9dcc0119beaa2f0637e3cb1734e68"
    }
    provision "/us/usc/t45/s1116/b" subsection {
      num "b" "(b)"
      content "The operation of trains by Conrail shall not be subject to the requirement of any State or local law which specifies the minimum number of crew members who must be employed in connection with the operation of such trains."
      hash "59b74a680bb5fd15fbec8002985d4eebe96fc3b7c30ffc2b9806e3d1811ea983"
    }
    hash "9cd05b869a6a662e2051184d415ddb90704723c921a73372113af43bfed2bc0c"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1168" -> "/us/pl/97/35/tXI/s1168"] ", Aug. 13, 1981, " ["95 Stat. 687" -> "/us/stat/95/687"] "; " ["Pub. L. 99–509, title IV, § 4033(c)(1)(B)" -> "/us/pl/99/509/tIV/s4033/c/1/B"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "; " ["Pub. L. 113–287, § 5(m)(1)" -> "/us/pl/113/287/s5/m/1"] ", Dec. 19, 2014, " ["128 Stat. 3271" -> "/us/stat/128/3271"] "; " ["Pub. L. 117–286, § 4(a)(288)" -> "/us/pl/117/286/s4/a/288"] ", Dec. 27, 2022, " ["136 Stat. 4337" -> "/us/stat/136/4337"] ".)"
  note "/us/usc/t45/s1116/note/editorialNotes/act.1946-06-11.ch324/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Administrative Procedure Act, referred to in subsec. (a), is " ["act June 11, 1946, ch. 324" -> "/us/act/1946-06-11/ch324"] ", " ["60 Stat. 237" -> "/us/stat/60/237"] ", which was classified to sections 1001 to 1011 of former title 5 and which was repealed and reenacted as subchapter II (§ 551 et seq.) of chapter 5, and chapter 7 (§ 701 et seq.), of Title 5, Government Organization and Employees, by " ["Pub. L. 89–554" -> "/us/pl/89/554"] ", Sept. 6, 1966, " ["80 Stat. 378" -> "/us/stat/80/378"] "."
    p "The Government in the Sunshine Act, referred to in subsec. (a), is " ["Pub. L. 94–409" -> "/us/pl/94/409"] ", Sept. 13, 1976, " ["90 Stat. 1241" -> "/us/stat/90/1241"] ", which enacted " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] ", amended sections 551, 552, 556, and 557 of Title 5, " ["section 10 of Pub. L. 92–463" -> "/us/pl/92/463/s10"] ", formerly set out in the Appendix to Title 5, and " ["section 410 of Title 39" -> "/us/usc/t39/s410"] ", Postal Service, and enacted provisions set out as notes under " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] ". For complete classification of this Act to the Code, see Short Title of 1976 Amendment note set out under " ["section 552b of Title 5" -> "/us/usc/t5/s552b"] " and Tables."
    p "The Regional Rail Reorganization Act of 1973, referred to in subsec. (a), is " ["Pub. L. 93–236" -> "/us/pl/93/236"] ", Jan. 2, 1974, " ["87 Stat. 985" -> "/us/stat/87/985"] ". Title IV of the Regional Rail Reorganization Act of 1973 was classified generally to subchapter IV (§ 761 et seq.) of chapter 16 of this title, and was repealed by " ["Pub. L. 99–509, title IV, § 4033(a)(1)" -> "/us/pl/99/509/tIV/s4033/a/1"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] ". For complete classification of this Act to the Code, see Short Title note set out under " ["section 701 of this title" -> "/us/usc/t45/s701"] " and Tables."
    p "The Conrail Privatization Act, referred to in subsec. (a), is subtitle A (§§ 4001–4052) of title IV of " ["Pub. L. 99–509" -> "/us/pl/99/509"] ", Oct. 21, 1986, " ["100 Stat. 1892" -> "/us/stat/100/1892"] ", which is classified principally to chapter 22 (§ 1301 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 1301 of this title" -> "/us/usc/t45/s1301"] " and Tables."
    hash "9a1db5dc4b08425a46bd87d9453ee700c6fe7cc4c75efed31111a8772df34f70"
  }
  note "/us/usc/t45/s1116/note/editorialNotes/pl.97.449/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "In subsec. (a), “" ["section 303 of title 49" -> "/us/usc/t49/s303"] "” substituted for “section 4(f) of the Department of Transportation Act of 1966 [" ["49 U.S.C. 1653(f)" -> "/us/usc/t49/s1653/f"] "]” on authority of " ["Pub. L. 97–449, § 6(b)" -> "/us/pl/97/449/s6/b"] ", Jan. 12, 1983, " ["96 Stat. 2443" -> "/us/stat/96/2443"] ", the first section of which enacted subtitle I (§ 101 et seq.) and chapter 31 (§ 3101 et seq.) of subtitle II of Title 49, Transportation."
    hash "248c9172b6d96974b86269509ebc22e9ff5a93a635add507fefe9590958ced07"
  }
  note "/us/usc/t45/s1116/note/editorialNotes/pl.117.286/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2022—Subsec. (a). " ["Pub. L. 117–286" -> "/us/pl/117/286"] " substituted “chapter 10 of title 5,” for “the Federal Advisory Committee Act,”."
    p "2014—Subsec. (a). " ["Pub. L. 113–287" -> "/us/pl/113/287"] ", which directed substitution of “division A of subtitle III of title 54” for “the National Historic Preservation Act”, was executed by making the substitution for “the National Historic Preservation Act of 1966” to reflect the probable intent of Congress."
    p "1986—Subsec. (a). " ["Pub. L. 99–509" -> "/us/pl/99/509"] " inserted “and to the implementation of the sale of the interest of the United States in Conrail under the Conrail Privatization Act”."
    hash "93dd69f83cb8e9765bb93e716f483959554a1e696a5a7d56c06e09ca5b9590f7"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "9cd05b869a6a662e2051184d415ddb90704723c921a73372113af43bfed2bc0c"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "9f28abb66b181dc0d7241ef365f7734c1f73dde8f688a296ad5c8b08dd21b11b"
  }
}
