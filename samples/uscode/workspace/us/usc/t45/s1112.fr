edition 2
module "/us/usc/t45/s1112" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1112" section {
    num "1112" "§ 1112."
    heading "Interstate Commerce Commission proceedings"
    provision "/us/usc/t45/s1112/a" subsection {
      num "a" "(a)"
      heading "Final decisions involving railroads in bankruptcy"
      content "Notwithstanding any other provision of subtitle IV of title 49, in any proceeding before the Commission under section 11324 or 11325 of title 49 involving a railroad in the Region, as defined in " ["section 702 of this title" -> "/us/usc/t45/s702"] ", which was in a bankruptcy proceeding under section 77 of the Bankruptcy Act on November 4, 1979, the Commission shall, with or without a hearing, issue a final decision within a period not to exceed 180 days after receipt of an application under either such section."
      hash "bb88fdc9b4a703696bbdd438fda41be0d15b90826c6b62fbcaebf18e4ca0cfbc"
    }
    provision "/us/usc/t45/s1112/b" subsection {
      num "b" "(b)"
      heading "Final decisions involving profitable railroads"
      content "Notwithstanding any other provision of subtitle IV of title 49, in any proceeding before the Commission under section 11324 or 11325 of title 49 involving a profitable railroad in the Region, as defined in " ["section 702 of this title" -> "/us/usc/t45/s702"] ", which received a loan under " ["section 721(a) of this title" -> "/us/usc/t45/s721/a"] ", the Commission shall, with or without a hearing, issue a final decision within a period not to exceed 180 days after receipt of an application under either such section."
      hash "43438ceea4f5ed134411aa116600f926f65a422d22bc0aed6f39a4b12f989ab1"
    }
    provision "/us/usc/t45/s1112/c" subsection {
      num "c" "(c)"
      heading "Interest of United States attaching in bankruptcy, liquidation, abandonment, etc."
      provision "/us/usc/t45/s1112/c/1" paragraph {
        num "1" "(1)"
        content "If the Secretary determines under subsection (b) that there is an agreement between a profitable railroad in the Region (as defined in " ["section 702 of this title" -> "/us/usc/t45/s702"] ") which received a loan under " ["section 721(a) of this title" -> "/us/usc/t45/s721/a"] " and a prospective purchaser for the sale of such railroad, the Secretary shall limit the interest of the United States in any debt of such a railroad to an interest which attaches to such debt in the event of bankruptcy or substantial sale or liquidation of the assets of the railroad. The Secretary may substitute for the evidence of such debt contingency notes payable solely from the railroad operating assets then securing such debt, including reinvestments thereof, or such other contingency notes as the Secretary deems appropriate and which conform to the terms set forth in this subsection."
        hash "02a232359b16fa9ef595f31ffc8b5c1219f6b46227f42055a5e4e172f43e7e81"
      }
      provision "/us/usc/t45/s1112/c/2" paragraph {
        num "2" "(2)"
        content "If the interest of the United States is limited under paragraph (1), any new debt issued by such a railroad subsequent to the issuance of the debt described in paragraph (1) may have such higher priority in the event of bankruptcy, liquidation, or abandonment of the assets of such a railroad than the debt described in such paragraph as the Secretary and the railroad may agree."
        hash "2615492aae64a50a12f250f7d823c366d28b5199f01afcc7011c45b0940dea0f"
      }
      provision "/us/usc/t45/s1112/c/3" paragraph {
        num "3" "(3)"
        content "In carrying out the duties under this subsection, the Secretary may (A) enter into such agreements, (B) in accordance with any such agreements, cancel or cause to be cancelled or amend or cause to be amended any notes or securities currently held by agencies or instrumentalities of the United States, and (C) accept in exchange as substitution therefor such instruments evidencing the indebtedness owed to such agencies or instrumentalities as, in the Secretary’s judgment, will effectuate the purposes of this subsection."
        hash "b0e958f9cade4a254fb494d6af84c7045ed91f40b49a0822674fc4ce29f2ae55"
      }
      hash "a4d41530736cbfa24ac9a53c301ffd071970bd3272faae7e52d341f66d8bd937"
    }
    hash "93febcef7b2a798ae23b3fc038a3285cf65a30e9b17de5f0ce21693aea379eed"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1164" -> "/us/pl/97/35/tXI/s1164"] ", Aug. 13, 1981, " ["95 Stat. 685" -> "/us/stat/95/685"] "; " ["Pub. L. 97–468, title V, § 510" -> "/us/pl/97/468/tV/s510"] ", Jan. 14, 1983, " ["96 Stat. 2554" -> "/us/stat/96/2554"] "; " ["Pub. L. 104–88, title III, § 331" -> "/us/pl/104/88/tIII/s331"] ", Dec. 29, 1995, " ["109 Stat. 953" -> "/us/stat/109/953"] ".)"
  note "/us/usc/t45/s1112/note/editorialNotes/act.1898-07-01.ch541/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Section 77 of the Bankruptcy Act, referred to in subsec. (a), was classified to section 205 of former Title 11, Bankruptcy. The Bankruptcy Act (" ["act July 1, 1898, ch. 541" -> "/us/act/1898-07-01/ch541"] ", " ["30 Stat. 544" -> "/us/stat/30/544"] ") was repealed effective Oct. 1, 1979, by " ["Pub. L. 95–598" -> "/us/pl/95/598"] ", §§ 401(a), 402(a), Nov. 6, 1978, " ["92 Stat. 2682" -> "/us/stat/92/2682"] ", section 101 of which enacted revised Title 11. For current provisions relating to railroad reorganization, see subchapter IV (§ 1161 et seq.) of chapter 11 of Title 11."
    hash "dedb0636feabfa75f9deb51b23de44b49607eabc6dd43b59ef6b30113b366de3"
  }
  note "/us/usc/t45/s1112/note/editorialNotes/pl.104.88/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1995—Subsecs. (a), (b). " ["Pub. L. 104–88" -> "/us/pl/104/88"] " substituted “section 11324 or 11325” for “section 11344 or 11345”."
    p "1983—Subsec. (c)(1). " ["Pub. L. 97–468, § 510(1)" -> "/us/pl/97/468/s510/1"] ", substituted “bankruptcy or substantial sale” for “bankruptcy, substantial sale,” after “in the event of”, and in last sentence substituted permission for the Secretary to substitute contingency notes for evidence of the debt for the requirement that the Secretary substitute contingency notes for evidence of the debt and inserted provision that the contingency notes be payable solely from the railroad operating assets then securing such debt, including reinvestments thereof, or be other contingency notes as the Secretary deems appropriate."
    p "Subsec. (c)(2). " ["Pub. L. 97–468, § 510(2)" -> "/us/pl/97/468/s510/2"] ", substituted permission that new debt may have such higher priority in the event of bankruptcy, liquidation, or abandonment of the assets of such a railroad than the debt described in par. (1) as the Secretary and the railroad may agree for the requirement that such debt have higher priority in the event of bankruptcy, liquidation, or abandonment of the assets of Conrail than the debt described in par. (1)."
    p "Subsec. (c)(3). " ["Pub. L. 97–468, § 510(3)" -> "/us/pl/97/468/s510/3"] ", added par. (3)."
    hash "ca877d99af05aa6e296e2f4297ec417f79084fea8b6e050e0ed90545231b9fe8"
  }
  note "/us/usc/t45/s1112/note/statutoryNotes/pl.104.88/effective-date-of-1995-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1995 Amendment"
    p "Amendment by " ["Pub. L. 104–88" -> "/us/pl/104/88"] " effective Jan. 1, 1996, see " ["section 2 of Pub. L. 104–88" -> "/us/pl/104/88/s2"] ", set out as an Effective Date note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ", Transportation."
    hash "16eb732b92d6b0fd94d8511c067f9406d87d2ddd14f399f38f5802eaed297332"
  }
  note "/us/usc/t45/s1112/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  layers {
    operative "93febcef7b2a798ae23b3fc038a3285cf65a30e9b17de5f0ce21693aea379eed"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "e235a0c4d1504b92d1c5b46daa70e0bbbe473b4fe113efd3ee16b6b129170abe"
  }
}
