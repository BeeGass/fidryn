edition 2
module "/us/usc/t45/s355a" {
  within "/us/usc/t45/ch11"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s355a" section {
    num "355a" "§ 355a."
    heading "Acceptance of claims for benefits"
    content "Whenever there is duly tendered to the Board, by any person, any claim for unemployment compensation pursuant to the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.], such claim shall be accepted by the Board without delay and appropriate administrative action for the allowance or disallowance of such claim shall be taken by the Board at the earliest practicable time."
    hash "5270077081e6166a8713e342d0025ee1611051187a2d818f24a178deba3d5b8b"
  }
  credit "(" ["June 29, 1956, ch. 477" -> "/us/act/1956-06-29/ch477"] ", title V, § 501, " ["70 Stat. 437" -> "/us/stat/70/437"] ".)"
  note "/us/usc/t45/s355a/note/editorialNotes/act.1938-06-25.ch680/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Railroad Unemployment Insurance Act, referred to in text, is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to this chapter. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "f77d6d4c3eda4ec106c8c6a1a4befbafc7aabbf99fe99404c5d9bf82a5642b85"
  }
  note "/us/usc/t45/s355a/note/editorialNotes/nolaw/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Section was enacted as part of act June 29, 1956, popularly known as the Departments of Labor, and Health, Education, and Welfare, Appropriation Act, 1957, and not as a part of the Railroad Unemployment Insurance Act which comprises this chapter."
    hash "238b05ffe1e258c87155eaa93b6aaed00644e444552bdda82450564dc81acb6c"
  }
  note "/us/usc/t45/s355a/note/editorialNotes/act.1955-08-01.ch437/prior-provisions" editorial {
    group editorialNotes
    topic "priorProvisions"
    heading "Prior Provisions"
    p "Similar provisions were contained in the following prior appropriation act: " ["Aug. 1, 1955, ch. 437" -> "/us/act/1955-08-01/ch437"] ", title V, § 501, " ["69 Stat. 411" -> "/us/stat/69/411"] "."
    hash "7fdf43d1b2cb8a6108ebccd404cb67b67d55c1312cfeaa601740ae8a7453bc55"
  }
  layers {
    operative "5270077081e6166a8713e342d0025ee1611051187a2d818f24a178deba3d5b8b"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "cc3167c933c8af13bf4695e26fdb53105e1926660b1f077d34cedf9b515133d4"
  }
}
