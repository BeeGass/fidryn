edition 2
module "/us/usc/t45/s1016" {
  within "/us/usc/t45/ch19"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1016" section {
    num "1016" "§ 1016."
    heading "Temporary rail banking"
    chapeau "During the 180-day period beginning on May 30, 1980, no rail line or facility of the Rock Island Railroad which has been approved for abandonment by the Commission or the bankruptcy court may be downgraded, scrapped, or otherwise disposed of without the approval of the Secretary under this section. In no case before abandonment has been approved and before the 180-day period has elapsed shall the Secretary approve a disposition of such portion of the rail line or related facility to any carrier or other entity not engaged in providing railroad services or not formed for the purpose of providing railroad services. The Secretary, upon application by the Rock Island Railroad, shall grant such approval unless he finds that—"
    provision "/us/usc/t45/s1016/1" paragraph {
      num "1" "(1)"
      content "a rail carrier, shipper, State, or other interested party has expressed in writing an interest in purchasing, leasing or rehabilitating the particular rail line or facility for purposes of providing rail service; and"
      hash "306e3bc15caafe6a3a18a46a122e7f4f121d72fb70157bee768d00508cb7e158"
    }
    provision "/us/usc/t45/s1016/2" paragraph {
      num "2" "(2)"
      content "there is a reasonable expectation that such purchase transaction will be consummated."
      hash "f35e253012bdf1ddbe184e992367d8e0e7dc59501a28c18c8e66ebe01e7a1326"
    }
    hash "ae0c9771175a129d2777d1cbf6df8d2e9393264ceb8af6991dc9881f75e6a4f2"
  }
  credit "(" ["Pub. L. 96–254, title I, § 121" -> "/us/pl/96/254/tI/s121"] ", May 30, 1980, " ["94 Stat. 409" -> "/us/stat/94/409"] ".)"
  note "/us/usc/t45/s1016/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  layers {
    operative "ae0c9771175a129d2777d1cbf6df8d2e9393264ceb8af6991dc9881f75e6a4f2"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "f4cbbf61275aa7a03c4e7125c44ee3fff8c79b67f617ccc2b2ebf4c1ac5b90a8"
  }
}
