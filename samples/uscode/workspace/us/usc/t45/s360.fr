  note "/us/usc/t45/s360/note/statutoryNotes/pl.86.28/effective-date-of-1959-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1959 Amendment"
    p ["Pub. L. 86–28" -> "/us/pl/86/28"] ", pt. III, § 308(b), May 19, 1959, " ["73 Stat. 33" -> "/us/stat/73/33"] ", provided that:"
    quoted "/us/pl/86/28" {
      p "“The amendment made by this section [amending this section] shall take effect on the date of enactment of this Act [May 19, 1959].”"
    }
