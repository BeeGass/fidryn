edition 2
module "/us/usc/t45/s713" {
  within "/us/usc/t45/ch16/schII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s713" section {
    num "713" "§ 713."
    heading "Access to information"
    content "The Corporation shall make available to the Association such information as the Association determines necessary for the Association to carry out its functions under this chapter. The Association shall request from other parties which are affected by this chapter information which will enable the Association to fulfill its functions under this chapter."
    hash "777609c83fcd9088248b31440d59b2f39dc70366e28dd1bfb4535c1c6523a09d"
  }
  credit "(" ["Pub. L. 93–236, title II, § 203" -> "/us/pl/93/236/tII/s203"] ", Jan. 2, 1974, " ["87 Stat. 992" -> "/us/stat/87/992"] "; " ["Pub. L. 94–210, title VI, § 607(d)" -> "/us/pl/94/210/tVI/s607/d"] ", Feb. 5, 1976, " ["90 Stat. 96" -> "/us/stat/90/96"] "; " ["Pub. L. 97–35, title XI, § 1149" -> "/us/pl/97/35/tXI/s1149"] ", Aug. 13, 1981, " ["95 Stat. 675" -> "/us/stat/95/675"] ".)"
  note "/us/usc/t45/s713/note/editorialNotes/pl.97.35/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1981—" ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions relating to the Corporation making available to the Association all necessary information for provisions set out as subsecs. (a) to (d) respecting planning and other information availability, and enforcement procedures."
    p "1976—Subsec. (a). " ["Pub. L. 94–210" -> "/us/pl/94/210"] " struck out provisions prohibiting requests for information under this subsection after effective date of the final system plan."
    hash "aa2bc6229b2d9c81d3b517ca6451e3e5b387e6ff713f363638336ef4264a1166"
  }
