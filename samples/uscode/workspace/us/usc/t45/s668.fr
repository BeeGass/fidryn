module "/us/usc/t45/s668" {
  within "/us/usc/t45/ch15"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s668" section {
    num "668" "§ 668."
    heading "Guarantee fees; amount; deposit"
    content "The Secretary shall prescribe a guarantee fee in connection with each loan guaranteed under this chapter which shall be collected from the railroad upon repayment of the loan guaranteed. Such fee shall be in an amount that the Secretary estimates to be necessary to cover the administrative costs of carrying out the provisions of this chapter with respect to such loan. Sums realized from such fees shall be deposited in the Treasury as miscellaneous receipts."
    hash "7c7ce3c0e0862545bafcb27f31958ea37fcd80ce526fc45bf67e609a7240fa8b"
  }
