  note "/us/usc/t45/s743/note/statutoryNotes/pl.96.73/effective-date-of-1979-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1979 Amendment"
    p ["Pub. L. 96–73, title V, § 501(b)" -> "/us/pl/96/73/tV/s501/b"] ", Sept. 29, 1979, " ["93 Stat. 558" -> "/us/stat/93/558"] ", provided that:"
    quoted "/us/pl/96/73/tV/s501/b" {
      p "“The amendments made by section 204 of this Act [enacting subsec. (b)(6)(B) of this section and section 721(h)(1)(A)(viii), (6) of this title] shall be effective as of the date of enactment [Nov. 4, 1978] of " ["Pub. L. 95–597" -> "/us/pl/95/597"] ".”"
