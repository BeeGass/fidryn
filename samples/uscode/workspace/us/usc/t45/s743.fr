  note "/us/usc/t45/s743/note/statutoryNotes/pl.104.317/cases-pending-in-special-court" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Cases Pending in Special Court"
    p "For applicability of amendment by " ["Pub. L. 104–317" -> "/us/pl/104/317"] " to cases pending in special court established under " ["section 719(b) of this title" -> "/us/usc/t45/s719/b"] ", see " ["section 605(d) of Pub. L. 104–317" -> "/us/pl/104/317/s605/d"] ", set out as a note under " ["section 719 of this title" -> "/us/usc/t45/s719"] "."
    hash "bf9e53b9760c06f1e7c46589af9e28a3f4cfda82afc8255912891b5cf80e2be7"
  }
  note "/us/usc/t45/s743/note/statutoryNotes/pl.95.597/administrative-claim-status" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Administrative Claim Status"
    p ["Pub. L. 95–597, § 2" -> "/us/pl/95/597/s2"] ", Nov. 4, 1978, " ["92 Stat. 2548" -> "/us/stat/92/2548"] ", provided that:"
    quoted "/us/pl/95/597/s2" {
      p "“The conferring of administrative claim status on amounts paid for the insurance premiums and benefits described in the amendment made by the first section of this Act [amending this section] shall be effective solely for purposes of meeting the conditions set forth in section 211(h)(4)(A)(iii) of the Regional Rail Reorganization Act of 1973 [" ["section 721(h)(4)(A)(iii) of this title" -> "/us/usc/t45/s721/h/4/A/iii"] "] with respect to which obligations of the estate of a railroad in reorganization may be paid pursuant to such section 211(h) [" ["section 721(h) of this title" -> "/us/usc/t45/s721/h"] "], and shall not be construed—"
      level paragraph {
        num "1" "“(1)"
        content "as affecting the jurisdiction of the district court having jurisdiction over such a railroad in reorganization to determine whether such insurance premiums and benefits constitute enforceable contractual obligations of the estate of such a railroad for purposes of reimbursement under such section 211(h) [" ["section 721(h) of this title" -> "/us/usc/t45/s721/h"] "]; or"
      }
      level paragraph {
        num "2" "“(2)"
        content "as establishing or reordering any priority which a claim against the estate of such a railroad for reimbursement for the amounts paid for such insurance premiums and benefits may or may not have under the provisions of the Bankruptcy Act [section 1 et seq. of former Title 11, Bankruptcy] or any other law.”"
      }
    }
    hash "a675efe7a8f1d2a975a1f8109c74e4165af1e333d2cdda8ea4fbdefdd5ef8ba5"
  }
  note "/us/usc/t45/s743/note/statutoryNotes/pl.95.597/corporation-as-successor-in-interest" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Corporation as Successor in Interest"
    p ["Pub. L. 95–597, § 3" -> "/us/pl/95/597/s3"] ", Nov. 4, 1978, " ["92 Stat. 2548" -> "/us/stat/92/2548"] ", provided that:"
    quoted "/us/pl/95/597/s3" {
      p "“Notwithstanding any other provision of law, any corporation which, pursuant to a plan of reorganization under section 77 of the Bankruptcy Act [section 205 of former Title 11, Bankruptcy], is the successor in interest to a railroad in reorganization shall have standing to assert, in any judicial or administrative proceeding, any claim or defense available to such railroad in reorganization with respect to whether the insurance benefits and premiums described in the amendment made by the first section of this Act [amending this section] constitute enforceable contractual obligations of the estate of such railroad in reorganization. For purposes of this section, the term ‘railroad in reorganization’ has the meaning given such term in paragraph (14) of section 102 of the Regional Rail Reorganization Act of 1973 [" ["section 702(14) of this title" -> "/us/usc/t45/s702/14"] "].”"
    }
    hash "7badf0352f3d9bd27895a147c385afa82605b548539544f62520ef9af5a9d1e2"
  }
  note "/us/usc/t45/s743/note/statutoryNotes/pl.94.210/applicability-of-national-environmental-policy-act" enacted {
