edition 2
module "/us/usc/t45/s354" {
  within "/us/usc/t45/ch11"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s354" section {
    num "354" "§ 354."
    heading "Disqualifying conditions"
    provision "/us/usc/t45/s354/a–1" subsection {
      num "a–1" "(a–1)"
      heading "Day of unemployment or day of sickness"
      chapeau "There shall not be considered as a day of unemployment, or as a day of sickness, with respect to any employee—"
      provision "/us/usc/t45/s354/a–1/i" clause {
        num "i" "(i)"
        content "any of the seventy-five days beginning with the first day of any registration period with respect to which the Board finds that he knowingly made or aided in making or caused to be made any false or fraudulent statement or claim for the purpose of causing benefits to be paid;"
        hash "7bedb00fb086ef63aedc72871db0f39f19fb81b53a6cb2be4d2e12e80276318f"
      }
      provision "/us/usc/t45/s354/a–1/ii" clause {
        num "ii" "(ii)"
        content "any day in any period with respect to which the Board finds that he is receiving or will have received annuity payments under the Railroad Retirement Act of 1974 [" ["45 U.S.C. 231" -> "/us/usc/t45/s231"] " et seq.], or insurance benefits under title II of the Social Security Act [" ["42 U.S.C. 401" -> "/us/usc/t42/s401"] " et seq.], or unemployment, maternity, or sickness benefits under an unemployment, maternity, or sickness compensation law other than this chapter, or any other social-insurance payments under any law: Provided, That if an employee receives or is held entitled to receive any such payments, other than unemployment, maternity, or sickness payments, with respect to any period which include days of unemployment or sickness in a registration period, after benefits under this chapter for such registration period will have been paid, the amount by which such benefits under this chapter will have been increased by including such days as days of unemployment or as days of sickness shall be recoverable by the Board: Provided further, That, if that part of any such payment or payments, other than unemployment, maternity, or sickness payments, which is apportionable to such days of unemployment or days of sickness is less in amount than the benefits under this chapter which, but for this paragraph, would be payable and not recoverable with respect to such days of unemployment or days of sickness, the preceding provisions of this paragraph shall not apply but such benefits under this chapter for such days of unemployment or days of sickness shall be diminished or recoverable in the amount of such part of such other payment or payments;"
        hash "7d375d8a99cd976156156043bb44b3e1bdac7f80962c6a050fd809799736831e"
      }
      provision "/us/usc/t45/s354/a–1/iii" clause {
        num "iii" "(iii)"
        content "if he is paid a separation allowance, any of the days in the period beginning with the day following his separation from service and continuing for that number of consecutive fourteen-day periods which is equal, or most nearly equal, to the amount of the separation allowance divided (i) by ten times his last daily rate of compensation prior to his separation if he normally works five days a week, (ii) by twelve times such rate if he normally works six days a week, and (iii) by fourteen times such rate if he normally works seven days a week;" mark "1" 1
        hash "21d463aa8bd521d8820b81c4d7a399c2f48e98d0e7a48b303992f0b9d3951a66"
      }
      hash "9dae4f8b53981f466c40826e7d584e88ea5bddc2fa481bd98aa856e30de7ef16"
    }
    provision "/us/usc/t45/s354/a–2" subsection {
      num "a–2" "(a–2)"
      heading "Day of unemployment"
      provision "/us/usc/t45/s354/a–2/i" clause {
        num "i" "(i)"
        provision "/us/usc/t45/s354/a–2/i/A" level {
          num "A" "(A)"
          content "subject to the provisions of subdivision (B) hereof, any of the days in the period beginning with the day with respect to which the Board finds that he left work voluntarily, and continuing until he has been paid compensation of not less than $1,500 with respect to time after the beginning of such period and before 1989 or, if any part of such compensation is paid in a calendar year after 1988, not less than an amount that is equal to 2.5 times the monthly compensation base for months in such calendar year, as computed under " ["section 351(i) of this title" -> "/us/usc/t45/s351/i"] ";"
          hash "a6630f412306e63b827eff09d0c629f1ffd6ce35c9bbc5b5a9c5ccd59a96c9b8"
        }
        provision "/us/usc/t45/s354/a–2/i/B" level {
          num "B" "(B)"
          content "if the Board finds that he left work voluntarily with good cause, the provisions of subdivision (A) shall not apply, with respect to him, to any day in a registration period if such period does not include any day which is in a period for which he could receive benefits under an unemployment compensation law other than this chapter, and he so certifies. Such certification shall, in the absence of evidence to the contrary, be accepted subject to the penalty provisions of " ["section 359(a) of this title" -> "/us/usc/t45/s359/a"] ";"
          hash "c6bd904ed06f03a31450563812ecf6e5779b9d19c9b644bbfca85a96a268f67a"
        }
        hash "fac361216ac575bced5e27bf8e3845c29d8e692d335845ceec181346bb3c4df5"
      }
      provision "/us/usc/t45/s354/a–2/ii" clause {
        num "ii" "(ii)"
        content "any of the thirty days beginning with the day with respect to which the Board finds that he failed, without good cause, to accept suitable work available on such day and offered to him, or to comply with instructions from the Board requiring him to apply for suitable work or to report, in person or by mail as the Board may require, to an employment office;"
        hash "8bbf6f9b28a4bef424d9019eec4d4487629f16f94a1185c00c7b446fcdc01e1f"
      }
      provision "/us/usc/t45/s354/a–2/iii" clause {
        num "iii" "(iii)"
        content "subject to the provisions of subsection (b) of this section, any day with respect to which the Board finds that his unemployment was due to a stoppage of work because of a strike in the establishment, premises, or enterprise at which he was last employed, and the Board finds that such strike was commenced in violation of the provisions of the Railway Labor Act [" ["45 U.S.C. 151" -> "/us/usc/t45/s151"] " et seq.] or in violation of the established rules and practices of a bona fide labor organization of which he was a member."
        hash "f5aebdf08a9f356ac998da416f470d88129a291adead52bea65d19dfd1b088ee"
      }
      hash "78a847a0513d04c856dbfeff11dd4894d3ea3802278f2717772cc6942482e98f"
    }
    provision "/us/usc/t45/s354/b" subsection {
      num "b" "(b)"
      heading "Participation, interest, or financial assistance in labor dispute"
      chapeau "The disqualification provided in subsection (a–2)(iii) of this section shall not apply if the Board finds that—"
      provision "/us/usc/t45/s354/b/i" clause {
        num "i" "(i)"
        content "the employee is not participating in or financing or directly interested in the strike which causes the stoppage of work: Provided, That payment of regular union dues shall not be construed to constitute financing a strike or direct interest in a strike within the meaning of this and the following paragraphs; and"
        hash "654c326617b98f8e0e3e61b689e8a618dfc939889aea1cdcca036ee4a2cfe22c"
      }
      provision "/us/usc/t45/s354/b/ii" clause {
        num "ii" "(ii)"
        content "he does not belong to a grade or class of workers of which, immediately before the commencement of the stoppage, there were members employed in the establishment, premises, or enterprise at which the stoppage occurs, any of whom are participating in or financing or directly interested in the dispute: Provided, That if separate types of work are commonly conducted in separate departments of a single enterprise, each such department shall, for the purposes of this subsection, be deemed to be a separate establishment, enterprise, or other premises."
        hash "956e48c511fdcf7d10298af567d57c2ef8b4717a4e167d91b7fbbe014b13841d"
      }
      hash "49c7191efa089c615e10e44cde0830894f7704d6677e833571274bf73dbe21ea"
    }
    provision "/us/usc/t45/s354/c" subsection {
      num "c" "(c)"
      heading "Unsuitable work"
      chapeau "No work shall be deemed suitable for the purposes of subsection (a–2)(ii) of this section, and benefits shall not be denied under this chapter to any otherwise qualified employee for refusing to accept work if—"
      provision "/us/usc/t45/s354/c/i" clause {
        num "i" "(i)"
        content "the position offered is vacant due directly to a strike, lockout, or other labor dispute;"
        hash "226027c7cea6fcd5b9cabe6b074177a6b3d04a3523f47c689809642c918a11c7"
      }
      provision "/us/usc/t45/s354/c/ii" clause {
        num "ii" "(ii)"
        content "the remuneration, hours, or other conditions of work offered are substantially less favorable to the employee than those prevailing for similar work in the locality, or the rate of remuneration is less than the union wage rate, if any, for similar work in the locality;"
        hash "ad84c057a66443e8e58a4990bccc8a4a64cb384e4e6d00e9850f8943442678f5"
      }
      provision "/us/usc/t45/s354/c/iii" clause {
        num "iii" "(iii)"
        content "as a condition of being employed he would be required to join a company union or to resign from or refrain from joining any bona fide labor organization;"
        hash "88dab9414073d0b33e6cfabacefca3b5c8b2aa03c06f4aa1408344193bac8b7d"
      }
      provision "/us/usc/t45/s354/c/iv" clause {
        num "iv" "(iv)"
        content "acceptance of the work would require him to engage in activities in violation of law or which, by reason of their being in violation of reasonable requirements of the constitution, bylaws, or similar regulations of a bona fide labor organization of which he is a member, would subject him to expulsion from such labor organization; or"
        hash "42c7d38e592c7de898031ea3cb13d62b2baa09660cc8ccabb5efc182b0b2c15d"
      }
      provision "/us/usc/t45/s354/c/v" clause {
        num "v" "(v)"
        content "acceptance of the work would subject him to loss of substantial seniority rights under any collective bargaining agreement between a railway labor organization, organized in accordance with the provisions of the Railway Labor Act [" ["45 U.S.C. 151" -> "/us/usc/t45/s151"] " et seq.], and any other employer."
        hash "ddbf34d4cf406b8988cef082d9e107bce2c216b5ff2616d51fa1d4b2b14bbae0"
      }
      hash "9932ff01df9d0455dfbb49d83190ee4e68c2a4a3b5b96cdad96c560f7b9ac76d"
    }
    provision "/us/usc/t45/s354/d" subsection {
      num "d" "(d)"
      heading "Factors in determination of suitable work"
      content "In determining, within the limitations of subsection (c) of this section, whether or not any work is suitable for an employee for the purposes of subsection (a–2)(ii) of this section, the Board shall consider, in addition to such other factors as it deems relevant, (i) the current practices recognized by management and labor with respect to such work; (ii) the degree of risk involved to such employee’s health, safety, and morals; (iii) his physical fitness and prior training; (iv) his experience and prior earnings; (v) his length of unemployment and prospects for securing work in his customary occupation; and (vi) the distance of the available work from his residence and from his most recent work."
      hash "1dde89b8f0aa00243c9dfaf62873edbd31eefaccfa85df69dbe913b5d3483c27"
    }
    provision "/us/usc/t45/s354/e" subsection {
      num "e" "(e)"
      heading "Voluntarily leaving unsuitable work"
      content "For the purposes of subsection (a–2)(i) of this section, no voluntary leaving of work shall be deemed to have been without good cause if the Board finds that such work would not have been suitable for the purposes of subsection (a–2)(ii) of this section."
      hash "b735a4f5a643cb5b584a90e531ab52b92572be2b594ed6b565f3cda6f4b66e30"
    }
    hash "0faa110b8fe47cb0f01ec14adfe8c0db2c95956a1bfb1301b341ccba4ca81e2b"
  }
  credit "(" ["June 25, 1938, ch. 680, § 4" -> "/us/act/1938-06-25/ch680/s4"] ", " ["52 Stat. 1098" -> "/us/stat/52/1098"] "; " ["June 20, 1939, ch. 227, § 11" -> "/us/act/1939-06-20/ch227/s11"] ", " ["53 Stat. 846" -> "/us/stat/53/846"] "; " ["Oct. 10, 1940, ch. 842" -> "/us/act/1940-10-10/ch842"] ", §§ 14–18, " ["54 Stat. 1097" -> "/us/stat/54/1097"] ", 1098; " ["July 31, 1946, ch. 709" -> "/us/act/1946-07-31/ch709"] ", §§ 309, 310, " ["60 Stat. 737" -> "/us/stat/60/737"] ", 738; " ["Oct. 30, 1951, ch. 632, § 27" -> "/us/act/1951-10-30/ch632/s27"] ", " ["65 Stat. 691" -> "/us/stat/65/691"] "; " ["Pub. L. 85–927" -> "/us/pl/85/927"] ", pt. II, § 202, Sept. 6, 1958, " ["72 Stat. 1782" -> "/us/stat/72/1782"] "; " ["Pub. L. 86–28" -> "/us/pl/86/28"] ", pt. III, § 305, May 19, 1959, " ["73 Stat. 31" -> "/us/stat/73/31"] "; " ["Pub. L. 88–133, title III, § 302(a)" -> "/us/pl/88/133/tIII/s302/a"] ", Oct. 5, 1963, " ["77 Stat. 222" -> "/us/stat/77/222"] "; " ["Pub. L. 90–257, title II, § 204" -> "/us/pl/90/257/tII/s204"] ", Feb. 15, 1968, " ["82 Stat. 24" -> "/us/stat/82/24"] "; " ["Pub. L. 93–445, title IV, § 402" -> "/us/pl/93/445/tIV/s402"] ", Oct. 16, 1974, " ["88 Stat. 1359" -> "/us/stat/88/1359"] "; " ["Pub. L. 98–76, title IV, § 411(a)(3)" -> "/us/pl/98/76/tIV/s411/a/3"] ", Aug. 12, 1983, " ["97 Stat. 436" -> "/us/stat/97/436"] "; " ["Pub. L. 100–647, title VII, § 7101(d)" -> "/us/pl/100/647/tVII/s7101/d"] ", Nov. 10, 1988, " ["102 Stat. 3758" -> "/us/stat/102/3758"] ".)"
  note "/us/usc/t45/s354/note/editorialNotes/act.1935-08-29.ch812/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Railroad Retirement Act of 1974, referred to in subsec. (a–1)(ii), is " ["act Aug. 29, 1935, ch. 812" -> "/us/act/1935-08-29/ch812"] ", as amended generally by " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1305" -> "/us/stat/88/1305"] ", which is classified generally to subchapter IV (§ 231 et seq.) of chapter 9 of this title. For further details and complete classification of this Act to the Code, see Codification note set out preceding " ["section 231 of this title" -> "/us/usc/t45/s231"] ", " ["section 231t of this title" -> "/us/usc/t45/s231t"] ", and Tables."
    p "The Social Security Act, referred to in subsec. (a–1)(ii), is " ["act Aug. 14, 1935, ch. 531" -> "/us/act/1935-08-14/ch531"] ", " ["49 Stat. 620" -> "/us/stat/49/620"] ". Title II of the Social Security Act is classified generally to subchapter II (§ 401 et seq.) of chapter 7 of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see " ["section 1305 of Title 42" -> "/us/usc/t42/s1305"] " and Tables."
    p "This chapter, referred to in subsecs. (a–1)(ii), (a–2)(i)(B), and (c), was in the original “this Act”, meaning " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which enacted this chapter and amended sections 503 and 1104 and former " ["section 1107 of Title 42" -> "/us/usc/t42/s1107"] ", The Public Health and Welfare. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    p "The Railway Labor Act, referred to in subsecs. (a–2)(iii) and (c)(v), is " ["act May 20, 1926, ch. 347" -> "/us/act/1926-05-20/ch347"] ", " ["44 Stat. 577" -> "/us/stat/44/577"] ", which is classified principally to chapter 8 (§ 151 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 151 of this title" -> "/us/usc/t45/s151"] " and Tables."
    hash "7e09209a470f4d646839a525465668f192a02a186792ffd4b0c84583ad8c65c7"
  }
  note "/us/usc/t45/s354/note/editorialNotes/pl.100.647/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1988—Subsec. (a–2)(i)(A). " ["Pub. L. 100–647" -> "/us/pl/100/647"] " inserted “and before 1989 or, if any part of such compensation is paid in a calendar year after 1988, not less than an amount that is equal to 2.5 times the monthly compensation base for months in such calendar year, as computed under " ["section 351(i) of this title" -> "/us/usc/t45/s351/i"] "” after “such period”."
    p "1983—Subsec. (a–2)(i)(A). " ["Pub. L. 98–76" -> "/us/pl/98/76"] " substituted “$1,500” for “$1,000”."
    p "1974—Subsec. (a–1)(ii). " ["Pub. L. 93–445" -> "/us/pl/93/445"] " substituted “annuity payments under the Railroad Retirement Act of 1974” for “annuity payments or pensions under the Railroad Retirement Act of 1935 or the Railroad Retirement Act of 1937”."
    p "1968—Subsec. (a–1)(iii). " ["Pub. L. 90–257, § 204(a)" -> "/us/pl/90/257/s204/a"] ", added cl. (iii)."
    p "Subsec. (a–2)(i)(A). " ["Pub. L. 90–257, § 204(b)" -> "/us/pl/90/257/s204/b"] ", substituted “$1,000” for “$750”."
    p "1963—Subsec. (a–2)(i). " ["Pub. L. 88–133" -> "/us/pl/88/133"] " substituted cl. (i) providing in subd. (A) that an employee who voluntarily leaves his work shall not be considered as having days of unemployment for a period beginning with the day he so leaves and continuing until he has been paid compensation of not less than $750 with respect to time after the beginning of such period and subd. (B) that if the Board finds that the employee left work voluntarily with good cause, such disqualification shall not apply, except that in such case the employee would not be considered as having days of unemployment with respect to any day in a registration period if such period includes a day which is in a period for which he could receive benefits under an unemployment law other than this chapter and he so certifies, for former cl. (i) providing that an employee who leaves work voluntarily is not considered as having days of unemployment with respect to any of the first 30 days after he so leaves if the Board finds that he left work voluntarily without good cause."
    p "1959—Subsec. (a–2)(iv). " ["Pub. L. 86–28" -> "/us/pl/86/28"] " struck out cl. (iv) which prevented Sundays and holidays from being considered as days of unemployment unless they were preceded and succeeded by a day of unemployment."
    p "1958—Subsec. (a–1)(ii). " ["Pub. L. 85–927" -> "/us/pl/85/927"] " substituted “other than this chapter or any other social-insurance payments under any law” for “of any State of the United States other than this chapter, or any other social-insurance payments under a law of any State or of the United States”."
    p "1951—Subsec. (a–1). Act Oct. 30, 1951, struck out cls. (iii) and (iv) which excepted from consideration as a day of unemployment or as a day of sickness, any days in any registration period in which the employee had certain specified earnings."
    p "1946—Subsec. (a–1). Act July 31, 1946, § 309(a), (b), designated provisions of former subsec. (a) which apply both to days of unemployment and to days of sickness as subsec. (a–1) and changed cl. (ii) to include sickness and maternity benefits."
    p "Subsec. (a–2). Act July 31, 1946, § 309(c), designated provisions of former subsec. (a) which apply only to days of unemployment as subsec. (a–2)."
    p "Subsecs. (b) to (e). Act July 31, 1946, § 310, changed references to subsec. (a) of this section to refer to subsec. (a–2)."
    p "1940—Subsec. (a)(ii). Act Oct. 10, 1940, § 14, inserted provisions relating to employee’s failure to comply with instructions of the Board."
    p "Subsec. (a)(iv). Act Oct. 10, 1940, § 15, substituted “registration period” for “half-month”."
    p "Subsec. (a)(v). Act Oct. 10, 1940, § 16, struck out applicability to employee having a right to receive compensation or other wages in lieu of notice, and inserted provisions relating to recovery of certain other payments and inapplicability of paragraph under specified conditions."
    p "Subsec. (a)(vi). Act Oct. 10, 1940, § 17, substituted provisions relating to earnings of employees during any day in any registration period, for provisions relating to earnings of employees during any day in any half-month."
    p "Subsec. (a)(vii), (viii). Act Oct. 10, 1940, § 18, added cls. (vii) and (viii)."
    p "1939—Subsec. (a). Act June 20, 1939, generally revised criteria for determining what shall not be considered as a day of unemployment with respect to any employee."
    p "Subsec. (b). Act June 20, 1939, substituted provisions setting forth criteria for determining nonapplicability of disqualification provided in subsec. (a)(iii) of this section, for provisions setting forth criteria for determining nonapplicability of disqualification provided in subsec. (a)(v) of this section."
    p "Subsecs. (c) to (e). Act June 20, 1939, substituted references to subsec. (a)(ii) of this section for references to subsec. (a)(iii) or (iv) of this section."
    hash "0bc411fd7b55ae32a7d988ecf1e331760837167f1d9ed7afd12e3419ddc1f3bc"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.98.76/effective-date-of-1983-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1983 Amendment"
    p "Amendment by " ["Pub. L. 98–76" -> "/us/pl/98/76"] " applicable to compensation paid for services rendered after Dec. 31, 1983, see " ["section 411(b) of Pub. L. 98–76" -> "/us/pl/98/76/s411/b"] ", set out as a note under " ["section 351 of this title" -> "/us/usc/t45/s351"] "."
    hash "1a8d8e5fb536ff3c1dc14958d87f4ffa4df300155b4a95fc75b69e724ba8aeab"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.93.445/effective-date-of-1974-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1974 Amendment"
    p "Amendment by " ["Pub. L. 93–445" -> "/us/pl/93/445"] " effective Jan. 1, 1975, see " ["section 603 of Pub. L. 93–445" -> "/us/pl/93/445/s603"] ", set out as a note under " ["section 402 of Title 42" -> "/us/usc/t42/s402"] ", The Public Health and Welfare."
    hash "5fa55b4cf8ad1c4e9c627a6cb7ce22c58124f616c18c46e9c5b5749b769ab526"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.90.257/effective-date-of-1968-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1968 Amendment"
    p "Amendment by " ["section 204(a) of Pub. L. 90–257" -> "/us/pl/90/257/s204/a"] " effective with respect to calendar days in benefit years beginning after June 30, 1968, and amendment by " ["section 204(b) of Pub. L. 90–257" -> "/us/pl/90/257/s204/b"] " effective with respect to voluntary leaving of work (within the meaning of subsec. (a–2)(i) this section) after February 15, 1968, see " ["section 208 of Pub. L. 90–257" -> "/us/pl/90/257/s208"] ", set out as a note under " ["section 352 of this title" -> "/us/usc/t45/s352"] "."
    hash "04e4fd2a8e4d5b55f03ec80da14c6d1a7490f3d2ec3d230a1a5a26f980227088"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.88.133/effective-date-of-1963-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1963 Amendment"
    p ["Pub. L. 88–133, title III, § 302(b)" -> "/us/pl/88/133/tIII/s302/b"] ", Oct. 5, 1963, " ["77 Stat. 222" -> "/us/stat/77/222"] ", provided that:"
    quoted "/us/pl/88/133/tIII/s302/b" {
      p "“The amendment made by subsection (a) [amending this section] shall be effective only with respect to an employee who leaves work voluntarily after the date of enactment of this Act [Oct. 5, 1963].”"
    }
    hash "8be9e82587ae75bfe33ff43ba59f02d190e9643fa7996fb168589df2cfd3e2da"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.86.28/effective-date-of-1959-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1959 Amendment"
    p "Amendment by " ["Pub. L. 86–28" -> "/us/pl/86/28"] " effective with respect to benefits accruing in general benefit years which begin after the benefit year ending June 30, 1958, and in extended benefit periods which begin after Dec. 31, 1957, see " ["section 309 of Pub. L. 86–28" -> "/us/pl/86/28/s309"] ", set out as a note under " ["section 351 of this title" -> "/us/usc/t45/s351"] "."
    hash "9849e2e36b707486912531e0d3ebc5b1856281c0a0f13fbbb4149c6d8e7bfa5b"
  }
  note "/us/usc/t45/s354/note/statutoryNotes/pl.85.927/effective-date-of-1958-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1958 Amendment"
    p "Amendment by " ["Pub. L. 85–927" -> "/us/pl/85/927"] " effective with respect to days in benefit years after the benefit year ending on June 30, 1958, see " ["section 207(a) of Pub. L. 85–927" -> "/us/pl/85/927/s207/a"] ", set out as a note under " ["section 351 of this title" -> "/us/usc/t45/s351"] "."
    hash "755d7926ec424593f4ba348582dbd6cc32eae13281f4f3b74960290f4dfd0196"
