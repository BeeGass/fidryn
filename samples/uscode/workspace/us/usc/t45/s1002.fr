    kind means
    words "As used in this chapter"
    region "/us/usc/t45/ch19"
    basis restated
    see_note "/us/usc/t45/s1002/note/editorialNotes/pl.96.254/references-in-text"
  }
  definition "/us/usc/t45/s1002/3" {
