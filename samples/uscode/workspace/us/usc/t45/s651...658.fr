    heading "Repealed. " ["Pub. L. 103–272, § 7(b)" -> "/us/pl/103/272/s7/b"] ", July 5, 1994, " ["108 Stat. 1379" -> "/us/stat/108/1379"]
    status repealed
    hash "1ce949022ae12b7b0ca6adf346857f941f52f07b30a7b14a81d6ec29bfc7ba9a"
