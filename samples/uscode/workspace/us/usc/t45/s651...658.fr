    topic "removalDescription"
    p "Section 653, " ["Pub. L. 91–518, title X, § 1003" -> "/us/pl/91/518/tX/s1003"] ", as added " ["Pub. L. 96–254, title II, § 212" -> "/us/pl/96/254/tII/s212"] ", May 30, 1980, " ["94 Stat. 416" -> "/us/stat/94/416"] "; amended H. Res. 549, Mar. 25, 1980, provided for submission of final corridor evaluation to Congress."
    hash "da425cd0c477436bc68415aa79ce309074525e29823a46322f596806ec3cda37"
  }
  note "/us/usc/t45/s651...658/note/ungrouped/pl.91.518/noheading/4" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 654, " ["Pub. L. 91–518, title X, § 1004" -> "/us/pl/91/518/tX/s1004"] ", as added " ["Pub. L. 96–254, title II, § 212" -> "/us/pl/96/254/tII/s212"] ", May 30, 1980, " ["94 Stat. 416" -> "/us/stat/94/416"] ", directed National Railroad Passenger Corporation to acquire equipment necessary to provide service in rail passenger corridors."
    hash "cfbb4f97379b11d42f5de2fc5537ff651e4473b300319117b8a1fd425af4a9ce"
  }
  note "/us/usc/t45/s651...658/note/ungrouped/pl.91.518/noheading/5" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 655, " ["Pub. L. 91–518, title X, § 1005" -> "/us/pl/91/518/tX/s1005"] ", as added " ["Pub. L. 96–254, title II, § 212" -> "/us/pl/96/254/tII/s212"] ", May 30, 1980, " ["94 Stat. 416" -> "/us/stat/94/416"] ", directed Secretary to encourage private sector development of potential rail passenger corridors by removing institutional barriers and coordinating funding."
    hash "4f0936c8f3cc6eac121473c06c7d29b2a002c4ae394f954d0f7f2a42d75fe02e"
  }
