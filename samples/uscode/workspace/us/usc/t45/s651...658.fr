  note "/us/usc/t45/s651...658/note/ungrouped/pl.91.518/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 651, " ["Pub. L. 91–518, title X, § 1001" -> "/us/pl/91/518/tX/s1001"] ", as added " ["Pub. L. 96–254, title II, § 212" -> "/us/pl/96/254/tII/s212"] ", May 30, 1980, " ["94 Stat. 415" -> "/us/stat/94/415"] "; amended H. Res. 549, Mar. 25, 1980, required Secretary to develop and submit to Congress a proposed method for evaluating rail passenger corridors, ranking those with greatest potential."
    hash "aa3bdbc1d2bd9c96aaf9fb906399395dfa830347cfcffa2e23029c7e5bb4059c"
  }
  note "/us/usc/t45/s651...658/note/ungrouped/pl.91.518/noheading/2" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 652, " ["Pub. L. 91–518, title X, § 1002" -> "/us/pl/91/518/tX/s1002"] ", as added " ["Pub. L. 96–254, title II, § 212" -> "/us/pl/96/254/tII/s212"] ", May 30, 1980, " ["94 Stat. 415" -> "/us/stat/94/415"] ", directed National Railroad Passenger Corporation to develop design and engineering plans for rail corridors in consultation with Secretary and rail carriers owning facilities to be used in the corridors."
    hash "8e65a4cade1b4ec94ff899b9f3eefd27332fe8ab74e868c299c52a2b0b264a37"
  }
  note "/us/usc/t45/s651...658/note/ungrouped/pl.91.518/noheading/3" editorial {
