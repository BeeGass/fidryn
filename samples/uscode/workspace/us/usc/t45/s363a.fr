edition 2
module "/us/usc/t45/s363a" {
  within "/us/usc/t45/ch11"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s363a" section {
    num "363a" "§ 363a."
    heading "Refunds of State unemployment contributions by employees; amount; application period; definitions"
    provision "/us/usc/t45/s363a/a" subsection {
      num "a" "(a)"
      content "Notwithstanding any other provision of law, in any case where an employee amount (as hereinafter defined) was paid from a State unemployment fund to the Unemployment Trust Fund, an aggregate amount equal thereto shall be paid from the Unemployment Trust Fund, as refunds, to employees who paid into the State fund the contributions upon which such payment into the Unemployment Trust Fund was based, except that in case any such employee is deceased, payment shall be made to his estate; and the payment so made in the case of any employee shall be in proportion to the contributions paid by such employee into the State fund: Provided, That payment in any such case shall be made only if application therefor is made to the Railroad Retirement Board within two years after August 2, 1946."
      hash "b5565d095a64cb84528d9812ab997a2de242ef06d54979fc7e8f2cc69a32ab84"
    }
    provision "/us/usc/t45/s363a/b" subsection {
      num "b" "(b)"
      chapeau "As used in this section—"
      provision "/us/usc/t45/s363a/b/1" paragraph {
        num "1" "(1)"
        content "The term “employee amount” means any amount paid from a State unemployment fund to the Unemployment Trust Fund which would not have been required to be paid, under the provisions of " ["section 363(c) of this title" -> "/us/usc/t45/s363/c"] ", if said section had not required payment of amounts based on contributions collected from employees."
        hash "034b203ac589d85620ac7690fce3b688be70066471ec9c5ce70e53ab763775bf"
      }
      provision "/us/usc/t45/s363a/b/2" paragraph {
        num "2" "(2)"
        content "The term “Unemployment Trust Fund” means the fund established by " ["section 1104 of title 42" -> "/us/usc/t42/s1104"] "."
        hash "2c64e731d9c4ac3d97db884a8ab2337520c481d6d9cf3dfc3b7d7fdeda504fbf"
      }
      provision "/us/usc/t45/s363a/b/3" paragraph {
        num "3" "(3)"
        content "The term “employees” has the same meaning as in the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.]."
        hash "f1895cde45f45473d8fa571a49c19f3a3edb27168869bb859aea62ad0ce37b39"
      }
      hash "8440fabfc5ea5af0abd867569327d459c4e15949bea11ca38544bf4e924c66da"
    }
    hash "b781cf5a48173b7ef199502cf22d7c9d5b2481658edf863c514940554cdacc57"
  }
  credit "(" ["Aug. 2, 1946, ch. 743" -> "/us/act/1946-08-02/ch743"] ", " ["60 Stat. 806" -> "/us/stat/60/806"] "; " ["Aug. 6, 1947, ch. 509" -> "/us/act/1947-08-06/ch509"] ", " ["61 Stat. 793" -> "/us/stat/61/793"] ".)"
  note "/us/usc/t45/s363a/note/editorialNotes/act.1938-06-25.ch680/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Railroad Unemployment Insurance Act, referred to in subsec. (b)(3), is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to this chapter. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "9e54a8b7f838ca360f9eb84a8a67fed13c05779c75da5edb3ec623dd504a698f"
  }
  note "/us/usc/t45/s363a/note/editorialNotes/nolaw/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Section was not enacted as a part of the Railroad Unemployment Insurance Act which comprises this chapter."
    hash "e79dbd28b084a720911bc3eaab795645f89e8b8c79efa8a7b4a50d4df8084e69"
  }
  note "/us/usc/t45/s363a/note/editorialNotes/nolaw/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1947—Subsec. (a). Act Aug. 6, 1947, extended time for application for refund from twelve months to two years after Aug. 2, 1946."
    hash "e0a8c72b4e5a947e1bca527961325e844b150fa44ec0c680a9f39d8c015cb91c"
  }
  layers {
    operative "b781cf5a48173b7ef199502cf22d7c9d5b2481658edf863c514940554cdacc57"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "493235f7aecbd7e8f31ab87ecfef96c1c59ee1cf62aaba2b119898c9fd2c114f"
  }
}
