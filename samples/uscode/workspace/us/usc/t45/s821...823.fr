  note "/us/usc/t45/s821...823/note/statutoryNotes/pl.117.58/savings-provision" enacted {
    group statutoryNotes
    topic "savings"
    heading "Savings Provision"
    p ["Pub. L. 117–58, div. B, title I, § 21301(b)(2)" -> "/us/pl/117/58/dB/tI/s21301/b/2"] ", Nov. 15, 2021, " ["135 Stat. 683" -> "/us/stat/135/683"] ", provided that:"
    quoted "/us/pl/117/58/dB/tI/s21301/b/2" {
      p "“The repeals under paragraph (1) [repealing this section and sections 822, 823, and 836 of this title] shall not affect the rights and duties that matured under the repealed sections, the penalties that were incurred under such sections, or any proceeding authorized under any such section that commenced before the date of enactment of this Act [Nov. 15, 2021].”"
    }
    hash "deb69abf7a33d82cb340347dab01a564aad64e906e451a0eccac7daf2c4273b6"
  }
