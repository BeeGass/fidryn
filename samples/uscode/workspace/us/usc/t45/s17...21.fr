    group ungrouped
    topic "removalDescription"
    p "Section 18, acts " ["May 30, 1908, ch. 225, § 3" -> "/us/act/1908-05-30/ch225/s3"] ", " ["35 Stat. 476" -> "/us/stat/35/476"] "; " ["June 25, 1948, ch. 646, § 1" -> "/us/act/1948-06-25/ch646/s1"] ", " ["62 Stat. 909" -> "/us/stat/62/909"] "; Oct. 15, 1966, " ["Pub. L. 89–670, § 6(e)(1)(D)" -> "/us/pl/89/670/s6/e/1/D"] ", " ["80 Stat. 939" -> "/us/stat/80/939"] ", set forth penalties for violations and authorized United States attorneys to bring actions for enforcement of provisions."
