  provision "/us/usc/t45/s231j" section {
    num "231j" "§ 231j."
    heading "Waiver of annuities"
    content "Any person awarded an annuity under this subchapter may decline to accept all or any part of such annuity by a waiver signed and filed with the Board. Such a waiver may be revoked in writing at any time, but no payment of the annuity waived shall be made covering the period during which such waiver was in effect. Such a waiver will have no effect on entitlement to, or the amount of, any other annuity or benefit."
    hash "bb8fcebdc347bf0477851f5ef2776f58657ac705b47264277de8873db7ad356f"
  }
