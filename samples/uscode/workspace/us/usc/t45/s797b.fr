edition 2
module "/us/usc/t45/s797b" {
  within "/us/usc/t45/ch16/schVII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s797b" section {
    num "797b" "§ 797b."
    heading "Preferential hiring"
    provision "/us/usc/t45/s797b/a" subsection {
      num "a" "(a)"
      heading "General"
      content "Any employee who is deprived of employment shall have the first right of hire by any other railroad for a vacancy for which he is qualified in a class or craft (or in the case of a non-agreement employee, for a non-agreement vacancy) in which such employee was employed by the Corporation or a predecessor carrier for not less than one year, except where such a vacancy is covered by (1) an affirmative action plan, or a hiring plan designed to eliminate discrimination, that is required by Federal or State statute, regulation, or Executive order, or by the order of a Federal court or agency, or (2) a permissible voluntary affirmative action plan. For purposes of this section, a railroad shall not be considered to be hiring new employees when it recalls any of its own furloughed employees."
      hash "ded4f2042a3853484c3dc3b40773cd6f7d6b5edbd08019c34af1f65e1c093c06"
    }
    provision "/us/usc/t45/s797b/b" subsection {
      num "b" "(b)"
      heading "Status"
      content "The first right of hire afforded to employees under this section shall be coequal to the first right of hire afforded under sections 907 and 1004 of this title."
      hash "3cbb061f30e55da8cb060cac5c10cef003f6164e8d2b90d1adb310caaa34ae73"
    }
    hash "936a18e0d986059516ca106bd2953fd723f2b6d402cbb4d022bc10b0a6193ef1"
  }
  credit "(" ["Pub. L. 93–236, title VII, § 703" -> "/us/pl/93/236/tVII/s703"] ", as added " ["Pub. L. 97–35, title XI, § 1143(a)" -> "/us/pl/97/35/tXI/s1143/a"] ", Aug. 13, 1981, " ["95 Stat. 663" -> "/us/stat/95/663"] ".)"
  note "/us/usc/t45/s797b/note/statutoryNotes/pl.99.272/exemption-of-national-railroad-passenger-corporation-in-hiri" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Exemption of National Railroad Passenger Corporation in Hiring Qualified Train and Engine Employees"
    p ["Pub. L. 99–272, title IV, § 4011(c)" -> "/us/pl/99/272/tIV/s4011/c"] ", Apr. 7, 1986, " ["100 Stat. 109" -> "/us/stat/100/109"] ", provided that:"
    quoted "/us/pl/99/272/tIV/s4011/c" {
      p "“The provisions of section 703 of the Regional Rail Reorganization Act of 1973 (" ["45 U.S.C. 797b" -> "/us/usc/t45/s797b"] "), section 8 of the Milwaukee Railroad Restructuring Act (" ["45 U.S.C. 907" -> "/us/usc/t45/s907"] "), and section 105 of the Rock Island Railroad Transition and Employee Assistance Act (" ["45 U.S.C. 1004" -> "/us/usc/t45/s1004"] ") shall not apply to the National Railroad Passenger Corporation in the hiring of qualified train and engine employees who hold seniority rights to work in intercity rail passenger service in connection with the assumption by such Corporation of functions previously performed under contract by other carriers.”"
    }
    hash "62608ef868f2404250b955b460f72351392aef734a6eb3fee0bf5cb7e65981d0"
  }
  layers {
    operative "936a18e0d986059516ca106bd2953fd723f2b6d402cbb4d022bc10b0a6193ef1"
    enacted "a853deab082657557a18b25d76e0112ebc52e21b4626087cebe95a77349749a3"
    editorial "b9e03aa2b65e0b07611407bdbe3d8c3594253f6d0cd76010f6f2159a5ca60eb2"
  }
}
