edition 2
module "/us/usc/t45/s797d" {
  within "/us/usc/t45/ch16/schVII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s797d" section {
    num "797d" "§ 797d."
    heading "Election and treatment of benefits"
    provision "/us/usc/t45/s797d/a" subsection {
      num "a" "(a)"
      heading "Election"
      provision "/us/usc/t45/s797d/a/1" paragraph {
        num "1" "(1)"
        content "Any employee who accepts any benefits under an agreement entered into under section 797" mark "1" 1 " of this title or a termination allowance under " ["section 797a of this title" -> "/us/usc/t45/s797a"] ", shall, except as provided in paragraph (2) of this subsection, be deemed to waive any employee protection benefits otherwise available under any other provision of law or any contract or agreement in effect on August 13, 1981, except benefits under sections 797b and 797c of this title, and shall be deemed to waive any cause of action for any alleged loss of benefits resulting from the provisions of or the amendments made by the Northeast Rail Service Act of 1981."
        hash "b8c70d4deb3872faf23d65402cc4d7240e1d90242ff4aed6c79b48a516982a41"
      }
      provision "/us/usc/t45/s797d/a/2" paragraph {
        num "2" "(2)"
        content "Nothing in paragraph (1) of this subsection shall affect the right of any employee described in such paragraph to benefits under the Railroad Retirement Act of 1974 [" ["45 U.S.C. 231" -> "/us/usc/t45/s231"] " et seq.] or the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.]."
        hash "dbc261491ad7e2d11caf243c57d6505f2300dbe5f50c36f9ebd78f0a0f7e30d4"
      }
      hash "a68e5e93840f32a02fa8be7838adbc8918cd618da60c8600323316a2ae69efd3"
    }
    provision "/us/usc/t45/s797d/b" subsection {
      num "b" "(b)"
      heading "Treatment of benefits"
      chapeau "Any benefits received by an employee under an agreement entered into pursuant to section 797 " sup "1" " of this title and any termination allowance received under " ["section 797a of this title" -> "/us/usc/t45/s797a"] " shall be considered compensation solely for purposes of—"
      provision "/us/usc/t45/s797d/b/1" paragraph {
        num "1" "(1)"
        content "the Railroad Retirement Act of 1974 (" ["45 U.S.C. 231" -> "/us/usc/t45/s231"] " et seq.); and"
        hash "02a738d290d6743282ed3a23224951fbcdc4cc505e4aad33c2ace30bd3e30047"
      }
      provision "/us/usc/t45/s797d/b/2" paragraph {
        num "2" "(2)"
        content "determining the compensation received by such employee in any base year under the Railroad Unemployment Insurance Act (" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.)."
        hash "04c9e2b846186233abb7b554df17e121b99d78caf0857640491702b6859f4438"
      }
      hash "afb2c889dbadde57841576a83006b57ce03ab284c3800f4cf1c2c40f27a2e148"
    }
    hash "0aeb03451d4d1fa20df962c20a48e1158d559619ad4a948ebf436765020bce5d"
  }
  credit "(" ["Pub. L. 93–236, title VII, § 705" -> "/us/pl/93/236/tVII/s705"] ", as added " ["Pub. L. 97–35, title XI, § 1143(a)" -> "/us/pl/97/35/tXI/s1143/a"] ", Aug. 13, 1981, " ["95 Stat. 664" -> "/us/stat/95/664"] ".)"
  note "/us/usc/t45/s797d/note/editorialNotes/pl.99.509/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 797 of this title" -> "/us/usc/t45/s797"] ", referred to in subsecs. (a)(1) and (b), was repealed by " ["Pub. L. 99–509, title IV, § 4024(c)" -> "/us/pl/99/509/tIV/s4024/c"] ", Oct. 21, 1986, " ["100 Stat. 1904" -> "/us/stat/100/1904"] ", effective on the sale date (Apr. 2, 1987)."
    p "The Northeast Rail Service Act of 1981, referred to in subsec. (a)(1), is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ". For complete classification of this Act to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    p "The Railroad Retirement Act of 1974, referred to in subsecs. (a)(2) and (b)(1), is " ["act Aug. 29, 1935, ch. 812" -> "/us/act/1935-08-29/ch812"] ", as amended generally by " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1305" -> "/us/stat/88/1305"] ", which is classified generally to subchapter IV (§ 231 et seq.) of chapter 9 of this title. For further details and complete classification of this Act to the Code, see Codification note set out preceding " ["section 231 of this title" -> "/us/usc/t45/s231"] ", " ["section 231t of this title" -> "/us/usc/t45/s231t"] ", and Tables."
    p "The Railroad Unemployment Insurance Act, referred to in subsecs. (a)(2) and (b)(2), is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to chapter 11 (§ 351 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "929f40fe23377e35edaa7a105b44247dc270b552da0fd1b334a40c307263823a"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "0aeb03451d4d1fa20df962c20a48e1158d559619ad4a948ebf436765020bce5d"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "9edf8728c7383591ace37e17293f5101e432619fb2ebf279543c8825a41d3b2f"
  }
}
