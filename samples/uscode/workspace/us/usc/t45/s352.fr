  note "/us/usc/t45/s352/note/statutoryNotes/pl.117.2/clarification-on-authority-to-use-funds" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Clarification on Authority To Use Funds"
    p ["Pub. L. 117–2, title II, § 2901(b)" -> "/us/pl/117/2/tII/s2901/b"] ", Mar. 11, 2021, " ["135 Stat. 49" -> "/us/stat/135/49"] ", provided that:"
    quoted "/us/pl/117/2/tII/s2901/b" {
      p "“Funds appropriated under subparagraph (B) of section 2(a)(5) of the Railroad Unemployment Insurance Act (" ["45 U.S.C. 352(a)(5)" -> "/us/usc/t45/s352/a/5"] ") shall be available to cover the cost of recovery benefits provided under such section 2(a)(5) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(a)(5) as in effect on the day before the date of enactment of this Act [Mar. 11, 2021].”"
    }
    p ["Pub. L. 117–2, title II, § 2902(b)" -> "/us/pl/117/2/tII/s2902/b"] ", Mar. 11, 2021, " ["135 Stat. 50" -> "/us/stat/135/50"] ", provided that:"
    quoted "/us/pl/117/2/tII/s2902/b" {
      p "“Funds appropriated under the first, second, or third sentence of clause (v) of section 2(c)(2)(D) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)(2)(D)" -> "/us/usc/t45/s352/c/2/D"] "] shall be available to cover the cost of additional extended unemployment benefits provided under such section 2(c)(2)(D) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(c)(2)(D) as in effect on the day before the date of enactment of this Act [Mar. 11, 2021].”"
    }
    p ["Pub. L. 116–260, div. N, title II, § 232(b)" -> "/us/pl/116/260/dN/tII/s232/b"] ", Dec. 27, 2020, " ["134 Stat. 1957" -> "/us/stat/134/1957"] ", provided that:"
    quoted "/us/pl/116/260/dN/tII/s232/b" {
      p "“Funds appropriated under subparagraph (B) of section 2(a)(5) of the Railroad Unemployment Insurance Act (" ["45 U.S.C. 352(a)(5)" -> "/us/usc/t45/s352/a/5"] ") shall be available to cover the cost of recovery benefits provided under such section 2(a)(5) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(a)(5) as in effect on the day before the date of enactment of this Act [Dec. 27, 2020].”"
    }
    p ["Pub. L. 116–260, div. N, title II, § 233(c)" -> "/us/pl/116/260/dN/tII/s233/c"] ", Dec. 27, 2020, " ["134 Stat. 1958" -> "/us/stat/134/1958"] ", provided that:"
    quoted "/us/pl/116/260/dN/tII/s233/c" {
      p "“Funds appropriated under either the first or second sentence of clause (v) of section 2(c)(2)(D) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)(2)(D)" -> "/us/usc/t45/s352/c/2/D"] "] (as redesignated by subsection (a)(4)) shall be available to cover the cost of additional extended unemployment benefits provided under such section 2(c)(2)(D) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(c)(2)(D) as in effect on the day before the date of enactment of this Act [Dec. 27, 2020].”"
    }
    p ["Pub. L. 116–136, div. A, title II, § 2114(b)" -> "/us/pl/116/136/dA/tII/s2114/b"] ", Mar. 27, 2020, " ["134 Stat. 334" -> "/us/stat/134/334"] ", provided that:"
    quoted "/us/pl/116/136/dA/tII/s2114/b" {
      p "“Funds appropriated under either the first or second sentence of clause (iv) [now (v)] of section 2(c)(2)(D) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)(2)(D)(v)" -> "/us/usc/t45/s352/c/2/D/v"] "] shall be available to cover the cost of additional extended unemployment benefits provided under such section 2(c)(2)(D) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(c)(2)(D) as in effect on the day before the date of enactment of this Act [Mar. 27, 2020].”"
    }
    hash "84a2903c3292830c7240663528a422aa32e25d01a657d0f3b8aa1c0379667da1"
  }
  note "/us/usc/t45/s352/note/statutoryNotes/pl.112.240/extended-unemployment-benefits-and-administrative-expenses" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Extended Unemployment Benefits and Administrative Expenses"
    p ["Pub. L. 112–240, title V, § 504(b)" -> "/us/pl/112/240/tV/s504/b"] ", (c), Jan. 2, 2013, " ["126 Stat. 2345" -> "/us/stat/126/2345"] ", provided that:"
    quoted "/us/pl/112/240/tV/s504/b" {
      level subsection {
        num "b" "“(b)"
        heading "Clarification on Authority to Use Funds.—"
        content "Funds appropriated under either the first or second sentence of clause (iv) [now (v)] of section 2(c)(2)(D) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)(2)(D)(v)" -> "/us/usc/t45/s352/c/2/D/v"] "] shall be available to cover the cost of additional extended unemployment benefits provided under such section 2(c)(2)(D) by reason of the amendments made by subsection (a) [amending this section] as well as to cover the cost of such benefits provided under such section 2(c)(2)(D), as in effect on the day before the date of enactment of this Act [Jan. 2, 2013]."
      }
      level subsection {
        num "c" "“(c)"
        heading "Funding for Administration.—"
        content "Out of any funds in the Treasury not otherwise appropriated, there are appropriated to the Railroad Retirement Board $250,000 for administrative expenses associated with the payment of additional extended unemployment benefits provided under section 2(c)(2)(D) of the Railroad Unemployment Insurance Act by reason of the amendments made by subsection (a), to remain available until expended.”"
      }
    }
    hash "057a0fc8678caec37cebb2d2c502b7a3a5d5c4840f44aa5b3165193281e5514a"
  }
  note "/us/usc/t45/s352/note/statutoryNotes/pl.103.152/extended-railroad-unemployment-insurance-benefits-during-per" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Extended Railroad Unemployment Insurance Benefits During Periods of High National Unemployment"
    p ["Pub. L. 102–164, title V, § 501" -> "/us/pl/102/164/tV/s501"] ", Nov. 15, 1991, " ["105 Stat. 1064" -> "/us/stat/105/1064"] ", as amended by " ["Pub. L. 102–182, § 3(a)(6)" -> "/us/pl/102/182/s3/a/6"] ", (7), Dec. 4, 1991, " ["105 Stat. 1234" -> "/us/stat/105/1234"] "; " ["Pub. L. 102–244, § 5" -> "/us/pl/102/244/s5"] ", Feb. 7, 1992, " ["106 Stat. 5" -> "/us/stat/106/5"] "; " ["Pub. L. 102–318, title I, § 105" -> "/us/pl/102/318/tI/s105"] ", July 3, 1992, " ["106 Stat. 293" -> "/us/stat/106/293"] "; " ["Pub. L. 103–6, § 3(a)" -> "/us/pl/103/6/s3/a"] ", (b), Mar. 4, 1993, " ["107 Stat. 33" -> "/us/stat/107/33"] "; " ["Pub. L. 103–152" -> "/us/pl/103/152"] ", §§ 8, 9(b), Nov. 24, 1993, " ["107 Stat. 1519" -> "/us/stat/107/1519"] ", provided that:"
    quoted "/us/pl/103/152" {
      level subsection {
        num "a" "“(a)"
        heading "In General.—"
        content "For purposes of section 2(h) of the Railroad Unemployment Insurance Act (" ["45 U.S.C. 352(h)(2)" -> "/us/usc/t45/s352/h/2"] "), a ‘period of high unemployment’ includes any month during the period November 1991 through February 1994."
      }
      level subsection {
        num "b" "“(b)"
        heading "Effective Dates.—"
        level paragraph {
          num "1" "“(1)"
          heading "In general.—"
          content "Except as provided in paragraphs (2) and (3), no employee shall have an extended benefit period under the second proviso of section 2(c) of the Railroad Unemployment Insurance Act beginning before November 17, 1991, or after February 5, 1994."
        }
        level paragraph {
          num "2" "“(2)"
          heading "Transition.—"
          content "If an employee has established an extended benefit period under the second proviso of section 2(c) of the Railroad Unemployment Insurance Act and the last day of such extended benefit period, as established, is after February 5, 1994, such employee shall continue to be entitled to extended unemployment benefits for days of unemployment in registration periods included in such extended benefit period, provided that such employee meets the eligibility requirements of this section and the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.]."
        }
        level paragraph {
          num "3" "“(3)"
          heading "Reachback Provisions.—"
          content "If an employee has exhausted that employee’s rights to normal unemployment benefits under section 2(c) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)" -> "/us/usc/t45/s352/c"] "] after February 28, 1991, but before November 17, 1991, such employee shall, for the purposes of the application of this section, be deemed to have exhausted such rights after November 17, 1991."
        }
      }
      level subsection {
        num "c" "“(c)"
        heading "Limitation on Payment.—"
        content "Extended benefits under this section shall be payable for a maximum of 65 days of unemployment, including any extended benefits payable by reason of the application of the reachback provisions."
      }
      level subsection {
        num "d" "“(d)"
        heading "Enlargement of Benefits.—"
        level paragraph {
          num "1" "“(1)"
          heading "Generally.—"
          chapeau "During the period that begins on the date of the enactment of this subsection [Feb. 7, 1992]—"
          level subparagraph {
            num "A" "“(A)"
            content "subsection (c) of this section shall be applied by substituting ‘130’ for ‘65’;"
          }
          level subparagraph {
            num "B" "“(B)"
            chapeau "section 2(c) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)" -> "/us/usc/t45/s352/c"] "] shall be applied—"
            level clause {
              num "i" "“(i)"
              content "by substituting ‘13 (but not more than 130 days)’ for ‘7 (but not more than 65 days)’ in the table; and"
            }
            level clause {
              num "ii" "“(ii)"
              content "by substituting ‘but not by more than 130 days’ for ‘but not by more than sixty-five days’ in the second proviso; and"
            }
          }
          level subparagraph {
            num "C" "“(C)"
            content "section 2(h)(1) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(h)(1)" -> "/us/usc/t45/s352/h/1"] "] shall be applied by substituting ‘13’ for ‘seven’."
          }
        }
        level paragraph {
          num "2" "“(2)"
          heading "Phase-out.—"
          level subparagraph {
            num "A" "“(A)"
            heading "Benefits on or after june 14, 1992.—"
            content "Effective on and after June 14, 1992, paragraph (1) of this section shall be applied by substituting ‘100’ for ‘130’ each place it appears, and by substituting ‘10’ for ‘13’ each place it appears."
          }
          level subparagraph {
            num "B" "“(B)"
            heading "Reductions under emergency compensation extension provisions.—"
            level clause {
              num "i" "“(i)"
              content "Effective on and after the date on which a reduction in benefits is imposed under section 102(b)(2)(A)(iii) [" ["section 102(b)(2)(A)(iii) of Pub. L. 102–164" -> "/us/pl/102/164/s102/b/2/A/iii"] ", " ["26 U.S.C. 3304" -> "/us/usc/t26/s3304"] " note], subparagraph (A) of this paragraph and subparagraphs (B) and (C) of paragraph (1) shall not apply and subparagraph (A) of paragraph (1) shall be applied by substituting ‘50’ for ‘130’."
            }
            level clause {
              num "ii" "“(ii)"
              content "Effective after October 2, 1993, subparagraph (A) of this paragraph and subparagraphs (B) and (C) of paragraph (1) shall not apply and subparagraph (A) of paragraph (1) shall be applied by substituting ‘35’ for ‘130’."
            }
          }
          level subparagraph {
            num "C" "“(C)"
            heading "Limitations on reductions.—"
            content "Notwithstanding subparagraphs (A) and (B), in the case of an individual who is receiving extended benefits under section 2(c) of the Railroad Unemployment Insurance Act [" ["45 U.S.C. 352(c)" -> "/us/usc/t45/s352/c"] "] for persons with 10 or more but less than 15 years of service, or extended benefits by reason of this section, for any day during a week which precedes a period for which a reduction under this paragraph takes effect, such reduction shall not apply for purposes of determining the amount of benefits payable to such individual for any day thereafter for which the individual meets the eligibility requirements of this section and the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.]."
          }
        }
      }
      level subsection {
        num "e" "“(e)"
        heading "Termination of Benefits.—"
        content "In the case of an individual who is receiving extended benefits by reason of this section on February 5, 1994, such benefits shall not continue to be payable to such individual after April 30, 1994.”"
      }
    }
    p "[" ["Pub. L. 103–6, § 3(c)" -> "/us/pl/103/6/s3/c"] ", Mar. 4, 1993, " ["107 Stat. 33" -> "/us/stat/107/33"] ", provided that:"
    quoted "/us/pl/103/6/s3/c" {
      p "“The amendments made by this section [amending " ["section 501 of Pub. L. 102–164" -> "/us/pl/102/164/s501"] ", set out above] shall apply to weeks beginning after March 6, 1993.”"
    }
    p "]"
    p "[Amendments made by " ["Pub. L. 102–182" -> "/us/pl/102/182"] " to " ["section 501 of Pub. L. 102–164" -> "/us/pl/102/164/s501"] ", set out above, applicable as if included in the provisions of and the amendments made by " ["Pub. L. 102–164" -> "/us/pl/102/164"] ", see " ["section 3(b) of Pub. L. 102–182" -> "/us/pl/102/182/s3/b"] ", set out as a note under " ["section 3304 of Title 26" -> "/us/usc/t26/s3304"] ", Internal Revenue Code.]"
    hash "aea7b07e016350f31833a08aa636767dac5d4b261189924548ecd0281e105605"
  }
  note "/us/usc/t45/s352/note/statutoryNotes/pl.100.647/gao-study-of-fraud-and-payment-errors" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "GAO Study of Fraud and Payment Errors"
    p ["Pub. L. 100–647, title VII, § 7107" -> "/us/pl/100/647/tVII/s7107"] ", Nov. 10, 1988, " ["102 Stat. 3774" -> "/us/stat/102/3774"] ", provided that:"
    quoted "/us/pl/100/647/tVII/s7107" {
      p "“The Comptroller General shall study the frequency of fraud and payment errors in the railroad unemployment compensation program. Not later than 1 year after the date of the enactment of this Act [Nov. 10, 1988], the Comptroller General shall report to Congress the results of such study. Such report shall include—"
      level paragraph {
        num "1" "“(1)"
        content "estimates of rates and amounts of annual losses due to fraud and overpayment;"
      }
      level paragraph {
        num "2" "“(2)"
        content "comparisons of such rates with the rates of losses in other Federal programs which experience such losses;"
      }
      level paragraph {
        num "3" "“(3)"
        content "recommendations for legislative measures that could be taken to reduce the losses in the railroad unemployment compensation program arising from fraud and payment errors; and"
      }
      level paragraph {
        num "4" "“(4)"
        content "such other matters relating to such fraud and payment errors as the Comptroller General determines are appropriate.”"
      }
    }
    hash "a2ce1bb98c38d2f7f0002b2a79b6d3df19fc855397b68c9b966ef213f5385128"
  }
  note "/us/usc/t45/s352/note/statutoryNotes/pl.86.28/benefits-for-certain-employees-who-exhausted-rights-to-benef" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Benefits for Certain Employees Who Exhausted Rights to Benefits Before April 1, 1959"
    p ["Pub. L. 86–28" -> "/us/pl/86/28"] ", pt. III, § 303(b), May 19, 1959, " ["73 Stat. 31" -> "/us/stat/73/31"] ", provided that:"
    quoted "/us/pl/86/28" {
      p "“An employee who has less than ten years of service as defined in section 1(f) of the Railroad Retirement Act of 1937 [" ["section 228a(f) of this title" -> "/us/usc/t45/s228a/f"] "], and who has after June 30, 1957, and before April 1, 1959, exhausted (within the meaning prescribed by the Railroad Retirement Board by regulation) his rights to unemployment benefits, shall be paid unemployment benefits for days of unemployment, not exceeding sixty-five, which occur in registration periods beginning on or after June 19, 1958, and before July 1, 1959, and which would not be days with respect to which he would be held entitled otherwise to receive unemployment benefits under the Railroad Unemployment Insurance Act [this chapter], except that an employee who has filed, and established, a first claim for benefits under the Temporary Unemployment Compensation Act of 1958 [" ["42 U.S.C. 1400" -> "/us/usc/t42/s1400"] " et seq.] may not thereafter establish a claim under this subsection, and an employee who has registered for, and established a claim for benefits under this subsection may not thereafter establish a claim under the Temporary Unemployment Compensation Act of 1958. Except to the extent inconsistent with this subsection, the provisions of the Railroad Unemployment Insurance Act [this chapter] shall be applicable in the administration of this subsection.”"
    }
    hash "84c2eb02ceb987becb0f6ec47d0aa66559e16f3d345f9cddec5a17a33b081950"
  }
  note "/us/usc/t45/s352/note/statutoryNotes/pl.86.28/interchange-of-information-between-secretary-of-labor-and-ra" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Interchange of Information Between Secretary of Labor and Railroad Retirement Board"
    p ["Pub. L. 86–28" -> "/us/pl/86/28"] ", pt. III, § 303(c), May 19, 1959, " ["73 Stat. 31" -> "/us/stat/73/31"] ", provided that:"
    quoted "/us/pl/86/28" {
      p "“The Secretary of Labor, upon request shall furnish the Board information deemed necessary by the Board for the administration of the provisions of subsection (b) hereof [set out above], and the Board, upon request, shall furnish the Secretary of Labor information deemed necessary by the Secretary for the administration of the Temporary Unemployment Compensation Act of 1958 [section 1400 et seq. of Title 42, The Public Health and Welfare].”"
    }
    hash "6b7203b09780fc2d5ede582071eaeb9aa9840d3e3429680a71ffdcdbba0979dd"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  footnote 2 "2" {
    p "So in original."
  }
