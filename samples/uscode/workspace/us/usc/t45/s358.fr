edition 2
module "/us/usc/t45/s358" {
  within "/us/usc/t45/ch11"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s358" section {
    num "358" "§ 358."
    heading "Contributions"
    provision "/us/usc/t45/s358/a" subsection {
      num "a" "(a)"
      heading "Employer contribution"
      provision "/us/usc/t45/s358/a/1" paragraph {
        num "1" "(1)"
        heading "In general"
        provision "/us/usc/t45/s358/a/1/A" subparagraph {
          num "A" "(A)"
          heading "General rule"
          provision "/us/usc/t45/s358/a/1/A/i" clause {
            num "i" "(i)"
            heading "Contribution rate generally"
            content "Every employer shall pay a contribution, with respect to having employees in his service, equal to the percentage determined under subparagraph (B), (C), or (D), whichever is applicable, of so much of the compensation paid in any calendar month by such employer to any employee as is not in excess of the monthly compensation base for that month as computed under " ["section 351(i) of this title" -> "/us/usc/t45/s351/i"] "."
            hash "0c4fc1998aa56d024aeae909e3b4b3f576fa0d0b5814f2185eba8cc7cc87bfda"
          }
          provision "/us/usc/t45/s358/a/1/A/ii" clause {
            num "ii" "(ii)"
            heading "Multiple employer limitation"
            chapeau "If compensation is paid to an employee by more than one employer in any calendar month—"
            provision "/us/usc/t45/s358/a/1/A/ii/I" subclause {
              num "I" "(I)"
              content "the contributions required by this subsection shall not apply to any amount of the aggregate compensation paid to such employee by all such employers in such calendar month which is in excess of such monthly compensation base; and"
              hash "fc8579803cbc9052d4a9f84600f1a80a4700ea9a125f4759f6c0f61fd2af568a"
            }
            provision "/us/usc/t45/s358/a/1/A/ii/II" subclause {
              num "II" "(II)"
              content "each employer (other than a subordinate unit of a national-railway-labor-organization employer) shall be liable for that portion of the contribution with respect to such compensation paid by all such employers which the compensation paid by him to such employee bears to the total compensation paid in such month by all such employers to such employee."
              hash "1cd5dc3fd0180e822a044f6274f48d439da3429658a1aa485afdb9433d0a7cf6"
            }
            hash "00052e1696b40d1b372223de8a547eaebcddfe31b5aef78b01760463174c8693"
          }
          continuation "In the event that the compensation paid by such employers to the employee in such month is less than such monthly compensation base, each subordinate unit of a national-railway-labor-organization employer shall be liable for such portion of any additional contribution as the compensation paid by such employer to such employee in such month bears to the total compensation paid by all such employers to such employee in such month."
          hash "5089e3606f713d9a4770488e540423e53ad72933dc77dadbd2911b35dd764aae"
        }
        provision "/us/usc/t45/s358/a/1/B" subparagraph {
          num "B" "(B)"
          heading "Transitional rule"
          provision "/us/usc/t45/s358/a/1/B/i" clause {
            num "i" "(i)"
            heading "1st, 2d, and 3d calendar years"
            content "Except as provided in clause (vi), with respect to compensation paid in calendar years 1988, 1989, and 1990, the contribution rate shall be 8 percent."
            hash "e516ded3e9bed154ea8a0390f86ba4a71bb684f1de1e70d7715e7ba06a70bac5"
          }
          provision "/us/usc/t45/s358/a/1/B/ii" clause {
            num "ii" "(ii)"
            heading "4th calendar year"
            chapeau "With respect to compensation paid in calendar year 1991, the contribution rate shall be the smaller of—"
            provision "/us/usc/t45/s358/a/1/B/ii/I" subclause {
              num "I" "(I)"
              content "the maximum contribution limit computed under paragraph (20); or"
              hash "6f2ec8b0255d302eb188342d891f3a08d206430690d4ce82aa8a2666d96408a1"
            }
            provision "/us/usc/t45/s358/a/1/B/ii/II" subclause {
              num "II" "(II)"
              content {
                p "the percentage computed pursuant to the following formula:"
                table {
