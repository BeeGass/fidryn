            }
            hash "9740aeb3dd8e48529ae080f2c956dbd392f8d892c0316a4804a04349eed51d22"
          }
          provision "/us/usc/t45/s358/a/1/B/iv" clause {
            num "iv" "(iv)"
            heading "Meaning of symbols"
            chapeau "For purposes of the formulas in clauses (ii) and (iii)—"
            provision "/us/usc/t45/s358/a/1/B/iv/I" subclause {
              num "I" "(I)"
              content "“R” is the applicable contribution rate expressed as a percentage for months in the calendar year;"
              hash "00b727448651793b6b536a0e2d4dcea0f79541cf97a65de91517705698f3fdd3"
            }
            provision "/us/usc/t45/s358/a/1/B/iv/II" subclause {
              num "II" "(II)"
              content "“A” is the contribution rate determined under clause (i);"
              hash "be90fd3e75bad254e36390d3d9e15c3331f6d061fad0bc8ea704876549d79373"
            }
            provision "/us/usc/t45/s358/a/1/B/iv/III" subclause {
              num "III" "(III)"
              content "“B” is the percentage rate for the employer, as determined under subparagraph (C), for calendar year 1991; and"
              hash "ad9e9ded41e71e569ddca06ee50b016a12c1bbf300f1ad1bc96d52a21ceac722"
            }
            provision "/us/usc/t45/s358/a/1/B/iv/IV" subclause {
              num "IV" "(IV)"
              content "“C” is the percentage rate for the employer, as determined under subparagraph (C), for calendar year 1992."
              hash "561ee034bff6366da9bf88250e43215830bc5fda12602d9578e5db738ab18af4"
            }
            hash "e34a030291bb3f17939ce8c7fd0bddd100e2f40bea49f4b54fbda84d9b6eb2af"
          }
          provision "/us/usc/t45/s358/a/1/B/v" clause {
            num "v" "(v)"
            heading "Special rule for certain computations"
            chapeau "For purposes of computing B and C in such formulas—"
            provision "/us/usc/t45/s358/a/1/B/v/I" subclause {
              num "I" "(I)"
              content "the percentage rate computed under subparagraph (C), if more than the maximum contribution limit computed under paragraph (20) shall not be reduced to that limit; and"
              hash "e2b99a9f69b33e28725c79b863611d1062a4d03c22b9ca682bd3265e051ea841"
            }
            provision "/us/usc/t45/s358/a/1/B/v/II" subclause {
              num "II" "(II)"
              content "any computations which under subparagraph (C) are to be made on the basis of a 4-quarter or a 12-quarter period ending on a given June 30 shall be made on the basis of a period beginning on January 1, 1990, and ending on that June 30, and the amount so computed shall be increased to an amount that bears the same ratio to the amount so computed as 4 or 12, as appropriate, bears to the number of calendar quarters in the period on which the computation was based."
              hash "d55c323ac9bda2d7aa68d4fe7a1a02b95a6208a98c97665d279c51203efbe481"
            }
            hash "3ec668f0db8ddf36f497fb99dc410ac088b853fad363a3fb16c6ca6a0b2a82fa"
          }
          provision "/us/usc/t45/s358/a/1/B/vi" clause {
            num "vi" "(vi)"
            heading "Special transition rule for public commuter railroads"
            content "With respect to each of calendar years 1989 and 1990, the contribution of the National Railroad Passenger Corporation and an employer which on November 10, 1988, is a publicly funded and publicly operated carrier providing rail commuter service shall be equal to the amount of benefits attributable to such carrier, plus an amount equal to 0.65 percent of the total compensation paid by that employer in that year on which that employer’s contribution would be based under clause (i) if such employer’s contribution were determined under that clause."
            hash "18dc785be78a41dbcdafaef3ae57e53bcc8381357cde0e6747d967f07594ac0c"
          }
          hash "2b95d97b86138e0bc06fb16d4a630eb8d01634751ab8841196a8386eb0df456c"
        }
        provision "/us/usc/t45/s358/a/1/C" subparagraph {
          num "C" "(C)"
          heading "Experience-rated contributions"
          chapeau "With respect to compensation paid in a calendar year that begins after December 31, 1992, the contribution rate for each employer shall be determined as follows:"
          provision "/us/usc/t45/s358/a/1/C/i" clause {
            num "i" "(i)"
            heading "Step 1"
            content "Compute the employer’s benefit ratio as of the preceding June 30 to 4 decimal points in accordance with paragraph (2)."
            hash "29dcc255f5d2fe79ede0c8ae9b2fb76d5c6d1419cf5915fc46cd09d8abdb71ce"
          }
          provision "/us/usc/t45/s358/a/1/C/ii" clause {
            num "ii" "(ii)"
            heading "Step 2"
            content "Subtract the employer’s reserve ratio as of the preceding June 30 as computed to 4 decimal points in accordance with paragraph (4)."
            hash "1b53480c0ac69180f0effc761450f9139a2fc3138ca74f1c5cfb95fb0d3d0e33"
          }
          provision "/us/usc/t45/s358/a/1/C/iii" clause {
            num "iii" "(iii)"
            heading "Step 3"
            content "Subtract the pooled credit ratio for the calendar year, if any, as computed to 4 decimal points in accordance with paragraph (12)."
            hash "9de70c9e5ba4a1cb4390dddd0fac834c13d2b43ce79c38fdc10b8713a144fffe"
          }
          provision "/us/usc/t45/s358/a/1/C/iv" clause {
            num "iv" "(iv)"
            heading "Step 4"
            content "Multiply by 100 the total arrived at under the steps set forth in clauses (i) through (iii) so as to obtain a percentage rate, which shall be rounded to the nearest 100th of 1 percent. If the total arrived at under such steps is 0 or less than 0, the percentage rate as so computed shall be 0."
            hash "ba25824f6b54267f1b86358b3f0c87739efec8be71681597571b30c0dee49cb8"
          }
          provision "/us/usc/t45/s358/a/1/C/v" clause {
            num "v" "(v)"
            heading "Step 5"
            content "Add 0.65 to the percentage rate arrived at under clause (iv), representing the portion of the employer’s contribution which is to be deposited to the credit of the fund under subsection (i)."
            hash "16220601751b4c65caf4cca3f705e18f5d8a6f385cc8e7bd78683cdb0bbf36b1"
          }
          provision "/us/usc/t45/s358/a/1/C/vi" clause {
            num "vi" "(vi)"
            heading "Step 6"
            content "Add the surcharge rate for the calendar year, if any, as computed under paragraph (14)."
            hash "c149433f10ccd927fd12b73a95a252da378c28b9a0f79dd5c422e9200aafd57a"
          }
          provision "/us/usc/t45/s358/a/1/C/vii" clause {
            num "vii" "(vii)"
            heading "Step 7"
            content "Add the pooled charge ratio for the calendar year, if any, as computed to 4 decimal points under paragraph (13) and multiplied by 100."
            hash "1daa2c2f1030543d402371dac521faf83f48c5b24798b449a9f753c201f9860d"
          }
          provision "/us/usc/t45/s358/a/1/C/viii" clause {
            num "viii" "(viii)"
            heading "Step 8"
            content "Reduce the precentage" mark "1" 1 " rate computed in accordance with the preceding steps to the maximum contribution limit computed under paragraph (20), if such rate is higher than such limit. The rate computed in accordance with the preceding steps, after any reduction under this clause, is the contribution rate."
            hash "6a5efd546aa3aafd9f82659061d16e89c77a6f799adf33f201cef18d4f52a380"
          }
          hash "8efe3e1213a3193eda28eb98cc12271260d104b2e505142859a08c5287692fad"
        }
        provision "/us/usc/t45/s358/a/1/D" subparagraph {
          num "D" "(D)"
          heading "New-employer contribution rates"
          chapeau "Notwithstanding subparagraphs (B) and (C), the contribution rate applicable to a new employer who does not become subject to this chapter until after December 31, 1989, shall be determined as follows:"
          provision "/us/usc/t45/s358/a/1/D/i" clause {
            num "i" "(i)"
            heading "1st calendar year"
            chapeau "With respect to compensation paid in calendar months before the end of the first full calendar year in which the employer is subject to this chapter, the contribution rate shall be the average contribution rate paid by all employers during the 3 calendar years preceding the calendar year before the calendar year in which the compensation is paid. The average contribution rate shall be determined—"
            provision "/us/usc/t45/s358/a/1/D/i/I" subclause {
              num "I" "(I)"
              content "by dividing the aggregate contributions paid by all employers under this subsection in those 3 calendar years by the aggregate compensation with respect to which such contributions were paid; and"
              hash "cb23b811173a6f85a082a321b455a89fc8104c2dba35f4edc0682ddcf0af3323"
            }
            provision "/us/usc/t45/s358/a/1/D/i/II" subclause {
              num "II" "(II)"
              content "by multiplying the resulting ratio as computed to 4 decimal points by 100."
              hash "ed220a8379e930a984369b67b510a19badea652d2a05f7a06fad57f2fab9811f"
            }
            hash "1cab88563cf6bc48d4eaa7ea17e35eb494e510c4ac96b2620baf3d9d8bb065b9"
          }
          provision "/us/usc/t45/s358/a/1/D/ii" clause {
            num "ii" "(ii)"
            heading "2d calendar year"
            chapeau "With respect to compensation paid in calendar months in the next calendar year, the contribution rate shall be the smaller of—"
            provision "/us/usc/t45/s358/a/1/D/ii/I" subclause {
              num "I" "(I)"
              content "the maximum contribution limit computed under paragraph (20); or"
              hash "6f2ec8b0255d302eb188342d891f3a08d206430690d4ce82aa8a2666d96408a1"
            }
            provision "/us/usc/t45/s358/a/1/D/ii/II" subclause {
              num "II" "(II)"
              content {
                p "the percentage rate computed pursuant to the following formula:"
                table {
