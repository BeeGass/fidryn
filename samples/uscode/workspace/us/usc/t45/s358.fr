    p ["Pub. L. 100–647, title VII, § 7103(c)" -> "/us/pl/100/647/tVII/s7103/c"] ", Nov. 10, 1988, " ["102 Stat. 3770" -> "/us/stat/102/3770"] ", provided that:"
    quoted "/us/pl/100/647/tVII/s7103/c" {
      p "“The amendments made by this section [amending this section and sections 360 and 361 of this title] shall apply with respect to compensation paid in months beginning after September 30, 1988.”"
