            }
            hash "16a534d22d2c9f17f54f1c2f29934a6e8f2405909af38e33b316aa287ddc9f92"
          }
          provision "/us/usc/t45/s358/a/1/B/iii" clause {
            num "iii" "(iii)"
            heading "5th calendar year"
            chapeau "With respect to compensation paid in calendar year 1992, the contribution rate shall be the smaller of—"
            provision "/us/usc/t45/s358/a/1/B/iii/I" subclause {
              num "I" "(I)"
              content "the maximum contribution limit computed under paragraph (20); or"
              hash "6f2ec8b0255d302eb188342d891f3a08d206430690d4ce82aa8a2666d96408a1"
            }
            provision "/us/usc/t45/s358/a/1/B/iii/II" subclause {
