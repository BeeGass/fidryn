              hash "1c6ccae48729c86ad274f402c33951c492503debf7be6790fb8dbf09d027e43f"
            }
            hash "9f9294aedc0b6deeb74ab45d04ec1341cab985109666963073ec0146284ef7ed"
          }
          provision "/us/usc/t45/s358/a/1/D/iii" clause {
            num "iii" "(iii)"
            heading "3d calendar year"
            chapeau "With respect to compensation paid in calendar months in the third full calendar year in which the employer is subject to the coverage of this chapter, the contribution rate shall be the smaller of—"
            provision "/us/usc/t45/s358/a/1/D/iii/I" subclause {
              num "I" "(I)"
              content "the maximum contribution limit computed under paragraph (20); or"
              hash "6f2ec8b0255d302eb188342d891f3a08d206430690d4ce82aa8a2666d96408a1"
            }
            provision "/us/usc/t45/s358/a/1/D/iii/II" subclause {
