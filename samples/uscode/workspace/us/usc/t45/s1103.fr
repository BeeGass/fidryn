edition 2
module "/us/usc/t45/s1103" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1103" section {
    num "1103" "§ 1103."
    heading "Goals and objectives"
    chapeau "It is the goal of this subtitle to provide Conrail the opportunity to become profitable through the achievement of the following objectives:"
    provision "/us/usc/t45/s1103/1" paragraph {
      num "1" "(1)"
      heading "Nonagreement personnel"
      provision "/us/usc/t45/s1103/1/A" subparagraph {
        num "A" "(A)"
        content "Employees who are not subject to collective bargaining agreements (hereafter in this section referred to as “nonagreement personnel”) should forego wage increases and benefits in an amount proportionately equivalent to the amount foregone by agreement employees pursuant to paragraph (4) of this section, adjusted annually to reflect inflation."
        hash "9598c4aac696c79d6134428a04532b80739e039dd5767f301b96d7588bc89cf3"
      }
      provision "/us/usc/t45/s1103/1/B" subparagraph {
        num "B" "(B)"
        content "After May 1, 1981, the number of nonagreement personnel should be reduced proportionately to any reduction in agreement employees (excluding reductions pursuant to the termination program under " ["section 797a of this title" -> "/us/usc/t45/s797a"] ")."
        hash "63923ea8efdba72de39e1fb6aba795ca2ca8fd819c82856ed15606aea5207a8c"
      }
      hash "a15c16f8fe9deaffa0dbfdcf533b4bd25f6ecfd564614a46233a6ca6e2759b72"
    }
    provision "/us/usc/t45/s1103/2" paragraph {
      num "2" "(2)"
      heading "Suppliers"
      content "To facilitate the orderly movement of goods in interstate commerce, materials and services should continue to be available to Conrail, under normal business practices, including the provision of credit and normal financing arrangements."
      hash "30aa4e14081b4d0a0cf7e057524d053340929dac41d05cca94529cc505db455d"
    }
    provision "/us/usc/t45/s1103/3" paragraph {
      num "3" "(3)"
      heading "Shippers"
      content "Conrail should utilize the revenue opportunities available to it under the Staggers Rail Act of 1980 and subtitle IV of title 49."
      hash "0abff394851b5a7e9a930f7f236d2b5b1c714f31968721dd1794edaab0d746bf"
    }
    provision "/us/usc/t45/s1103/4" paragraph {
      num "4" "(4)"
      heading "Agreement employees"
      provision "/us/usc/t45/s1103/4/A" subparagraph {
        num "A" "(A)"
        content "Conrail should enter into collective bargaining agreements with its employees which would reduce Conrail’s costs in an amount equal to $200,000,000 a year, beginning April 1, 1981, adjusted annually to reflect inflation."
        hash "e727963a3f2b4802706536dbff5a3645bbe2a84ef9643daeed2b9b8f592ea8e7"
      }
      provision "/us/usc/t45/s1103/4/B" subparagraph {
        num "B" "(B)"
        content "Agreements under this subparagraph may provide for reductions in wage increases and for changes in fringe benefits common to agreement employees, including vacations and holidays."
        hash "b1477ae8f35f87a6843e11f9e8a89f6b9c23e2414cec1f81e40456a5d97d2c0d"
      }
      provision "/us/usc/t45/s1103/4/C" subparagraph {
        num "C" "(C)"
        content "The cost reductions required under this subparagraph in the first year of the agreement may be deferred, but the aggregate cost reductions should be no less than an average of $200,000,000 per year for each of the first three one-year periods beginning April 1, 1981."
        hash "8b064c87cd5db2ca7d0d9d0e21b44d54ed3ed22dc8371eb8971800c1668e6e9a"
      }
      provision "/us/usc/t45/s1103/4/D" subparagraph {
        num "D" "(D)"
        content "The amount of cost reductions provided under this paragraph shall be calculated by subtracting the cost of an agreement entered into under this paragraph from (i) the cost that would otherwise result from the application of the national agreement reached by railroad industry and its employees, or (ii) until such national agreement is reached, the cost which the United States Railway Association estimates would result from the application of such a national agreement."
        hash "52506b3516ae51e195707c9f1ef835068561c6f5cbc1fbe69d94040b4dbdedc3"
      }
      hash "ecec75bfcad93b5b7238e798f33d77f4aea5273272318c352dec6d392925931f"
    }
    hash "c0c7fdfedc34afca559d6a61216aa26c319c22ad91c65af126c883e78badcbe0"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1134" -> "/us/pl/97/35/tXI/s1134"] ", Aug. 13, 1981, " ["95 Stat. 645" -> "/us/stat/95/645"] ".)"
  note "/us/usc/t45/s1103/note/editorialNotes/pl.97.35/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This subtitle, referred to in text, is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", known as the Northeast Rail Service Act of 1981. For complete classification of this subtitle to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    p "The Staggers Rail Act of 1980, referred to in par. (3), is " ["Pub. L. 96–448" -> "/us/pl/96/448"] ", Oct. 14, 1980, " ["94 Stat. 1895" -> "/us/stat/94/1895"] ". For complete classification of this Act to the Code, see Short Title of 1980 Amendment note set out under " ["section 10101 of Title 49" -> "/us/usc/t49/s10101"] ", Transportation, and Tables."
    hash "7d78f8cd83ab09766e39aaff5d8505443520dc77f5276382278461cf71b731a5"
  }
  note "/us/usc/t45/s1103/note/statutoryNotes/nolaw/abolition-of-united-states-railway-association-and-transfer" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  layers {
    operative "c0c7fdfedc34afca559d6a61216aa26c319c22ad91c65af126c883e78badcbe0"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "29fd193cc783c94df03ea6e87b382e8420b62b09b0c70c93237d7083532fdc2e"
  }
}
