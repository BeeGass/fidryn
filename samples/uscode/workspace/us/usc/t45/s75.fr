    topic "codification"
    heading "Codification"
    p "Section 75, acts " ["Mar. 3, 1891, ch. 521, § 1" -> "/us/act/1891-03-03/ch521/s1"] ", " ["26 Stat. 833" -> "/us/stat/26/833"] "; " ["May 28, 1928, ch. 824" -> "/us/act/1928-05-28/ch824"] ", " ["45 Stat. 789" -> "/us/stat/45/789"] ", relating to rules as to accommodations for export animals, was transferred to " ["section 466a of Title 46" -> "/us/usc/t46/s466a"] ", Shipping, and subsequently repealed and reenacted as " ["section 3901 of Title 46" -> "/us/usc/t46/s3901"] " by " ["Pub. L. 98–89" -> "/us/pl/98/89"] ", Aug. 26, 1983, " ["97 Stat. 500" -> "/us/stat/97/500"] ". " ["Section 3901 of Title 46" -> "/us/usc/t46/s3901"] " was subsequently repealed by " ["Pub. L. 107–171, title X, § 10418(a)(20)" -> "/us/pl/107/171/tX/s10418/a/20"] ", May 13, 2002, " ["116 Stat. 508" -> "/us/stat/116/508"] "."
    p "Section 76, acts " ["Mar. 3, 1891, ch. 521, § 2" -> "/us/act/1891-03-03/ch521/s2"] ", " ["26 Stat. 833" -> "/us/stat/26/833"] "; " ["May 28, 1928, ch. 824" -> "/us/act/1928-05-28/ch824"] ", " ["45 Stat. 790" -> "/us/stat/45/790"] ", relating to penalties for rule violations, was transferred to " ["section 466b of Title 46" -> "/us/usc/t46/s466b"] ", and subsequently repealed and reenacted as " ["section 3902 of Title 46" -> "/us/usc/t46/s3902"] " by " ["Pub. L. 98–89" -> "/us/pl/98/89"] ", Aug. 26, 1983, " ["97 Stat. 500" -> "/us/stat/97/500"] ". " ["Section 3902 of Title 46" -> "/us/usc/t46/s3902"] " was subsequently repealed by " ["Pub. L. 107–171, title X, § 10418(a)(20)" -> "/us/pl/107/171/tX/s10418/a/20"] ", May 13, 2002, " ["116 Stat. 508" -> "/us/stat/116/508"] "."
