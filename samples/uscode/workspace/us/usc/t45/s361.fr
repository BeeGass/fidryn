    p "Amendment by " ["Pub. L. 93–445" -> "/us/pl/93/445"] " effective Jan. 1, 1975, see " ["section 603 of Pub. L. 93–445" -> "/us/pl/93/445/s603"] ", set out as a note under " ["section 402 of Title 42" -> "/us/usc/t42/s402"] ", The Public Health and Welfare."
    hash "5fa55b4cf8ad1c4e9c627a6cb7ce22c58124f616c18c46e9c5b5749b769ab526"
  }
  note "/us/usc/t45/s361/note/statutoryNotes/pl.85.927/effective-date-of-1958-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1958 Amendment"
    p "Amendment by " ["Pub. L. 85–927" -> "/us/pl/85/927"] " effective Sept. 6, 1958, except as otherwise indicated, see " ["section 207(c) of Pub. L. 85–927" -> "/us/pl/85/927/s207/c"] ", set out as a note under " ["section 351 of this title" -> "/us/usc/t45/s351"] "."
    hash "e5491c4ad18c46a3258951b0ea60b804fb41eaea802bcca74a247d6a7c4a35a8"
  }
  note "/us/usc/t45/s361/note/statutoryNotes/nolaw/effective-date-of-1940-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1940 Amendment"
    p "For effective date of amendment by act Oct. 10, 1940, see section 1 of act Oct. 10, 1940, see note set out under " ["section 351 of this title" -> "/us/usc/t45/s351"] "."
    hash "506a81d8e5a605c788adabaa6ab90004e3807ef46df7075848fbb5e6ec90fc27"
  }
  note "/us/usc/t45/s361/note/execDoc/nolaw/transfer-of-functions" enacted {
    group execDoc
    topic "transferOfFunctions"
    heading "Transfer of Functions"
    p "“Director of the Office of Personnel Management” substituted for “Civil Service Commission” in subsec. (c), pursuant to Reorg. Plan No. 2 of 1978, § 102, 43 F.R. 36037, " ["92 Stat. 3783" -> "/us/stat/92/3783"] ", set out under " ["section 1101 of Title 5" -> "/us/usc/t5/s1101"] ", Government Organization and Employees, which transferred functions vested by statute in United States Civil Service Commission to Director of Office of Personnel Management (except as otherwise specified), effective Jan. 1, 1979, as provided by section 1–102 of Ex. Ord. No. 12107, Dec. 28, 1978, 44 F.R. 1055, set out under " ["section 1101 of Title 5" -> "/us/usc/t5/s1101"] "."
    hash "13f8f6df68fbb1077a3174a474e639ed1bbf5f1fb06f6f98d39df3f871fea4e0"
  }
  layers {
