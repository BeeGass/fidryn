edition 2
module "/us/usc/t45/s728" {
  within "/us/usc/t45/ch16/schII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s728" section {
    num "728" "§ 728."
    heading "Reports to Congress"
    provision "/us/usc/t45/s728/a" subsection {
      num "a" "(a)"
      heading "Progress and evaluation"
      provision "/us/usc/t45/s728/a/1" paragraph {
        num "1" "(1)"
        content "The Association shall prepare and submit to Congress periodic reports on the progress of the Secretary in carrying out the provisions of subchapters II, III, and IV" mark "1" 1 " of this chapter."
        hash "d92bc6f48644abd25f63d35b33dde1dc67fdc4cc380191f9a9995fabaeff92ae"
      }
      provision "/us/usc/t45/s728/a/2" paragraph {
        num "2" "(2)"
        content "Reports submitted under paragraph (1) of this subsection shall also include an evaluation of the performance of the Corporation in order to keep the Congress informed as to matters which may affect the quality of rail service in the Northeast and which may affect the security of Federal funds invested in the Corporation."
        hash "0051be53f641acc210c30c47f36b58b24b707dfa1dcc9bc8134b8246eee7d226"
      }
      hash "ae993f180f72137292bd44aa8717df95bc4e1946efa51c287c661cd8de8abf22"
    }
    provision "/us/usc/t45/s728/b" subsection {
      num "b" "(b)"
      heading "Transfer agreements"
      provision "/us/usc/t45/s728/b/1" paragraph {
        num "1" "(1)"
        content "The Association shall prepare and submit to Congress a final report on the transfer agreements which the Secretary is required to transmit to Congress under section 767 " sup "1" " of this title. Such report shall be submitted on the same date as the Secretary’s transmittal of such agreements to Congress."
        hash "c220b165e3fa8d542b97e27f2c0862e04be7028816308cb7bd64c66571820ced"
      }
      provision "/us/usc/t45/s728/b/2" paragraph {
        num "2" "(2)"
        content "The report submitted under paragraph (1) of this subsection shall include an evaluation of the effect of the transfer agreements on rail service in the Northeast, railroad employees, the economy of the Region, other railroads in the Northeast and elsewhere, and any other matter which the Association considers appropriate. Such report shall also include recommendations with respect to approval, disapproval, or modification of the transfer agreements."
        hash "20372aecd1597a803c1d2cb6826b10b02cf1450d1d12f020341332adcbfa03d8"
      }
      hash "80326bea3cf6d120c92baaa910646090dfd0b4fb8d62b2131f478bcee49dfefb"
    }
    hash "52ad8662c5c1d80fac9bfe5b516696f4f2888a90930f8b37da29b083022c3ce2"
  }
  credit "(" ["Pub. L. 93–236, title II, § 218" -> "/us/pl/93/236/tII/s218"] ", as added " ["Pub. L. 97–35, title XI, § 1150(a)" -> "/us/pl/97/35/tXI/s1150/a"] ", Aug. 13, 1981, " ["95 Stat. 675" -> "/us/stat/95/675"] ".)"
  note "/us/usc/t45/s728/note/editorialNotes/pl.99.509/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Subchapter IV of this chapter, including " ["section 767 of this title" -> "/us/usc/t45/s767"] ", referred to in subsecs. (a)(1) and (b)(1), was repealed by " ["Pub. L. 99–509, title IV, § 4033(a)(1)" -> "/us/pl/99/509/tIV/s4033/a/1"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "."
    hash "14fbcab3c78308b753114243f2c8f46c3cd74e2af13becb55953b3ac5379dbf4"
  }
  note "/us/usc/t45/s728/note/statutoryNotes/pl.97.35/effective-date" enacted {
    group statutoryNotes
    topic "effectiveDate"
    heading "Effective Date"
    p "Section effective Aug. 13, 1981, see " ["section 1169 of Pub. L. 97–35" -> "/us/pl/97/35/s1169"] ", set out as a note under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] "."
    hash "c0941333df7fda0a7e45f1a15726e04b8f5639248b2b6fb747963faa50869950"
  }
  note "/us/usc/t45/s728/note/statutoryNotes/pl.104.66/termination-of-reporting-requirements" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Termination of Reporting Requirements"
    p "For termination, effective May 15, 2000, of provisions of law requiring submittal to Congress of any annual, semiannual, or other regular periodic report listed in House Document No. 103–7 (in which a report required under subsec. (a) of this section is listed as the 9th item on page 195), see " ["section 3003 of Pub. L. 104–66" -> "/us/pl/104/66/s3003"] ", as amended, set out as a note under " ["section 1113 of Title 31" -> "/us/usc/t31/s1113"] ", Money and Finance."
    hash "057e6046c25071d43ce3200cb67ea96678afed5e0a50e2fd6c109fb9ab9a6610"
  }
  note "/us/usc/t45/s728/note/statutoryNotes/nolaw/abolition-of-united-states-railway-association-and-transfer" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "52ad8662c5c1d80fac9bfe5b516696f4f2888a90930f8b37da29b083022c3ce2"
    enacted "0d62674676a371104dbb6e98d26040771595807c838cf9797c1a15d025841e4f"
    editorial "dcfe7bb3a7f7212ee4adcd0fa24d0725a943e97f447a51582875d314529c018e"
  }
}
