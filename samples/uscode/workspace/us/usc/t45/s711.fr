edition 2
module "/us/usc/t45/s711" {
  within "/us/usc/t45/ch16/schII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s711" section {
    num "711" "§ 711."
    heading "Formation and structure"
    provision "/us/usc/t45/s711/a" subsection {
      num "a" "(a)"
      heading "Establishment"
      content "There is established, in accordance with the provisions of this section, an incorporated nonprofit association to be known as the United States Railway Association."
      hash "39abe397881d2f125e90348902b7eb21d71cd784af34688f421cb93e61545b8e"
    }
    provision "/us/usc/t45/s711/b" subsection {
      num "b" "(b)"
      heading "Administration"
      content "The Association shall be directed by a Board of Directors. The individuals designated, pursuant to subsection (d)(2) of this section, as the Government members of such Board shall be deemed the incorporators of the Association and shall take whatever steps are necessary to establish the Association, including filing of articles of incorporation, and serving as an acting Board of Directors for a period of not more than 45 days after the date of incorporation of the Association."
      hash "ef1fff969da7c8979dd0e47123df23276c05034433bed90c3fdba6a4ec52c1c6"
    }
    provision "/us/usc/t45/s711/c" subsection {
      num "c" "(c)"
      heading "Status"
      content "The Association shall be a government corporation of the District of Columbia subject, to the extent not inconsistent with this subchapter, to the District of Columbia Nonprofit Corporation Act. Except as otherwise provided, employees of the Association shall not be deemed employees of the Federal Government. The Association shall have succession until dissolved by Act of Congress, shall maintain its principal office in the District of Columbia, and shall be deemed to be a resident of the District of Columbia with respect to venue in any legal proceeding."
      hash "0a7e1e5123f67f3ca75ea6d74da1579cce366cca903db467979d77664b9cc8dc"
    }
    provision "/us/usc/t45/s711/d" subsection {
      num "d" "(d)"
      heading "Board of Directors"
      provision "/us/usc/t45/s711/d/1" paragraph {
        num "1" "(1)"
        chapeau "The Board of Directors of the Association shall consist of five individuals, as follows:"
        provision "/us/usc/t45/s711/d/1/A" subparagraph {
          num "A" "(A)"
          content "The Chairman, who shall be the individual serving as Chairman on August 13, 1981, until the expiration of his term of office or his resignation, or his replacement, who shall be selected by the outgoing Chairman and the other members of the Board."
          hash "b90367228fca199a0759ee11425b23309a85f122dff1e540cf3e8800b87f6594"
        }
        provision "/us/usc/t45/s711/d/1/B" subparagraph {
          num "B" "(B)"
          content "The Secretary of Transportation."
          hash "30d4f504c74ff40bcc7dc59cba9028c1243c1d1050f8fbef56112da39bb6d4e0"
        }
        provision "/us/usc/t45/s711/d/1/C" subparagraph {
          num "C" "(C)"
          content "The Comptroller General of the United States."
          hash "3d69843480541138fc4971da67f2f5214246449f1a72eb51f3eb47702edf814f"
        }
        provision "/us/usc/t45/s711/d/1/D" subparagraph {
          num "D" "(D)"
          content "The Chairman of the Commission."
          hash "124e9489c9414ebee7bdbafddbb373a92f6cbc9d7ba17338213dacc2e418baa6"
        }
        provision "/us/usc/t45/s711/d/1/E" subparagraph {
          num "E" "(E)"
          content "The Chairman of the Board of Directors of the Corporation."
          hash "08a7665d8a2573be0acc37288fda92d59e49ac27e1cccdde581deeb9cd03f5c7"
        }
        hash "97dca37e25923e08f72835691ae36fc8d9328af076ecfec91641af525c57f7e6"
      }
      provision "/us/usc/t45/s711/d/2" paragraph {
        num "2" "(2)"
        content "The Chairman may not have any employment or other direct financial relationship with any freight railroad. The Chairman shall receive $300 per diem when engaged in the actual performance of his duties plus reimbursement for travel, subsistence, and other necessary expenses incurred in the performance of such duties."
        hash "b42b2cdfb5750487a2badf9e49634aafce10ec3cfb74ac485320f0d994fad707"
      }
      hash "3b03de886a64df64bd76347e42e5dfb20258e11ac63df9b811a17daf93973658"
    }
    provision "/us/usc/t45/s711/e" subsection {
      num "e" "(e)"
      heading "Term of office"
      content "The term of office of the Chairman of the Board of Directors of the Association shall expire on December 31, 1987. The Chairman may be reappointed and the term of the Chairman shall be 3 years."
      hash "9cc5c4f5b5795d6280c1ca77ef1a3a7c0390bdc142052d9e84d2109c668507db"
    }
    provision "/us/usc/t45/s711/f" subsection {
      num "f" "(f)"
      heading "Quorum"
      content "Three members of the Board of Directors, or their representatives, shall constitute a quorum for the transaction of any function of the Association."
      hash "dc6e6e710c982edb1ec005b1bc34adfd48bc2c895ebbec9758074483e3dc407f"
    }
    provision "/us/usc/t45/s711/g" subsection {
      num "g" "(g)"
      heading "Assumption of Finance Committee functions"
      content "The Board of Directors shall, on August 13, 1981, assume the functions previously performed by the Finance Committee."
      hash "24cd92a36f7f7fbd823c84a8f1cf7b2ebd4b48716734c1cfbffc628e82efa47d"
    }
    provision "/us/usc/t45/s711/h" subsection {
      num "h" "(h)"
      heading "Representation at meetings"
      content "The members of the Board of Directors may send representatives to meetings of such Board, and such representatives may exercise full powers of the members."
      hash "26c2747167202c909e1254b83245a06a2545b67ba502d032d8fca9986af8acd7"
    }
    provision "/us/usc/t45/s711/i" subsection {
      num "i" "(i)"
      heading "Miscellaneous" mark "1" 1
      provision "/us/usc/t45/s711/i/1" paragraph {
        num "1" "(1)"
        content "The Association shall have a seal which shall be judicially recognized."
        hash "aa8fc05db653c412b49ac726546e6434bcecb1c01a25686a19aedfd57fdac52d"
      }
      provision "/us/usc/t45/s711/i/2" paragraph {
        num "2" "(2)"
        content "The Administrator of General Services shall furnish the Association with such offices, equipment, supplies, and services as he is authorized to furnish to any other agency or instrumentality of the United States."
        hash "13c702f3cc673912f40da4dd35e630fe418c855baf0d87c97660a7ff6b7edb4b"
      }
      provision "/us/usc/t45/s711/i/3" paragraph {
        num "3" "(3)"
        content "The Secretary is authorized to transfer to the Association or the Corporation rights in intellectual property which are directly related to the conduct of the functions of the Association or the Corporation, to the extent that the Federal Government has such rights and to the extent that transfer is necessary to carry out the purposes of this chapter."
        hash "e20b6cf91223f83731792362fc719bf0cbeaf238e6182830237b73653ac97193"
      }
      provision "/us/usc/t45/s711/i/4" paragraph {
        num "4" "(4)"
        content "Any reference in this chapter to the Chairman of the Commission is to the Chairman of the Commission or the person who is at the time performing the duties of the Chairman of the Commission in accordance with law."
        hash "b7d4c830e77ab2f352799a339c036e0e6a7438ca6334f77d55841a8bc7821983"
      }
      hash "91852e13091526321fbe7a2ae26333fafe681a3442fef2e42109910748d7d18a"
    }
    provision "/us/usc/t45/s711/j" subsection {
      num "j" "(j)"
      heading "Use of names " sup "1"
      content "No person, except the Association, shall hereafter use the words “United States Railway Association” as a name for any business purpose. Violations of this provision may be enjoined by any court of general jurisdiction in an action commenced by the Association. In any such action, the Association may recover any actual damages flowing from such violation, and, in addition, shall be entitled to punitive damages (regardless of the existence or nonexistence of actual damage) in an amount not to exceed $100 for each day during which such violation was committed. The district courts of the United States shall have jurisdiction over actions brought under this subsection, without regard to the amount in controversy or the citizenship of the parties."
      hash "31492f1fd8e4a6f147e575d446989ebb02593e8455a7fabf45253c6e489762f9"
    }
    hash "60e2980e2a45d3507e4b3d1f3fe3badc0cbef82a66fdca02dc221110fb404c57"
  }
  credit "(" ["Pub. L. 93–236, title II, § 201" -> "/us/pl/93/236/tII/s201"] ", Jan. 2, 1974, " ["87 Stat. 988" -> "/us/stat/87/988"] "; " ["Pub. L. 94–210, title VI" -> "/us/pl/94/210/tVI"] ", §§ 603(a), (b), 607(a), 612(j)(2), Feb. 5, 1976, " ["90 Stat. 88" -> "/us/stat/90/88"] ", 96, 109; " ["Pub. L. 94–555, title II, § 211(b)" -> "/us/pl/94/555/tII/s211/b"] "–(e), Oct. 19, 1976, " ["90 Stat. 2624" -> "/us/stat/90/2624"] "; " ["Pub. L. 95–611, § 2" -> "/us/pl/95/611/s2"] ", Nov. 8, 1978, " ["92 Stat. 3089" -> "/us/stat/92/3089"] "; " ["Pub. L. 96–448, title V, § 508(c)" -> "/us/pl/96/448/tV/s508/c"] ", Oct. 14, 1980, " ["94 Stat. 1957" -> "/us/stat/94/1957"] "; " ["Pub. L. 97–35, title XI, § 1147" -> "/us/pl/97/35/tXI/s1147"] ", Aug. 13, 1981, " ["95 Stat. 673" -> "/us/stat/95/673"] "; " ["Pub. L. 98–181, title II, § 2003(c)(1)" -> "/us/pl/98/181/tII/s2003/c/1"] ", Nov. 30, 1983, " ["97 Stat. 1297" -> "/us/stat/97/1297"] "; " ["Pub. L. 99–190, § 101(e) [title III, § 332]" -> "/us/pl/99/190/s101/e/tIII/s332"] ", Dec. 19, 1985, " ["99 Stat. 1267" -> "/us/stat/99/1267"] ", 1290.)"
  note "/us/usc/t45/s711/note/editorialNotes/pl.87.569/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The District of Columbia Nonprofit Corporation Act, referred to in subsec. (c), is " ["Pub. L. 87–569" -> "/us/pl/87/569"] ", Aug. 6, 1962, " ["76 Stat. 265" -> "/us/stat/76/265"] ", which is not classified to the Code."
    hash "1b4c04fc054dccbe12357ee2f83f3d0f9312c5ef04a88d47d08b58ccd6fcab68"
  }
  note "/us/usc/t45/s711/note/editorialNotes/pl.97.35/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p ["Section 1147 of Pub. L. 97–35" -> "/us/pl/97/35/s1147"] " directed that subsecs. (d) to (i) be struck out and replaced by new subsecs. (d) to (h), and that subsecs. (j) and (k) be redesignated (g) and (h), respectively. Because a literal execution of the amendment would result in two subsections designated (g) and two subsections designated (h), and to reflect the probable intent of Congress, subsecs. (j) and (k) have been editorially redesignated (i) and (j), respectively."
    hash "c1af091dee77e5c10b383eda8e8477493b896b6b3111f3b2c244f2646d378b8c"
  }
  note "/us/usc/t45/s711/note/editorialNotes/pl.99.190/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1985—Subsec. (d)(2). " ["Pub. L. 99–190, § 101(e) [title III, § 332(1)]" -> "/us/pl/99/190/s101/e/tIII/s332/1"] ", inserted “freight” before “railroad”."
    p "Subsec. (e). " ["Pub. L. 99–190, § 101(e) [title III, § 332(2)]" -> "/us/pl/99/190/s101/e/tIII/s332/2"] ", substituted “1987” for “1985”."
    p "1983—Subsec. (e). " ["Pub. L. 98–181" -> "/us/pl/98/181"] " substituted “1985” for “1983”."
    p "1981—Subsec. (d). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions respecting a five-member board for provisions respecting an eleven-member board."
    p "Subsec. (e). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions respecting term of office and reappointment of Chairman for provisions respecting term of office of Chairman and nongovernmental members, reappointment of members, and vacancies."
    p "Subsec. (f). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions respecting three-member quorum requirement for provisions respecting six-member quorum requirement."
    p "Subsec. (g). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions relating to assumption of Finance Committee functions for provisions relating to appointment of the President of the Association. See Codification note above."
    p "Subsec. (h). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " substituted provisions relating to representation at meetings for provisions relating to the executive committee of the Board of Directors. See Codification note above."
    p "Subsec. (i). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " redesignated subsec. (j) as (i). Former subsec. (i), which related to membership, functions, etc., of the Finance Committee, was struck out. See Codification note above."
    p "Subsecs. (j), (k). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " redesignated former subsecs. (j) relating to miscellaneous provisions, and (k) relating to use of names, as (i) and (j), respectively. See Codification note above."
    p "1980—Subsec. (d)(2). " ["Pub. L. 96–448, § 508(c)(1)" -> "/us/pl/96/448/s508/c/1"] ", inserted provision authorizing Secretary of Transportation to act directly or through the General Counsel of Department of Transportation, the Federal Railroad Administrator, or the Deputy Administrator of the Federal Railroad Administration and substituted provision authorizing Secretary of the Treasury to act directly or through an officer of Department of the Treasury who has been appointed with the advice and consent of the Senate for provision authorizing Secretary of the Treasury to act directly or through Deputy Secretary of the Treasury."
    p "Subsec. (i). " ["Pub. L. 96–448, § 508(c)(2)" -> "/us/pl/96/448/s508/c/2"] ", substituted “in the case of the Secretary, through the Deputy Secretary of Transportation, the General Counsel of the Department of Transportation, the Federal Railroad Administrator, or the Deputy Administrator of the Federal Railroad Administration, and, in the case of the Secretary of the Treasury, through an officer of the Department of the Treasury who has been appointed with the advice and consent of the Senate” for “through their respective Deputy Secretaries”."
    p "Subsec. (j)(4). " ["Pub. L. 96–448, § 508(c)(3)" -> "/us/pl/96/448/s508/c/3"] ", struck out provision that any reference in this chapter to Secretary of the Treasury is to Secretary of the Treasury or person who is at time performing duties of the Office of Secretary of the Treasury or, in his absence, Deputy Secretary of the Treasury."
    p "1978—Subsec. (e). " ["Pub. L. 95–611" -> "/us/pl/95/611"] " inserted provision that members of Board shall continue to serve until their successors have been appointed and qualified."
    p "1976—Subsec. (d)(2). " ["Pub. L. 94–555, § 211(b)" -> "/us/pl/94/555/s211/b"] ", substituted “the Deputy Secretary of Transportation, the Vice Chairman of the Commission, or the Deputy Secretary of the Treasury, as the case may be” for “their duly authorized representatives” after “at any time through”."
    p ["Pub. L. 94–210, § 603(b)(2)" -> "/us/pl/94/210/s603/b/2"] ", substituted “acting directly or at any time through” for “or”."
    p "Subsec. (h). " ["Pub. L. 94–555, § 211(c)" -> "/us/pl/94/555/s211/c"] ", struck out “The Secretary and the Chairman of the Commission may act in such capacity directly or at any time through their duly authorized representatives” after “members of the Board”."
    p ["Pub. L. 94–210, § 603(b)(1)" -> "/us/pl/94/210/s603/b/1"] ", inserted provision authorizing Secretary and Chairman to act directly or through their duly authorized representatives."
    p "Subsec. (i). " ["Pub. L. 94–555, § 211(d)" -> "/us/pl/94/555/s211/d"] ", substituted “Deputy Secretaries” for “duly authorized representatives” after “through their respective”."
    p ["Pub. L. 94–210, § 603(a)" -> "/us/pl/94/210/s603/a"] ", added subsec. (i). Former subsec. (i) redesignated (j)."
    p "Subsec. (j). " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", §§ 603(a), 607(a), redesignated former subsec. (i) as (j) and added par. (4). Former subsec. (j) redesignated (k)."
    p "Subsec. (j)(4). " ["Pub. L. 94–555, § 211(e)" -> "/us/pl/94/555/s211/e"] ", inserted “who is” after “Treasury or the person” and “Commission or the person”, and substituted “in his absence, the Deputy Secretary of the Treasury” for “the duly authorized representatives of either of them” after “Treasury in accordance with law”."
    p "Subsec. (k). " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", §§ 603(a), 612(j)(2), redesignated former subsec. (j) as (k), substituted “this provision” for “these provisions”, and struck out “or the Corporation” after “Association” in two places and provisions relating to use of “Consolidated Rail Corporation” as a name for any business purpose."
    hash "85c50c96464b1402c3a1c940f29ece60e5925f62ebf516897f6d465cd26d932a"
  }
  note "/us/usc/t45/s711/note/statutoryNotes/pl.97.35/effective-date-of-1981-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1981 Amendment"
    p "Amendment by " ["Pub. L. 97–35" -> "/us/pl/97/35"] " effective Aug. 13, 1981, see " ["section 1169 of Pub. L. 97–35" -> "/us/pl/97/35/s1169"] ", set out as an Effective Date note under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] "."
    hash "ce7dcc740f9bc75628da6da8e14fc1eb7bee2a77c67bd18e04c70e99f0b41d10"
  }
  note "/us/usc/t45/s711/note/statutoryNotes/pl.96.448/effective-date-of-1980-amendment" enacted {
