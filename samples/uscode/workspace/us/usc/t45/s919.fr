edition 2
module "/us/usc/t45/s919" {
  within "/us/usc/t45/ch18"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s919" section {
    num "919" "§ 919."
    heading "Publications and reports"
    provision "/us/usc/t45/s919/a" subsection {
      num "a" "(a)"
      content "Within 30 days after November 4, 1979, the Board shall publish, and make available for distribution by the Milwaukee Railroad to all its employees, a document which describes in detail the rights of such employees under sections 907, 908, 909, 910," mark "1" 1 " and 911 of this title."
      hash "a45793b75a37106df3fcf6879a7f39803854b247046ffc3f9c9d987b5b15c702"
    }
    provision "/us/usc/t45/s919/b" subsection {
      num "b" "(b)"
      content "During the 2-year period beginning on November 4, 1979, the Board shall submit a report to the Congress every 6 months describing its activities under this chapter."
      hash "2b6de6e5a4eb9228af5e2f6f4ba1d02d8de8a785b5eba458418585b3ed750492"
    }
    hash "4e4d8b93cd7ac8f7577f40fab2fdee577ef1a9fa10aafba0f9bbe7672f31b478"
  }
  credit "(" ["Pub. L. 96–101, § 21" -> "/us/pl/96/101/s21"] ", Nov. 4, 1979, " ["93 Stat. 746" -> "/us/stat/93/746"] ".)"
  note "/us/usc/t45/s919/note/editorialNotes/pl.96.101/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 909 of this title" -> "/us/usc/t45/s909"] ", referred to in subsec. (a), was in the original “section 10”, meaning " ["section 10 of Pub. L. 96–101" -> "/us/pl/96/101/s10"] ", Nov. 4, 1979, " ["93 Stat. 741" -> "/us/stat/93/741"] ". Subsecs. (a) to (g) of section 10 are classified to " ["section 909 of this title" -> "/us/usc/t45/s909"] ". Subsec. (h) of section 10 amended " ["section 231f(b)(7) of this title" -> "/us/usc/t45/s231f/b/7"] "."
    p ["Section 910 of this title" -> "/us/usc/t45/s910"] ", referred to in subsec. (a), was repealed by " ["Pub. L. 97–35, title XI, § 1144(b)" -> "/us/pl/97/35/tXI/s1144/b"] ", Aug. 13, 1981, " ["95 Stat. 669" -> "/us/stat/95/669"] "."
    hash "fdbd1f48dcc802abab8ff5c44bc0f6b6b01b1056b1d5b72801bbd143e2cf0417"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
