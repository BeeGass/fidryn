edition 2
module "/us/usc/t45/s746" {
  within "/us/usc/t45/ch16/schIII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s746" section {
    num "746" "§ 746."
    heading "Certificates of value"
    provision "/us/usc/t45/s746/a" subsection {
      num "a" "(a)"
      heading "General"
      content "On the date when the Corporation is required to deposit securities with the special court pursuant to " ["section 743(a)(1) of this title" -> "/us/usc/t45/s743/a/1"] ", the Association shall deposit with the special court the certificates of value of the Association required by this section. The Secretary shall guarantee the payment of all certificates of value delivered in accordance with this subchapter. All guarantees entered by the Secretary under this section shall constitute general obligations of the United States of America for the payment or redemption of which its full faith and credit are pledged. Such guarantees shall be valid and incontestable except as to mutual mistake of fact or as to fraud or material misrepresentation by the holder of such certificates or the transferor of rail properties to which certificates of value of any series so guaranteed are issued."
      hash "aad8080245233cf8bb4a629e20402c44b6b5468bbc5be0df1f9e1303a7a39c4e"
    }
    provision "/us/usc/t45/s746/b" subsection {
      num "b" "(b)"
      heading "Number and distribution"
      content "A separate series of certificates of value shall be issued to each railroad in reorganization in the region and each person leased, operated, or controlled by such a railroad that transfers rail properties to the Corporation or a subsidiary thereof. The number of certificates of value of each series to be deposited pursuant to subsection (a) shall be equal to the number of shares of series B preferred stock of the Corporation which are required to be deposited by the Corporation with the special court, pursuant to " ["section 743(a)(1) of this title" -> "/us/usc/t45/s743/a/1"] " in exchange for the rail properties transferred to the Corporation or a subsidiary thereof by such transferor. Certificates of value of the appropriate series shall be distributed by the special court, pursuant to " ["section 743(c)(4) of this title" -> "/us/usc/t45/s743/c/4"] ", at the same time to the same transferors, and in the same numbers of units as shares of such series B preferred stock are distributed to such transferor."
      hash "ab57627e368d4c51c19e66ef8417b4400b9acb7ff23f559f60e8a1b27f488f70"
    }
    provision "/us/usc/t45/s746/c" subsection {
      num "c" "(c)"
      heading "Redemption"
      provision "/us/usc/t45/s746/c/1" paragraph {
        num "1" "(1)"
        content "Certificates of value, of any series, shall be redeemed by the Association on December 31, 1987, or on such earlier date as the Board of Directors of the Association and the Finance Committee jointly may determine and specify."
        hash "3705c642b9152bced6d4135d10ce5684a6966a640376bc60cdcf5aa7321451a9"
      }
      provision "/us/usc/t45/s746/c/2" paragraph {
        num "2" "(2)"
        chapeau "Each certificate of value of each series shall be redeemable for an amount, payable in cash, equal to its base value on the redemption date, minus—"
        provision "/us/usc/t45/s746/c/2/A" subparagraph {
          num "A" "(A)"
          content "the sum of the fair market value of the series B preferred stock applicable to such certificate, the fair market value of the common stock applicable to such certificate, and all cash dividends theretofore paid on any such series B preferred stock and on any such common stock; and"
          hash "c1b26f776b16effd61a982f1197af0d50e7f16ecefcd1e9d9bdb860d5f633c20"
        }
        provision "/us/usc/t45/s746/c/2/B" subparagraph {
          num "B" "(B)"
          content "any sums paid to a transferor of rail properties to whom such series of certificates of value was issued resulting from sales or leases by the Corporation of properties transferred to it by such transferor divided by the number of certificates of value distributed to such transferor."
          hash "e77b444295e4aaa4e41c82c820f6fdcd79c88b6554e682558bb697efa6189e69"
        }
        hash "c3c8b0ab68181c52921516175bb7abaf253e8f009261812175ca6e9fc1ef0c11"
      }
      provision "/us/usc/t45/s746/c/3" paragraph {
        num "3" "(3)"
        chapeau "The number of shares of series B preferred stock and common stock applicable to each certificate of value of any series, pursuant to paragraph (2) of this subsection, shall be—"
        provision "/us/usc/t45/s746/c/3/A" subparagraph {
          num "A" "(A)"
          content "one share of series B preferred stock (adjusted to reflect any stock splits, stock combinations, reclassifications or similar transactions affecting the number of shares of outstanding series B preferred stock following the date of distribution pursuant to " ["section 743(c)(4) of this title" -> "/us/usc/t45/s743/c/4"] "); and"
          hash "c78691f5046f44328a37b3cc9c81f8a1a07af43f0d621468b5563ad0c328f325"
        }
        provision "/us/usc/t45/s746/c/3/B" subparagraph {
          num "B" "(B)"
          content "the number of shares of common stock determined by dividing the total number of shares of common stock distributed pursuant to " ["section 743(c)(4) of this title" -> "/us/usc/t45/s743/c/4"] " to the transferor receiving such series of certificates of value (adjusted to reflect any stock splits, stock combinations, reclassifications, or similar transactions affecting the number of shares of outstanding common stock following the date of distribution pursuant to " ["section 743(c)(4) of this title" -> "/us/usc/t45/s743/c/4"] ") by the total number of certificates of value in the series so distributed to such transferor."
          hash "33eb5e4ad3d9a590bf1252340f6d8e1db46d95f07fa89f390ac387673f34abd7"
        }
        hash "47072fbc4dda7eb13c9916173fbfd205bad4fbc79f7128dfa16e12878a100c93"
      }
      provision "/us/usc/t45/s746/c/4" paragraph {
        num "4" "(4)"
        content "The base value of each certificate of value of any series shall be the value obtained by (A) taking the net liquidation value, as determined by the special court, to which the transferor to whom such series of certificates of value is issued is entitled by virtue of transfers of rail properties, under " ["section 743(b)(1) of this title" -> "/us/usc/t45/s743/b/1"] " to the Corporation or a subsidiary thereof; (B) subtracting the value of other benefits provided under this chapter, as determined by the special court; (C) adding such amount, if any, as the special court may determine shall be required after taking into consideration compensable unconstitutional erosion, if any, in the estate of a railroad in reorganization, or of a railroad leased, operated, or controlled by such a railroad, which the special court finds to have occurred during any bankruptcy proceeding with respect to such railroad; (D) adding interest from the transfer date to the redemption date to be compounded annually at a rate of 8 percent per annum; and (E) dividing the resulting value by the number of certificates of value of such series distributed to such transferor. In determining such base value, the special court shall give due weight and consideration to the finding of the Association as to the net liquidation value to which each transferor is entitled by virtue of conveyances of rail properties under " ["section 743(b)(1) of this title" -> "/us/usc/t45/s743/b/1"] ". For purposes of this paragraph, the term “rail properties” includes all rights with respect to employee benefit plans transferred and assigned to the Corporation pursuant to " ["section 743(b)(6) of this title" -> "/us/usc/t45/s743/b/6"] ". Net liquidation value with respect to such rights shall be determined after taking into account all obligations finally transferred or assigned to the Corporation pursuant to such section."
        hash "5ace66921141ced08d2f30b7a46d23c821d5b6bc67200539912c660023a5ed4e"
      }
      provision "/us/usc/t45/s746/c/5" paragraph {
        num "5" "(5)"
        content "The fair market value of series B preferred stock and of common stock of the Corporation shall be determined in accordance with regulations prescribed by the Association, on the basis of the average price of each such security in the primary established market in which such securities are traded over a period of 120 consecutive trading days ending not less than 20 nor more than 40 trading days preceding the redemption date, or, in the case of a security for which there is not an established trading market, on the basis of the fair market value thereof as determined by the majority vote of three experts in the valuation of securities, one to be selected by the Association, one to be selected by the directors of the Corporation elected by the holders of the security to be valued, and one to be selected by the two first selected."
        hash "a1f8ff66a2e21d1f28ac3f3d09f3574adead415284c5ea309ff97b8a292278e2"
      }
      hash "ab85d5bb9f1e03fa4ca8cac99526483d47d4b6d38772b097b9c169d7447d939c"
    }
    provision "/us/usc/t45/s746/d" subsection {
      num "d" "(d)"
      heading "Authorization of appropriations"
      content "There are authorized to be appropriated to the Secretary such sums as are necessary to discharge the obligations of the United States arising under this section."
      hash "d91ae23d2d9f50c71d2d9415b721332986a20fd274806bce3fa4091f96263adb"
    }
    hash "0763a090d770911343bb51bb37ccb278e2d7d78ad00a72c68e03f151d09f821d"
  }
  credit "(" ["Pub. L. 93–236, title III, § 306" -> "/us/pl/93/236/tIII/s306"] ", as added " ["Pub. L. 94–210, title VI, § 610(b)" -> "/us/pl/94/210/tVI/s610/b"] ", Feb. 5, 1976, " ["90 Stat. 104" -> "/us/stat/90/104"] "; amended " ["Pub. L. 94–248" -> "/us/pl/94/248"] ", §§ 2, 3, Mar. 25, 1976, " ["90 Stat. 286" -> "/us/stat/90/286"] ".)"
  note "/us/usc/t45/s746/note/editorialNotes/pl.94.248/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1976—Subsec. (c)(3)(A). " ["Pub. L. 94–248, § 2" -> "/us/pl/94/248/s2"] ", substituted “adjusted to reflect” for “without regard to”."
    p "Subsec. (c)(3)(B). " ["Pub. L. 94–248, § 3" -> "/us/pl/94/248/s3"] ", inserted provisions relating to adjustment of number of shares of common stock to reflect any stock splits, stock combinations, etc."
    hash "03fb793746151d50d658104b1bd94c4a9d380d317b58efabba2eb3b796ad86dc"
  }
  note "/us/usc/t45/s746/note/statutoryNotes/nolaw/abolition-of-special-court-regional-rail-reorganization-act" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Special Court, Regional Rail Reorganization Act of 1973, and Transfer of Functions"
    p "Special court abolished and all jurisdiction and functions transferred to United States District Court for District of Columbia, see " ["section 719(b)(2) of this title" -> "/us/usc/t45/s719/b/2"] "."
    hash "b36896cd25152a2ad11f070c8b08b800c6cb73145cec88413adfe814d660133f"
  }
  note "/us/usc/t45/s746/note/statutoryNotes/nolaw/abolition-of-united-states-railway-association-and-transfer" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  note "/us/usc/t45/s746/note/statutoryNotes/pl.94.210/applicability-of-national-environmental-policy-act" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Applicability of National Environmental Policy Act"
    p "Application of National Environmental Policy Act to actions of Commission not affected by title VI of " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", see " ["section 619 of Pub. L. 94–210" -> "/us/pl/94/210/s619"] ", set out as a note under " ["section 791 of this title" -> "/us/usc/t45/s791"] "."
    hash "7ce373698c822f6cf7cb1f07e93f5e378a6239d819a9e93ab08ae9f21b104a45"
  }
  layers {
    operative "0763a090d770911343bb51bb37ccb278e2d7d78ad00a72c68e03f151d09f821d"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "4828b88ed8edea63a0b8aa6a97edc417bf181d76155733e9f0b6ba76fa7cb2a9"
  }
}
