edition 2
module "/us/usc/t45/s802" {
  within "/us/usc/t45/ch17/schI"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s802" section {
    num "802" "§ 802."
    heading "Definitions"
    chapeau "As used in this Act, unless the context otherwise indicates, the term—"
    provision "/us/usc/t45/s802/1" paragraph {
      num "1" "(1)"
      content "“Association” means the United States Railway Association;"
      hash "37055b0d2d62fc14f3ba15f2cc23522a2b73a8b84bd5c5f5709d7cdec6794a98"
    }
    provision "/us/usc/t45/s802/2" paragraph {
      num "2" "(2)"
      content "“Commission” means the Interstate Commerce Commission;"
      hash "c56111dfa3a2bc6d8b19f8f87df64caf5b72035aa82b8692ac281dc0d8595164"
    }
    provision "/us/usc/t45/s802/3" paragraph {
      num "3" "(3)"
      content "“Corporation” means the Consolidated Rail Corporation;"
      hash "84a0cb391a755c47b1f9e545a2677e7e7a632438f23e93ddb3cad49d02d87c75"
    }
    provision "/us/usc/t45/s802/4" paragraph {
      num "4" "(4)"
      content "“final system plan” means the final system plan and any additions thereto adopted by the Association pursuant to the Regional Rail Reorganization Act of 1973 (" ["45 U.S.C. 701" -> "/us/usc/t45/s701"] " et seq.);"
      hash "bcb69831f450aee7454cde4504a71200f002316cb4a5245dcbbbebac788153e1"
    }
    provision "/us/usc/t45/s802/5" paragraph {
      num "5" "(5)"
      content "“includes” and variants thereof should be read as if the phrase “but is not limited to” were also set forth;"
      hash "14aca450a4d83901ce2b05517d5d524b60ea785af15d9a895aaecbac48353f78"
    }
    provision "/us/usc/t45/s802/6" paragraph {
      num "6" "(6)"
      content "“Office” means the Rail Services Planning Office of the Commission;"
      hash "68068113e78dfea0d7e8c4ddb3d9f0c64ca012fc4b600eacc20033247f072235"
    }
    provision "/us/usc/t45/s802/7" paragraph {
      num "7" "(7)"
      content "“railroad” has the meaning given that term in " ["section 20102 of title 49" -> "/us/usc/t49/s20102"] "; and"
      hash "529bbb490531ed10310972ac367098d0dfb3b3fcd940f9d750aced68d10d50a0"
    }
    provision "/us/usc/t45/s802/8" paragraph {
      num "8" "(8)"
      content "“Secretary” means the Secretary of Transportation or his designated representative."
      hash "f90e269ce7358cd997177477fd14b96d83bcf69b1670c34adf017439f33f4083"
    }
    hash "12ddd7671d968dc6860d57d9823f6781f9f65fc9d31ada58b0c820f7c7eb95c6"
  }
  credit "(" ["Pub. L. 94–210, title I, § 102" -> "/us/pl/94/210/tI/s102"] ", Feb. 5, 1976, " ["90 Stat. 33" -> "/us/stat/90/33"] "; " ["Pub. L. 97–468, title VI, § 615(b)(2)" -> "/us/pl/97/468/tVI/s615/b/2"] ", Jan. 14, 1983, " ["96 Stat. 2578" -> "/us/stat/96/2578"] "; " ["Pub. L. 104–88, title III, § 330(1)" -> "/us/pl/104/88/tIII/s330/1"] ", Dec. 29, 1995, " ["109 Stat. 953" -> "/us/stat/109/953"] "; " ["Pub. L. 109–59, title IX, § 9003(a)" -> "/us/pl/109/59/tIX/s9003/a"] ", Aug. 10, 2005, " ["119 Stat. 1921" -> "/us/stat/119/1921"] ".)"
  note "/us/usc/t45/s802/note/editorialNotes/pl.94.210/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This Act, referred to in text, means " ["Pub. L. 94–210" -> "/us/pl/94/210"] ", Feb. 5, 1976, " ["90 Stat. 31" -> "/us/stat/90/31"] ", known as the Railroad Revitalization and Regulatory Reform Act of 1976. For complete classification of this Act to the Code, see Short Title note set out under " ["section 801 of this title" -> "/us/usc/t45/s801"] " and Tables."
    p "The Regional Rail Reorganization Act of 1973, referred to in par. (4), is " ["Pub. L. 93–236" -> "/us/pl/93/236"] ", Jan. 2, 1974, " ["87 Stat. 985" -> "/us/stat/87/985"] ", which is classified principally to chapter 16 (§ 701 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 701 of this title" -> "/us/usc/t45/s701"] " and Tables."
    hash "6e52c5ddf9ccb613e4a86f12b2985492acd42f0e57e183a7e1e1a964c88fb4fe"
  }
  note "/us/usc/t45/s802/note/editorialNotes/pl.109.59/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2005—Par. (7). " ["Pub. L. 109–59" -> "/us/pl/109/59"] " amended par. (7) generally. Prior to amendment, par. (7) read as follows: “ ‘railroad’ means a rail carrier subject to part A of subtitle IV of title 49, and includes the National Railroad Passenger Corporation; and”."
    p "1995—Par. (7). " ["Pub. L. 104–88" -> "/us/pl/104/88"] " substituted “rail carrier subject to part A of subtitle IV of title 49” for “common carrier by railroad or express, as defined in section 1(3) of the Interstate Commerce Act (" ["49 U.S.C. 1(3)" -> "/us/usc/t49/s1/3"] ")”."
    p "1983—Par. (7). " ["Pub. L. 97–468" -> "/us/pl/97/468"] " struck out “and the Alaska Railroad” before the semicolon at end."
    hash "03e45011d853e5e91c2cf318eb2be69af75e1b8bff5fa0e3fa08aed4402d1ad4"
  }
  note "/us/usc/t45/s802/note/statutoryNotes/pl.104.88/effective-date-of-1995-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1995 Amendment"
    p "Amendment by " ["Pub. L. 104–88" -> "/us/pl/104/88"] " effective Jan. 1, 1996, see " ["section 2 of Pub. L. 104–88" -> "/us/pl/104/88/s2"] ", set out as an Effective Date note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ", Transportation."
    hash "16eb732b92d6b0fd94d8511c067f9406d87d2ddd14f399f38f5802eaed297332"
  }
  note "/us/usc/t45/s802/note/statutoryNotes/pl.97.468/effective-date-of-1983-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1983 Amendment"
    p "Amendment by " ["Pub. L. 97–468" -> "/us/pl/97/468"] " effective on date of transfer of Alaska Railroad to the State [Jan. 5, 1985], pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] ", see " ["section 615(b) of Pub. L. 97–468" -> "/us/pl/97/468/s615/b"] "."
    hash "2876b836327b157f1cdd0809933ff8b311052cab10a5367a628a87654edc2c29"
  }
  note "/us/usc/t45/s802/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  note "/us/usc/t45/s802/note/statutoryNotes/nolaw/abolition-of-united-states-railway-association-and-transfer" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  definition "/us/usc/t45/s802/1" {
    term "Association"
    kind means
    words "As used in this Act, unless the context otherwise indicates"
    basis unresolved
  }
