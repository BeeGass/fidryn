edition 2
module "/us/usc/t45/s908" {
  within "/us/usc/t45/ch18"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s908" section {
    num "908" "§ 908."
    heading "Employee protection agreements"
    provision "/us/usc/t45/s908/a" subsection {
      num "a" "(a)"
      heading "Agreement between Milwaukee Railroad and labor organizations"
      content "The Milwaukee Railroad and labor organizations representing the employees of such railroad may, not later than 20 days after November 4, 1979, enter into an agreement providing protection for employees of such railroad who are adversely affected as a result of a reduction in service by such railroad or a restructuring transaction carried out by such railroad. Such employee protection may include, but need not be limited to, interim employee assistance, moving expenses, employee relocation incentive compensation, and separation allowances."
      hash "776c47ede82a6a4b22b7fa581ce6fd1fa941be7b5f007d05f612b936a48e4c0d"
    }
    provision "/us/usc/t45/s908/b" subsection {
      num "b" "(b)"
      heading "Submission of matter to National Mediation Board"
      content "If the Milwaukee Railroad and the labor organizations representing the employees of such railroad are unable to enter into an employee protection agreement under subsection (a) of this section within 20 days after November 4, 1979, the parties shall immediately submit the matter to the National Mediation Board. The National Mediation Board shall attempt, by mediation, to bring the parties to an agreement with respect to employee protection no later than 40 days after November 4, 1979."
      hash "b4020580418330b0f4f1dfaf63b245f72dc04e238a0d265bfc9a1aff40ced988"
    }
    provision "/us/usc/t45/s908/c" subsection {
      num "c" "(c)"
      heading "Fair and equitable agreements"
      provision "/us/usc/t45/s908/c/1" paragraph {
        num "1" "(1)"
        content "If the National Mediation Board is unable to bring the parties to an agreement under subsection (b) of this section within 40 days after November 4, 1979, the Milwaukee Railroad and the labor organizations representing the employees of such railroad shall immediately enter into an employee protection agreement that is fair and equitable."
        hash "d74cc2c81d779bc72285bb9716361a0d497ecf720798d6ef2d95a05503bd5e05"
      }
      provision "/us/usc/t45/s908/c/2" paragraph {
        num "2" "(2)"
        content "If an employee protection agreement is entered into under this subsection, any claim of an employee for benefits and allowances under such agreement shall be filed with the Board in such time and manner as the Board by regulation shall prescribe. The Board shall determine the amount for which such employee is eligible under such agreement and shall certify such amount to the Milwaukee Railroad for payment."
        hash "a27aeb18a88c604f2883c7a05c7bf27b46c2ec95905c4053d4e4f6a5535e74da"
      }
      hash "1d98855526f8bb636ff8c41fcabdc971e4479d37a46b5870d573d1ed89a29ff4"
    }
    provision "/us/usc/t45/s908/d" subsection {
      num "d" "(d)"
      heading "Payment of benefits and allowances"
      content "Benefits and allowances under an employee protection agreement entered into under this section shall be paid by the Milwaukee Railroad in accordance with " ["section 914 of this title" -> "/us/usc/t45/s914"] ", and claims of employees for such benefits and allowances shall be treated as administrative expenses of the estate of the Milwaukee Railroad."
      hash "b50903ec4a1dd3fdaeac906e4dfe6c0aa2342a54fba59595b24d5620124afc1a"
    }
    hash "a13d66fc094dd9cf133943d6621ac388b911282c37904bfcbb33ad7c1c6547e0"
  }
  credit "(" ["Pub. L. 96–101, § 9" -> "/us/pl/96/101/s9"] ", Nov. 4, 1979, " ["93 Stat. 741" -> "/us/stat/93/741"] ".)"
  layers {
    operative "a13d66fc094dd9cf133943d6621ac388b911282c37904bfcbb33ad7c1c6547e0"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "8bc6b59aa998a533d2a2be9e5535cf3054c866c89e12254f7e62e9dedeea07fd"
  }
}
