edition 2
module "/us/usc/t45/s404" {
  within "/us/usc/t45/ch12"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s404" section {
    num "404" "§ 404."
    heading "Temporary increase in employers’ contribution rate"
    content "Notwithstanding the provisions of section 358(a)2" mark "1" 1 " of this title, the rate of contribution required to be paid under the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.] by every employer as defined in such Act shall be 4 per centum with respect to compensation as defined in such Act, paid after December 31, 1961, and before January 1, 1964."
    hash "32de60126bce455cad443b7c806ab99cf8a3c2c5866425823eecc048b105ad15"
  }
  credit "(" ["Pub. L. 87–7, § 5" -> "/us/pl/87/7/s5"] ", Mar. 24, 1961, " ["75 Stat. 17" -> "/us/stat/75/17"] ".)"
  note "/us/usc/t45/s404/note/editorialNotes/pl.100.647/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 358(a) of this title" -> "/us/usc/t45/s358/a"] ", referred to in text, was amended generally by " ["Pub. L. 100–647, title VII, § 7102(a)" -> "/us/pl/100/647/tVII/s7102/a"] ", Nov. 10, 1988, " ["102 Stat. 3759" -> "/us/stat/102/3759"] ", and, as so amended, does not contain a cl. “2”."
    p "The Railroad Unemployment Insurance Act, referred to in text, is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to chapter 11 (§ 351 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "e366247f3e130ac03ba4f8e4edd7d8184e68e6959bbeac5fbd4025797ebca144"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "32de60126bce455cad443b7c806ab99cf8a3c2c5866425823eecc048b105ad15"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "d70a56cf9717c8559b312db0318c9df3bb5ab7b07439f896dbf5daca3be8a991"
  }
}
