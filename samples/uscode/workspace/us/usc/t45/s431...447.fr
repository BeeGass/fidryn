  note "/us/usc/t45/s431...447/note/ungrouped/pl.91.458/noheading" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 431, " ["Pub. L. 91–458, title II, § 202" -> "/us/pl/91/458/tII/s202"] ", Oct. 16, 1970, " ["84 Stat. 971" -> "/us/stat/84/971"] "; " ["Pub. L. 94–348, § 5" -> "/us/pl/94/348/s5"] ", July 8, 1976, " ["90 Stat. 819" -> "/us/stat/90/819"] "; " ["Pub. L. 96–423, § 14" -> "/us/pl/96/423/s14"] ", Oct. 10, 1980, " ["94 Stat. 1817" -> "/us/stat/94/1817"] "; " ["Pub. L. 97–468, title VII, § 702(a)" -> "/us/pl/97/468/tVII/s702/a"] ", (c), Jan. 14, 1983, " ["96 Stat. 2579" -> "/us/stat/96/2579"] "; " ["Pub. L. 100–342" -> "/us/pl/100/342"] ", §§ 4(a), 7, 9, 10, 19(a), 21–23, June 22, 1988, " ["102 Stat. 625" -> "/us/stat/102/625"] ", 628, 629, 637–639; " ["Pub. L. 102–143, title V, § 4" -> "/us/pl/102/143/tV/s4"] ", Oct. 28, 1991, " ["105 Stat. 957" -> "/us/stat/105/957"] "; " ["Pub. L. 102–365" -> "/us/pl/102/365"] ", §§ 2, 5(a)(1), 7, 8, 10, Sept. 3, 1992, " ["106 Stat. 972" -> "/us/stat/106/972"] ", 975, 976, 978; " ["Pub. L. 102–533, § 14" -> "/us/pl/102/533/s14"] ", Oct. 27, 1992, " ["106 Stat. 3522" -> "/us/stat/106/3522"] ", authorized Secretary of Transportation to promulgate rules, regulations, orders, and standards for all areas of railroad safety. See sections 20102, 20103, 20103 note, 20108, 20110, 20114, 20131 to 20143, and 24902 of Title 49, Transportation."
    hash "93bff80c8f6b2e318cfaa53b5796e4201f794fe1d4acc6b162b1ceb3251001b9"
  }
  note "/us/usc/t45/s431...447/note/ungrouped/pl.91.458/noheading/2" editorial {
