edition 2
module "/us/usc/t45/s231l" {
  within "/us/usc/t45/ch9/schIV"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s231l" section {
    num "231l" "§ 231l."
    heading "Penalties"
    provision "/us/usc/t45/s231l/a" subsection {
      num "a" "(a)"
      content "Any person who shall knowingly fail or refuse to make any report or furnish any information required by the Board in the administration of this subchapter, including the provisions of " ["section 231f(b)(2) of this title" -> "/us/usc/t45/s231f/b/2"] " or who shall knowingly make or cause to be made any false or fraudulent statement or report when a statement or report is required to be made for the purpose of this subchapter, or who shall knowingly make or aid in making any false or fraudulent statement or claim for the purpose of causing an award or payment to be made, shall be punished by a fine of not more than $10,000 or by imprisonment not exceeding one year, or both."
      hash "2f402950f55c83bf0c414ed7fbc0f7d93315d6702197b454162b0999fcf15c1a"
    }
    provision "/us/usc/t45/s231l/b" subsection {
      num "b" "(b)"
      content "All fines and penalties imposed by a court pursuant to this subchapter shall be paid to the court and be remitted from time to time by order of the judge to the Treasury of the United States to be credited to the Railroad Retirement Account."
      hash "26ec99180a7f8c981601e926eb8e3776099bd112a1b1b5cd0c7969e168c9bd72"
    }
    hash "2229ede02f4a72cafd3f46124b5cac845f554d08e09dd6a66b4d853a3d969b41"
  }
  credit "(" ["Aug. 29, 1935, ch. 812, § 13" -> "/us/act/1935-08-29/ch812/s13"] ", as restated " ["June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", pt. I, " ["50 Stat. 307" -> "/us/stat/50/307"] ", as restated " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1345" -> "/us/stat/88/1345"] ".)"
  layers {
    operative "2229ede02f4a72cafd3f46124b5cac845f554d08e09dd6a66b4d853a3d969b41"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "b88a28e7acbcc928921c75e1def4e5d1e837c7c6b05ef8cc4ff2672ae4751b61"
  }
}
