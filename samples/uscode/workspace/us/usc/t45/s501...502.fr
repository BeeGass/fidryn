    group ungrouped
    topic "removalDescription"
    p "Section 501, " ["Pub. L. 91–518, title I, § 101" -> "/us/pl/91/518/tI/s101"] ", Oct. 30, 1970, " ["84 Stat. 1328" -> "/us/stat/84/1328"] "; " ["Pub. L. 96–73, title I, § 102" -> "/us/pl/96/73/tI/s102"] ", Sept. 29, 1979, " ["93 Stat. 537" -> "/us/stat/93/537"] "; " ["Pub. L. 97–35, title XI, § 1171" -> "/us/pl/97/35/tXI/s1171"] ", Aug. 13, 1981, " ["95 Stat. 687" -> "/us/stat/95/687"] ", related to congressional findings on needs for cost- and energy-efficient intercity rail passenger service. See " ["section 24101 of Title 49" -> "/us/usc/t49/s24101"] ", Transportation."
