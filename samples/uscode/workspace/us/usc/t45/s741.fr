edition 2
module "/us/usc/t45/s741" {
  within "/us/usc/t45/ch16/schIII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s741" section {
    num "741" "§ 741."
    heading "Formation and structure"
    provision "/us/usc/t45/s741/a" subsection {
      num "a" "(a)"
      heading "Establishment"
      content "There shall be established within 300 days after January 2, 1974, in accordance with the provisions of this section, a corporation to be known as the Consolidated Rail Corporation or such other corporate name as may be duly adopted by the Corporation."
      hash "a4fee340e3032740d147ce71174189d3a1212a7d2ce177db755efe9fe6942fa9"
    }
    provision "/us/usc/t45/s741/b" subsection {
      num "b" "(b)"
      heading "Status"
      content "The Corporation shall be a for-profit corporation established under the laws of a State and shall not be an agency or instrumentality of the Federal Government. The Corporation shall be deemed a rail carrier subject to part A of subtitle IV of title 49, shall be subject to the provisions of this Act and, to the extent not inconsistent with such Act and subtitle IV of title 49, shall be subject to applicable State law. The principal office of the Corporation or of its principal railroad operating subsidiary shall be located in Philadelphia in the Commonwealth of Pennsylvania."
      hash "27af18c0a9e79716e4d23a1b56929f4474c25428b6aa7229f09172a9a7213d15"
    }
    provision "/us/usc/t45/s741/c" subsection {
      num "c" "(c)"
      heading "Incorporators"
      provision "/us/usc/t45/s741/c/1" paragraph {
        num "1" "(1)"
        content "The members of the executive committee of the Association shall be the incorporators of the Corporation and shall take whatever steps are necessary to establish the Corporation, including the filing of articles of incorporation."
        hash "23c994e6e3b875cd37f64636266bc7fffa301be3a2a62ecd7d22315af5584922"
      }
      provision "/us/usc/t45/s741/c/2" paragraph {
        num "2" "(2)"
        content "Notwithstanding any provision of State law, after February 5, 1976, the members of the executive committee of the Association (including duly authorized representatives of members who are authorized by this chapter to be represented) and the chief executive officer and chief operating officer of the Corporation shall adopt the bylaws of the Corporation and serve as the Board of Directors of the Corporation until all members of the Board of Directors of the Corporation have been selected in accordance with subsection (d) of this section. The chief executive officer shall serve as chairman of such Board until a chairman thereof is selected pursuant to subsection (d) of this section, after which time such chairman shall serve at the pleasure of such Board."
        hash "31ac27d0ce1dc585f668c9f93e8cecd7a10ec86088e04b7acb933ef7487e5d7c"
      }
      hash "8e55fe2c6e73afe8385de2e6755254265abb74458862a152702193e21c0ea3ac"
    }
    provision "/us/usc/t45/s741/d" subsection {
      num "d" "(d)"
      heading "Board of Directors"
      provision "/us/usc/t45/s741/d/1" paragraph {
        num "1" "(1)"
        chapeau "Notwithstanding any provision of State law, the articles of incorporation and bylaws of the Corporation shall provide that the Board of Directors of the Corporation shall consist of 13 members selected in accordance with the articles and bylaws of the Corporation, as follows:"
        provision "/us/usc/t45/s741/d/1/A" subparagraph {
          num "A" "(A)"
          content "six individuals selected by the holders of the Corporation’s debentures and series A preferred stock voting as one class, with every $100 principal amount of debentures, and every $100 liquidation amount of series A preferred stock each receiving one vote for directors;"
          hash "e06563cabc94185f6f8c5b7c56e0d11f783454308e5072b372957b9f838406ee"
        }
        provision "/us/usc/t45/s741/d/1/B" subparagraph {
          num "B" "(B)"
          content "three individuals selected by the holders of the Corporation’s series B preferred stock; and"
          hash "c43a7ef27a64cf3c241dae0a442df24776ee023f504f1eaf2d01b2b4147bea9c"
        }
        provision "/us/usc/t45/s741/d/1/C" subparagraph {
          num "C" "(C)"
          content "two individuals selected by the holders of the Corporation’s common stock."
          hash "3431caa39f67de197ac364b9b62910cc4927b755416759a49ad488ddd0871c2c"
        }
        hash "175870e4987c5d3eb054c5cc9bf2ad6d6b2b1dad48fb56a1c5b28c0adb27f653"
      }
      provision "/us/usc/t45/s741/d/2" paragraph {
        num "2" "(2)"
        content "The chief executive officer and the chief operating officer of the Corporation shall also serve on the Board, but the chief executive officer and chief operating officer of the Corporation shall not be entitled to vote on the election or removal of either. In the event a vacancy occurs on the Board of Directors due to death, disability or resignation of a director, such vacancy shall be filled only by a vote of the holders of the class of securities that initially elected such director."
        hash "0cb9e8c93a7091fa73dc0df6b26cc25e08a157d5b520fa3f530f634ba5423333"
      }
      hash "e388b5fea3f8b65bdb8a43b5a5de91e375c12f7afbb08c172bd95d3d7efe52af"
    }
    provision "/us/usc/t45/s741/e" subsection {
      num "e" "(e)"
      heading "Initial capitalization"
      provision "/us/usc/t45/s741/e/1" paragraph {
        num "1" "(1)"
        content "The Corporation is authorized to issue debentures, series A preferred stock, series B preferred stock, common stock, contingent interest notes, and other securities."
        hash "59217579cad553bf710644e41723f6e3b1164d225481ba5a024e55ced26e3139"
      }
      provision "/us/usc/t45/s741/e/2" paragraph {
        num "2" "(2)"
        content "Debentures and series A preferred stock shall be issued initially to the Association. Series B preferred stock and common stock shall be issued initially to the estates of railroads in reorganization in the region, to railroads leased, operated, and controlled by railroads in reorganization in the region, and to other persons leased, operated or controlled by a railroad in reorganization who are transferors of rail properties in exchange for rail properties transferred to the Corporation pursuant to the final system plan. Notwithstanding any other provisions of State or Federal law, the series B preferred stock and common stock shall have terms and conditions not inconsistent with the final system plan. As a condition of its investment in the Corporation, the Association may require that the Corporation adopt limitations consistent with the final system plan on the circumstances under which dividends on the series B preferred stock and common stock are payable so long as any of the debentures or series A preferred stock are outstanding. Notwithstanding anything to the contrary in the final system plan, the initial authorized number of shares of series B preferred stock may be 35,000,000, and the Corporation may issue initially for the purpose of the deposit required under " ["section 743(a)(1) of this title" -> "/us/usc/t45/s743/a/1"] " such numbers of shares of series B preferred and common stock as the Association shall certify to the Special Court pursuant to section 719(c)(1)(3)" mark "1" 1 " of this title, including any modifications in such numbers of shares as may be ordered by the Special Court for the purpose of, and in connection with, such deposit and certification."
        hash "9fd24bec5c9227c16328d2b09193e48b318461b882d7f4895a57289e6dc9cc03"
      }
      hash "c0af75021c3196a8ea01abaf72b582a3d03d9c2f53c9cfd3899fd17c82c2efb4"
    }
    provision "/us/usc/t45/s741/f" subsection {
      num "f" "(f)"
      heading "Officers"
      content "The officers of the Corporation shall include a chief executive officer and a chief operating officer, who shall be appointed by the Board of Directors and who shall serve at the pleasure of the Board; and such other officers as shall be provided for in the bylaws of the Corporation."
      hash "0f86fd7412e344b9aad70ae8072bab2c13cb735c4ac3c9b19862b8f5f41138b8"
    }
    provision "/us/usc/t45/s741/g" subsection {
      num "g" "(g)"
      heading "Voting trustees"
      content "For and during the period between the deposit of securities of the Corporation with the special court, in accordance with " ["section 743(a) of this title" -> "/us/usc/t45/s743/a"] ", and the distribution of such securities, in accordance with " ["section 743(c) of this title" -> "/us/usc/t45/s743/c"] ", the special court shall, within 30 days after the date of conveyance pursuant to " ["section 743(b)(1) of this title" -> "/us/usc/t45/s743/b/1"] ", appoint one or more voting trustees for each class of securities which is so deposited. Such voting trustees shall, on behalf of the distributees, exercise the rights of the holders of such securities as their interests may appear. Within 30 days after such appointment, such voting trustees shall select members of the Board of Directors of the Corporation on behalf of the holders of the class of securities whose rights they exercise pursuant to this subsection."
      hash "91c40a0245e6766ddd4cda1ec5566784770813f1d2cddc0fae7421766f41a60c"
    }
    provision "/us/usc/t45/s741/h" subsection {
      num "h" "(h)"
      heading "Annual report"
      content "The Corporation shall transmit to the Congress and the President, not later than 90 days after the end of each fiscal year, a comprehensive and detailed report on all activities and accomplishments of the Corporation during the preceding fiscal year."
      hash "af1b0e7e3ae95e36038f0bfd2e62d177e6d14cd87aa476f06e529574f41a15c3"
    }
    provision "/us/usc/t45/s741/i" subsection {
      num "i" "(i)"
      heading "Liability of directors"
      content "No director of the Corporation shall be liable, for money damages or otherwise, to any party by reason of the fact that such person is or was a director, if, with respect to the subject matter of the action, suit, or proceeding, such person was fulfilling a duty which he in good faith reasonably believed to be required by law or vested in him in his capacity as a director of the Association or as an officer of the United States. The United States shall indemnify such person against all judgments, amounts paid in settlement, and costs and expenses (including fees of accountants, experts, and attorneys), actually and reasonably incurred in connection with any such action, suit, or proceeding in which such person is determined to have met such standard of conduct. This subsection shall not be construed to grant any immunity from any criminal law of the United States."
      hash "5064930c9364a68b64c46e24d8e9f380c513033feedee4b08c92d2b5253f7661"
    }
    provision "/us/usc/t45/s741/j" subsection {
      num "j" "(j)"
      heading "Signal systems"
      content "If, within two years after August 13, 1981, the Corporation applies for the permission of the Secretary to substitute manual block signal systems for automatic block signal systems on lines on which less than 20,000,000 gross tons of freight are carried annually, the Secretary shall approve or disapprove such application within 90 days of its submission."
      hash "1a973aa77e768156d5dec54e7f97782e9951dbf4366a03361f1f534e507c321e"
    }
    provision "/us/usc/t45/s741/k" subsection {
      num "k" "(k)"
      heading "Governing provisions after sale"
      chapeau "The provisions of this chapter shall not apply to the Corporation and to activities and other actions and responsibilities of the Corporation and its directors and employees after the sale date, other than with regard to—"
      provision "/us/usc/t45/s741/k/1" paragraph {
        num "1" "(1)"
        content ["section 702 of this title" -> "/us/usc/t45/s702"] ";"
        hash "4a598576efeec2bc48c2c2c74223936af09d79edfc5185bb275e2a80d1d8bcdd"
      }
      provision "/us/usc/t45/s741/k/2" paragraph {
        num "2" "(2)"
        content ["section 711(d) of this title" -> "/us/usc/t45/s711/d"] ";"
        hash "bbb697171d50fd741371ee9380fd61e45ad87daae94a57178e1817bda701734a"
      }
      provision "/us/usc/t45/s741/k/3" paragraph {
        num "3" "(3)"
        content ["section 713 of this title" -> "/us/usc/t45/s713"] ", but only with respect to information relating to proceedings before the special court established under " ["section 719(b) of this title" -> "/us/usc/t45/s719/b"] ";"
        hash "2ba288fe8b36d8220b2a1eb958adae336124488f2d4fd811f01239195ea05625"
      }
      provision "/us/usc/t45/s741/k/4" paragraph {
        num "4" "(4)"
        content ["section 719 of this title" -> "/us/usc/t45/s719"] ", other than subsection (f) thereof;"
        hash "aa724315b047edbdcec133a9c75a7767015f416277aecfa21fb5d0d4bee139fc"
      }
      provision "/us/usc/t45/s741/k/5" paragraph {
        num "5" "(5)"
        content ["section 726(f)(8) of this title" -> "/us/usc/t45/s726/f/8"] ", but only as such authority applies to activities related to the ESOP and related trust before the sale date;"
        hash "bd342f77eb3f5eeec7ee36486f482cf679acc41088d6bc6866bd7d8669d6509d"
      }
      provision "/us/usc/t45/s741/k/6" paragraph {
        num "6" "(6)"
        content ["section 726(f)(9) of this title" -> "/us/usc/t45/s726/f/9"] ", but only as such indemnification applies to activities relating to the ESOP and related trust before the sale date;"
        hash "9216c77c66b0f0a66dba2319a7e8741d32c2e83a66cf321a75397f8b01d153a4"
      }
      provision "/us/usc/t45/s741/k/7" paragraph {
        num "7" "(7)"
        content ["section 726(f)(10) of this title" -> "/us/usc/t45/s726/f/10"] " with respect to all securities of the Corporation issued or transferred in connection with the public offering under the Conrail Privatization Act [" ["45 U.S.C. 1301" -> "/us/usc/t45/s1301"] " et seq.] and all securities of ConRail Equity Corporation and all interests in the ESOP;"
        hash "0283a51787cc726c6b36e7dc9a70adef32f772a91ca9e72c3ac70c45e67e7e02"
      }
      provision "/us/usc/t45/s741/k/8" paragraph {
        num "8" "(8)"
        content "section 727(c) and (e) of this title;"
        hash "01c23432c341af0122f271ac63e234fd3649ac21da28a5c5700a0344c1527a36"
      }
      provision "/us/usc/t45/s741/k/9" paragraph {
        num "9" "(9)"
        content "subsection (b) of this section, but only with respect to matters covered by the last sentence of such subsection;"
        hash "01723d4a0bc7017214f6c79ee053656e3581de57c8b4e18f479e971516b26390"
      }
      provision "/us/usc/t45/s741/k/10" paragraph {
        num "10" "(10)"
        content "subsection (i) of this section, but only as such authority applies to service as a director of the Corporation before the sale of the interest of the United States in the common stock of the Corporation;"
        hash "948aabbaf8a18b235056a2fded20231cc2bbc3f5aaea7e9a14f8f89dbbbef397"
      }
      provision "/us/usc/t45/s741/k/11" paragraph {
        num "11" "(11)"
        content ["section 742 of this title" -> "/us/usc/t45/s742"] ", but only to the extent of (A) the creation and maintenance of the power and authority of the Corporation to operate rail service and to rehabilitate, improve, and modernize rail properties, and (B) the creation and maintenance of the powers of the Corporation as a railroad in any State in which it operates as of the sale date;"
        hash "6d23cff1577828894fcd93282a6e5efd43bd7a7baff4e41ec9e5a8f669927aef"
      }
      provision "/us/usc/t45/s741/k/12" paragraph {
        num "12" "(12)"
        content "section 743(b)(1) and (2) of this title, but only to the extent of establishing the legal effect of the conveyance of property ordered and of the deeds and other instruments executed, acknowledged, delivered, or recorded in connection therewith and the quality of title acquired in such property;"
        hash "385ba7508630b2c07015c699986384d16c7b564b0e34740702924448c11d482e"
      }
      provision "/us/usc/t45/s741/k/13" paragraph {
        num "13" "(13)"
        content ["section 743(b)(3)(B) of this title" -> "/us/usc/t45/s743/b/3/B"] " with respect to the effect of an assignment, conveyance, or assumption as set forth in the last sentence of such subparagraph (B);"
        hash "f055c358dcbe87197f99f0084b90487fde581f304863d7bf7274a60ddb001979"
      }
      provision "/us/usc/t45/s741/k/14" paragraph {
        num "14" "(14)"
        content ["section 743(b)(5) of this title" -> "/us/usc/t45/s743/b/5"] ";"
        hash "9ebeb4576fe7f47b393edb851ceff6a9d888142e20fe6488330fc2f1401d346a"
      }
      provision "/us/usc/t45/s741/k/15" paragraph {
        num "15" "(15)"
        content ["section 743(b)(6) of this title" -> "/us/usc/t45/s743/b/6"] ", but only with respect to establishing and maintaining the rights of the Corporation with respect to, limiting its obligations with respect to, and establishing the status of, the employee pension and welfare benefit plans transferred to the Corporation thereunder and with respect to the exclusivity of the jurisdiction of the special court and the limitation of jurisdiction of other courts;"
        hash "e39a992fde0b5e8423794e4d56c82d9ff979c7edd8e03dc467b238ac34794749"
      }
      provision "/us/usc/t45/s741/k/16" paragraph {
        num "16" "(16)"
        content ["section 743(e) of this title" -> "/us/usc/t45/s743/e"] ";"
        hash "258b0ae394f5e4fd01a1d2524c1a9b5458f7d3c6c65cb3a2641417e4d64214f8"
      }
      provision "/us/usc/t45/s741/k/17" paragraph {
        num "17" "(17)"
        content ["section 744 of this title" -> "/us/usc/t45/s744"] ", but only with respect to the finality of abandonments completed before the sale date pursuant to the authority thereof;"
        hash "300b5e549855fb482786c33036b33475bf26c123ea7d80902156db4a8869926d"
      }
      provision "/us/usc/t45/s741/k/18" paragraph {
        num "18" "(18)"
        content ["section 745 of this title" -> "/us/usc/t45/s745"] ", but only as to the effect, and continuing administration, of supplemental transactions consummated before the sale date;"
        hash "4de208ba45c4743b52d2a122ff436ca8c9267acf7b2383968d0548f1958dac69"
      }
      provision "/us/usc/t45/s741/k/19" paragraph {
        num "19" "(19)"
        content ["section 748 of this title" -> "/us/usc/t45/s748"] ", but only (A) as to the finality of abandonments completed before the sale date and (B) as to abandonments of lines where a notice or notices of insufficient revenues with respect to such lines have been filed before November 1, 1985;"
        hash "34b2673e8fa01bc356b37e9cecf8aaeb2d72f446807a908c06bfdb294617349b"
      }
      provision "/us/usc/t45/s741/k/20" paragraph {
        num "20" "(20)"
        content ["section 791(a)(2) of this title" -> "/us/usc/t45/s791/a/2"] ", but only with respect to activities before the sale date;"
        hash "27bd3a2bd569b5814ffb8e3149872ee0c80a66ca9d209c86a7671672e2439f64"
      }
      provision "/us/usc/t45/s741/k/21" paragraph {
        num "21" "(21)"
        content "section 791(b)(2) and (b)(3) of this title, but only with respect to issuance of and transactions in any security of the Corporation before the sale date;"
        hash "2bd76a260e2135c307deea14a360450cdd738e22d7c71905acb89a18f6c537d3"
      }
      provision "/us/usc/t45/s741/k/22" paragraph {
        num "22" "(22)"
        content ["section 797a(e) of this title" -> "/us/usc/t45/s797a/e"] ";"
        hash "e44f1705f258766cad1c70c4714944724a1c8e6bd1e999e4dd74b07b330414a6"
      }
      provision "/us/usc/t45/s741/k/23" paragraph {
        num "23" "(23)"
        content ["section 797b of this title" -> "/us/usc/t45/s797b"] ";"
        hash "1579e3c43aa34a4e6e5e2c882c257786bd5c959e6bbc70f4fa5747564264b3a0"
      }
      provision "/us/usc/t45/s741/k/24" paragraph {
        num "24" "(24)"
        content ["section 797c of this title" -> "/us/usc/t45/s797c"] ";"
        hash "36e7fdd98d9f83189cca7845f7b9144599fba76f1d3d62f6f831a614b7293771"
      }
      provision "/us/usc/t45/s741/k/25" paragraph {
        num "25" "(25)"
        content "sections 797e(a), 797f, and 797g(a) of this title, but only insofar as they establish part of the prevailing status quo for the Corporation’s employees’ rates of pay, rules, and working conditions, such provisions to continue to apply unless changed pursuant to " ["section 156 of this title" -> "/us/usc/t45/s156"] ";"
        hash "7ad66dfa1827c0651b7eaa76c4cb883f89d313584379720143268040319ea5b0"
      }
      provision "/us/usc/t45/s741/k/26" paragraph {
        num "26" "(26)"
        content ["section 797h of this title" -> "/us/usc/t45/s797h"] ";"
        hash "72f2b905d6c121c716f3543ac88d9428e411559b6e44a80f9660aae84a73e75f"
      }
      provision "/us/usc/t45/s741/k/27" paragraph {
        num "27" "(27)"
        content ["section 797i(b)(1) of this title" -> "/us/usc/t45/s797i/b/1"] ";"
        hash "4e1a25c2fe6d6c9d4351c4ad7732067803970c7a312632a2155a5e7b4b60ebcb"
      }
      provision "/us/usc/t45/s741/k/28" paragraph {
        num "28" "(28)"
        content ["section 797j of this title" -> "/us/usc/t45/s797j"] "; and"
        hash "997b0df98d1eb1c09a80a447d8e3d344c20bf0fedee9a337c81f7496a75f2399"
      }
      provision "/us/usc/t45/s741/k/29" paragraph {
        num "29" "(29)"
        content ["section 797m of this title" -> "/us/usc/t45/s797m"] ", but only with regard to disputes or controversies specified in such section that arose before the sale date."
        hash "6c229bbeca47cefeffdf683afefe008ff2acf85e6722d88ac38c3a602d10251b"
      }
      hash "7bbe65eb7f382b44a4ad7147c84282ceed1cba6f5dabd95d8581fad0d2061cc2"
    }
    hash "9109443502e5780a70fa408ac225bf0153a6260ff23c1aa441b6a14c15b8ccdd"
  }
  credit "(" ["Pub. L. 93–236, title III, § 301" -> "/us/pl/93/236/tIII/s301"] ", Jan. 2, 1974, " ["87 Stat. 1004" -> "/us/stat/87/1004"] "; " ["Pub. L. 94–210, title VI" -> "/us/pl/94/210/tVI"] ", §§ 608, 611, 612(j)(1), (3), (m), Feb. 5, 1976, " ["90 Stat. 99" -> "/us/stat/90/99"] ", 105, 109, 110; " ["Pub. L. 94–216" -> "/us/pl/94/216"] ", §§ 1, 3, Feb. 17, 1976, " ["90 Stat. 191" -> "/us/stat/90/191"] "; " ["Pub. L. 94–248, § 4" -> "/us/pl/94/248/s4"] ", Mar. 25, 1976, " ["90 Stat. 286" -> "/us/stat/90/286"] "; " ["Pub. L. 97–35, title XI, § 1141" -> "/us/pl/97/35/tXI/s1141"] ", Aug. 13, 1981, " ["95 Stat. 653" -> "/us/stat/95/653"] "; " ["Pub. L. 99–509, title IV, § 4032" -> "/us/pl/99/509/tIV/s4032"] ", Oct. 21, 1986, " ["100 Stat. 1906" -> "/us/stat/100/1906"] "; " ["Pub. L. 104–88, title III, § 327(2)" -> "/us/pl/104/88/tIII/s327/2"] ", Dec. 29, 1995, " ["109 Stat. 951" -> "/us/stat/109/951"] ".)"
  note "/us/usc/t45/s741/note/editorialNotes/pl.93.236/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This Act, referred to in subsec. (b), means the Regional Rail Reorganization Act of 1973, " ["Pub. L. 93–236" -> "/us/pl/93/236"] ", Jan. 2, 1974, " ["87 Stat. 985" -> "/us/stat/87/985"] ", which is classified principally to this chapter (§ 701 et seq.). For complete classification of this Act to the Code, see Short Title note set out under " ["section 701 of this title" -> "/us/usc/t45/s701"] " and Tables."
    p "The Conrail Privatization Act, referred to in subsec. (k)(7), is subtitle A (§§ 4001–4052) of title IV of " ["Pub. L. 99–509" -> "/us/pl/99/509"] ", Oct. 21, 1986, " ["100 Stat. 1892" -> "/us/stat/100/1892"] ", which is classified principally to chapter 22 (§ 1301 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 1301 of this title" -> "/us/usc/t45/s1301"] " and Tables."
    hash "8df6337ce20c42a58886f3232cc6b7d0f4a74c5e883ed422762598fa9189020e"
  }
  note "/us/usc/t45/s741/note/editorialNotes/pl.95.473/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "In subsec. (b), “such Act and subtitle IV of title 49” substituted for “such Acts”, on authority of " ["Pub. L. 95–473, § 3(b)" -> "/us/pl/95/473/s3/b"] ", Oct. 17, 1978, " ["92 Stat. 1466" -> "/us/stat/92/1466"] ", the first section of which enacted subtitle IV (§ 10101 et seq.) of Title 49, Transportation."
    p "The last sentence of subsec. (f) of this section as originally enacted, which amended section 856 of former Title 31, Money and Finance, was repealed by " ["Pub. L. 97–258, § 5(b)" -> "/us/pl/97/258/s5/b"] ", Sept. 13, 1982, " ["96 Stat. 1068" -> "/us/stat/96/1068"] ", the first section of which enacted Title 31."
    hash "6069967fc4f0bf47ae39fc78f1d0fe06c5d92aafed6f648d6fee80e38dc1a0a0"
  }
  note "/us/usc/t45/s741/note/editorialNotes/pl.104.88/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1995—Subsec. (b). " ["Pub. L. 104–88, § 327(2)" -> "/us/pl/104/88/s327/2"] ", substituted “rail carrier subject to part A of subtitle IV of title 49” for “common carrier by railroad under section 1(3) of the Interstate Commerce Act (" ["49 U.S.C. 1(3)" -> "/us/usc/t49/s1/3"] ")”."
    p "1986—Subsec. (k). " ["Pub. L. 99–509" -> "/us/pl/99/509"] " added subsec. (k)."
    p "1981—Subsec. (d)(2). " ["Pub. L. 97–35, § 1141(a)" -> "/us/pl/97/35/s1141/a"] ", struck out provisions respecting resignations."
    p "Subsec. (e)(1). " ["Pub. L. 97–35, § 1141(b)" -> "/us/pl/97/35/s1141/b"] ", substituted “The” for “In order to carry out the final system plan, the”."
    p "Subsec. (j). " ["Pub. L. 97–35, § 1141(c)" -> "/us/pl/97/35/s1141/c"] ", substituted provisions relating to signal systems for provisions relating to corporate simplification."
    p "1976—Subsec. (a). " ["Pub. L. 94–210, § 612(j)(1)" -> "/us/pl/94/210/s612/j/1"] ", inserted “or such other corporate name as may be duly adopted by the Corporation” after “Corporation”."
    p "Subsec. (b). " ["Pub. L. 94–210, § 612(j)(3)" -> "/us/pl/94/210/s612/j/3"] ", inserted “or of its principal railroad operating subsidiary” after “of the Corporation”."
    p "Subsec. (c). " ["Pub. L. 94–210, § 611(a)" -> "/us/pl/94/210/s611/a"] ", designated existing provisions as par. (1), struck out provision relating to service of the incorporators as the Board of Directors, and added par. (2)."
    p "Subsec. (d). " ["Pub. L. 94–210, § 611(b)" -> "/us/pl/94/210/s611/b"] ", designated existing provisions as par. (1), inserted provision relating to applicability of State law, decreased membership from 15 to 13, and revised criteria for selection to membership, and added par. (2)."
    p "Subsec. (e). " ["Pub. L. 94–210, § 608" -> "/us/pl/94/210/s608"] ", designated existing provisions as par. (1), substituted provisions authorizing issuance of debentures, series A preferred stock, series B preferred stock, common stock, contingent interest notes, and other securities, for provisions relating to issuance of stock and other securities, and added par. (2)."
    p "Subsec. (e)(2). " ["Pub. L. 94–248" -> "/us/pl/94/248"] " inserted provisions relating to initial authorized number of shares of series B preferred stock and provisions setting such number at 35,000,000."
    p "Subsec. (f). " ["Pub. L. 94–210, § 611(c)" -> "/us/pl/94/210/s611/c"] ", added subsec. (f). Former subsec. (f), which related to a Federal Government audit of the Corporation, was struck out."
    p "Subsec. (g). " ["Pub. L. 94–210, § 611(c)" -> "/us/pl/94/210/s611/c"] ", added subsec. (g). Former subsec. (g) redesignated (h) “Annual report”."
    p "Subsec. (h). " ["Pub. L. 94–216, § 1" -> "/us/pl/94/216/s1"] ", redesignated subsec. (h) “Liability of directors” as (i)."
    p ["Pub. L. 94–210" -> "/us/pl/94/210"] ", §§ 611(c), 612(m), redesignated former subsec. (g) as (h) “Annual report” and added subsec. (h) “Liability of directors”."
    p "Subsec. (i). " ["Pub. L. 94–216" -> "/us/pl/94/216"] ", §§ 1, 3, redesignated former subsec. (h) “Liability of directors” as (i) and substituted “a director of the Association” for “a director of the Corporation”. Former subsec. (i) redesignated (j)."
    p ["Pub. L. 94–210, § 612(m)" -> "/us/pl/94/210/s612/m"] ", added subsec. (i) “Corporate simplification”."
    p "Subsec. (j). " ["Pub. L. 94–216, § 1" -> "/us/pl/94/216/s1"] ", redesignated former subsec. (i) “Corporate simplification” as (j)."
    hash "50e9c0dc8841317effb68a245ee99d386d92ef8034a9280b41833acc9699b245"
  }
