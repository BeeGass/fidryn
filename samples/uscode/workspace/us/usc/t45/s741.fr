  note "/us/usc/t45/s741/note/statutoryNotes/pl.104.66/termination-of-reporting-requirements" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Termination of Reporting Requirements"
    p "For termination, effective May 15, 2000, of provisions in subsec. (h) of this section relating to the requirement that the Corporation transmit an annual report to Congress, see " ["section 3003 of Pub. L. 104–66" -> "/us/pl/104/66/s3003"] ", as amended, set out as a note under " ["section 1113 of Title 31" -> "/us/usc/t31/s1113"] ", Money and Finance, and the 7th item on page 199 of House Document No. 103–7."
    hash "fb0a6aa3dd3a6d6e52274446400064f626aea65ca92a3849532d6c5896567466"
  }
  note "/us/usc/t45/s741/note/statutoryNotes/nolaw/abolition-of-special-court-regional-rail-reorganization-act" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Special Court, Regional Rail Reorganization Act of 1973, and Transfer of Functions"
    p "Special court abolished and all jurisdiction and functions transferred to United States District Court for District of Columbia, see " ["section 719(b)(2) of this title" -> "/us/usc/t45/s719/b/2"] "."
    hash "b36896cd25152a2ad11f070c8b08b800c6cb73145cec88413adfe814d660133f"
  }
