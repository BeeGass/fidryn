edition 2
module "/us/usc/t45/s231i" {
  within "/us/usc/t45/ch9/schIV"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s231i" section {
    num "231i" "§ 231i."
    heading "Erroneous payments"
    provision "/us/usc/t45/s231i/a" subsection {
      num "a" "(a)"
      heading "Recovery"
      content "If the Board finds that at any time more than the correct amount of annuities or other benefits has been paid to any individual under this subchapter, or payment has been made to an individual not entitled thereto, recovery by adjustment in subsequent payments to which such individual, or any other individual on the basis of the same compensation, wages, or self-employment income, is entitled under this subchapter, or the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.] may, except as otherwise provided in this section, be made under regulations prescribed by the Board. If the individual to whom more than the correct amount has been paid dies before recovery is completed, recovery may be made by setoff or adjustments, under regulations prescribed by the Board, in subsequent payments due, under this subchapter, or the Railroad Unemployment Insurance Act, to the estate of such individual or to any person on the basis of the compensation, wages, or self-employment income of such individual. The Board shall have the authority to recover from any payment which would be made to an individual by the Board under " ["section 231f(b)(2) of this title" -> "/us/usc/t45/s231f/b/2"] " the amount of annuity payments made to such individual which are erroneous because of such individual’s entitlement to monthly insurance benefits under title II of the Social Security Act [" ["42 U.S.C. 401" -> "/us/usc/t42/s401"] " et seq.]."
      hash "eb01db5acad7318893c6feb564aa7cd2bfd4b8b53be709024de7995a9dd20a21"
    }
    provision "/us/usc/t45/s231i/b" subsection {
      num "b" "(b)"
      heading "Adjustments"
      content "Adjustments under this section may be made either by deductions from subsequent payments or, with respect to payments which are to be made during a lifetime or lifetimes, by subtracting the total amount of annuities or other benefits paid in excess of the proper amount from the actuarial value, as determined by the Board, of such payments to be made during a lifetime or lifetimes and recertifying such payments on the basis of the reduced actuarial value. In the latter case, recovery shall be deemed to have been completed upon such recertification."
      hash "6014466d285289a233398732f85bc9039ab968da8bcf03e13748ae8cfcbbd7b2"
    }
    provision "/us/usc/t45/s231i/c" subsection {
      num "c" "(c)"
      heading "Decision not to recover"
      content "There shall be no recovery in any case in which more than the correct amount of annuities or other benefits has been paid under this subchapter to an individual or payment has been made to an individual not entitled thereto who, in the judgment of the Board, is without fault when, in the judgment of the Board, recovery would be contrary to the purpose of this subchapter or the Railroad Unemployment Insurance Act [" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.] or would be against equity or good conscience."
      hash "e9d181fe2c19a749b1c0f153853f0fd933c6f74e6d4240985f2a71688640a00d"
    }
    provision "/us/usc/t45/s231i/d" subsection {
      num "d" "(d)"
      heading "Liability of officers"
      content "No certifying or disbursing officer shall be held liable for any amount certified or paid by him in good faith to any person where the recovery of such amount is waived under subsection (c) of this section or has been begun but cannot be completed under subsection (a) of this section."
      hash "6d7a3c008fb93b5d5586d6d52e7ad6e4c9e57ffc32ecb5d494b4d96fccea243d"
    }
    hash "c2442ec6c7d8c1e374ed92b75c35aa7c3693f84c7c69ebfd7137e9610655574f"
  }
  credit "(" ["Aug. 29, 1935, ch. 812, § 10" -> "/us/act/1935-08-29/ch812/s10"] ", as restated " ["June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", pt. I, " ["50 Stat. 307" -> "/us/stat/50/307"] ", as restated " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1344" -> "/us/stat/88/1344"] "; amended " ["Pub. L. 97–35, title XI, § 1123" -> "/us/pl/97/35/tXI/s1123"] ", Aug. 13, 1981, " ["95 Stat. 638" -> "/us/stat/95/638"] ".)"
  note "/us/usc/t45/s231i/note/editorialNotes/act.1938-06-25.ch680/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Railroad Unemployment Insurance Act, referred to in subsecs. (a) and (c), is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to chapter 11 (§ 351 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    p "The Social Security Act, referred to in subsec. (a), is " ["act Aug. 14, 1935, ch. 531" -> "/us/act/1935-08-14/ch531"] ", " ["49 Stat. 620" -> "/us/stat/49/620"] ". Title II of the Social Security Act is classified generally to subchapter II (§ 401 et seq.) of chapter 7 of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see " ["section 1305 of Title 42" -> "/us/usc/t42/s1305"] " and Tables."
    hash "75e8699b6d9b3d547d1f04c6202c25ee662cf15db501d6a72f0018eed91745af"
  }
  note "/us/usc/t45/s231i/note/editorialNotes/pl.97.35/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1981—Subsec. (a). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " inserted provisions authorizing Board to recover from any payment which would be made to an individual by Board under " ["section 231f(b)(2) of this title" -> "/us/usc/t45/s231f/b/2"] " amount of annuity payments made to such individual which are erroneous because of such individual’s entitlement to monthly insurance benefits under title II of the Social Security Act."
    hash "dcb90d89949f1b9014a2726d3de16556f5bc15b332b605d990732a17819f99bc"
  }
  note "/us/usc/t45/s231i/note/statutoryNotes/pl.97.35/effective-date-of-1981-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1981 Amendment"
    p "Amendment by " ["Pub. L. 97–35" -> "/us/pl/97/35"] " effective Jan. 1, 1975, see " ["section 1129 of Pub. L. 97–35" -> "/us/pl/97/35/s1129"] ", set out as a note under " ["section 231 of this title" -> "/us/usc/t45/s231"] "."
    hash "8c66366eeed2e69260f83b11cbe61042d46b85b44c062b65b4d0774d6b66be88"
  }
  layers {
    operative "c2442ec6c7d8c1e374ed92b75c35aa7c3693f84c7c69ebfd7137e9610655574f"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "f97d67df53f5bb63f9a2df992990bb1d6c0922fb7d0e466b91b28c1e92d854ae"
  }
}
