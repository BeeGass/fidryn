  note "/us/usc/t45/s65/note/ungrouped/nolaw/h.17f5da6073b415dc" editorial {
    group ungrouped
    topic "removalDescription"
    p "Section 66, act Sept. 3, 5, 1916, ch. 436, § 4, " ["39 Stat. 722" -> "/us/stat/39/722"] ", provided penalty for violation of " ["section 65 of this title" -> "/us/usc/t45/s65"] ". See " ["section 28302 of Title 49" -> "/us/usc/t49/s28302"] ", Transportation."
    hash "17f5da6073b415dcc06baf7a27c1964089f71ce25cab1685319987b3732be430"
  }
