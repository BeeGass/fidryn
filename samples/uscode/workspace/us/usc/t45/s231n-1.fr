edition 2
module "/us/usc/t45/s231n–1" {
  within "/us/usc/t45/ch9/schIV"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s231n–1" section {
    num "231n–1" "§ 231n–1."
    heading "Social Security Equivalent Benefit Account"
    provision "/us/usc/t45/s231n–1/a" subsection {
      num "a" "(a)"
      heading "Establishment"
      content "There is hereby created an account in the Treasury of the United States to be known as the “Social Security Equivalent Benefit Account”."
      hash "499813dd633da74c9750078b74f9f74e653276b011593f4a61f36e3f170f7bb6"
    }
    provision "/us/usc/t45/s231n–1/b" subsection {
      num "b" "(b)"
      heading "Transfers, etc., to Social Security Equivalent Benefit Account"
      provision "/us/usc/t45/s231n–1/b/1" paragraph {
        num "1" "(1)"
        chapeau "There is hereby appropriated to the Social Security Equivalent Benefit Account for each fiscal year, beginning with the fiscal year beginning October 1, 1984, an amount equal to the sum of the following amounts:"
        provision "/us/usc/t45/s231n–1/b/1/A" subparagraph {
          num "A" "(A)"
          content "Amounts covered into the Treasury (minus refunds) during such fiscal year under sections 3201(a), 3211(a)(1), and 3221(a) of the Railroad Retirement Tax Act [" ["26 U.S.C. 3201(a)" -> "/us/usc/t26/s3201/a"] ", 3211(a)(1), 3221(a)]."
          hash "dfe0b1ed62a5a6b300eec900fb0bd491bce90d49af2b80a477f2e702c4ccf537"
        }
        provision "/us/usc/t45/s231n–1/b/1/B" subparagraph {
          num "B" "(B)"
          content "The amount which (but for this section) would have been transferred to the Railroad Retirement Account under section 121(e) of the Social Security Amendments of 1983 to the extent that the amount which would have been so transferred is attributable to taxation of social security equivalent benefits."
          hash "e0ce9ec43de94a64ba1277121ff914c148d1d9da073706b3b6854fd815a8535a"
        }
        continuation "Amounts appropriated to the Railroad Retirement Account shall be appropriately reduced to take into account the amounts appropriated under this paragraph to the Social Security Equivalent Benefit Account."
        hash "027a65d4a1bf01ace7418920b5c89e38fd1bb400ae7d7a39ad2709e9a67a3264"
      }
      provision "/us/usc/t45/s231n–1/b/2" paragraph {
        num "2" "(2)"
        content "On and after October 1, 1984, any amount which (but for this section) would have been transferred to the Railroad Retirement Account pursuant to paragraph (2) or (4) of " ["section 231f(c) of this title" -> "/us/usc/t45/s231f/c"] " shall be transferred to the Social Security Equivalent Benefit Account. On and after October 1, 1984, no transfer shall be made to the Railroad Retirement Account pursuant to paragraph (2) or (4) of " ["section 231f(c) of this title" -> "/us/usc/t45/s231f/c"] "."
        hash "e7eb965cdd53f057386aa9736c26f4b6737bcc3dbeb2df08dd31ae31b4bbad6d"
      }
      provision "/us/usc/t45/s231n–1/b/3" paragraph {
        num "3" "(3)"
        content "To the extent that the authorization for appropriation contained in " ["section 231n(b) of this title" -> "/us/usc/t45/s231n/b"] " is attributable to the cost of social security equivalent benefits, on and after October 1, 1984, any reference in such section to the Railroad Retirement Account shall be treated as a reference to the Social Security Equivalent Benefit Account."
        hash "c0f5743d0efd7ae96bdaab90d26f2e9a9f67fcff65b5046a14ca88a27e83b6ec"
      }
      provision "/us/usc/t45/s231n–1/b/4" paragraph {
        num "4" "(4)"
        content "Amounts appropriated or transferred to the Social Security Equivalent Benefit Account under this section shall be credited or transferred to such Account at the same time and in the same manner as such amounts would have been credited or transferred to the Railroad Retirement Account but for this section."
        hash "ff21980cb55e393681004483658554eea62d74a0a5cab862e77aba15763c5ecf"
      }
      hash "550ec5040e696a408ecfa7d6df594b0a1ae5027cbe88faba244f50a10132d5a8"
    }
    provision "/us/usc/t45/s231n–1/c" subsection {
      num "c" "(c)"
      heading "Availability and transfer of funds"
      provision "/us/usc/t45/s231n–1/c/1" paragraph {
        num "1" "(1)"
        content "Except as otherwise provided in this section, amounts in the Social Security Equivalent Benefit Account shall be available only for purposes of paying social security equivalent benefits under this subchapter and to provide for the administrative expenses of the Board allocable to social security equivalent benefits. The Secretary shall from time to time transfer to the disbursing agent under " ["section 231f(b)(4) of this title" -> "/us/usc/t45/s231f/b/4"] " amounts necessary to pay those benefits."
        hash "62de8483875f785f13a8c119a608afeb588665f1c1a20403b21f572a1234c1f2"
      }
      provision "/us/usc/t45/s231n–1/c/2" paragraph {
        num "2" "(2)"
        content "On and after October 1, 1984, any transfer which (but for this paragraph) would be required to be made from the Railroad Retirement Account under paragraph (2) or (4) of " ["section 231f(c) of this title" -> "/us/usc/t45/s231f/c"] " shall be made from the Social Security Equivalent Benefit Account."
        hash "999bd61cc96f5c7508ab62318f550ecd19e3ec8b12e0ef5255d7e703aa4e61e1"
      }
      hash "9f14bf9d66acdbf442cf8c0abd7e16275c3a07638dabd9acd8db44d36dc7694b"
    }
    provision "/us/usc/t45/s231n–1/d" subsection {
      num "d" "(d)"
      heading "Transfers to Social Security Equivalent Benefit Account and National Railroad Retirement Investment Trust"
      provision "/us/usc/t45/s231n–1/d/1" paragraph {
        num "1" "(1)"
        content "Whenever the Board finds that the balance in the Social Security Equivalent Benefit Account will be insufficient to pay social security equivalent benefits which it estimates are due in any month, it shall request the Secretary of the Treasury to transfer from the Railroad Retirement Account to the credit of the Social Security Equivalent Benefit Account such moneys as the Board estimates will be necessary for the payment of such benefits, and the Secretary shall make such transfer."
        hash "5146bc423fa2acb8483f9122814a77ef390705fbd1f1908e7e38551c166fc66c"
      }
      provision "/us/usc/t45/s231n–1/d/2" paragraph {
        num "2" "(2)"
        content "Upon establishment of the National Railroad Retirement Investment Trust and from time to time thereafter, the Board shall direct the Secretary of the Treasury to transfer, in such manner as will maximize the investment returns to the Railroad Retirement system, the balance of the Social Security Equivalent Benefit Account not needed to pay current benefits and administrative expenses required to be paid from that Account to the National Railroad Retirement Investment Trust or the Railroad Retirement Account, and the Secretary shall make that transfer. Any balance transferred under this paragraph shall be used by the National Railroad Retirement Investment Trust or the Railroad Retirement Board only to pay benefits under this subchapter or to purchase obligations of the United States (either directly or through a commingled account consisting only of such obligations) that are backed by the full faith and credit of the United States pursuant to chapter 31 of title 31. The proceeds of sales of, and the interest income from, such obligations shall be used by the Trust only to pay benefits under this subchapter or to purchase such additional obligations."
        hash "9e0054422ea6edb1377db29efdbf3d993966a07c592768ca4c432fbb0d925e52"
      }
      hash "4d2071f61d68a21a36bb0e79461ae9cf3a5828fb6561f5e747c1b17d3a9c920b"
    }
    provision "/us/usc/t45/s231n–1/e" subsection {
      num "e" "(e)"
      heading "Applicability of section 231n"
      content "The provisions of subsections (e), (f), and (g) of " ["section 231n of this title" -> "/us/usc/t45/s231n"] " are hereby made applicable to the Social Security Equivalent Benefit Account."
      hash "3ad79610324df2817e0702ba8a2fdfe002e28049065b62b94e6991b4eb89ec88"
    }
    provision "/us/usc/t45/s231n–1/f" subsection {
      num "f" "(f)"
      heading "References to Railroad Retirement Account deemed references to Social Security Equivalent Benefit Account; “social security equivalent benefits” defined"
      provision "/us/usc/t45/s231n–1/f/1" paragraph {
        num "1" "(1)"
        content "For purposes of making payments of social security equivalent benefits, references in the" mark "1" 1 " subchapter to the Railroad Retirement Account shall be treated as references to the Social Security Equivalent Benefit Account."
        hash "add07dfda558a844a5b97356c4e83388ec7b0515c40777bdb2bf01a586e4d371"
      }
      provision "/us/usc/t45/s231n–1/f/2" paragraph {
        num "2" "(2)"
        content "For purposes of this section, the term “social security equivalent benefits” means benefits payable under this subchapter which are of a kind taken into account in determining the amount of transfers made under " ["section 231f(c)(2) of this title" -> "/us/usc/t45/s231f/c/2"] "."
        hash "c70c28e53cf39e2a87059788d89f232a2b6c9cd62bb4b20b25722609121cf4c9"
      }
      hash "27d9eaf984cec44e6620a49d26845bd7c8fc185ee95b70f7b2ac635af3f3be55"
    }
    hash "566e95e13b7328654505d4aa453a906df301ea728e6a610b6e380e4330acb82d"
  }
  credit "(" ["Aug. 29, 1935, ch. 812, § 15A" -> "/us/act/1935-08-29/ch812/s15A"] ", as added " ["Pub. L. 98–76, title V, § 501(a)" -> "/us/pl/98/76/tV/s501/a"] ", Aug. 12, 1983, " ["97 Stat. 438" -> "/us/stat/97/438"] "; amended " ["Pub. L. 107–90, title I, § 107(c)" -> "/us/pl/107/90/tI/s107/c"] ", Dec. 21, 2001, " ["115 Stat. 888" -> "/us/stat/115/888"] "; " ["Pub. L. 108–203, title IV, § 426(e)" -> "/us/pl/108/203/tIV/s426/e"] ", Mar. 2, 2004, " ["118 Stat. 538" -> "/us/stat/118/538"] ".)"
  note "/us/usc/t45/s231n–1/note/editorialNotes/pl.98.21/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Section 121(e) of the Social Security Amendments of 1983, referred to in subsec. (b)(1)(B), is " ["section 121(e) of Pub. L. 98–21" -> "/us/pl/98/21/s121/e"] ", title I, Apr. 20, 1983, " ["97 Stat. 83" -> "/us/stat/97/83"] ", which is set out as a note under " ["section 401 of Title 42" -> "/us/usc/t42/s401"] ", The Public Health and Welfare."
    hash "32495c291ccf8b895b4deddbdba87ea9599460ca4bc37075f0adc41551f674dc"
  }
  note "/us/usc/t45/s231n–1/note/editorialNotes/pl.108.203/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2004—Subsec. (d)(2). " ["Pub. L. 108–203" -> "/us/pl/108/203"] " inserted “or the Railroad Retirement Account” before “, and the Secretary shall make”, “or the Railroad Retirement Board” before “only to pay benefits”, “(either directly or through a commingled account consisting only of such obligations)” after “obligations of the United States”, and “or to purchase such additional obligations” before period at end."
    p "2001—Subsec. (c)(1). " ["Pub. L. 107–90, § 107(c)(2)" -> "/us/pl/107/90/s107/c/2"] ", inserted at end “The Secretary shall from time to time transfer to the disbursing agent under " ["section 231f(b)(4) of this title" -> "/us/usc/t45/s231f/b/4"] " amounts necessary to pay those benefits.”"
    p "Subsec. (d)(1). " ["Pub. L. 107–90, § 107(c)(3)" -> "/us/pl/107/90/s107/c/3"] ", struck out at end: “Whenever later in such month there is a transfer to the Social Security Equivalent Benefit Account under paragraph (2) or (4) of " ["section 231f(c) of this title" -> "/us/usc/t45/s231f/c"] ", the amount so transferred shall be immediately retransferred to the Railroad Retirement Account. The amount retransferred under the preceding sentence shall not exceed the amount of any outstanding transfers under this paragraph from the Railroad Retirement Account plus such additional amounts determined by the Board to be equal to the loss of interest to the Railroad Retirement Account resulting from such outstanding transfers.”"
    p "Subsec. (d)(2). " ["Pub. L. 107–90, § 107(c)(1)" -> "/us/pl/107/90/s107/c/1"] ", amended par. (2) generally. Prior to amendment, par. (2) read as follows: “Whenever the Board determines that—"
    p "“(A) amounts in the Railroad Retirement Account will not be sufficient to pay the annuities which it estimates are due, or will become due, from such Account, and"
    p "“(B) the transfer under this paragraph will not jeopardize the present or future payment of social security equivalent benefits,"
    p "the Board shall request the Secretary of the Treasury to transfer from the Social Security Equivalent Benefit Account to the Railroad Retirement Account such moneys as the Board estimates will be necessary for the payment of such annuities, and the Secretary shall make such transfer. No transfer under this paragraph shall be required to be repaid.”"
    hash "0beae2fac242d251caf219206cc3e630f9089b9323e3db3b640abd42764eab0a"
  }
  note "/us/usc/t45/s231n–1/note/statutoryNotes/pl.98.76/effective-date" enacted {
    group statutoryNotes
    topic "effectiveDate"
    heading "Effective Date"
    p ["Pub. L. 98–76, title V, § 501(b)(1)" -> "/us/pl/98/76/tV/s501/b/1"] ", Aug. 12, 1983, " ["97 Stat. 440" -> "/us/stat/97/440"] ", provided that:"
    quoted "/us/pl/98/76/tV/s501/b/1" {
      p "“The amendment made by this section [enacting this section] shall take effect on October 1, 1984.”"
    }
    hash "c0609d7489ac0df9e0dd1022c7d842a88e614f691267b8e6d7ff17c0d1dc1281"
  }
  note "/us/usc/t45/s231n–1/note/statutoryNotes/pl.99.514/treatment-of-tier-1-portion-of-tax-imposed-with-respect-to-c" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Treatment of Tier 1 Portion of Tax Imposed With Respect to Compensation Paid Before 1985"
    p ["Pub. L. 98–76, title V, § 501(b)(2)" -> "/us/pl/98/76/tV/s501/b/2"] ", Aug. 12, 1983, " ["97 Stat. 440" -> "/us/stat/97/440"] ", as amended by " ["Pub. L. 99–514, § 2" -> "/us/pl/99/514/s2"] ", Oct. 22, 1986, " ["100 Stat. 2095" -> "/us/stat/100/2095"] ", provided that:"
    quoted "/us/pl/99/514/s2" {
      level subparagraph {
        num "A" "“(A)"
        content "The tier 1 portion of the tax imposed by section 3201, 3211, or 3221 of the Internal Revenue Code of 1986 [formerly I.R.C. 1954] [" ["26 U.S.C. 3201" -> "/us/usc/t26/s3201"] ", 3211, 3221], as the case may be, with respect to compensation paid before 1985 shall be treated as described in subparagraph (A) of section 15A(b)(1) of the Railroad Retirement Act of 1974 [subsec. (b)(1)(A) of this section]."
      }
      level subparagraph {
        num "B" "“(B)"
        content "For purposes of subparagraph (A), the tier 1 portion of any tax is so much of such tax as is determined by reference to the rates of taxes imposed by chapter 21 of the Internal Revenue Code of 1986 [" ["26 U.S.C. 3101" -> "/us/usc/t26/s3101"] " et seq.].”"
      }
    }
    hash "6c67e79077fdbf7e0999d4cd8a5d4b2a4213955f0272f24c7cd8722631abb9bf"
  }
  footnote 1 "1" {
    p "So in original. Probably should be “this”."
  }
  definition "/us/usc/t45/s231n–1/f/2" {
    term "social security equivalent benefits"
    kind means
    words "For purposes of this section"
    region "/us/usc/t45/s231n–1"
    basis restated
  }
  layers {
    operative "566e95e13b7328654505d4aa453a906df301ea728e6a610b6e380e4330acb82d"
    enacted "d557c0ffa219ba13fc859bbfd281da2f660303831f822eb39b2a6aab41d7c35a"
    editorial "a9a2aa51f9326fad4c9e592d2a9b403bfe81167d8eeec876107ea796cea1ecac"
  }
}
