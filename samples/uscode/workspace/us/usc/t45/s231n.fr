  note "/us/usc/t45/s231n/note/statutoryNotes/pl.94.92/effective-date-of-1975-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1975 Amendment"
    p ["Pub. L. 94–92, title II, § 201(e)" -> "/us/pl/94/92/tII/s201/e"] ", Aug. 9, 1975, " ["89 Stat. 465" -> "/us/stat/89/465"] ", provided that:"
    quoted "/us/pl/94/92/tII/s201/e" {
      p "“The amendments [amending this section] made by this section shall be effective January 1, 1975.”"
    }
    hash "08327e0b8dc24899459e2e63187205e941963f8737225af329acd6ce9333fbbc"
