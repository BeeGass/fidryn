  }
  note "/us/usc/t45/s231n/note/statutoryNotes/pl.94.547/effective-date-of-1976-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1976 Amendment"
    p ["Pub. L. 94–547, § 3(b)" -> "/us/pl/94/547/s3/b"] ", Oct. 18, 1976, " ["90 Stat. 2526" -> "/us/stat/90/2526"] ", provided that:"
