  note "/us/usc/t45/s44...46/note/editorialNotes/pl.103.272/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Sections 44 to 46 were transferred to sections 1201 to 1203, respectively, of former Title 49, Transportation, and were subsequently repealed and restated in " ["section 80504 of Title 49" -> "/us/usc/t49/s80504"] ", Transportation, by " ["Pub. L. 103–272" -> "/us/pl/103/272"] ", §§ 1(e), 7(b), July 5, 1994, " ["108 Stat. 1358" -> "/us/stat/108/1358"] ", 1379."
    p "Section 44, acts " ["Feb. 23, 1905, ch. 744, § 1" -> "/us/act/1905-02-23/ch744/s1"] ", " ["33 Stat. 743" -> "/us/stat/33/743"] "; June 13, 1957, " ["Pub. L. 85–50, § 1(1)" -> "/us/pl/85/50/s1/1"] ", " ["71 Stat. 69" -> "/us/stat/71/69"] ", related to awards for acts of heroism involving railroads or motor vehicles."
    p "Section 45, " ["act Feb. 23, 1905, ch. 744, § 2" -> "/us/act/1905-02-23/ch744/s2"] ", " ["33 Stat. 743" -> "/us/stat/33/743"] ", related to issuance of rosettes and ribbons."
    p "Section 46, acts " ["Feb. 23, 1905, ch. 744, § 3" -> "/us/act/1905-02-23/ch744/s3"] ", " ["33 Stat. 743" -> "/us/stat/33/743"] "; June 13, 1957, " ["Pub. L. 85–50, § 1(2)" -> "/us/pl/85/50/s1/2"] ", " ["71 Stat. 69" -> "/us/stat/71/69"] ", related to authorization of appropriations for carrying out sections 44 and 45 of this title."
    hash "ccc9e45c0640d06fd91f1f9f69a00da4ff466555247862a00b0379f57ef80e43"
  }
