edition 2
module "/us/usc/t45/s797l" {
  within "/us/usc/t45/ch16/schVII"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s797l" section {
    num "797l" "§ 797l."
    heading "Class II railroads receiving Federal assistance"
    chapeau "The Surface Transportation Board shall impose no labor protection conditions in approving an application under " ["section 10902 of title 49" -> "/us/usc/t49/s10902"] " when the application involves a Class II rail carrier which—"
    provision "/us/usc/t45/s797l/1" paragraph {
      num "1" "(1)"
      content "is headquartered in a State, and operates in at least one State, with a population of less than 1,000,000 persons, as determined by the 1990 census; and"
      hash "6eea536542c5167ad31e400503176a45d345290f207218affbc150b9705400f2"
    }
    provision "/us/usc/t45/s797l/2" paragraph {
      num "2" "(2)"
      content "has, as of January 1, 1996, been a recipient of repayable Federal Railroad Administration assistance in excess of $5,000,000."
      hash "f20417c0c9b02dbd6edc34cf6c045147d78b22612e13419dd9f243f55ea30f6d"
    }
    hash "608322b83e73b76a48f0deb55f9307c67ef64bf88b0b07f82e6f6da557ac3c39"
  }
  credit "(" ["Pub. L. 93–236, title VII, § 713" -> "/us/pl/93/236/tVII/s713"] ", as added " ["Pub. L. 104–88, title III, § 327(5)(A)" -> "/us/pl/104/88/tIII/s327/5/A"] ", formerly § 327(5), Dec. 29, 1995, " ["109 Stat. 952" -> "/us/stat/109/952"] ", renumbered " ["Pub. L. 104–287, § 6(f)(4)(B)" -> "/us/pl/104/287/s6/f/4/B"] ", Oct. 11, 1996, " ["110 Stat. 3399" -> "/us/stat/110/3399"] ".)"
  note "/us/usc/t45/s797l/note/editorialNotes/pl.93.236/prior-provisions" editorial {
    group editorialNotes
    topic "priorProvisions"
    heading "Prior Provisions"
    p "A prior section 797l, " ["Pub. L. 93–236, title VII, § 713" -> "/us/pl/93/236/tVII/s713"] ", as added " ["Pub. L. 97–35, title XI, § 1143(a)" -> "/us/pl/97/35/tXI/s1143/a"] ", Aug. 13, 1981, " ["95 Stat. 668" -> "/us/stat/95/668"] ", authorized appropriations to carry out activities for protection of employees of Consolidated Rail Corporation, prior to repeal by " ["Pub. L. 99–509, title IV, § 4033(a)(2)" -> "/us/pl/99/509/tIV/s4033/a/2"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "."
