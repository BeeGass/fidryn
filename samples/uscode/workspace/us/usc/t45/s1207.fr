edition 2
module "/us/usc/t45/s1207" {
  within "/us/usc/t45/ch21"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1207" section {
    num "1207" "§ 1207."
    heading "State operation"
    provision "/us/usc/t45/s1207/a" subsection {
      num "a" "(a)"
      heading "Laws, authorities, etc., applicable to State-owned railroad with status as rail carrier engaged in interstate and foreign commerce"
      provision "/us/usc/t45/s1207/a/1" paragraph {
        num "1" "(1)"
        content "After the date of transfer to the State pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] ", the State-owned railroad shall be a rail carrier engaged in interstate and foreign commerce subject to part A of subtitle IV of title 49 and all other Acts applicable to rail carriers subject to that chapter," mark "1" 1 " including the antitrust laws of the United States, except, so long as it is an instrumentality of the State of Alaska, the Railroad Retirement Act of 1974 (" ["45 U.S.C. 231" -> "/us/usc/t45/s231"] " et seq.), the Railroad Retirement Tax Act (" ["26 U.S.C. 3201" -> "/us/usc/t26/s3201"] " et seq.), the Railway Labor Act (" ["45 U.S.C. 151" -> "/us/usc/t45/s151"] " et seq.), the Act of April 22, 1908 (" ["45 U.S.C. 51" -> "/us/usc/t45/s51"] " et seq.) (popularly referred to as the “Federal Employers’ Liability Act”), and the Railroad Unemployment Insurance Act (" ["45 U.S.C. 351" -> "/us/usc/t45/s351"] " et seq.). Nothing in this chapter shall preclude the State from explicitly invoking by law any exemption from the antitrust laws as may otherwise be available."
        hash "3614f009e604fb62961ab2c9a41d80d2d832dc1c160937e9724e39dcfdc3102b"
      }
      provision "/us/usc/t45/s1207/a/2" paragraph {
        num "2" "(2)"
        content "The transfer to the State authorized by " ["section 1203 of this title" -> "/us/usc/t45/s1203"] " and the conferral of jurisdiction to the Interstate Commerce Commission pursuant to paragraph (1) of this subsection are intended to confer upon the State-owned railroad all business opportunities available to comparable railroads, including contract rate agreements meeting the requirements of section 10713" mark "2" 2 " of title 49, notwithstanding any participation in such agreements by connecting water carriers."
        hash "52b13c44c01b5565cb5cd47ffe6f6443a6741c636b0d337885e3c99f353c68af"
      }
      provision "/us/usc/t45/s1207/a/3" paragraph {
        num "3" "(3)"
        content "All memoranda which sanction noncompliance with Federal railroad safety regulations contained in 49 CFR Parts 209–236, and which are in effect on the date of transfer, shall continue in effect according to their terms as “waivers of compliance” (as that term is used in " ["section 20103(d) of title 49" -> "/us/usc/t49/s20103/d"] ")."
        hash "bc81605de31d7e8f055eb816d09441485cc533e6a331601eb899458977b919a5"
      }
      provision "/us/usc/t45/s1207/a/4" paragraph {
        num "4" "(4)"
        content "The operation of trains by the State-owned railroad shall not be subject to the requirement of any State or local law which specifies the minimum number of crew members which must be employed in connection with the operation of such trains."
        hash "4efaa0ce948ced180aa504d5379ab1541253370ccd9c22c32e4c20eff03702f0"
      }
      provision "/us/usc/t45/s1207/a/5" paragraph {
        num "5" "(5)"
        content "Revenues generated by the State-owned railroad, including any amount appropriated or otherwise made available to the State-owned railroad, shall be retained and managed by the State-owned railroad for railroad and related purposes."
        hash "cd923fc1b79ce838514293897267a0edf39b3c6a7275f6c17ddc44118f8ebdda"
      }
      provision "/us/usc/t45/s1207/a/6" paragraph {
        num "6" "(6)"
        provision "/us/usc/t45/s1207/a/6/A" subparagraph {
          num "A" "(A)"
          content "After the date of transfer, continued operation of the Alaska Railroad by a public corporation, authority or other agency of the State shall be deemed to be an exercise of an essential governmental function, and revenue derived from such operation shall be deemed to accrue to the State for the purposes of " ["section 115(a)(1) of title 26" -> "/us/usc/t26/s115/a/1"] ". Obligations issued by such entity shall also be deemed obligations of the State for the purposes of section 103(a)(1) " sup "2" " of title 26, but not obligations within the meaning of section 103(b)(2) " sup "2" " of title 26."
          hash "bc02710b0a87865696c3fd647c672cbabefd2ef7a00d1805a2ff4a968c16d011"
        }
        provision "/us/usc/t45/s1207/a/6/B" subparagraph {
          num "B" "(B)"
          content "Nothing in this chapter shall be deemed or construed to affect customary tax treatment of private investment in the equipment or other assets that are used or owned by the State-owned railroad."
          hash "6034b4d93300febe8869bafbae4cca716573bf9039481a2a02c52cd8f0c93ca3"
        }
        hash "0e8af3549b768084db1c0c4686d2e2cfa1570506c4f4bdc2456cd35bc72d1d92"
      }
      hash "5dd84ffc1f2e03185f37fc473eebd7ee45b0d7d1bd43fa144215227eb9301d1f"
    }
    provision "/us/usc/t45/s1207/b" subsection {
      num "b" "(b)"
      heading "Procedures for issuance of certificate of public convenience and necessity; inventory, valuation, or classification of property; additional laws, authorities, etc., applicable"
      content "As soon as practicable after January 14, 1983, the Interstate Commerce Commission shall promulgate an expedited, modified procedure for providing on the date of transfer a certificate of public convenience and necessity to the State-owned railroad. No inventory, valuation, or classification of property owned or used by the State-owned railroad pursuant to subchapter V " sup "2" " of chapter 107 of title 49 shall be required during the two-year period after the date of transfer. The provisions of the National Environmental Policy Act of 1969 (" ["42 U.S.C. 4321" -> "/us/usc/t42/s4321"] " et seq.) and section 382(b) of the Energy Policy and Conservation Act (" ["42 U.S.C. 6362(b)" -> "/us/usc/t42/s6362/b"] ") shall not apply to actions of the Commission under this subsection."
      hash "a778442b0fb711bce2bbc72429d81a811aa2aed03489f5155df6b8c83c9c0dcb"
    }
    provision "/us/usc/t45/s1207/c" subsection {
      num "c" "(c)"
      heading "Eligibility for participation in Federal railroad assistance programs"
      content "The State-owned railroad shall be eligible to participate in all Federal railroad assistance programs on a basis equal to that of other rail carriers subject to part A of subtitle IV of title 49."
      hash "5bbded6e3907b621597189e4d5a57d8eafb94b64f39894b51aa38b59984bd828"
    }
    provision "/us/usc/t45/s1207/d" subsection {
      num "d" "(d)"
      heading "Laws and regulations applicable to national forest and park lands; limitations on Federal actions"
      content "After the date of transfer to the State pursuant to " ["section 1203 of this title" -> "/us/usc/t45/s1203"] ", the portion of the rail properties within the boundaries of the Chugach National Forest and the exclusive-use easement within the boundaries of the Denali National Park and Preserve shall be subject to laws and regulations for the protection of forest and park values. The right to fence the exclusive-use easement within Denali National Park and Preserve shall be subject to the concurrence of the Secretary of the Interior. The Secretary of the Interior, or the Secretary of Agriculture where appropriate, shall not act pursuant to this subsection without consulting with the Governor of the State of Alaska or in such a manner as to unreasonably interfere with continued or expanded operations and support functions authorized under this chapter."
      hash "51851816e8e045cda8932dfc9447a7c3d960eda5a3d301afc1be2c85fc3955d0"
    }
    provision "/us/usc/t45/s1207/e" subsection {
      num "e" "(e)"
      heading "Preservation and protection of rail properties"
      content "The State-owned railroad may take any necessary or appropriate action, consistent with Federal railroad safety laws, to preserve and protect its rail properties in the interests of safety."
      hash "19b7037d12a02577a0a055b8b7ebcb9fd5aa01f00715893feb4d719dce2d8319"
    }
    hash "03bc5279f4c2d3bbb9e80ad647433876788407b38076f6cbbe9f7fd3e1d2b156"
  }
  credit "(" ["Pub. L. 97–468, title VI, § 608" -> "/us/pl/97/468/tVI/s608"] ", Jan. 14, 1983, " ["96 Stat. 2573" -> "/us/stat/96/2573"] "; " ["Pub. L. 99–514, § 2" -> "/us/pl/99/514/s2"] ", Oct. 22, 1986, " ["100 Stat. 2095" -> "/us/stat/100/2095"] "; " ["Pub. L. 104–88, title III, § 326" -> "/us/pl/104/88/tIII/s326"] ", Dec. 29, 1995, " ["109 Stat. 951" -> "/us/stat/109/951"] "; " ["Pub. L. 108–447, div. H, title I, § 152(1)" -> "/us/pl/108/447/dH/tI/s152/1"] ", (2), Dec. 8, 2004, " ["118 Stat. 3222" -> "/us/stat/118/3222"] ".)"
  note "/us/usc/t45/s1207/note/editorialNotes/act.1935-08-29.ch812/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Railroad Retirement Act of 1974, referred to in subsec. (a)(1), is " ["act Aug. 29, 1935, ch. 812" -> "/us/act/1935-08-29/ch812"] ", as amended generally by " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1305" -> "/us/stat/88/1305"] ", which is classified generally to subchapter IV (§ 231 et seq.) of chapter 9 of this title. For further details and complete classification of this Act to the Code, see Codification note set out preceding " ["section 231 of this title" -> "/us/usc/t45/s231"] ", " ["section 231t of this title" -> "/us/usc/t45/s231t"] ", and Tables."
    p "The Railroad Retirement Tax Act, referred to in subsec. (a)(1), is " ["act Aug. 16, 1954, ch. 736" -> "/us/act/1954-08-16/ch736"] ", §§ 3201, 3202, 3211, 3212, 3221, and 3231 to 3233, " ["68A Stat. 431" -> "/us/stat/68A/431"] ", which is classified generally to chapter 22 (§ 3201 et seq.) of Title 26, Internal Revenue Code. For complete classification of this Act to the Code, see " ["section 3233 of Title 26" -> "/us/usc/t26/s3233"] " and Tables."
    p "The Railway Labor Act, referred to in subsec. (a)(1), is " ["act May 20, 1926, ch. 347" -> "/us/act/1926-05-20/ch347"] ", " ["44 Stat. 577" -> "/us/stat/44/577"] ", which is classified principally to chapter 8 (§ 151 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 151 of this title" -> "/us/usc/t45/s151"] " and Tables."
    p "Act of April 22, 1908 (" ["45 U.S.C. 51" -> "/us/usc/t45/s51"] " et seq.) (popularly referred to as the “Federal Employers’ Liability Act”), referred to in subsec. (a)(1), is " ["act Apr. 22, 1908, ch. 149" -> "/us/act/1908-04-22/ch149"] ", " ["35 Stat. 65" -> "/us/stat/35/65"] ", and is classified generally to chapter 2 (§ 51 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 51 of this title" -> "/us/usc/t45/s51"] " and Tables."
    p "The Railroad Unemployment Insurance Act, referred to in subsec. (a)(1), is " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which is classified principally to chapter 11 (§ 351 et seq.) of this title. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    p ["Section 10713 of title 49" -> "/us/usc/t49/s10713"] ", referred to in subsec. (a)(2), was omitted in the general amendment of subtitle IV of Title 49, Transportation, by " ["Pub. L. 104–88, title I, § 102(a)" -> "/us/pl/104/88/tI/s102/a"] ", Dec. 29, 1995, " ["109 Stat. 804" -> "/us/stat/109/804"] ". Provisions similar to those in section 10713 are contained in " ["section 10709 of Title 49" -> "/us/usc/t49/s10709"] "."
    p "Section 103, referred to in subsec. (a)(6)(A), which related to interest on certain governmental obligations was amended generally by " ["Pub. L. 99–514, title XIII, § 1301(a)" -> "/us/pl/99/514/tXIII/s1301/a"] ", Oct. 22, 1986, " ["100 Stat. 2602" -> "/us/stat/100/2602"] ", and as so amended relates to interest on State and local bonds. Section 103(b)(2), which prior to the general amendment defined industrial development bond, relates to the applicability of the interest exclusion to arbitrage bonds."
    p "Subchapter V of chapter 107 of title 49, referred to in subsec. (b), was omitted in the general amendment of subtitle IV of Title 49, Transportation, by " ["Pub. L. 104–88, title I, § 102(a)" -> "/us/pl/104/88/tI/s102/a"] ", Dec. 29, 1995, " ["109 Stat. 804" -> "/us/stat/109/804"] "."
    p "The National Environmental Policy Act of 1969, referred to in subsec. (b), is " ["Pub. L. 91–190" -> "/us/pl/91/190"] ", Jan. 1, 1970, " ["83 Stat. 852" -> "/us/stat/83/852"] ", which is classified generally to chapter 55 (§ 4321 et seq.) of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see Short Title note set out under " ["section 4321 of Title 42" -> "/us/usc/t42/s4321"] " and Tables."
    hash "71f5871681aba852f255eaee730abfcd2130376d3c19a891e635a525bbc989e8"
  }
  note "/us/usc/t45/s1207/note/editorialNotes/pl.103.272/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "In subsec. (a)(3), “" ["section 20103(d) of title 49" -> "/us/usc/t49/s20103/d"] "” substituted for “section 202(c) of the Federal Railroad Safety Act of 1970 (" ["45 U.S.C. 431(c)" -> "/us/usc/t45/s431/c"] ")” on authority of " ["Pub. L. 103–272, § 6(b)" -> "/us/pl/103/272/s6/b"] ", July 5, 1994, " ["108 Stat. 1378" -> "/us/stat/108/1378"] ", the first section of which enacted subtitles II, III, and V to X of Title 49, Transportation."
    hash "7be17767334c013610716b6632aeb2f56473b7b22cc65ac93c8a541679e61623"
  }
  note "/us/usc/t45/s1207/note/editorialNotes/pl.108.447/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2004—Subsec. (a)(5). " ["Pub. L. 108–447, § 152(1)" -> "/us/pl/108/447/s152/1"] ", inserted “, including any amount appropriated or otherwise made available to the State-owned railroad,” before “shall be retained”."
    p "Subsec. (e). " ["Pub. L. 108–447, § 152(2)" -> "/us/pl/108/447/s152/2"] ", added subsec. (e)."
    p "1995—Subsecs. (a)(1), (c). " ["Pub. L. 104–88" -> "/us/pl/104/88"] " substituted “part A” for “the jurisdiction of the Interstate Commerce Commission under chapter 105”."
    p "1986—Subsec. (a)(6)(A). " ["Pub. L. 99–514" -> "/us/pl/99/514"] " substituted “Internal Revenue Code of 1986” for “Internal Revenue Code of 1954”, which for purposes of codification was translated as “title 26” thus requiring no change in text."
    hash "e4b4e5d54504ed92a6fda2a97c6e0a36b53bbcc0f5876d6459d1f78c3d12a5f5"
  }
  note "/us/usc/t45/s1207/note/statutoryNotes/pl.104.88/effective-date-of-1995-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1995 Amendment"
    p "Amendment by " ["Pub. L. 104–88" -> "/us/pl/104/88"] " effective Jan. 1, 1996, see " ["section 2 of Pub. L. 104–88" -> "/us/pl/104/88/s2"] ", set out as an Effective Date note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ", Transportation."
    hash "16eb732b92d6b0fd94d8511c067f9406d87d2ddd14f399f38f5802eaed297332"
  }
  note "/us/usc/t45/s1207/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  note "/us/usc/t45/s1207/note/statutoryNotes/pl.109.59/alaska-railroad" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Alaska Railroad"
    p ["Pub. L. 109–59, title IX, § 9006" -> "/us/pl/109/59/tIX/s9006"] ", Aug. 10, 2005, " ["119 Stat. 1925" -> "/us/stat/119/1925"] ", provided that:"
    quoted "/us/pl/109/59/tIX/s9006" {
      level subsection {
        num "a" "“(a)"
        heading "Grants.—"
        content "The Secretary [of Transportation] shall make grants to the Alaska Railroad for capital rehabilitation and improvements benefiting its passenger operations."
      }
      level subsection {
        num "b" "“(b)"
        heading "Authorization of Appropriations.—"
        content "There are authorized to be appropriated to carry out this section such sums as may be necessary.”"
      }
    }
    p "Similar provisions were contained in " ["Pub. L. 105–178, title VII, § 7204" -> "/us/pl/105/178/tVII/s7204"] ", June 9, 1998, " ["112 Stat. 477" -> "/us/stat/112/477"] "."
    hash "49d5996d1e6c57e71786d87f64491592ca2e628307287ca843a94dd0767f3cdd"
  }
  footnote 1 "1" {
    p "So in original. Probably should be “that part,”."
  }
  footnote 2 "2" {
    p "See References in Text note below."
  }
  layers {
    operative "03bc5279f4c2d3bbb9e80ad647433876788407b38076f6cbbe9f7fd3e1d2b156"
    enacted "d07245821ca3dc1f79f62147e47122d5036ba3923edbc5a010fec5b708d29cb1"
    editorial "33236eef145c1131e836c394314248a93a4a2d48177f282779706f487f346e50"
  }
}
