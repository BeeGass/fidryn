edition 2
module "/us/usc/t45/s1101" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1101" section {
    num "1101" "§ 1101."
    heading "Congressional findings and declarations"
    chapeau "The Congress finds and declares that—"
    provision "/us/usc/t45/s1101/1" paragraph {
      num "1" "(1)"
      content "the processes set in motion by the Regional Rail Reorganization Act of 1973 [" ["45 U.S.C. 701" -> "/us/usc/t45/s701"] " et seq.] have failed to create a self-sustaining railroad system in the Northeast region of the United States and have cost United States taxpayers many billions of dollars over original estimates;"
      hash "e9ad2b3d7982c438c9e1d17607120ef4370a9f2e6f2d2c4f697f4f5ddaea954d"
    }
    provision "/us/usc/t45/s1101/2" paragraph {
      num "2" "(2)"
      content "current arrangements for the provision of rail freight and commuter service in the Northeast and Midwest regions of the United States are inadequate to meet the transportation needs of the public and the needs of national security;"
      hash "cc72fc9b35c49a041c0cf14a590be7876ec84132d85d946a17ad7799af3fd9da"
    }
    provision "/us/usc/t45/s1101/3" paragraph {
      num "3" "(3)"
      content "although the Federal Government has provided billions of dollars in assistance for Conrail and its employees, the Federal interest in ensuring the flow of interstate commerce through rail service in the private sector has not been achieved, and the protection of interstate commerce requires Federal intervention to preserve essential rail service in the private sector;"
      hash "a5546210f3405c70e301480a9798bceb2ed8734a714995a19cad36c309ac0f1c"
    }
    provision "/us/usc/t45/s1101/4" paragraph {
      num "4" "(4)"
      content "the provisions for protection of employees of bankrupt railroads contained in the Regional Rail Reorganization Act of 1973 [" ["45 U.S.C. 701" -> "/us/usc/t45/s701"] " et seq.] have resulted in the payment of benefits far in excess of levels anticipated at the time of enactment, have imposed an excessive fiscal burden on the Federal taxpayer, and are now an obstacle to the establishment of improved rail service and continued rail employment in the Northeast region of the United States; and"
      hash "44f92750afa73df0acb2b89bc346b5d5e29ad9923385dda00dc137d72e3193dc"
    }
    provision "/us/usc/t45/s1101/5" paragraph {
      num "5" "(5)"
      content "since holding Conrail liable for employee protection payments would destroy its prospects of becoming a profitable carrier and further injure its employees, an alternative employee protection system must be developed and funded."
      hash "c00adb50abda0fe33897035c20e8235ef8df24e996c72eeb101bc96fd6c46f76"
    }
    hash "4996358011f3f839e4e0fcfd03cb19520801077ccd84a0f4b183a0cc7a854dd9"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1132" -> "/us/pl/97/35/tXI/s1132"] ", Aug. 13, 1981, " ["95 Stat. 644" -> "/us/stat/95/644"] ".)"
  note "/us/usc/t45/s1101/note/editorialNotes/pl.93.236/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Regional Rail Reorganization Act of 1973, referred to in pars. (1) and (4), is " ["Pub. L. 93–236" -> "/us/pl/93/236"] ", Jan. 2, 1974, " ["87 Stat. 985" -> "/us/stat/87/985"] ", which is classified principally to chapter 16 (§ 701 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 701 of this title" -> "/us/usc/t45/s701"] " and Tables."
    hash "4e5fcc6a5d4cc7dbb2ef6c646ee55cc5b2241765aeff1cfb8785d8dbe10fd85d"
  }
  note "/us/usc/t45/s1101/note/statutoryNotes/pl.97.35/effective-date" enacted {
    group statutoryNotes
    topic "effectiveDate"
    heading "Effective Date"
    p ["Pub. L. 97–35, title XI, § 1169" -> "/us/pl/97/35/tXI/s1169"] ", Aug. 13, 1981, " ["95 Stat. 687" -> "/us/stat/95/687"] ", provided that:"
    quoted "/us/pl/97/35/tXI/s1169" {
      p "“Except as otherwise provided, the provisions of and the amendments made by this subtitle [subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", see Short Title note set out below] shall take effect on the date of the enactment of this subtitle [Aug. 13, 1981].”"
    }
    hash "de5ba64209b563e07d19f6bbdbd7b68f65437d497546408d2e860acf5e5f9257"
  }
  note "/us/usc/t45/s1101/note/statutoryNotes/pl.97.35/short-title" enacted {
    group statutoryNotes
    topic "shortTitle"
    heading "Short Title"
    p ["Pub. L. 97–35, title XI, § 1131" -> "/us/pl/97/35/tXI/s1131"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", provided that:"
    quoted "/us/pl/97/35/tXI/s1131" {
      p "“This subtitle [subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", enacting this chapter, and sections 159a, 581 to 590, 727 to 729, 744a, 748, 761 to 769c, and 797 to 797m of this title, amending sections 601, 702, 711 to 713, 724, 741, 743, 745, 821, 825, and 829 of this title, repealing sections 771 to 780, 910, and 1006 of this title, and enacting provisions set out as notes under sections 744a, 771, and 1101 of this title] may be cited as the ‘Northeast Rail Service Act of 1981’.”"
    }
    hash "576f130110795822de6f9bc406ae7a1b790a10e3115b25f6437f112c6be99813"
  }
  layers {
    operative "4996358011f3f839e4e0fcfd03cb19520801077ccd84a0f4b183a0cc7a854dd9"
    enacted "f5a2b6e8aabc06ed731133a70873f7866a21e656459f6904d2896c741c3361e4"
    editorial "315171bf7fc178f298c107ca5af43410a345195898849ae755066281f25861cd"
  }
}
