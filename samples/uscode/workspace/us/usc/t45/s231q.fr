edition 2
module "/us/usc/t45/s231q" {
  within "/us/usc/t45/ch9/schIV"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s231q" section {
    num "231q" "§ 231q."
    heading "Crediting service under Social Security Act"
    provision "/us/usc/t45/s231q/1" paragraph {
      num "1" "(1)"
      content "Except as provided in subdivision (2), the term “employment” as defined in section 216 of the Social Security Act [" ["42 U.S.C. 416" -> "/us/usc/t42/s416"] "] shall not include service performed by an individual as an employee as defined in " ["section 231(b) of this title" -> "/us/usc/t45/s231/b"] "."
      hash "6bf88084845ff4239317298eb120fc696238c282f198a51106b1bfd27282c6fb"
    }
    provision "/us/usc/t45/s231q/2" paragraph {
      num "2" "(2)"
      content "For the purpose of determining (i) monthly insurance benefits under the Social Security Act [" ["42 U.S.C. 301" -> "/us/usc/t42/s301"] " et seq.] to an employee who will have completed less than ten years of service (or less than five years of service, all of which accrues after December 31, 1995) and to others deriving from him or her during his or her life and (ii) monthly insurance benefits and lump-sum death benefits under such Act with respect to the death of an employee who (A) will have completed less than ten years of service (or less than five years of service, all of which accrues after December 31, 1995) or (B) will have completed ten or more years of service (or five or more years of service, all of which accrues after December 31, 1995) but will not have had a current connection with the railroad industry at the time of his death, and for the purposes of section 203 and section 216(i) of that Act [" ["42 U.S.C. 403" -> "/us/usc/t42/s403"] ", 416(i)], section 210(a)(9) of the Social Security Act [" ["42 U.S.C. 410(a)(9)" -> "/us/usc/t42/s410/a/9"] "] and subdivision (1) of this section shall not operate to exclude from “employment” under the Social Security Act service which would otherwise be included in such “employment” but for such sections. For such purpose, compensation paid in a calendar year shall, in the absence of evidence to the contrary, be presumed to have been paid in equal proportions with respect to all months in the year in which the employee will have been in service as an employee. In the application of the Social Security Act pursuant to this subdivision to service as an employee, all service as defined in " ["section 231(d) of this title" -> "/us/usc/t45/s231/d"] " shall be deemed to have been performed within the United States."
      hash "cd0539381ec24cd7fb64f98adda35ccfb65d554672067d01db778d82e2fb3763"
    }
    hash "02579cfcaf5b91136809c21f0721ca922fab6af96198d8e8938b747e8dc78279"
  }
  credit "(" ["Aug. 29, 1935, ch. 812, § 18" -> "/us/act/1935-08-29/ch812/s18"] ", as restated " ["June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", pt. I, " ["50 Stat. 307" -> "/us/stat/50/307"] ", as restated " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1349" -> "/us/stat/88/1349"] "; amended " ["Pub. L. 97–35, title XI, § 1125" -> "/us/pl/97/35/tXI/s1125"] ", Aug. 13, 1981, " ["95 Stat. 639" -> "/us/stat/95/639"] "; " ["Pub. L. 107–90, title I, § 103(g)" -> "/us/pl/107/90/tI/s103/g"] ", Dec. 21, 2001, " ["115 Stat. 881" -> "/us/stat/115/881"] ".)"
  note "/us/usc/t45/s231q/note/editorialNotes/act.1935-08-14.ch531/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Social Security Act, referred to in par. (2), is " ["act Aug. 14, 1935, ch. 531" -> "/us/act/1935-08-14/ch531"] ", " ["49 Stat. 620" -> "/us/stat/49/620"] ", which is classified generally to chapter 7 (§ 301 et seq.) of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see " ["section 1305 of Title 42" -> "/us/usc/t42/s1305"] " and Tables."
    hash "62fcefd23acd91da8e75e80198047914fba321aa5f008a77bc9674598146d3ad"
  }
  note "/us/usc/t45/s231q/note/editorialNotes/pl.107.90/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2001—Par. (2). " ["Pub. L. 107–90" -> "/us/pl/107/90"] " inserted “(or less than five years of service, all of which accrues after December 31, 1995)” after “ten years of service” in two places and inserted “(or five or more years of service, all of which accrues after December 31, 1995)” after “ten or more years of service”."
    p "1981—Par. (2). " ["Pub. L. 97–35" -> "/us/pl/97/35"] " inserted “and section 216(i)” after “203”."
    hash "a575eed8c99e8e192f0a6fa38830c3558727821336949e7fe81e801f1b2681dc"
  }
  note "/us/usc/t45/s231q/note/statutoryNotes/pl.107.90/effective-date-of-2001-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 2001 Amendment"
    p "Amendment by " ["Pub. L. 107–90" -> "/us/pl/107/90"] " effective Jan. 1, 2002, see " ["section 103(j) of Pub. L. 107–90" -> "/us/pl/107/90/s103/j"] ", set out as a note under " ["section 405 of Title 42" -> "/us/usc/t42/s405"] ", The Public Health and Welfare."
    hash "0130bc1cbea49fe3f27ee02f0e294b2913a7bccef7be11ea8b35d37121b4e20a"
  }
  note "/us/usc/t45/s231q/note/statutoryNotes/pl.97.35/effective-date-of-1981-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1981 Amendment"
    p "Amendment by " ["Pub. L. 97–35" -> "/us/pl/97/35"] " effective Jan. 1, 1975, see " ["section 1129(b)(2) of Pub. L. 97–35" -> "/us/pl/97/35/s1129/b/2"] ", set out as a note under " ["section 231 of this title" -> "/us/usc/t45/s231"] "."
    hash "9b2c0d4d3bd3a24547aa9edd8c3ff35cc3683b3847c536390bf16679c3514c52"
  }
  layers {
    operative "02579cfcaf5b91136809c21f0721ca922fab6af96198d8e8938b747e8dc78279"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "1f76a33c787fe9a4f4a759d8a352456278170e2b481af442082105e1e1a8b56e"
  }
}
