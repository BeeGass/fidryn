  provision "/us/usc/t45/s366" section {
    num "366" "§ 366."
    heading "Separability"
    content "If any provision of this chapter or the application there of to any person or circumstance is held invalid, the application of such provision to other persons or circumstances, and the remainder of this chapter shall not be affected thereby."
    hash "25c23fe9a6a1671238b69b56aa6cc5dc1716b558a6968e53b1ebe9642c87086e"
  }
  credit "(" ["June 25, 1938, ch. 680, § 16" -> "/us/act/1938-06-25/ch680/s16"] ", " ["52 Stat. 1113" -> "/us/stat/52/1113"] ".)"
  note "/us/usc/t45/s366/note/editorialNotes/act.1938-06-25.ch680/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This chapter, referred to in text, was in the original “this Act”, meaning " ["act June 25, 1938, ch. 680" -> "/us/act/1938-06-25/ch680"] ", " ["52 Stat. 1094" -> "/us/stat/52/1094"] ", which enacted this chapter and amended sections 503 and 1104 and former " ["section 1107 of Title 42" -> "/us/usc/t42/s1107"] ", The Public Health and Welfare. For complete classification of this Act to the Code, see " ["section 367 of this title" -> "/us/usc/t45/s367"] " and Tables."
    hash "7f40dec236ae0b77696bd1507c7a445f083ac012d82b2af4b0a24fdc241110b8"
  }
