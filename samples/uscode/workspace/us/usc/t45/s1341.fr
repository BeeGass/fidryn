edition 2
module "/us/usc/t45/s1341" {
  within "/us/usc/t45/ch22/schII/ptC"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1341" section {
    num "1341" "§ 1341."
    heading "Abolition of United States Railway Association"
    provision "/us/usc/t45/s1341/a" subsection {
      num "a" "(a)"
      heading "Abolition and termination"
      provision "/us/usc/t45/s1341/a/1" paragraph {
        num "1" "(1)"
        content "Effective April 1, 1987, the United States Railway Association is abolished."
        hash "ebc948690d93e1292843c7b4f8dcaa7af6b6586f06cec22b838fb70463668fdf"
      }
      provision "/us/usc/t45/s1341/a/2" paragraph {
        num "2" "(2)"
        content "On January 1, 1987, all powers, duties, rights, and obligations of such association relating to the Corporation under the Regional Rail Reorganization Act of 1973 (" ["45 U.S.C. 701" -> "/us/usc/t45/s701"] " et seq.) shall be transferred to the Secretary of Transportation."
        hash "5a40419c11cba4c0fed19878bbdde283a36e9d1b2e6ba75d78e42b93317c69ab"
      }
      provision "/us/usc/t45/s1341/a/3" paragraph {
        num "3" "(3)"
        content "The sole function of the United States Railway Association after January 1, 1987, shall be the termination of its affairs and the liquidation of its assets."
        hash "f07a9c678395f7fd19606c0e82fa4c69d0872e2829e5fe4c8e8be3c48f5c4b2c"
      }
      hash "e7439353f0d95da391460d32da6d4727104140608c166c370ae008c7ea561adf"
    }
    provision "/us/usc/t45/s1341/b" subsection {
      num "b" "(b)"
      heading "Transfer of securities and responsibilities"
      provision "/us/usc/t45/s1341/b/1" paragraph {
        num "1" "(1)"
        content "Any securities of the Corporation held by the United States Railway Association shall, upon" mark "1" 1 " October 21, 1986, be transferred to the Secretary of Transportation."
        hash "0257398eef4ddf41d82ba4ed5472efd26ea8f360c75dda02e6089c38e4abd966"
      }
      provision "/us/usc/t45/s1341/b/2" paragraph {
        num "2" "(2)"
        content "If, on the date the United States Railway Association is abolished under subsection (a), such association shall not have completed the termination of its affairs and the liquidation of its assets, the duty of completing such winding up of its affairs and liquidation shall be transferred to the Secretary of Transportation, who for such purposes shall succeed to all remaining powers, duties, rights, and obligations of such association."
        hash "20cfcb48d6c46c699ea865169fb908efbaeb628122da617412aa9839b58ffa0a"
      }
      hash "8e3f1bac2c4aea88fe042f28679d554f837b15a04a584f2d676a0aef24456408"
    }
    provision "/us/usc/t45/s1341/c" subsection {
      num "c" "(c)"
      heading "Financing agreement"
      provision "/us/usc/t45/s1341/c/1" paragraph {
        num "1" "(1)"
        content "On January 1, 1987, the Amended and Restated Financing Agreement, dated May 10, 1979, between the United States Railway Association and the Corporation, together with any and all rights and obligations of or on behalf of any person with respect to such agreement, shall terminate and be of no further force or effect, except for those provisions specifying terms and conditions for payments made to the United States with respect to debentures, preferred stock, and contingent interest notes."
        hash "0766a47b7c019d79cf2cd414fe901fd72657700e8f7947adeed74a1ab3a9daa4"
      }
      provision "/us/usc/t45/s1341/c/2" paragraph {
        num "2" "(2)"
        content "Effective as of the sale date, those provisions of the Financing Agreement referred to in paragraph (1) shall terminate."
        hash "b8bb795d51faaa60aeeb0c9b10077e6a79445555cf21e8018d81c318e908890a"
      }
      hash "a11dcdffc9036d075ffa82a5834c0d4e3070553020a446f8d023497d4065a267"
    }
    hash "a6cbeb542cd3fa7113cb31919e58a930cbd08f1500375d8278a0bc3fbb7bbbf7"
  }
  credit "(" ["Pub. L. 99–509, title IV, § 4031" -> "/us/pl/99/509/tIV/s4031"] ", Oct. 21, 1986, " ["100 Stat. 1906" -> "/us/stat/100/1906"] ".)"
  note "/us/usc/t45/s1341/note/editorialNotes/pl.93.236/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Regional Rail Reorganization Act of 1973, referred to in subsec. (a)(2), is " ["Pub. L. 93–236" -> "/us/pl/93/236"] ", Jan. 2, 1974, " ["87 Stat. 985" -> "/us/stat/87/985"] ", which is classified principally to chapter 16 (§ 701 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 701 of this title" -> "/us/usc/t45/s701"] " and Tables."
    hash "8f41148cf76ce210bd650836ae7636412949670b053bb9683ae3f367e7aeaa1c"
  }
  footnote 1 "1" {
    p "So in original. Probably should be “on”."
  }
  layers {
    operative "a6cbeb542cd3fa7113cb31919e58a930cbd08f1500375d8278a0bc3fbb7bbbf7"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "a5605721fd0895c1dd57ad2654ab197069460382a381704075512458db35ead7"
  }
}
