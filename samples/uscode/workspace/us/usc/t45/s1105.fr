edition 2
module "/us/usc/t45/s1105" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1105" section {
    num "1105" "§ 1105."
    heading "Judicial review"
    provision "/us/usc/t45/s1105/a" subsection {
      num "a" "(a)"
      heading "Special court; exclusive jurisdiction for civil actions"
      chapeau "Notwithstanding any other provision of law, the special court shall have original and exclusive jurisdiction over any civil action—"
      provision "/us/usc/t45/s1105/a/1" paragraph {
        num "1" "(1)"
        content "for injunctive, declaratory, or other relief relating to the enforcement, operation, execution, or interpretation of any provision of or amendment made by this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.], or administrative action taken thereunder to the extent such action is subject to judicial review;"
        hash "b18d43c630c20f0ae3d5c3471767b6ffe5472434608477099c8bc2c95a6d18a5"
      }
      provision "/us/usc/t45/s1105/a/2" paragraph {
        num "2" "(2)"
        content "challenging the constitutionality of any provision of or amendment made by this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.];"
        hash "b71238b9dcc378bc6f982c9f955aca7f6211843eb757063868bb35ac02757038"
      }
      provision "/us/usc/t45/s1105/a/3" paragraph {
        num "3" "(3)"
        content "to obtain, inspect, copy, or review any document in the possession or control of the Secretary, Conrail, the United States Railway Association, or Amtrak that would be discoverable in litigation under any provision of or amendment made by this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.]; or"
        hash "7087ee4e0f17a66fd54e11f8259d4dc15768e649dcf06297bf00e963e279485b"
      }
      provision "/us/usc/t45/s1105/a/4" paragraph {
        num "4" "(4)"
        content "seeking judgment upon any claim against the United States founded upon the Constitution and resulting from the operation of any provision of or amendment made by this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.]."
        hash "0272a19ab41bf93db119366c674a1d9df372ea33df269e6e198b46b4be7fff9b"
      }
      hash "7b804842493e1c286ccaf06fd61d5f140ec1acffd5440e3e94ab9d3a8088aa89"
    }
    provision "/us/usc/t45/s1105/b" subsection {
      num "b" "(b)"
      heading "Appeal"
      content "An order or judgment of the United States District Court for the District of Columbia in any action referred to in this section shall be reviewable in accordance with sections 1291, 1292, and 1294 of title 28."
      hash "ad19ff357ff80b94bef8b69103d4483ca2df8fddd48e379119717de9beeb453c"
    }
    provision "/us/usc/t45/s1105/c" subsection {
      num "c" "(c)"
      heading "Scope of review of administrative actions"
      content "Administrative action under the provisions of or amendments made by this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.] which is subject to review shall be upheld unless such action is found to be unlawful under standards established for review of informal agency action under paragraphs (2)(A), (B), (C), and (D) of " ["section 706 of title 5" -> "/us/usc/t5/s706"] ". The requirements of this subtitle or part 2 of the Conrail Privatization Act [" ["45 U.S.C. 1311" -> "/us/usc/t45/s1311"] " et seq.], as the case may be, shall constitute the exclusive procedures required by law for such administrative action."
      hash "300a0a2f40c544a62071be2fa357d3c2ac48a13d48c27353010504401ee7169a"
    }
    hash "dbd4f710d0e819500d005c859fcf43eccfa89ea6482d184a9fd6ee1321063492"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1152" -> "/us/pl/97/35/tXI/s1152"] ", Aug. 13, 1981, " ["95 Stat. 676" -> "/us/stat/95/676"] "; " ["Pub. L. 99–509, title IV, § 4033(c)(1)(A)" -> "/us/pl/99/509/tIV/s4033/c/1/A"] ", Oct. 21, 1986, " ["100 Stat. 1908" -> "/us/stat/100/1908"] "; " ["Pub. L. 100–352, § 6(f)" -> "/us/pl/100/352/s6/f"] ", June 27, 1988, " ["102 Stat. 664" -> "/us/stat/102/664"] "; " ["Pub. L. 104–317, title VI, § 605(b)(3)" -> "/us/pl/104/317/tVI/s605/b/3"] ", (c)(4), Oct. 19, 1996, " ["110 Stat. 3859" -> "/us/stat/110/3859"] ".)"
  note "/us/usc/t45/s1105/note/editorialNotes/pl.97.35/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This subtitle, referred to in subsecs. (a) and (c), is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", known as the Northeast Rail Service Act of 1981. For complete classification of this subtitle to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    p "The Conrail Privatization Act, referred to in subsecs. (a) and (c), is subtitle A (§§ 4001–4052) of title IV of " ["Pub. L. 99–509" -> "/us/pl/99/509"] ", Oct. 21, 1986, " ["100 Stat. 1892" -> "/us/stat/100/1892"] ". Part 2 of that Act is classified principally to subchapter II (§ 1311 et seq.) of chapter 22 of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 1301 of this title" -> "/us/usc/t45/s1301"] " and Tables."
    hash "e25609a85b3502fd7346789edb348d68265f0dff855414d33e96c37ddb6c8508"
  }
  note "/us/usc/t45/s1105/note/editorialNotes/pl.104.317/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1996—Subsec. (b). " ["Pub. L. 104–317, § 605(b)(3)" -> "/us/pl/104/317/s605/b/3"] ", added heading and text of subsec. (b) and struck out former subsec. (b) which read as follows: “A judgment of the special court in any action referred to in this section shall be reviewable only upon petition for a writ of certiorari to the Supreme Court of the United States. Such review is exclusive and any such petition shall be filed in the Supreme Court not more than 20 days after entry of such order or judgment.”"
    p "Subsec. (d). " ["Pub. L. 104–317, § 605(c)(4)" -> "/us/pl/104/317/s605/c/4"] ", struck out subsec. (d) which read as follows: “If the volume of civil actions under subsection (a) of this section so requires, the United States Railway Association shall apply to the judicial panel on multi-district litigation authorized by " ["section 1407 of title 28" -> "/us/usc/t28/s1407"] " for the assignment of additional judges to the special court. Within 30 days after the date of such application, the panel shall assign to the special court such additional judges as may be necessary to exercise the jurisdiction described in subsection (a) of this section.”"
    p "1988—Subsec. (b). " ["Pub. L. 100–352" -> "/us/pl/100/352"] " struck out “, except that any order or judgment enjoining the enforcement, or declaring or determining the unconstitutionality or invalidity, of any provision of this subtitle shall be reviewable by direct appeal to the Supreme Court of the United States” at end of first sentence and substituted “such petition shall be filed in the Supreme Court” for “petition or appeal shall be filed” in second sentence."
    p "1986—Subsecs. (a), (b). " ["Pub. L. 99–509, § 4033(c)(1)(A)(i)" -> "/us/pl/99/509/s4033/c/1/A/i"] ", inserted “or part 2 of the Conrail Privatization Act” after “subtitle” wherever appearing."
    p "Subsec. (c). " ["Pub. L. 99–509, § 4033(c)(1)(A)" -> "/us/pl/99/509/s4033/c/1/A"] ", inserted “or part 2 of the Conrail Privatization Act” after “subtitle” in first sentence and “or part 2 of the Conrail Privatization Act, as the case may be,” after “subtitle” in second sentence."
    hash "c23df0de33e04566cd1e7d094ac1fc7dfe4d602ab1d638475e9e262997a6beda"
  }
  note "/us/usc/t45/s1105/note/statutoryNotes/pl.104.317/effective-date-of-1996-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1996 Amendment"
    p "Amendment by " ["Pub. L. 104–317" -> "/us/pl/104/317"] " effective 90 days after Oct. 19, 1996, and except as otherwise provided, applicable to proceedings that arise or continue after such effective date, see " ["section 605(e) of Pub. L. 104–317" -> "/us/pl/104/317/s605/e"] ", set out as a note under " ["section 719 of this title" -> "/us/usc/t45/s719"] "."
    hash "5738327b8d935a396acd7128541b68a5aca7d2af8e8abb78fb66fd0602156b40"
  }
  note "/us/usc/t45/s1105/note/statutoryNotes/pl.100.352/effective-date-of-1988-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1988 Amendment"
    p "Amendment by " ["Pub. L. 100–352" -> "/us/pl/100/352"] " effective ninety days after June 27, 1988, except that such amendment not to apply to cases pending in Supreme Court on such effective date or affect right to review or manner of reviewing judgment or decree of court which was entered before such effective date, see " ["section 7 of Pub. L. 100–352" -> "/us/pl/100/352/s7"] ", set out as a note under " ["section 1254 of Title 28" -> "/us/usc/t28/s1254"] ", Judiciary and Judicial Procedure."
    hash "feff9722fe583140dc628b7a0fa8adfc8defc8e4756e12aae08abbfdb687d079"
  }
  note "/us/usc/t45/s1105/note/statutoryNotes/pl.104.317/cases-pending-in-special-court" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Cases Pending in Special Court"
    p "For applicability of amendment by " ["Pub. L. 104–317" -> "/us/pl/104/317"] " to cases pending in special court established under " ["section 719(b) of this title" -> "/us/usc/t45/s719/b"] ", see " ["section 605(d) of Pub. L. 104–317" -> "/us/pl/104/317/s605/d"] ", set out as a note under " ["section 719 of this title" -> "/us/usc/t45/s719"] "."
    hash "bf9e53b9760c06f1e7c46589af9e28a3f4cfda82afc8255912891b5cf80e2be7"
  }
  note "/us/usc/t45/s1105/note/statutoryNotes/nolaw/abolition-of-united-states-railway-association-and-transfer" editorial {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of United States Railway Association and Transfer of Functions and Securities"
    p "See " ["section 1341 of this title" -> "/us/usc/t45/s1341"] "."
    hash "cd850284f13614ffb2ee8fa50fe039a8021d217044da0d43075361bd126dc4fd"
  }
  layers {
    operative "dbd4f710d0e819500d005c859fcf43eccfa89ea6482d184a9fd6ee1321063492"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "361059b9c0dd8fefb4825767967624cd8f3910f063acc1aaeec3af2feba96cc0"
  }
}
