  provision "/us/usc/t45/s231t" section {
    num "231t" "§ 231t."
    heading "Short title"
    content "This subchapter may be cited as the “Railroad Retirement Act of 1974”."
    hash "1ab8a32f0507a9e5206c2ee23c79670a96dcd26a9b0b6802b13e86b2d48dd62a"
  }
  credit "(" ["Aug. 29, 1935, ch. 812, § 21" -> "/us/act/1935-08-29/ch812/s21"] ", as restated " ["June 24, 1937, ch. 382" -> "/us/act/1937-06-24/ch382"] ", pt. I, " ["50 Stat. 307" -> "/us/stat/50/307"] ", as restated " ["Pub. L. 93–445, title I, § 101" -> "/us/pl/93/445/tI/s101"] ", Oct. 16, 1974, " ["88 Stat. 1351" -> "/us/stat/88/1351"] ".)"
  note "/us/usc/t45/s231t/note/statutoryNotes/pl.109.478/short-title-of-2007-amendment" enacted {
    group statutoryNotes
    topic "shortTitleOfAmendment"
    heading "Short Title of 2007 Amendment"
    p ["Pub. L. 109–478, § 1" -> "/us/pl/109/478/s1"] ", Jan. 12, 2007, " ["120 Stat. 3573" -> "/us/stat/120/3573"] ", provided that:"
    quoted "/us/pl/109/478/s1" {
      p "“This Act [amending " ["section 231a of this title" -> "/us/usc/t45/s231a"] " and enacting provisions set out as a note under " ["section 231a of this title" -> "/us/usc/t45/s231a"] "] may be cited as the ‘Railroad Retirement Disability Earnings Act’.”"
    }
    hash "a872db5ef2c1fe94c25d76476e71ae6f22d22f5aa222bac6f43343ff92b74959"
  }
  note "/us/usc/t45/s231t/note/statutoryNotes/pl.109.305/short-title-of-2006-amendment" enacted {
    group statutoryNotes
    topic "shortTitleOfAmendment"
    heading "Short Title of 2006 Amendment"
    p ["Pub. L. 109–305, § 1" -> "/us/pl/109/305/s1"] ", Oct. 6, 2006, " ["120 Stat. 1719" -> "/us/stat/120/1719"] ", provided that:"
    quoted "/us/pl/109/305/s1" {
      p "“This Act [amending " ["section 231f of this title" -> "/us/usc/t45/s231f"] "] may be cited as the ‘Railroad Retirement Technical Improvement Act of 2006’.”"
    }
    hash "dca8f68024f1c0d8a23879b0a8a4c5a241d8b7ecfe8a17740865835176a9b21d"
