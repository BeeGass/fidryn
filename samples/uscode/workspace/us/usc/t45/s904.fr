edition 2
module "/us/usc/t45/s904" {
  within "/us/usc/t45/ch18"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s904" section {
    num "904" "§ 904."
    heading "Court approved abandonments and sales"
    provision "/us/usc/t45/s904/a" subsection {
      num "a" "(a)"
      heading "Abandonment of lines of railroad under " ["section 1170 of title 11" -> "/us/usc/t11/s1170"]
      provision "/us/usc/t45/s904/a/1" paragraph {
        num "1" "(1)"
        content "Upon the occurrence of an event described in " ["section 920(b) of this title" -> "/us/usc/t45/s920/b"] ", or on April 1, 1980, whichever first occurs, the bankruptcy court may authorize the abandonment of lines of the Milwaukee Railroad pursuant to " ["section 1170 of title 11" -> "/us/usc/t11/s1170"] ". Pending the expiration of the time for appeal of an abandonment order or the determination of any such appeal, the bankruptcy court may authorize the termination of service on a line to be abandoned, and the order authorizing such termination may not be stayed. In authorizing any abandonment pursuant to this section, the court shall require the carrier to provide a fair arrangement at least as protective of the interests of employees as that required under section 11347" mark "1" 1 " of title 49."
        hash "8edec1ab9eca275973a41768a9e93850afa50385f3644ba5ec1dfdef5ee5b5a6"
      }
      provision "/us/usc/t45/s904/a/2" paragraph {
        num "2" "(2)"
        content "Prior to the date specified in paragraph (1) of this subsection, the bankruptcy court may hear and consider any request for the abandonment of lines of the Milwaukee Railroad, and may fix the time for the Commission’s report on the request, but it may take final action authorizing such abandonment only in accordance with such paragraph (1)."
        hash "ffa80ec11a6fd44a072a8624b3941ba4b3d910c1fad1d1da0fabe3680f4b0c3f"
      }
      hash "d69da8d48535720190d4a152666f14ce726261c0997d9176a44a740568959e01"
    }
    provision "/us/usc/t45/s904/b" subsection {
      num "b" "(b)"
      heading "Sale or transfer of lines of railroad"
      provision "/us/usc/t45/s904/b/1" paragraph {
        num "1" "(1)"
        content "Upon the occurrence of an event described in " ["section 920(b) of this title" -> "/us/usc/t45/s920/b"] ", or on April 1, 1980, whichever first occurs, the bankruptcy court may authorize the sale or transfer of a line of the Milwaukee Railroad to be used in continued rail operations, subject to the approval of the Commission under paragraph (2) of this subsection. In authorizing any such sale or transfer, the court shall provide a fair arrangement at least as protective of the interest" mark "2" 2 " of employees as that required under section 11347 " sup "1" " of title 49."
        hash "c8f857f9380347f8158d48d4aa93db6de39e860c2d87cac5c7c803ac1ce6bbad"
      }
      provision "/us/usc/t45/s904/b/2" paragraph {
        num "2" "(2)"
        content "The bankruptcy court may not authorize a sale or transfer pursuant to paragraph (1) of this subsection unless an appropriate application with respect to such sale or transfer is initiated with the Commission and, within such time as the court may fix, not exceeding 180 days, the Commission, with or without a hearing, as the Commission may determine, and with or without modification or condition, approves such application, or does not act on such application. Any action or order of the Commission approving, modifying, conditioning, or disapproving such application is subject to review by the court only under sections 706(2)(A), 706(2)(B), 706(2)(C), and 706(2)(D) of title 5. An application may be initiated with the Commission prior to the date specified in paragraph (1) of this subsection."
        hash "f3e1973f15ed1beb3968b7441c83afc02725e0ecbac04c7cd62fe91d05d854eb"
      }
      provision "/us/usc/t45/s904/b/3" paragraph {
        num "3" "(3)"
        content "Pending review of an application by the Commission pursuant to paragraph (2) of this subsection, the bankruptcy court may, on a preliminary basis, authorize the sale or transfer of lines of the Milwaukee Railroad to another rail carrier. The court may permit the purchasing carrier to operate interim service as a common carrier over the lines to be purchased, without regard to " ["section 10901 of title 49" -> "/us/usc/t49/s10901"] ". In operating such service, the purchasing carrier shall use employees of the Milwaukee Railroad to the extent necessary for the operation of such service. The bankruptcy court may take final action authorizing any such sale or transfer only in accordance with paragraph (1) of this subsection."
        hash "69a7f166f417cc39fc9219b52336d4a395a1dd777408ee4bd3a24e88f3c5c2e7"
      }
      hash "abd3dd15018ec42367604c7068a4088d7c6d59fa54576db31be55b69adf630bf"
    }
    provision "/us/usc/t45/s904/c" subsection {
      num "c" "(c)"
      heading "Effect on priorities and timing of employee protection payments"
      content "Nothing in this section shall be deemed to affect the priorities or timing of payment of employee protection which might have existed in the absence of this chapter."
      hash "12ca8970989b1dd7048c2aeb729834627edac2f1d314d5bd49a54c3127ba7ec6"
    }
    hash "785fd8801d2f1ae756e207288cdf691df3f35e3b279a849ba0c5e10c1d5d2880"
  }
  credit "(" ["Pub. L. 96–101, § 5" -> "/us/pl/96/101/s5"] ", Nov. 4, 1979, " ["93 Stat. 737" -> "/us/stat/93/737"] ".)"
  note "/us/usc/t45/s904/note/editorialNotes/pl.104.88/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 11347 of title 49" -> "/us/usc/t49/s11347"] ", referred to in subsecs. (a)(1) and (b)(1), was omitted in the general amendment of subtitle IV of Title 49, Transportation, by " ["Pub. L. 104–88, title I, § 102(a)" -> "/us/pl/104/88/tI/s102/a"] ", Dec. 29, 1995, " ["109 Stat. 804" -> "/us/stat/109/804"] ". Provisions similar to those in section 11347 are contained in " ["section 11326(a) of Title 49" -> "/us/usc/t49/s11326/a"] "."
    hash "2f2348282debb1b0d014bd284c8a95dad6436247392bc3a6881b1176000e6759"
  }
  note "/us/usc/t45/s904/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  footnote 2 "2" {
    p "So in original. Probably should be “interests”."
  }
  layers {
    operative "785fd8801d2f1ae756e207288cdf691df3f35e3b279a849ba0c5e10c1d5d2880"
    enacted "932199c39da4ec48bbb99059fd2a0f7608b22f583e734ade5c00c737ec5c9b4b"
    editorial "e4fd8dc2ae832d57786248f8ffb449a106b7988e3c44c6cff23bc8d0e6374633"
  }
}
