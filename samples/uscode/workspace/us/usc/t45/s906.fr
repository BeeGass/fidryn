edition 2
module "/us/usc/t45/s906" {
  within "/us/usc/t45/ch18"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s906" section {
    num "906" "§ 906."
    heading "Guarantee of trustee certificates"
    provision "/us/usc/t45/s906/a" subsection {
      num "a" "(a)"
      heading "to (c) Omitted"
      hash "382dafb0073193f039a048cc328279cb005cb4c8eeaca75b6b0586282b4092af"
    }
    provision "/us/usc/t45/s906/d" subsection {
      num "d" "(d)"
      heading "Authorization"
      content "The Secretary of Transportation shall, under the authority of the Emergency Rail Services Act of 1970 [" ["45 U.S.C. 661" -> "/us/usc/t45/s661"] " et seq.], immediately guarantee trustee certificates of the Milwaukee Railroad, on the basis of an estimate of the amount required to be provided under subsection (e) of this section, for purposes of allowing the Milwaukee Railroad, commencing November 1, 1979, to maintain its entire railroad system in accordance with " ["section 920 of this title" -> "/us/usc/t45/s920"] ", and as required to finance operations which the Milwaukee Railroad continues for the 60-day period beginning on the date of the occurrence of an event described in " ["section 920(b) of this title" -> "/us/usc/t45/s920/b"] " or on April 1, 1980, whichever first occurs. Such guarantee shall be made without regard to the findings set forth in section 3(a) of the Emergency Rail Services Act of 1970 [" ["45 U.S.C. 662(a)" -> "/us/usc/t45/s662/a"] "], and the provisions of section 3(b)(3) [" ["45 U.S.C. 662(b)(3)" -> "/us/usc/t45/s662/b/3"] "] and the last two sentences of section 3(d) of such Act [" ["45 U.S.C. 662(d)" -> "/us/usc/t45/s662/d"] "] shall not apply to such guarantee."
      hash "498e0f020e5a2225bff16d63ea0492b797abcb97a6b03fa40b90efb28f546b2e"
    }
    provision "/us/usc/t45/s906/e" subsection {
      num "e" "(e)"
      heading "Amount of guarantee"
      content "The Secretary shall guarantee trustee certificates of the Milwaukee Railroad pursuant to this section in an amount equal to the difference between (1) the total expenses incurred by such railroad attributable to the maintenance and the continuation of service in accordance with subsection (d) of this section, and (2) the revenues of such railroad."
      hash "cc9bf46b8266dc8c7b4edf77abfa2e691094d3cbb3820e96b8e7af5d8de26dd6"
    }
    provision "/us/usc/t45/s906/f" subsection {
      num "f" "(f)"
      heading "Subordination of claims"
      content "Notwithstanding the provisions of section 3(c) of the Emergency Rail Services Act of 1970 [" ["45 U.S.C. 662(c)" -> "/us/usc/t45/s662/c"] "], certificates guaranteed under this chapter shall be subordinated to the claims of any creditors of the Milwaukee Railroad as of November 4, 1979."
      hash "1b451c4a05feebaea9d3390fd8a338b996a3f6bbd0fdf129b8aa3b6155d1468b"
    }
    provision "/us/usc/t45/s906/g" subsection {
      num "g" "(g)"
      heading "Availability of funds"
      content "The Commission shall immediately make available to the Secretary of Transportation the sum of $10,000,000, out of funds available for directed service under title 49. The Secretary of Transportation shall immediately make such funds available to the trustee of the Milwaukee Railroad for purposes of financing the operations of the Milwaukee Railroad, beginning November 1, 1979, in accordance with " ["section 920 of this title" -> "/us/usc/t45/s920"] "."
      hash "05f3b8bc1277aba9d153f75db7b8875c96eb5140dbdf708ae3045d93e4930e9c"
    }
    provision "/us/usc/t45/s906/h" subsection {
      num "h" "(h)"
      heading "Cancellation of United States obligations"
      provision "/us/usc/t45/s906/h/1" paragraph {
        num "1" "(1)"
        chapeau "All obligations to the United States or any agency or instrumentality of the United States incurred pursuant to this section by the Milwaukee Railroad or the trustee of the property of the Milwaukee Railroad shall be waived and canceled when—"
        provision "/us/usc/t45/s906/h/1/A" subparagraph {
          num "A" "(A)"
          content "the Milwaukee Railroad is reorganized as an operating rail carrier; or"
          hash "60697fa4afd2172019ef7715653056f02c4b1609db73134072b36ca1112c2dda"
        }
        provision "/us/usc/t45/s906/h/1/B" subparagraph {
          num "B" "(B)"
          content "substantially all of the Milwaukee Railroad is purchased."
          hash "0dbf93721cf2689d44d751887d4e46910269532ba1e3fd6745541001298a62a2"
        }
        hash "a6dc8c2e384e64e839d9f4277e4bdb5dc4234813d8f9b81082c1895862249dfc"
      }
      provision "/us/usc/t45/s906/h/2" paragraph {
        num "2" "(2)"
        content "For purposes of this subsection, substantially all of the Milwaukee Railroad shall be considered as having been purchased when (A) more than 50 percent of the rail system operated by the Milwaukee Railroad on October 14, 1980, has been purchased, and (B) more than 50 percent of the employees employed by the Milwaukee Railroad on October 14, 1980, have obtained employment with other rail carriers."
        hash "b0528b268fa63d4163616b0eb8f3c8f9d1b0c07b0625486da2ae4123bc9a489a"
      }
      hash "2fb4e987ebdd6427f56278b20c49fa784839f5a8f914927a104cfec9f14ae920"
    }
    hash "8da5aadb4e52703f49ca3ad8962f0fa146b2d85a18451fc8c8d152ed05ad7dc0"
  }
  credit "(" ["Pub. L. 96–101, § 7" -> "/us/pl/96/101/s7"] "(less (a)–(c)), Nov. 4, 1979, " ["93 Stat. 740" -> "/us/stat/93/740"] "; " ["Pub. L. 96–448, title VII, § 701(c)(1)" -> "/us/pl/96/448/tVII/s701/c/1"] ", Oct. 14, 1980, " ["94 Stat. 1961" -> "/us/stat/94/1961"] ".)"
  note "/us/usc/t45/s906/note/editorialNotes/pl.91.663/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "The Emergency Rail Services Act of 1970, referred to in subsec. (d), is " ["Pub. L. 91–663" -> "/us/pl/91/663"] ", Jan. 8, 1971, " ["84 Stat. 1975" -> "/us/stat/84/1975"] ", which is classified generally to chapter 15 (§ 661 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under " ["section 661 of this title" -> "/us/usc/t45/s661"] " and Tables."
    p "Directed service under title 49, referred to in subsec. (g), probably refers to directed service under " ["section 11125 of Title 49" -> "/us/usc/t49/s11125"] ", Transportation, prior to the general amendment of subtitle IV of Title 49, by " ["Pub. L. 104–88, § 102(a)" -> "/us/pl/104/88/s102/a"] "."
    hash "92a1d46fd8a48fed322c6e787c55d3ef02d5a70ecb38292339ae66fdf92c44b6"
  }
  note "/us/usc/t45/s906/note/editorialNotes/nolaw/codification" editorial {
    group editorialNotes
    topic "codification"
    heading "Codification"
    p "Subsecs. (a) to (c) of this section amended " ["section 662 of this title" -> "/us/usc/t45/s662"] "."
    hash "dcd9def3acf1bd21ccac4f179c9027a9ae4f425b171f9917e71053c05e0f5068"
  }
  note "/us/usc/t45/s906/note/editorialNotes/pl.96.448/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1980—Subsec. (h). " ["Pub. L. 96–448" -> "/us/pl/96/448"] " added subsec. (h)."
    hash "7dd1a59f14391a6131f35c486ed2994c535e666802ed2831ee68533a8cc79b35"
  }
  note "/us/usc/t45/s906/note/statutoryNotes/pl.96.448/effective-date-of-1980-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1980 Amendment"
    p "Amendment by " ["Pub. L. 96–448" -> "/us/pl/96/448"] " effective Oct. 14, 1980, see " ["section 710(d) of Pub. L. 96–448" -> "/us/pl/96/448/s710/d"] ", set out as a note under " ["section 1170 of Title 11" -> "/us/usc/t11/s1170"] ", Bankruptcy."
    hash "5bd57dc238e4804a5a01c5250e2074da2589039fa458d2c6ff972282781779c6"
  }
  note "/us/usc/t45/s906/note/statutoryNotes/pl.104.88/abolition-of-interstate-commerce-commission-and-transfer-of" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Abolition of Interstate Commerce Commission and Transfer of Functions"
    p "Interstate Commerce Commission abolished and functions of Commission transferred, except as otherwise provided in " ["Pub. L. 104–88" -> "/us/pl/104/88"] ", to Surface Transportation Board effective Jan. 1, 1996, by " ["section 1302 of Title 49" -> "/us/usc/t49/s1302"] ", Transportation, and " ["section 101 of Pub. L. 104–88" -> "/us/pl/104/88/s101"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] ". References to Interstate Commerce Commission deemed to refer to Surface Transportation Board, a member or employee of the Board, or Secretary of Transportation, as appropriate, see " ["section 205 of Pub. L. 104–88" -> "/us/pl/104/88/s205"] ", set out as a note under " ["section 1301 of Title 49" -> "/us/usc/t49/s1301"] "."
    hash "04cef30710e4013529296b7ceb2d04067f7b8b6e3aac69433b414e47c59b7065"
  }
  layers {
    operative "8da5aadb4e52703f49ca3ad8962f0fa146b2d85a18451fc8c8d152ed05ad7dc0"
    enacted "5e193d966dffef3af96ae3dff6b65cc653d17b83e06ddb828294496a3c4f170b"
    editorial "cc947327f153f7c04ead9f9521592852e37e55b4654017d6c362841192f4c068"
  }
}
