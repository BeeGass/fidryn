edition 2
module "/us/usc/t45/s1210" {
  within "/us/usc/t45/ch21"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1210" section {
    num "1210" "§ 1210."
    heading "Other disposition"
    chapeau "If the Secretary has not certified that the State has satisfied the conditions under " ["section 1203 of this title" -> "/us/usc/t45/s1203"] " within one year after the date of delivery of the report referred to in " ["section 1204(a) of this title" -> "/us/usc/t45/s1204/a"] ", the Secretary may dispose of the rail properties of the Alaska Railroad. Any disposal under this section shall give preference to a buyer or transferee who will continue to operate rail service, except that—"
    provision "/us/usc/t45/s1210/1" paragraph {
      num "1" "(1)"
      content "such preference shall not diminish or modify the rights of the Cook Inlet Region, Incorporated (as that term is used in " ["section 12 of the Act of January 2, 1976" -> "/us/act/1976-01-02/s12"] " (" ["Public Law 94–204" -> "/us/pl/94/204"] "; " ["89 Stat. 1150" -> "/us/stat/89/1150"] ")), pursuant to such section, as amended by " ["section 606(d) of this title" -> "/us/usc/t45/s606/d"] ";" mark "1" 1 " and"
      hash "b153e03886ee648318494ec0206c1ca8e709e9aba59126fb7e8fab2ac1ca5902"
    }
    provision "/us/usc/t45/s1210/2" paragraph {
      num "2" "(2)"
      content "this section shall not be construed to diminish or modify the powers of consent of the Secretary or the State under section 12(b)(8) of such Act, as amended by " ["section 606(d)(5) of this title" -> "/us/usc/t45/s606/d/5"] "." sup "1"
      hash "679efadb983ccc3a195220e2d973bdeac5c244d2573ba54827fd6d7b502be804"
    }
    continuation "Any disposal under this section shall be subject to valid existing rights."
    hash "fe677a256fa64ae77dc4308823ad79da248f15cfc8e573ce42927ecffb24ca61"
  }
  credit "(" ["Pub. L. 97–468, title VI, § 611" -> "/us/pl/97/468/tVI/s611"] ", Jan. 14, 1983, " ["96 Stat. 2576" -> "/us/stat/96/2576"] ".)"
  note "/us/usc/t45/s1210/note/editorialNotes/act.1976-01-02.s12/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p ["Section 12 of the Act of January 2, 1976" -> "/us/act/1976-01-02/s12"] ", referred to in pars. (1) and (2), is " ["section 12 of Pub. L. 94–204" -> "/us/pl/94/204/s12"] ", Jan. 2, 1976, " ["89 Stat. 1150" -> "/us/stat/89/1150"] ", which is set out as a note under " ["section 1611 of Title 43" -> "/us/usc/t43/s1611"] ", Public Lands."
    p ["Section 606(d) of this title" -> "/us/usc/t45/s606/d"] ", referred to in pars. (1) and (2), means " ["section 606(d) of title VI of Pub. L. 97–468" -> "/us/pl/97/468/tVI/s606/d"] ", Jan. 14, 1983, " ["96 Stat. 2566" -> "/us/stat/96/2566"] "."
    hash "9358b51af1e6380cbcd9ebc041c95402731a046e3ed4b4f2a3b018a7204846c8"
  }
  footnote 1 "1" {
    p "See References in Text note below."
  }
  layers {
    operative "fe677a256fa64ae77dc4308823ad79da248f15cfc8e573ce42927ecffb24ca61"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "0e445596e87cec948fc6a14ddfef64863e7a3b0e46729c2ba95319a865363236"
  }
}
