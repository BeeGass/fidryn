edition 2
module "/us/usc/t45/s1106" {
  within "/us/usc/t45/ch20"
  source "usc45.xml"
  positive_law false
  provision "/us/usc/t45/s1106" section {
    num "1106" "§ 1106."
    heading "Exemption from transfer taxes and fees; recordation"
    provision "/us/usc/t45/s1106/a" subsection {
      num "a" "(a)"
      provision "/us/usc/t45/s1106/a/1" paragraph {
        num "1" "(1)"
        content "All transfers or conveyances of any interest in rail property (whether real, personal, or mixed) which are made under any provision of or amendment made by this subtitle shall be exempt from any taxes, imposts, or levies now or hereby imposed, by the United States or by any State or any political subdivision of a State, on or in connection with such transfers or conveyances or on the recording of deeds, bills of sale, liens, encumbrances, easements, or other instruments evidencing, effectuating, or incident to any such transfers or conveyances, whether imposed on the transferor or on the transferee. Such transferors and transferees shall be entitled to record any such deeds, bills of sale, liens, encumberances," mark "1" 1 " easements, or other instruments, and to record the release or removal of any preexisting liens or encumbrances of record with respect to properties so transferred or conveyed, upon payment of any appropriate and generally applicable charges to compensate for the cost of the service performed."
        hash "64d417dd2f35c0807e94edc2054e91bc6486d54a9f840bf3c2912acac529437e"
      }
      provision "/us/usc/t45/s1106/a/2" paragraph {
        num "2" "(2)"
        content "This section shall not apply to Federal income tax laws."
        hash "80b83a32b959a9bc543bd4bf20beb95a2422f4a005fa0f481c52c1fd9c66884e"
      }
      hash "c7cc728427906b93a8cd232dcacd19cef04ae4276f03f7849e40b3e5c41fcac6"
    }
    provision "/us/usc/t45/s1106/b" subsection {
      num "b" "(b)"
      content "Transfer of designated real property (including any interest in real property) authorized by the amendments made by part 2 of this subtitle shall have the same effect for purposes of rights and priorities with respect to such property as recordation on the transfer date of appropriate deeds, or other appropriate instruments, in offices appointed under State law for such recordation, except that acquiring rail carriers and other entities shall proffer such deeds or other instruments for recordation within 36 months after the transfer date as a condition of preserving such rights and priorities beyond the expiration of that period. Conrail shall cooperate in effecting the timely preparation, execution, and proffering for recordation of such deeds and other instruments."
      hash "1c73c40be19d79daf213b7d87b8f2dbb60a6bf10f0201c3b1682710a58160704"
    }
    hash "6eecde201857ee6b5f8c48830fa44a124b3dc88ef209ad4487a3a8a3f2ea8567"
  }
  credit "(" ["Pub. L. 97–35, title XI, § 1153" -> "/us/pl/97/35/tXI/s1153"] ", Aug. 13, 1981, " ["95 Stat. 677" -> "/us/stat/95/677"] ".)"
  note "/us/usc/t45/s1106/note/editorialNotes/pl.97.35/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "This subtitle, referred to in subsecs. (a)(1) and (b), is subtitle E (§§ 1131–1169) of title XI of " ["Pub. L. 97–35" -> "/us/pl/97/35"] ", Aug. 13, 1981, " ["95 Stat. 643" -> "/us/stat/95/643"] ", known as the Northeast Rail Service Act of 1981. Part 2 (§§ 1136–1142) of subtitle E enacted sections 581 to 587, 727, 744a, and 761 to 769a of this title, amended sections 601 and 741 of this title, and enacted provisions set out as a note under " ["section 744a of this title" -> "/us/usc/t45/s744a"] ". For complete classification of this subtitle to the Code, see Short Title note set out under " ["section 1101 of this title" -> "/us/usc/t45/s1101"] " and Tables."
    hash "2e59ea5a55bc3935d2acb419db4162ff7fe6f96367814841aaaf5df6df738631"
  }
  footnote 1 "1" {
    p "So in original. Probably should be “encumbrances,”."
  }
  layers {
    operative "6eecde201857ee6b5f8c48830fa44a124b3dc88ef209ad4487a3a8a3f2ea8567"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "69737fbc8a2777f86ab6d590d7b52f0124830f1bdc911a93f2b8d4d709b3cf09"
  }
}
