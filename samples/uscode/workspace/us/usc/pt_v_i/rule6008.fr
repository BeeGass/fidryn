edition 2
module "/us/usc/ptVI/rule6008" {
  within "/us/usc/ptVI"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVI/rule6008" courtRule {
    num "6008" "Rule 6008."
    heading "Redeeming Property from a Lien or a Sale to Enforce a Lien"
    content "On motion by the debtor, trustee, or debtor in possession and after a hearing on notice as the court may order, the court may authorize property to be redeemed from a lien or from a sale to enforce a lien under applicable law."
    hash "8ce710c3dbb1ecacdc4dbaac4a6fecc63f066a0dba7b9755ecfc835de58804b5"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVI/rule6008/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule is derived from former Bankruptcy Rule 609. No provision in the Code addresses the trustee’s right of redemption. Ordinarily the secured creditor should be given notice of the trustee’s motion so that any objection may be raised to the proposed redemption."
    p "The rule applies also to a debtor exercising a right of redemption pursuant to § 722. A proceeding under that section is governed by Rule 9014."
    hash "86bf009502c7782592b22bf38dd6c2534d0e69a8b27daa087b98f259f67c73ec"
  }
  note "/us/usc/ptVI/rule6008/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 6008 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "1e4000da42a89ce0f736112c12a7f5fb6eebd56533087f4459dfc46eef696060"
  }
  layers {
    operative "8ce710c3dbb1ecacdc4dbaac4a6fecc63f066a0dba7b9755ecfc835de58804b5"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "f7e931e33eee11a50c91e38d0636a312568114cbffd70f3bb224ed3c9a2d6f72"
  }
}
