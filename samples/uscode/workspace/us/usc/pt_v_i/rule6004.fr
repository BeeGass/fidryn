edition 2
module "/us/usc/ptVI/rule6004" {
  within "/us/usc/ptVI"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVI/rule6004" courtRule {
    num "6004" "Rule 6004."
    heading "Use, Sale, or Lease of Property"
    provision "/us/usc/ptVI/rule6004/a" subsection {
      num "a" "(a)"
      heading "Notice."
      provision "/us/usc/ptVI/rule6004/a/1" paragraph {
        num "1" "(1)"
        chapeau "In General. Notice of a proposed use, sale, or lease of property that is not in the ordinary course of business must be given:"
        provision "/us/usc/ptVI/rule6004/a/1/A" subparagraph {
          num "A" "(A)"
          content "under Rule 2002(a)(2), (c)(1), (i), and (k); and"
          hash "43e1d12f21eaeaf9a08dec6bb3f475cac31b05034b78a11e9c6a5c449d72d7e0"
        }
        provision "/us/usc/ptVI/rule6004/a/1/B" subparagraph {
          num "B" "(B)"
          content "in accordance with § 363(b)(2), if applicable."
          hash "2ba4df360e166b7bb5956f47c80885c655b4c60d5debc8e6bf2cc05961e9cc18"
        }
        hash "996c717877d94f5e48f349fb1e61345d66a39d397a014d73c6f86a4b1875235d"
      }
      provision "/us/usc/ptVI/rule6004/a/2" paragraph {
        num "2" "(2)"
        content "Exceptions. Notice is not required if (d) applies or the proposal involves cash collateral only."
        hash "4594f0e70a50f764551eb039008e0556111432070f79477d09fd062d82af1ed9"
      }
      hash "584e7d0b69a8ed4b043d01024cc62f528874acf53feddba504d325489ced8502"
    }
    provision "/us/usc/ptVI/rule6004/b" subsection {
      num "b" "(b)"
      heading "Objection."
      content "Except as provided in (c) and (d), an objection to a proposed use, sale, or lease of property must be filed and served at least 7 days before the date set for the proposed action or within the time set by the court. Rule 9014 governs the objection."
      hash "ce546680f5b0a1d5125027028cebf6e071beb6adce2225b5b3b90ff590716de3"
    }
    provision "/us/usc/ptVI/rule6004/c" subsection {
      num "c" "(c)"
      heading "Motion to Sell Property Free and Clear of Liens and Other Interests; Objection."
      chapeau "A motion for authority to sell property free and clear of liens or other interests must be made in accordance with Rule 9014 and served on the parties who have the liens or other interests. The notice required by (a) must include:"
      provision "/us/usc/ptVI/rule6004/c/1" paragraph {
        num "1" "(1)"
        content "the date of the hearing on the motion; and"
        hash "b7a4b4cf5e31301c6d56f0e23be464e1744a4a1a81edde4d4384477cc23ec3ef"
      }
      provision "/us/usc/ptVI/rule6004/c/2" paragraph {
        num "2" "(2)"
        content "the time to file and serve an objection on the debtor in possession or trustee."
        hash "7c0414de1503d679ec68958235259674d6ccefb3625bd9fa86c07e9007c63ee2"
      }
      hash "b1cc23e4af23f0488423eb2366927bacd833839359c2dcf51a20ba699d6902d3"
    }
    provision "/us/usc/ptVI/rule6004/d" subsection {
      num "d" "(d)"
      heading "Notice of an Intent to Sell Property Valued at Less Than $2,500; Objection."
      content {
        p "If all the nonexempt property of the estate—in the aggregate—has a gross value less than $2,500, a notice of an intent to sell the property that is not in the ordinary course of business must be given to:"
        p "• all creditors;"
        p "• all indenture trustees;"
        p "• any committees appointed or elected under the Code;"
        p "• the United States trustee; and"
        p "• other persons as the court orders."
      }
      continuation "A party in interest may file and serve an objection within 14 days after the notice is mailed or within the time set by the court. Rule 9014 governs the objection."
      hash "3d6710fd1098e5b7ac6a5d38972b0665238f0b7b58ec961962712a2d36a01a4d"
    }
    provision "/us/usc/ptVI/rule6004/e" subsection {
      num "e" "(e)"
      heading "Notice of a Hearing on an Objection."
      content "The date of a hearing on an objection under (b) or (d) may be set in the notice under (a)."
      hash "47529ea7130c596ae68566e1a889c22534c129c13ec8e5d204260369ca9ff3ae"
    }
    provision "/us/usc/ptVI/rule6004/f" subsection {
      num "f" "(f)"
      heading "Conducting a Sale That Is Not in the Ordinary Course of Business."
      provision "/us/usc/ptVI/rule6004/f/1" paragraph {
        num "1" "(1)"
        chapeau "Public Auction or Private Sale."
        provision "/us/usc/ptVI/rule6004/f/1/A" subparagraph {
          num "A" "(A)"
          content {
            p "Itemized Statement Required. A sale that is not in the ordinary course of business may be made by public auction or private sale. Unless it is impracticable, when the sale is completed, an itemized statement must be filed that shows:"
            p "• the property sold;"
            p "• the name of each purchaser; and"
            p "• the consideration received for each item or lot or, if sold in bulk, for the entire property."
          }
          hash "7198d1e6cd15621663f9789d446fb12ad699c3fbdc2a9bee6e32ab410aa26f0b"
        }
        provision "/us/usc/ptVI/rule6004/f/1/B" subparagraph {
          num "B" "(B)"
          content "If by an Auctioneer. If the property is sold by an auctioneer, the auctioneer must file the itemized statement and send a copy to the United States trustee and to either the trustee, debtor in possession, or Chapter 13 debtor."
          hash "17c0259c8525cbd0a3065b3dfff73a8ea34ffdd90fcf69155341dc05beca2c4c"
        }
        provision "/us/usc/ptVI/rule6004/f/1/C" subparagraph {
          num "C" "(C)"
          content "If Not by an Auctioneer. If the property is not sold by an auctioneer, the trustee, debtor in possession, or Chapter 13 debtor must file the itemized statement and send a copy to the United States trustee."
          hash "271ce79083aae3c8bdd34bb16e7b43e8cc6324d5e48df467150326c533ea5f71"
        }
        hash "fdde8aad82c7dfc16d4c7b25766cdba97b25c12bc999903dcde8658dff6f2273"
      }
      provision "/us/usc/ptVI/rule6004/f/2" paragraph {
        num "2" "(2)"
        content "Signing the Sale Documents. When a sale is complete, the debtor, trustee, or debtor in possession must sign any document that is necessary or court-ordered to transfer the property to the purchaser."
        hash "2c60a74420edeb3a78b3771b7c5f63e5a3cb33ae1cb0d46cc9651f2e0debc469"
      }
      hash "4ea5781032dc0984fd52fcaf14739ba39909c5026f4453123d07b20c7b22412f"
    }
    provision "/us/usc/ptVI/rule6004/g" subsection {
      num "g" "(g)"
      heading "Selling Personally Identifiable Information."
      provision "/us/usc/ptVI/rule6004/g/1" paragraph {
        num "1" "(1)"
        content {
          p "Request for a Consumer-Privacy Ombudsman. A motion for authority to sell or lease personally identifiable information under § 363(b)(1)(B) must include a request for an order directing the United States trustee to appoint a consumer-privacy ombudsman under § 332. Rule 9014 governs the motion. It must be sent to the United States trustee and served on:"
          p "• any committee elected under § 705 or appointed under § 1102;"
          p "• in a Chapter 11 case in which no committee of unsecured creditors has been appointed under § 1102, on the creditors included on the list filed under Rule 1007(d); and"
          p "• other entities as the court orders."
        }
        hash "4e15ccd5cc3cb485c3868975e8a0efa284cf9d29f3d7d87209a2ed29c4c75d4e"
      }
      provision "/us/usc/ptVI/rule6004/g/2" paragraph {
        num "2" "(2)"
        content {
          p "Notice That an Ombudsman Has Been Appointed. If a consumer-privacy ombudsman is appointed, the United States trustee must give notice of the appointment at least 7 days before the hearing on any motion under § 363(b)(1)(B). The notice must give the name and address of the person appointed and include the person’s verified statement that sets forth any connection with:"
          p "• the debtor, creditors, or any other party in interest;"
          p "• their respective attorneys and accountants;"
          p "• the United States trustee; and"
          p "• any person employed in the United States trustee’s office."
        }
        hash "6c3928287a497afc499cec98530e1e92b61657120576069c498fa554608e8b52"
      }
      hash "cab3270d0cd9af69555544f1067fe404cf8ff26146b6d135656ab6b6ff81ee11"
    }
    provision "/us/usc/ptVI/rule6004/h" subsection {
      num "h" "(h)"
      heading "Staying an Order Authorizing the Use, Sale, or Lease of Property."
      content "Unless the court orders otherwise, an order authorizing the use, sale, or lease of property (other than cash collateral) is stayed for 14 days after the order is entered."
      hash "b5827dc3b8d21827e14a47d4fd5813d622a7cb849fea83dbc52abf5d3e7f644e"
    }
    hash "89964c4f25b5ceb3af8bbe3b78b1401ee56c0faf68df46feed735c3c210d0f61"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 26, 1999, eff. Dec. 1, 1999; Apr. 23, 2008, eff. Dec. 1, 2008; Mar. 26, 2009, eff. Dec. 1, 2009; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Subdivisions (a) and (b). Pursuant to § 363(b) of the Code, a trustee or debtor in possession may use, sell, or lease property other than in the ordinary course of business only after notice and hearing. Rule 2002(a), (c) and (i) specifies the time when notice of sale is to be given, the contents of the notice and the persons to whom notice is to be given of sales of property. Subdivision (a) makes those provisions applicable as well to notices for proposed use and lease of property."
    p "The Code does not provide the time within which parties may file objections to a proposed sale. Subdivision (b) of the rule requires the objection to be in writing and filed not less than five days before the proposed action is to take place. The objection should also be served within that time on the person who is proposing to take the action which would be either the trustee or debtor in possession. This time period is subject to change by the court. In some instances there is a need to conduct a sale in a short period of time and the court is given discretion to tailor the requirements to the circumstances."
    p "Subdivision (c). In some situations a notice of sale for different pieces of property to all persons specified in Rule 2002(a) may be uneconomic and inefficient. This is particularly true in some chapter 7 liquidation cases when there is property of relatively little value which must be sold by the trustee. Subdivision (c) allows a general notice of intent to sell when the aggregate value of the estate’s property is less than $2,500. The gross value is the value of the property without regard to the amount of any debt secured by a lien on the property. It is not necessary to give a detailed notice specifying the time and place of a particular sale. Thus, the requirements of Rule 2002(c) need not be met. If this method of providing notice of sales is used, the subdivision specifies that parties in interest may serve and file objections to the proposed sale of any property within the class and the time for service and filing is fixed at not later than 15 days after mailing the notice. The court may fix a different time. Subdivision (c) would have little utility in chapter 11 cases. Pursuant to Rule 2002(i), the court can limit notices of sale to the creditors’ committee appointed under § 1102 of the Code and the same burdens present in a small chapter 7 case would not exist."
    p "Subdivision (d). If a timely objection is filed, a hearing is required with respect to the use, sale, or lease of property. Subdivision (d) renders the filing of an objection tantamount to requesting a hearing so as to require a hearing pursuant to §§ 363(b) and 102(l)(B)(i)."
    p "Subdivision (e) is derived in part from former Bankruptcy Rule 606(b) but does not carry forward the requirement of that rule that court approval be obtained for sales of property. Pursuant to § 363(b) court approval is not required unless timely objection is made to the proposed sale. The itemized statement or information required by the subdivision is not necessary when it would be impracticable to prepare it or set forth the information. For example, a liquidation sale of retail goods although not in the ordinary course of business may be on a daily ongoing basis and only summaries may be available."
    p "The duty imposed by paragraph (2) does not affect the power of the bankruptcy court to order third persons to execute instruments transferring property purchased at a sale under this subdivision. See, e.g., In re Rosenberg, 138 F.2d 409 (7th Cir. 1943)."
    hash "c7b548203f300be86a2e2e983ae8c6366c4a8f973b8fb4d39cc84b755014c3a6"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1987-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1987 Amendment"
    p "Subdivision (a) is amended to conform to the 1984 amendments to § 363(b)(2) of the Code."
    p "Subdivision (b) is amended to provide that an objection to a proposed use, sale, or lease of property creates a contested matter governed by Rule 9014. A similar amendment is made to subdivision (d), which was formerly subdivision (c)."
    p "Subdivision (c) is new. Section 363(f) provides that sales free and clear of liens or other interests are only permitted if one of the five statutory requirements is satisfied. Rule 9013 requires that a motion state with particularity the grounds relied upon by the movant. A motion for approval of a sale free and clear of liens or other interests is subject to Rule 9014, service must be made on the parties holding liens or other interests in the property, and notice of the hearing on the motion and the time for filing objections must be included in the notice given under subdivision (a)."
    hash "5b541a37df9e48341ce4c0721dd41764e4ead65f243aa52d2aacd6ee14924c51"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "This rule is amended to provide notice to the United States trustee of a proposed use, sale or lease of property not in the ordinary course of business. See Rule 2002(k). Subdivision (f)(1) is amended to enable the United States trustee to monitor the progress of the case in accordance with 28 U.S.C. § 586(a)(3)(G)."
    p "The words “with the clerk” in subdivision (f)(1) are deleted as unnecessary. See Rules 5005(a) and 9001(3)."
    hash "89acd3e9ddfa55f625eb1b41402f03d81e8acfe912c5604989604694c7c38e97"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/committee-notes-on-rules-1999-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—1999 Amendment"
    p "Subdivision (g) is added to provide sufficient time for a party to request a stay pending appeal of an order authorizing the use, sale, or lease of property under § 363(b) of the Code before the order is implemented. It does not affect the time for filing a notice of appeal in accordance with Rule 8002."
    p "Rule 6004(g) does not apply to orders regarding the use of cash collateral and does not affect the trustee’s right to use, sell, or lease property without a court order to the extent permitted under § 363 of the Code."
    p "The court may, in its discretion, order that Rule 6004(g) is not applicable so that the property may be used, sold, or leased immediately in accordance with the order entered by the court. Alternatively, the court may order that the stay under Rule 6004(g) is for a fixed period less than 10 days."
    p "GAP Report on Rule 6004. No changes since publication."
    hash "93ad7f36cb374159ce81b7538f7e55be7734c3d0277292722350ab961faffeb3"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/committee-notes-on-rules-2008-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2008 Amendment"
    p "The rule is amended by inserting a new subdivision (g) to implement §§ 332 and 363(b)(1)(B) of the Code, added by the 2005 amendments. This rule governs the proposed transfer of personally identifiable information in a manner inconsistent with any policy covering the transfer of the information. Rule 2002(c)(1) requires the seller to state in the notice of the sale or lease whether the transfer is consistent with and policy governing the transfer of the information."
    p "Under § 332 of the Code, the consumer privacy ombudsman must be appointed at least five days prior to the hearing on a sale or lease of personally identifiable information. In an appropriate case, the consumer privacy ombudsman may seek a continuance of the hearing on the proposed sale to perform the tasks required of the ombudsman by § 332 of the Code."
    p "Former subdivision (g) is redesignated as subdivision (h)."
    p "Changes Made After Publication. The Committee Note was amended to highlight the connection between this rule and Rule 2002 with regard to the obligation to provide notice of proposed transactions. It was also amended to recognize the ability of the consumer privacy ombudsman to seek a continuance of a hearing on the proposed sale of personally identifiable information."
    hash "50eaf9ebb5862835424c24f62923f0ef6ea28a87a6bee0b395ef6c803ea3c12d"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/committee-notes-on-rules-2009-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2009 Amendment"
    p "The rule is amended to implement changes in connection with the amendment to Rule 9006(a) and the manner by which time is computed under the rules. The deadlines in the rule are amended to substitute a deadline that is a multiple of seven days. Throughout the rules, deadlines are amended in the following manner:"
    p "• 5-day periods become 7-day periods"
    p "• 10-day periods become 14-day periods"
    p "• 15-day periods become 14-day periods"
    p "• 20-day periods become 21-day periods"
    p "• 25-day periods become 28-day periods"
    hash "709a2fc6cab84b9eeee11cf64ce488b5326c65441afd3ed29661b2f232e5592b"
  }
  note "/us/usc/ptVI/rule6004/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 6004 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "2c508380dd616c08ca3bcbae2f2d2b8236671fdd11a7acd0e36f3b705e8e022b"
  }
  layers {
    operative "89964c4f25b5ceb3af8bbe3b78b1401ee56c0faf68df46feed735c3c210d0f61"
    enacted "2e821c804f3c44024ef50ab4add23b227860ac42e93f25201f4a0a86ecf97d80"
    editorial "0a5414b832d92914b5b4dc6c3cbafaa43cf60927ea321f56e7827be3bee84648"
  }
}
