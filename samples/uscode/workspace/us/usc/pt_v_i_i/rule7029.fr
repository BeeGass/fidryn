  provision "/us/usc/ptVII/rule7029" courtRule {
    num "7029" "Rule 7029."
    heading "Stipulations About Discovery Procedure"
    content "Fed. R. Civ. P. 29 applies in an adversary proceeding."
    hash "0d464a7752893359c6bbce297840dea78903b00c85e35278061aa0a91f7a1b31"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVII/rule7029/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 7029 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "f5968c158220de82172b4330e868897a727dbdec8a99f1304af9993a81cc0a5f"
  }
  note "/us/usc/ptVII/rule7029/note/ungrouped/nolaw/references-in-text" editorial {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
