edition 2
module "/us/usc/ptVII/rule7017" {
  within "/us/usc/ptVII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVII/rule7017" courtRule {
    num "7017" "Rule 7017."
    heading "Plaintiff and Defendant; Capacity; Public Officers"
    content "Fed. R. Civ. P. 17 applies in an adversary proceeding, except as provided in Rule 2010(b)."
    hash "68de8e13223506c0e41b44941134460a86b36fd838913db65165238670108ba3"
  }
  credit "(As amended Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVII/rule7017/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Rules 2010(d) and 5008(d), which implement §§ 322 and 345 of the Code, authorize a party in interest to prosecute a claim on the bond of a trustee or depository in the name of the United States."
    hash "3125af2d63aaf531b7d9683b14260f0dd08e3f689c0567d7906e75bd6fbbaaf6"
  }
  note "/us/usc/ptVII/rule7017/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "Reference to Rule 5008(d) is deleted because of the abrogation of Rule 5008."
    hash "934fab192784dd0517887098418ef73b40dbfc1a5b2bb8be5aad8f11cfd4f141"
  }
  note "/us/usc/ptVII/rule7017/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 7017 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "b639030f17d8efa5479a3be8e010cb1ba27758d0401ab23dca53fc6bbb28f622"
  }
  note "/us/usc/ptVII/rule7017/note/ungrouped/nolaw/references-in-text" editorial {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "68de8e13223506c0e41b44941134460a86b36fd838913db65165238670108ba3"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "27accb88621766c119a0c3add9d4fd534d9dfee67b94ff6e9df736a0770d4107"
  }
}
