edition 2
module "/us/usc/ptVII/rule7025" {
  within "/us/usc/ptVII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVII/rule7025" courtRule {
    num "7025" "Rule 7025."
    heading "Substitution of Parties"
    content "Fed. R. Civ. P. 25 applies in an adversary proceeding—but is subject to Rule 2012."
    hash "ae6dae27f8a906a08991780b0b59e051213d005eb095af8aa08dc05cd8f1255b"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVII/rule7025/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Rule 25 F.R.Civ.P. refers to Rule 4 F.R.Civ.P. Pursuant to Rule 7002 that reference is to Rule 4 as incorporated and modified by Rule 7004."
    hash "6af7ef1d4746034cfe72ec480b5feedffbdc4ab8b96fc785cc27d771d11eb340"
  }
  note "/us/usc/ptVII/rule7025/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 7025 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "4cbf2572be53b56f246529c09d6fece3946dc443a089c58a431cf30ecd826b88"
  }
  note "/us/usc/ptVII/rule7025/note/ungrouped/nolaw/references-in-text" editorial {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "ae6dae27f8a906a08991780b0b59e051213d005eb095af8aa08dc05cd8f1255b"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "c10a101110a5e6791be5a9a648968e23b84cbb054eda57eae8f7c1191936bd29"
  }
}
