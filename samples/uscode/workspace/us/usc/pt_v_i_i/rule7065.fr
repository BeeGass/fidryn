edition 2
module "/us/usc/ptVII/rule7065" {
  within "/us/usc/ptVII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptVII/rule7065" courtRule {
    num "7065" "Rule 7065."
    heading "Injunctions"
    content "Fed. R. Civ. P. 65 applies in an adversary proceeding. But on application of a debtor, trustee, or debtor in possession, the court may issue a temporary restraining order or preliminary injunction without complying with subdivision (c) of that rule."
    hash "d8bdc6ece3c6c5aa9ef0e81f3206718c12494b8b6c94cf2c87fc9c42d00a6dbb"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptVII/rule7065/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 7065 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "f8f3ea9741f6bd75adbcfa706dcbb5ac1885d9724c1cb79543b042c24d55b795"
  }
  note "/us/usc/ptVII/rule7065/note/ungrouped/nolaw/references-in-text" editorial {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "d8bdc6ece3c6c5aa9ef0e81f3206718c12494b8b6c94cf2c87fc9c42d00a6dbb"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "01a7ef12a28087f76fe52b0196be37f1058a49d1476cef28f94909a64e0fa155"
  }
}
