edition 2
module "/us/usc/t1/s206" {
  within "/us/usc/t1/ch3"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s206" section {
    num "206" "§ 206."
    heading "Bills and resolutions of Committee on the Judiciary of House of Representatives; form and style; ancillaries; curtailment of copies"
    content "All bills and resolutions relating to the revision of the laws referred to or reported by the Committee on the Judiciary of the House of Representatives shall be printed in such form and style, and with such ancillaries, as such committee may prescribe as being economical and suitable, to so continue until final enactment thereof in both Houses of Congress; and such committee may also curtail the number of copies of such bills to be printed in the various parliamentary stages in the House of Representatives."
    hash "fbcd03be3b00fa6aceb39957ed55fd65eb2d2b74ce4dd21a85f9de2cd7e45bbc"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 639" -> "/us/stat/61/639"] ".)"
  layers {
    operative "fbcd03be3b00fa6aceb39957ed55fd65eb2d2b74ce4dd21a85f9de2cd7e45bbc"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "1112cb778ebe91d13b92bf3523f6b7ca597f782dc73beccc8f933c954f24c925"
  }
}
