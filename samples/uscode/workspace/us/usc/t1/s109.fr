edition 2
module "/us/usc/t1/s109" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s109" section {
    num "109" "§ 109."
    heading "Repeal of statutes as affecting existing liabilities"
    content "The repeal of any statute shall not have the effect to release or extinguish any penalty, forfeiture, or liability incurred under such statute, unless the repealing Act shall so expressly provide, and such statute shall be treated as still remaining in force for the purpose of sustaining any proper action or prosecution for the enforcement of such penalty, forfeiture, or liability. The expiration of a temporary statute shall not have the effect to release or extinguish any penalty, forfeiture, or liability incurred under such statute, unless the temporary statute shall so expressly provide, and such statute shall be treated as still remaining in force for the purpose of sustaining any proper action or prosecution for the enforcement of such penalty, forfeiture, or liability."
    hash "bd638741b1ac682f9d3d5e3d1c280b7c74d457920f1019824a13a53792f0782b"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 635" -> "/us/stat/61/635"] ".)"
