module "/us/usc/t1/s208" {
  within "/us/usc/t1/ch3"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s208" section {
    num "208" "§ 208."
    heading "Delegation of function of Committee on the Judiciary to other agencies; printing, and so forth, under direction of Joint Committee on Printing"
    content "The functions vested by sections 201, 202, 204–207 of this title in the Committee on the Judiciary of the House of Representatives may from time to time be vested in such other agency as the Congress may by concurrent resolution provide: Provided, That the printing, binding, and distribution of the volumes and publications enumerated in sections 202, 203 of this title shall be done under the direction of the Joint Committee on Printing."
    hash "55c0fb1527464aabeebe27c807a822eb8d388c4ba463bb0b9e0259d6977113de"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 639" -> "/us/stat/61/639"] ".)"
