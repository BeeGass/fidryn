    heading "References in " ["Pub. L. 108–7" -> "/us/pl/108/7"]
    p ["Pub. L. 108–7, § 3" -> "/us/pl/108/7/s3"] ", Feb. 20, 2003, " ["117 Stat. 12" -> "/us/stat/117/12"] ", provided that:"
    quoted "/us/pl/108/7/s3" {
      p "“Except as expressly provided otherwise, any reference to ‘this Act’ contained in any division of this joint resolution [Consolidated Appropriations Resolution, 2003, see Tables for classification] shall be treated as referring only to the provisions of that division.”"
    }
    hash "fba105fb6907e2ee5e434d979cc5fdb52d13ad2bc6fb2a4a473fdcee22066ec8"
  }
  note "/us/usc/t1/s1/note/statutoryNotes/pl.86.70/continental-united-states" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Continental United States"
    p ["Pub. L. 86–70, § 48" -> "/us/pl/86/70/s48"] ", June 25, 1959, " ["73 Stat. 154" -> "/us/stat/73/154"] ", provided that:"
    quoted "/us/pl/86/70/s48" {
      p "“Whenever the phrase ‘continental United States’ is used in any law of the United States enacted after the date of enactment of this Act [June 25, 1959], it shall mean the 49 States on the North American Continent and the District of Columbia, unless otherwise expressly provided.”"
    }
    hash "5be2ad5fc1cea5471fab6e97924dac2757270d71a094bb5d0ac0dd5358783f25"
  }
