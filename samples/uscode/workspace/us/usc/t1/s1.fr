edition 2
module "/us/usc/t1/s1" {
  within "/us/usc/t1/ch1"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s1" section {
    num "1" "§ 1."
    heading "Words denoting number, gender, and so forth"
    content {
      p "In determining the meaning of any Act of Congress, unless the context indicates otherwise—"
      p "words importing the singular include and apply to several persons, parties, or things;"
      p "words importing the plural include the singular;"
      p "words importing the masculine gender include the feminine as well;"
      p "words used in the present tense include the future as well as the present;"
      p "the words “insane” and “insane person” shall include every idiot, insane person, and person non compos mentis;"
      p "the words “person” and “whoever” include corporations, companies, associations, firms, partnerships, societies, and joint stock companies, as well as individuals;"
      p "“officer” includes any person authorized by law to perform the duties of the office;"
      p "“signature” or “subscription” includes a mark when the person making the same intended it as such;"
      p "“oath” includes affirmation, and “sworn” includes affirmed;"
      p "“writing” includes printing and typewriting and reproductions of visual symbols by photographing, multigraphing, mimeographing, manifolding, or otherwise."
    }
    hash "1cf962468bd0f85b74664dbcf6cf310f4d6b3def9a851394199a2b592f05ecd0"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 633" -> "/us/stat/61/633"] "; " ["June 25, 1948, ch. 645, § 6" -> "/us/act/1948-06-25/ch645/s6"] ", " ["62 Stat. 859" -> "/us/stat/62/859"] "; " ["Oct. 31, 1951, ch. 655, § 1" -> "/us/act/1951-10-31/ch655/s1"] ", " ["65 Stat. 710" -> "/us/stat/65/710"] "; " ["Pub. L. 112–231, § 2(a)" -> "/us/pl/112/231/s2/a"] ", Dec. 28, 2012, " ["126 Stat. 1619" -> "/us/stat/126/1619"] ".)"
  note "/us/usc/t1/s1/note/editorialNotes/pl.112.231/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2012—" ["Pub. L. 112–231" -> "/us/pl/112/231"] ", in fifth clause after opening clause, struck out “and ‘lunatic’ ” before “shall include every” and “lunatic,” before “insane person,”."
    p "1951—Act Oct. 31, 1951, substituted, in fourth clause after opening clause, “used” for “use”."
    p "1948—Act June 25, 1948, included “tense”, “whoever”, “signature”, “subscription”, “writing” and a broader definition of “person”."
    hash "6e0c4fe4823cbd0f3911946b19c977236a8b231c5c8ea78308b3b6c748e8e2e4"
  }
  note "/us/usc/t1/s1/note/statutoryNotes/pl.117.228/short-title-of-2022-amendment" enacted {
    group statutoryNotes
    topic "shortTitleOfAmendment"
    heading "Short Title of 2022 Amendment"
    p ["Pub. L. 117–228, § 1" -> "/us/pl/117/228/s1"] ", Dec. 13, 2022, " ["136 Stat. 2305" -> "/us/stat/136/2305"] ", provided that:"
    quoted "/us/pl/117/228/s1" {
      p "“This Act [enacting " ["section 1738C of Title 28" -> "/us/usc/t28/s1738C"] ", Judiciary and Judicial Procedure, amending " ["section 7 of this title" -> "/us/usc/t1/s7"] ", repealing " ["section 1738C of Title 28" -> "/us/usc/t28/s1738C"] ", and enacting provisions set out as notes under " ["section 7 of this title" -> "/us/usc/t1/s7"] "] may be cited as the ‘Respect for Marriage Act’.”"
    }
    hash "a563414e0fd93114532d90e52b2ec1c0cb9229826542a944c1cf21a13133b8a3"
  }
  note "/us/usc/t1/s1/note/statutoryNotes/pl.112.231/short-title-of-2012-amendment" enacted {
