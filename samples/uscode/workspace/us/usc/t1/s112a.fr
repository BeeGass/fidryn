edition 2
module "/us/usc/t1/s112a" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s112a" section {
    num "112a" "§ 112a."
    heading "United States Treaties and Other International Agreements; contents; admissibility in evidence"
    provision "/us/usc/t1/s112a/a" subsection {
      num "a" "(a)"
      content "The Secretary of State shall cause to be compiled, edited, indexed, and published, beginning as of January 1, 1950, a compilation entitled “United States Treaties and Other International Agreements,” which shall contain all treaties to which the United States is a party that have been proclaimed during each calendar year, and all international agreements other than treaties to which the United States is a party that have been signed, proclaimed, or with reference to which any other final formality has been executed, during each calendar year. The said United States Treaties and Other International Agreements shall be legal evidence of the treaties, international agreements other than treaties, and proclamations by the President of such treaties and agreements, therein contained, in all the courts of the United States, the several States, and the Territories and insular possessions of the United States."
      hash "8ce235c2758a47caee6231184834f0e22917cf31196568bd1752d73beee89e23"
    }
    provision "/us/usc/t1/s112a/b" subsection {
      num "b" "(b)"
      content "Copies of international agreements and qualifying non-binding instruments in the possession of the Department of State, but not published, other than the agreements described in section 112b(b)(3)(A), shall be made available by the Department of State upon request."
      hash "1b9c541a4f57d77ac46ada811128c8a2f6582b903f212cf9d2e0ea7ae421a74c"
    }
    hash "946c3cebdeaff2e6123134582132acec2697a9df38d9495b666e3324236e8a7f"
  }
  credit "(Added " ["Sept. 23, 1950, ch. 1001, § 2" -> "/us/act/1950-09-23/ch1001/s2"] ", " ["64 Stat. 980" -> "/us/stat/64/980"] "; amended " ["Pub. L. 103–236, title I, § 138" -> "/us/pl/103/236/tI/s138"] ", Apr. 30, 1994, " ["108 Stat. 397" -> "/us/stat/108/397"] "; " ["Pub. L. 108–458, title VII, § 7121(a)" -> "/us/pl/108/458/tVII/s7121/a"] ", Dec. 17, 2004, " ["118 Stat. 3807" -> "/us/stat/118/3807"] "; " ["Pub. L. 117–263, div. E, title LIX, § 5947(b)" -> "/us/pl/117/263/dE/tLIX/s5947/b"] ", Dec. 23, 2022, " ["136 Stat. 3482" -> "/us/stat/136/3482"] ".)"
  note "/us/usc/t1/s112a/note/editorialNotes/pl.117.263/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2022—Subsecs. (b) to (d). " ["Pub. L. 117–263" -> "/us/pl/117/263"] " added subsec. (b) and struck out former subsecs. (b) to (d) which related to determination that publication of certain categories of agreements is not required, publication of such determination in the Federal Register, and timely availability of certain treaties and international agreements on the Department of State website."
    p "2004—Subsec. (d). " ["Pub. L. 108–458" -> "/us/pl/108/458"] " added subsec. (d)."
    p "1994—" ["Pub. L. 103–236" -> "/us/pl/103/236"] " designated existing provisions as subsec. (a) and added subsecs. (b) and (c)."
    hash "dad0314e38696908032c3fd4eee18d8d0caf536cc8615792fee5fadc8491c921"
  }
  note "/us/usc/t1/s112a/note/statutoryNotes/pl.117.263/effective-date-of-2022-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 2022 Amendment"
    p ["Pub. L. 117–263, div. E, title LIX, § 5947(c)" -> "/us/pl/117/263/dE/tLIX/s5947/c"] ", Dec. 23, 2022, " ["136 Stat. 3482" -> "/us/stat/136/3482"] ", provided that:"
    quoted "/us/pl/117/263/dE/tLIX/s5947/c" {
      p "“The amendments made by this section [amending this section, " ["section 112b of this title" -> "/us/usc/t1/s112b"] ", and " ["section 195c of Title 6" -> "/us/usc/t6/s195c"] ", Domestic Security] shall take effect on the date that is 270 days after the date of the enactment of this Act [Dec. 23, 2022].”"
    }
    hash "8d4f0a06982662edd2bdb451888b070edbabf08749e42ea59e77b0870ecf40ca"
  }
  note "/us/usc/t1/s112a/note/statutoryNotes/pl.108.458/effective-date-of-2004-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 2004 Amendment"
    p ["Pub. L. 108–458, title VII, § 7122" -> "/us/pl/108/458/tVII/s7122"] ", Dec. 17, 2004, " ["118 Stat. 3808" -> "/us/stat/118/3808"] ", provided that:"
    quoted "/us/pl/108/458/tVII/s7122" {
      p "“Notwithstanding any other provision of this Act [see Tables for classification], this subtitle [subtitle A (§§ 7101–7122) of title VII of " ["Pub. L. 108–458" -> "/us/pl/108/458"] ", enacting sections 2228, 2732, 3922b, 4029, 7536a, and 7555 of Title 22, Foreign Relations and Intercourse, amending this section, " ["section 112b of this title" -> "/us/usc/t1/s112b"] ", " ["section 1189 of Title 8" -> "/us/usc/t8/s1189"] ", Aliens and Nationality, sections 2651a, 2656f, 4003, 7513, 7514, 7518, 7536, 7537, 7538, and 7554 of Title 22, and " ["section 4605 of Title 50" -> "/us/usc/t50/s4605"] ", War and National Defense, repealing " ["section 2374 of Title 22" -> "/us/usc/t22/s2374"] ", enacting provisions set out as notes under " ["section 1189 of Title 8" -> "/us/usc/t8/s1189"] ", sections 1431, 2451, 2452, 2651a, 2656, 2656f, 7501, 7511, 7513, 7514, and 7536 of Title 22, and " ["section 4605 of Title 50" -> "/us/usc/t50/s4605"] ", and amending provisions set out as a note under " ["section 112b of this title" -> "/us/usc/t1/s112b"] "] shall take effect on the date of enactment of this Act [Dec. 17, 2004].”"
    }
    hash "5260c2788aa986255b622142af370e5d93d39924fa422ade49763b9846528c65"
  }
  note "/us/usc/t1/s112a/note/statutoryNotes/act.1895-01-12.ch23/effect-of-repeal-of-section-73-of-act-jan-12-1895" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Effect of Repeal of Section 73 of Act Jan. 12, 1895"
    p "This section and " ["section 112 of this title" -> "/us/usc/t1/s112"] " as not affected by the repeal of section 73 of " ["act Jan. 12, 1895, ch. 23" -> "/us/act/1895-01-12/ch23"] ", " ["28 Stat. 615" -> "/us/stat/28/615"] ", which related to the same subject matter, see section 56(i) of " ["act Oct. 31, 1951, ch. 655" -> "/us/act/1951-10-31/ch655"] ", " ["65 Stat. 729" -> "/us/stat/65/729"] "."
    hash "a290fa31629b74cce18226a43938c0d6992f8eead3725f8b5089077ba93043c2"
  }
  note "/us/usc/t1/s112a/note/statutoryNotes/pl.94.59/written-requests-for-documents" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Written Requests for Documents"
    p "Copies of United States Treaties and Other International Agreements not available to Senators or Representatives unless specifically requested by them, in writing, see " ["Pub. L. 94–59, title VIII, § 801" -> "/us/pl/94/59/tVIII/s801"] ", July 25, 1975, " ["89 Stat. 296" -> "/us/stat/89/296"] ", set out as a note under " ["section 1317 of Title 44" -> "/us/usc/t44/s1317"] ", Public Printing and Documents."
    hash "e3e45000cccff206989a0dc7caca25722ced46d797669a9ae708a8be9d957d3d"
  }
  layers {
    operative "946c3cebdeaff2e6123134582132acec2697a9df38d9495b666e3324236e8a7f"
    enacted "ca28cc9654d4321c84af5ee721b5caca8cdd9af288c2c4f41662be2fcb6f4f2e"
