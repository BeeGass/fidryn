    p "This section and " ["section 112a of this title" -> "/us/usc/t1/s112a"] " as not affected by the repeal of section 73 of " ["act Jan. 12, 1895, ch. 23" -> "/us/act/1895-01-12/ch23"] ", " ["28 Stat. 615" -> "/us/stat/28/615"] ", which related to the same subject matter, see section 56(i) of " ["act Oct. 31, 1951, ch. 655" -> "/us/act/1951-10-31/ch655"] ", " ["65 Stat. 729" -> "/us/stat/65/729"] "."
    hash "e0cbe0fbac26cfbcffb6ea6549ab4a56a2646cbc60a442add710c7f867b88612"
  }
