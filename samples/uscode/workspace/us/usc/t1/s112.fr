  note "/us/usc/t1/s112/note/statutoryNotes/pl.106.554/publication-of-certain-laws-of-106th-congress" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Publication of Certain Laws of 106th Congress"
