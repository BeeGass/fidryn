edition 2
module "/us/usc/t1/s112b" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s112b" section {
    num "112b" "§ 112b."
    heading "United States international agreements and non-binding instruments; transparency provisions"
    provision "/us/usc/t1/s112b/a" subsection {
      num "a" "(a)"
      provision "/us/usc/t1/s112b/a/1" paragraph {
        num "1" "(1)"
        chapeau "Not less frequently than once each month, the Secretary shall provide in writing to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, and the appropriate congressional committees the following:"
        provision "/us/usc/t1/s112b/a/1/A" subparagraph {
          num "A" "(A)"
          provision "/us/usc/t1/s112b/a/1/A/i" clause {
            num "i" "(i)"
            content "A list of all international agreements and qualifying non-binding instruments signed, concluded, or otherwise finalized during the prior month."
            hash "c70e4c4f6da9a215f75bd6d636a5b950f2f9aa08d356949bdaccd11e54551f6d"
          }
          provision "/us/usc/t1/s112b/a/1/A/ii" clause {
            num "ii" "(ii)"
            content "The text of all international agreements and qualifying non-binding instruments described in clause (i)."
            hash "678faf163d4c7274f170216de27786a22bc4577388424d94d6c66cfa3e666d92"
          }
          provision "/us/usc/t1/s112b/a/1/A/iii" clause {
            num "iii" "(iii)"
            content "A detailed description of the legal authority that, in the view of the Secretary, provides authorization for each international agreement and that, in the view of the appropriate department or agency, provides authorization for each qualifying non-binding instrument provided under clause (ii) to become operative. If multiple authorities are relied upon in relation to an international agreement, the Secretary shall cite all such authorities, and if multiple authorities are relied upon in relation to a qualifying non-binding instrument, the appropriate department or agency shall cite all such authorities. All citations to the Constitution of the United States, a treaty, or a statute shall include the specific article or section and subsection reference whenever available and, if not available, shall be as specific as possible. If the authority relied upon is or includes article II of the Constitution of the United States, the Secretary or appropriate department or agency shall explain the basis for that reliance."
            hash "d29779d8b46bcf641575ecdf419f5876f40e25cee0a7d629aa337d8481e508d9"
          }
          hash "c3fb57e7da98d9ec3c2621f5851719e13053464ca0202340d0170c566a786a34"
        }
        provision "/us/usc/t1/s112b/a/1/B" subparagraph {
          num "B" "(B)"
          provision "/us/usc/t1/s112b/a/1/B/i" clause {
            num "i" "(i)"
            content "A list of all international agreements that entered into force and qualifying non-binding instruments that became operative for the United States or an agency of the United States during the prior month."
            hash "940de87ee7d4bb900cf4aa8122e82ae1a04ca72542b35889bd3b24eca4665fa1"
          }
          provision "/us/usc/t1/s112b/a/1/B/ii" clause {
            num "ii" "(ii)"
            content "The text of all international agreements and qualifying non-binding instruments described in clause (i) if such text differs from the text of the agreement or instrument previously provided pursuant to subparagraph (A)(ii)."
            hash "87a29a2ee6e8a27ede546fb15818900e016bc5ba691700134d95d760b1c306d8"
          }
          provision "/us/usc/t1/s112b/a/1/B/iii" clause {
            num "iii" "(iii)"
            content "A statement describing any new or amended statutory or regulatory authority anticipated to be required to fully implement each proposed international agreement and qualifying non-binding instrument included in the list described in clause (i)."
            hash "5b3940ff1961bad320582a3a6965768602b0521b0fca9c96d6bb3bada0a4117b"
          }
          hash "026e57a1a87e89dcc7e2355e6b7b2c7ce2e9849630782fbcb43860e2ff66453f"
        }
        hash "04b59816db6409af8b47e0ca8f5e81ccaf3c54503817f43463bdaf54ccb1e912"
      }
      provision "/us/usc/t1/s112b/a/2" paragraph {
        num "2" "(2)"
        content "The information and text required by paragraph (1) shall be submitted in unclassified form, but may include a classified annex."
        hash "53d156a00cc5252c5faa407abfcf5ca57cca67cf94db0a5160ca0e019952b2d1"
      }
      hash "620d86a68b0c931bdc52a0a91f29aafab895fbcc312540693b599b2b4fee90f7"
    }
    provision "/us/usc/t1/s112b/b" subsection {
      num "b" "(b)"
      provision "/us/usc/t1/s112b/b/1" paragraph {
        num "1" "(1)"
        content "Not later than 120 days after the date on which an international agreement enters into force, the Secretary shall make the text of the agreement, and the information described in subparagraphs (A)(iii) and (B)(iii) of subsection (a)(1) relating to the agreement, available to the public on the website of the Department of State."
        hash "c26a96bb17dd0a9a61378b70fe510afae8991c6c96920c7d8b5d8408ddb22439"
      }
      provision "/us/usc/t1/s112b/b/2" paragraph {
        num "2" "(2)"
        content "Not less frequently than once every 120 days, the Secretary shall make the text of each qualifying non-binding instrument that became operative during the preceding 120 days, and the information described in subparagraphs (A)(iii) and (B)(iii) of subsection (a)(1) relating to each such instrument, available to the public on the website of the Department of State."
        hash "93bc85331c311724e363dca2a85eb4facec8578b27aa89a3cc771e622e13a487"
      }
      provision "/us/usc/t1/s112b/b/3" paragraph {
        num "3" "(3)"
        chapeau "The requirements under paragraphs (1) and (2) shall not apply to the following categories of international agreements or qualifying non-binding instruments, or to information described in subparagraphs (A)(iii) and (B)(iii) of subsection (a)(1) relating to such agreements or qualifying non-binding instruments:"
        provision "/us/usc/t1/s112b/b/3/A" subparagraph {
          num "A" "(A)"
          content "International agreements and qualifying non-binding instruments that contain information that has been given a national security classification pursuant to Executive Order 13526 (" ["50 U.S.C. 3161" -> "/us/usc/t50/s3161"] " note; relating to classified national security information) or any predecessor or successor order, or that contain any information that is otherwise exempt from public disclosure pursuant to United States law."
          hash "a097355895d140297b4e5410b108a0552e244c703ed79f79e4c54e64bf309d39"
        }
        provision "/us/usc/t1/s112b/b/3/B" subparagraph {
          num "B" "(B)"
          content "International agreements and qualifying non-binding instruments that address military operations, military exercises, acquisition and cross servicing, logistics support, military personnel exchange or education programs, or the provision of health care to military personnel on a reciprocal basis."
          hash "994864c35f8a0f2daba6e1a13dc9836dabce698ffd1f10e6776005b695b0f320"
        }
        provision "/us/usc/t1/s112b/b/3/C" subparagraph {
          num "C" "(C)"
          content "International agreements and qualifying non-binding instruments that establish the terms of grant or other similar assistance, including in-kind assistance, financed with foreign assistance funds pursuant to the Foreign Assistance Act of 1961 (" ["22 U.S.C. 2151" -> "/us/usc/t22/s2151"] " et seq.) or the Food for Peace Act (" ["7 U.S.C. 1691" -> "/us/usc/t7/s1691"] " et seq.)."
          hash "0481feec573a231c665c67758407fe2c826375d10faf976fbac10d3e3f564183"
        }
        provision "/us/usc/t1/s112b/b/3/D" subparagraph {
          num "D" "(D)"
          content "International agreements and qualifying non-binding instruments, such as project annexes and other similar instruments, for which the principal function is to establish technical details for the implementation of a specific project undertaken pursuant to another agreement or qualifying non-binding instrument that has been published in accordance with paragraph (1) or (2)."
          hash "2678b6a61723ee23f235cbbf515ce5b94c1945efd65d3bcb6a834dfd130c78d8"
        }
        provision "/us/usc/t1/s112b/b/3/E" subparagraph {
          num "E" "(E)"
          content "International agreements and qualifying non-binding instruments that have been separately published by a depositary or other similar administrative body, except that the Secretary shall make the information described in subparagraphs (A)(iii) and (B)(iii) of subsection (a)(1), relating to such agreements or qualifying non-binding instruments, available to the public on the website of the Department of State within the timeframes required by paragraph (1) or (2)."
          hash "459ab98fcb45635fc9235d5c2ddaa0cbbf0a2c0af7501eb01bfe03bbf849f910"
        }
        hash "313d2483cd22fdd4fbbfb382c5633243e7180a991669c85234f954a79572ec72"
      }
      hash "67ec15ad311ae80fcc883abff67e888719a7fef4d85228d788dc93f61671d3af"
    }
    provision "/us/usc/t1/s112b/c" subsection {
      num "c" "(c)"
      content "For any international agreement or qualifying non-binding instrument for which an implementing agreement or arrangement, or any document of similar purpose or function to the aforementioned regardless of the title of the document, is not otherwise required to be submitted to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, and the appropriate congressional committees under subparagraphs (A)(ii) or (B)(ii) of subsection (a)(1), not later than 30 days after the date on which the Secretary receives a written communication from the Chair or Ranking Member of either of the appropriate congressional committees requesting the text of any such implementing agreements or arrangements, whether binding or non-binding, the Secretary shall submit such implementing agreements or arrangements to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, and the appropriate congressional committees."
      hash "262815af902b35432458d1add8b2052fab3ae3924127340effe5b2b79719bba9"
    }
    provision "/us/usc/t1/s112b/d" subsection {
      num "d" "(d)"
      chapeau "Any department or agency of the United States Government that enters into any international agreement or qualifying non-binding instrument on behalf of itself or the United States shall—"
      provision "/us/usc/t1/s112b/d/1" paragraph {
        num "1" "(1)"
        content "provide to the Secretary the text of each international agreement not later than 15 days after the date on which such agreement is signed or otherwise concluded;"
        hash "e6de89cc87d98db05912c038f76dd03ea90e95d87eebf3284897f6915b0a711c"
      }
      provision "/us/usc/t1/s112b/d/2" paragraph {
        num "2" "(2)"
        content "provide to the Secretary the text of each qualifying non-binding instrument not later than 15 days after the date on which such instrument is concluded or otherwise becomes finalized;"
        hash "85c037c7a6715dcc4e5abc411ac7b3db85aae03f99d7fbf56fa0c781e1ec002a"
      }
      provision "/us/usc/t1/s112b/d/3" paragraph {
        num "3" "(3)"
        content "provide to the Secretary a detailed description of the legal authority that provides authorization for each qualifying non-binding instrument to become operative not later than 15 days after such instrument is signed or otherwise becomes finalized; and"
        hash "6af9b00bd902e1b7ba0e369d3d3c114e4b4d807b22d69b25fe21e57bcc8293a0"
      }
      provision "/us/usc/t1/s112b/d/4" paragraph {
        num "4" "(4)"
        content "on an ongoing basis, provide any implementing material to the Secretary for transmittal to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, and the appropriate congressional committees as needed to satisfy the requirements described in subsection (c)."
        hash "88deb7c5771eadd60ed5d77558d65a8dbf1e7c539d3cd164a3593fc005c5af10"
      }
      hash "6bd22ade944b6a015073aa4f58e31b1a03aee22f980e605603d19e06abf2e68c"
    }
    provision "/us/usc/t1/s112b/e" subsection {
      num "e" "(e)"
      provision "/us/usc/t1/s112b/e/1" paragraph {
        num "1" "(1)"
        chapeau "Each department or agency of the United States Government that enters into any international agreement or qualifying non-binding instrument on behalf of itself or the United States shall designate a Chief International Agreements Officer, who shall—"
        provision "/us/usc/t1/s112b/e/1/A" subparagraph {
          num "A" "(A)"
          content "be selected from among employees of such department or agency;"
          hash "4a287f4082f25af6dfbad147816d1780fea1e28e7b8d69fa6ce949d70b51e723"
        }
        provision "/us/usc/t1/s112b/e/1/B" subparagraph {
          num "B" "(B)"
          content "serve concurrently as the Chief International Agreements Officer; and"
          hash "ae8285b656f7e1b593ff3354a5a763fd053907145dbf58a89453f138cdd1afa5"
        }
        provision "/us/usc/t1/s112b/e/1/C" subparagraph {
          num "C" "(C)"
          content "subject to the authority of the head of such department or agency, have department- or agency-wide responsibility for efficient and appropriate compliance with this section."
          hash "f679bb1090235bb134162b3aa45d82ccde62bec5acdee40ccbba469ea532f6ef"
        }
        hash "18f4105d8b32b50717b86f2b36a9a10f5cb00de6c4a1767b9c901d1a40fdd638"
      }
      provision "/us/usc/t1/s112b/e/2" paragraph {
        num "2" "(2)"
        content "There shall be a Chief International Agreements Officer who serves at the Department of State with the title of International Agreements Compliance Officer."
        hash "042aacd5df56845b79949fc25beac8497581de7b3adec21d5d01e2128ee2e26d"
      }
      hash "452a9920fc87ea803ee3b01724a3ae5fd4d29a2dd63139bb3af61edbb18fdc0e"
    }
    provision "/us/usc/t1/s112b/f" subsection {
      num "f" "(f)"
      content "The substance of oral international agreements shall be reduced to writing for the purpose of meeting the requirements of subsections (a) and (b)."
      hash "eee279f1f9b3b9b02c5703b729854bd43f4c05cb001da0504edb334f00929fc2"
    }
    provision "/us/usc/t1/s112b/g" subsection {
      num "g" "(g)"
      content "Notwithstanding any other provision of law, an international agreement may not be signed or otherwise concluded on behalf of the United States without prior consultation with the Secretary. Such consultation may encompass a class of agreements rather than a particular agreement."
      hash "dbb2e85556ea001f029e30e8e9a07bbb6d61eafa7ff095026c613686bc86ddad"
    }
    provision "/us/usc/t1/s112b/h" subsection {
      num "h" "(h)"
      provision "/us/usc/t1/s112b/h/1" paragraph {
        num "1" "(1)"
        content "Not later than 3 years after the date of the enactment of this section, and not less frequently than once every 3 years thereafter during the 9-year period beginning on the date of the enactment of this section, the Comptroller General of the United States shall conduct an audit of the compliance of the Secretary with the requirements of this section."
        hash "99d6c1aa8d0ddd4d9026cb04efd65d1e4e975872cf9b98ac1944ef390017ea06"
      }
      provision "/us/usc/t1/s112b/h/2" paragraph {
        num "2" "(2)"
        chapeau "In any instance in which a failure by the Secretary to comply with such requirements is determined by the Comptroller General to have been due to the failure or refusal of another agency to provide information or material to the Department of State, or the failure to do so in a timely manner, the Comptroller General shall engage such other agency to determine—"
        provision "/us/usc/t1/s112b/h/2/A" subparagraph {
          num "A" "(A)"
          content "the cause and scope of such failure or refusal;"
          hash "c536b3efd44f856cec6abd7c10613a5570c4eeb48f0871884383c364419352ff"
        }
        provision "/us/usc/t1/s112b/h/2/B" subparagraph {
          num "B" "(B)"
          content "the specific office or offices responsible for such failure or refusal; and"
          hash "d9b25f77fe854edc03a43d0d3f63060c169e63252ccab312ec6c768ac17fc2fc"
        }
        provision "/us/usc/t1/s112b/h/2/C" subparagraph {
          num "C" "(C)"
          content "recommendations for measures to ensure compliance with statutory requirements."
          hash "c0043b27ffc282a6b715c21a495fcce41f9c67ab88d5a4ad10ee79e7d9a75470"
        }
        hash "b0ee3dca63eeb09e782897a967399fc53e6ee2f8603dee8e255e55f762cf87b5"
      }
      provision "/us/usc/t1/s112b/h/3" paragraph {
        num "3" "(3)"
        content "The Comptroller General shall submit to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, and the appropriate congressional committees in writing the results of each audit required by paragraph (1)."
        hash "7cdc834808aae3f6fe2ee8dfa656879c9e392b2d477d726962202a6789900f37"
      }
      provision "/us/usc/t1/s112b/h/4" paragraph {
        num "4" "(4)"
        content "The Comptroller General and the Secretary shall make the results of each audit required by paragraph (1) publicly available on the websites of the Government Accountability Office and the Department of State, respectively."
        hash "e150837f45643db079d89189d05b68a5c7145e1ece240a5c4baa953d0daf0d97"
      }
      hash "201308456110c0db9709f83de04a12165032ebb3b85acd082f0ef6a7f62b1f6f"
    }
    provision "/us/usc/t1/s112b/i" subsection {
      num "i" "(i)"
      content "The President shall, through the Secretary, promulgate such rules and regulations as may be necessary to carry out this section."
      hash "a9dcb220ee9adfc565723ad320b8e351a5f6471d111ed49e2d380cd16d014e4a"
    }
    provision "/us/usc/t1/s112b/j" subsection {
      num "j" "(j)"
      content "It is the sense of Congress that the executive branch should not prescribe or otherwise commit to or include specific legislative text in a treaty, executive agreement, or non-binding instrument unless Congress has authorized such action."
      hash "aa36f859b56d4f8eafbc7679ba74cb7426f20e9d7cfe06f5395f15acbfe07b4c"
    }
    provision "/us/usc/t1/s112b/k" subsection {
      num "k" "(k)"
      chapeau "In this section:"
      provision "/us/usc/t1/s112b/k/1" paragraph {
        num "1" "(1)"
        chapeau "The term “appropriate congressional committees” means—"
        provision "/us/usc/t1/s112b/k/1/A" subparagraph {
          num "A" "(A)"
          content "the Committee on Foreign Relations of the Senate; and"
          hash "417290e038d5f2ad3af9ffcfaa7ccc7a017ea734e52dce313ec16a26066f1d99"
        }
        provision "/us/usc/t1/s112b/k/1/B" subparagraph {
          num "B" "(B)"
          content "the Committee on Foreign Affairs of the House of Representatives."
          hash "ec7ad7df911206bbb02fc27bd1e7cd99da336566191c8e3de8817f27d9f837a3"
        }
        hash "0555b3cda08d93c6bcdf2216dcd93a1ae0d31fa68edb65727e468715ea4dcb27"
      }
      provision "/us/usc/t1/s112b/k/2" paragraph {
        num "2" "(2)"
        content "The term “appropriate department or agency” means the department or agency of the United States Government that negotiates and enters into a qualifying non-binding instrument on behalf of itself or the United States."
        hash "4203abe86eac7e5db4fcea5c53e05c55cd581cf1460b7acae73f64d6506ad10d"
      }
      provision "/us/usc/t1/s112b/k/3" paragraph {
        num "3" "(3)"
        content "The term “intelligence community” has the meaning given that term in section 3(4) of the National Security Act of 1947 (" ["50 U.S.C. 3003(4)" -> "/us/usc/t50/s3003/4"] ")."
        hash "cb10887b70518848006feeef3582baac72d6661a3121e9d0275763d6dd4397c0"
      }
      provision "/us/usc/t1/s112b/k/4" paragraph {
        num "4" "(4)"
        chapeau "The term “international agreement” includes—"
        provision "/us/usc/t1/s112b/k/4/A" subparagraph {
          num "A" "(A)"
          content "any treaty that requires the advice and consent of the Senate, pursuant to article II of the Constitution of the United States; and"
          hash "c2c31556849e69f4cc604222558887ed148e0727e5d35da49a54d2c2e748739d"
        }
        provision "/us/usc/t1/s112b/k/4/B" subparagraph {
          num "B" "(B)"
          content "any other international agreement to which the United States is a party and that is not subject to the advice and consent of the Senate."
          hash "6092644f5bf22bcb5b3c898cb8710c19d96e87a0fc93b60bbd8280d86fffe7ee"
        }
        hash "99c8ecaee8578b386e8196e988ed8ce1096a85850b8dcef8aeb9113036a3bf11"
      }
      provision "/us/usc/t1/s112b/k/5" paragraph {
        num "5" "(5)"
        chapeau "The term “qualifying non-binding instrument”—"
        provision "/us/usc/t1/s112b/k/5/A" subparagraph {
          num "A" "(A)"
          chapeau "except as provided in subparagraph (B), means a non-binding instrument that—"
          provision "/us/usc/t1/s112b/k/5/A/i" clause {
            num "i" "(i)"
            content "is or will be under negotiation, is signed or otherwise becomes operative, or is implemented with one or more foreign governments, international organizations, or foreign entities, including non-state actors; and"
            hash "cfb212e170d4a93008689bac5b03c4f145135e5776ec9013984a828cfdc6f621"
          }
          provision "/us/usc/t1/s112b/k/5/A/ii" clause {
            num "ii" "(ii)"
            provision "/us/usc/t1/s112b/k/5/A/ii/I" subclause {
              num "I" "(I)"
              content "could reasonably be expected to have a significant impact on the foreign policy of the United States; or"
              hash "2deba03def3b7655ebad563549d42d19be94f5fa5de7fb8a6bea2bda5fc2bdad"
            }
            provision "/us/usc/t1/s112b/k/5/A/ii/II" subclause {
              num "II" "(II)"
              content "is the subject of a written communication from the Chair or Ranking Member of either of the appropriate congressional committees to the Secretary; and"
              hash "5f7ed9393e1a0df81011408177102258c5a34fda4c5aec6eecd56244acda77c6"
            }
            hash "33cd63de5e905e1e6ee1f3ac411ba1a6855c79c5e72c9c7e49cf705b2bf2dc42"
          }
          hash "9b6b6c67ebb2d3bb6d422752cd461f36fd086397582624c2570bbb48cd060746"
        }
        provision "/us/usc/t1/s112b/k/5/B" subparagraph {
          num "B" "(B)"
          content "does not include any non-binding instrument that is signed or otherwise becomes operative or is implemented pursuant to the authorities relied upon by the Department of Defense, the Armed Forces of the United States, or any element of the intelligence community."
          hash "b7c5cd6351b894ee36119953c0a2329e25085767e8e7a21ba01dad2d8e07e3ea"
        }
        hash "21e4e48cfb6ea77345df537adc3c48309ff5c10bcf844003d84c1f27089a5c79"
      }
      provision "/us/usc/t1/s112b/k/6" paragraph {
        num "6" "(6)"
        content "The term “Secretary” means the Secretary of State."
        hash "2c0d07cb62826aefb218254e211bda521b6aacd96b692e8470fcb51dbc2a92e4"
      }
      provision "/us/usc/t1/s112b/k/7" paragraph {
        num "7" "(7)"
        provision "/us/usc/t1/s112b/k/7/A" subparagraph {
          num "A" "(A)"
          chapeau "The term “text” with respect to an international agreement or qualifying non-binding instrument includes—"
          provision "/us/usc/t1/s112b/k/7/A/i" clause {
            num "i" "(i)"
            content "any annex, appendix, codicil, side agreement, side letter, or any document of similar purpose or function to the aforementioned, regardless of the title of the document, that is entered into contemporaneously and in conjunction with the international agreement or qualifying non-binding instrument; and"
            hash "1619713b0df31b74706f3895b1679f24741953b647634596a5389da5fcb52ac0"
          }
          provision "/us/usc/t1/s112b/k/7/A/ii" clause {
            num "ii" "(ii)"
            content "any implementing agreement or arrangement, or any document of similar purpose or function to the aforementioned regardless of the title of the document, that is entered into contemporaneously and in conjunction with the international agreement or qualifying non-binding instrument."
            hash "c96ab4342b657bad4a689588f0d55491970b3004d817a5b97d72622016b494c9"
          }
          hash "73bad872dca1a8075e8b506a4ab385fdbdd648376bde286221909dcd333c3b3c"
        }
        provision "/us/usc/t1/s112b/k/7/B" subparagraph {
          num "B" "(B)"
          chapeau "As used in subparagraph (A), the term “contemporaneously and in conjunction with”—"
          provision "/us/usc/t1/s112b/k/7/B/i" clause {
            num "i" "(i)"
            content "shall be construed liberally; and"
            hash "db94056aed973f47ea31e1c6d881723e96ecc35a7fb10013bfce60208d99e94e"
          }
          provision "/us/usc/t1/s112b/k/7/B/ii" clause {
            num "ii" "(ii)"
            content "may not be interpreted to require any action to have occurred simultaneously or on the same day."
            hash "44835244cff005cd88e388a4c3674ef07f818a334da4e147ebfaf72f11bb3b5c"
          }
          hash "6f709f74d1af9639946a5137d2e6be7860453dadba9b230d842a2c3e9c4417d5"
        }
        hash "c15439c3e6dd811803e55481c98b4e39213f473714dbc906dd595c50a2de2b85"
      }
      hash "3ad1860328b4f553cfe9761f127341b9fbe71d7c29a1ead7ee37222b347e0c47"
    }
    provision "/us/usc/t1/s112b/l" subsection {
      num "l" "(l)"
      chapeau "Nothing in this section may be construed—"
      provision "/us/usc/t1/s112b/l/1" paragraph {
        num "1" "(1)"
        content "to authorize the withholding from disclosure to the public of any record if such disclosure is required by law; or"
        hash "b8d4d9109bfb241d07be86a86a99e42db94651cc31258f3e9e120d019e4db0cf"
      }
      provision "/us/usc/t1/s112b/l/2" paragraph {
        num "2" "(2)"
        content "to require the provision of any implementing agreement or arrangement, or any document of similar purpose or function regardless of its title, which was entered into by the Department of Defense, the Armed Forces of the United States, or any element of the intelligence community or any implementing material originating with the aforementioned agencies, if such implementing agreement, arrangement, document, or material was not required to be provided to the Majority Leader of the Senate, the Minority Leader of the Senate, the Speaker of the House of Representatives, the Minority Leader of the House of Representatives, or the appropriate congressional committees prior to the date of the enactment of the James M. Inhofe National Defense Authorization Act for Fiscal Year 2023."
        hash "5e0dd59153917af2433b86c64f3e47d90d134a23579ed0936cb70ae3f497bef8"
      }
      hash "5dc897f1ad8b532af5132ce6a4fa4af04d7899a648162ef475773c498f41d14b"
    }
    hash "fe4262fb3d8f7cf6c1df90607195b512b13b063aea62798c87fdf35f704b4faa"
  }
  credit "(Added " ["Pub. L. 92–403, § 1" -> "/us/pl/92/403/s1"] ", Aug. 22, 1972, " ["86 Stat. 619" -> "/us/stat/86/619"] "; amended " ["Pub. L. 95–45, § 5" -> "/us/pl/95/45/s5"] ", June 15, 1977, " ["91 Stat. 224" -> "/us/stat/91/224"] "; " ["Pub. L. 95–426, title VII, § 708" -> "/us/pl/95/426/tVII/s708"] ", Oct. 7, 1978, " ["92 Stat. 993" -> "/us/stat/92/993"] "; " ["Pub. L. 103–437, § 1" -> "/us/pl/103/437/s1"] ", Nov. 2, 1994, " ["108 Stat. 4581" -> "/us/stat/108/4581"] "; " ["Pub. L. 108–458, title VII, § 7121(b)" -> "/us/pl/108/458/tVII/s7121/b"] "–(d), Dec. 17, 2004, " ["118 Stat. 3807" -> "/us/stat/118/3807"] ", 3808; " ["Pub. L. 116–260, div. FF, title XVII, § 1708(b)" -> "/us/pl/116/260/dFF/tXVII/s1708/b"] ", Dec. 27, 2020, " ["134 Stat. 3298" -> "/us/stat/134/3298"] "; " ["Pub. L. 117–263, div. E, title LIX, § 5947(a)(1)" -> "/us/pl/117/263/dE/tLIX/s5947/a/1"] ", Dec. 23, 2022, " ["136 Stat. 3476" -> "/us/stat/136/3476"] ".)"
  note "/us/usc/t1/s112b/note/editorialNotes/pl.87.195/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Executive Order 13526, referred to in subsec. (b)(3)(A), is Ex. Ord. No. 13526, Dec. 29, 2009, 75 F.R. 707, 1013, which is set out as a note under " ["section 3161 of Title 50" -> "/us/usc/t50/s3161"] ", War and National Defense."
    p "The Foreign Assistance Act of 1961, referred to in subsec. (b)(3)(C), is " ["Pub. L. 87–195" -> "/us/pl/87/195"] ", Sept. 4, 1961, " ["75 Stat. 424" -> "/us/stat/75/424"] ", which is classified principally to chapter 32 (§ 2151 et seq.) of Title 22, Foreign Relations and Intercourse. For complete classification of this Act to the Code, see Short Title note set out under " ["section 2151 of Title 22" -> "/us/usc/t22/s2151"] " and Tables."
    p "The Food for Peace Act, referred to in subsec. (b)(3)(C), is " ["act July 10, 1954, ch. 469" -> "/us/act/1954-07-10/ch469"] ", " ["68 Stat. 454" -> "/us/stat/68/454"] ", which is classified principally to chapter 41 (§ 1691 et seq.) of Title 7, Agriculture. For complete classification of this Act to the Code, see Short Title note set out under " ["section 1691 of Title 7" -> "/us/usc/t7/s1691"] " and Tables."
    p "The date of the enactment of this section, and the date of the enactment of the James M. Inhofe National Defense Authorization Act for Fiscal Year 2023, referred to in subsecs. (h)(1) and (l)(2), are the date of enactment of " ["Pub. L. 117–263" -> "/us/pl/117/263"] ", which was approved Dec. 23, 2022."
    hash "5619b67be0c892410a2353476a463c9091ab40db5f36749f9bc7012f4edf00fd"
  }
  note "/us/usc/t1/s112b/note/editorialNotes/pl.117.263/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "2022—" ["Pub. L. 117–263" -> "/us/pl/117/263"] " amended section generally. Prior to amendment, section related to requirements for transmitting the text of United States international agreements and various reports to Congress."
    p "2020—Subsec. (g). " ["Pub. L. 116–260" -> "/us/pl/116/260"] " added subsec. (g)."
    p "2004—Subsec. (a). " ["Pub. L. 108–458, § 7121(b)" -> "/us/pl/108/458/s7121/b"] ", substituted “Committee on International Relations” for “Committee on Foreign Affairs”."
    p "Subsec. (d). " ["Pub. L. 108–458, § 7121(c)" -> "/us/pl/108/458/s7121/c"] ", added subsec. (d). Former subsec. (d) redesignated (e)."
    p "Subsec. (e). " ["Pub. L. 108–458, § 7121(d)" -> "/us/pl/108/458/s7121/d"] ", designated existing provisions as par. (1), substituted “Subject to paragraph (2), the Secretary of State” for “The Secretary of State”, and added par. (2)."
    p ["Pub. L. 108–458, § 7121(c)(1)" -> "/us/pl/108/458/s7121/c/1"] ", redesignated subsec. (d) as (e). Former subsec. (e) redesignated (f)."
    p "Subsec. (f). " ["Pub. L. 108–458, § 7121(c)(1)" -> "/us/pl/108/458/s7121/c/1"] ", redesignated subsec. (e) as (f)."
    p "1994—Subsec. (a). " ["Pub. L. 103–437" -> "/us/pl/103/437"] " substituted “Committee on Foreign Affairs” for “Committee on International Relations”."
    p "1978—" ["Pub. L. 95–426" -> "/us/pl/95/426"] " designated existing provisions as subsec. (a), inserted “(including the text of any oral international agreement, which agreement shall be reduced to writing)”, and added subsecs. (b) to (e)."
    p "1977—" ["Pub. L. 95–45" -> "/us/pl/95/45"] " substituted “Committee on International Relations of the House of Representatives” for “Committee on Foreign Affairs of the House of Representatives” and inserted requirement that any department or agency of the United States Government which enters into any international agreement on behalf of the United States transmit to the Department of State the text of such agreement not later than twenty days after the agreement has been signed."
    hash "70519ebb2d28378749d8ab600042b78cd429bb19a59aaf8d1a53b9f0574cb516"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/nolaw/change-of-name" enacted {
    group statutoryNotes
    topic "changeOfName"
    heading "Change of Name"
    p "Committee on International Relations of House of Representatives changed to Committee on Foreign Affairs of House of Representatives by House Resolution No. 6, One Hundred Tenth Congress, Jan. 5, 2007."
    hash "f1ad0fc62272a02004702f8c97ca3f5a4f502e002fc95401e68d107923c4b03e"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/pl.117.263/effective-date-of-2022-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 2022 Amendment"
    p "Amendment by " ["Pub. L. 117–263" -> "/us/pl/117/263"] " effective 270 days after Dec. 23, 2022, see " ["section 5947(c) of Pub. L. 117–263" -> "/us/pl/117/263/s5947/c"] ", set out as a note under " ["section 112a of this title" -> "/us/usc/t1/s112a"] "."
    hash "368dcba7dc9c3634e64c0fb073e1fe4178ba432cbf80e1f4c4491351ad6df119"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/nolaw/short-title" enacted {
    group statutoryNotes
    topic "shortTitle"
    heading "Short Title"
    p "This section is popularly known as the Case-Zablocki Act."
    hash "cd8b2e8c22c0599a2d2fca205e76b143b871a86cb8da3f2fcb90cbe5f4fd0874"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/pl.117.263/rules-and-regulations" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Rules and Regulations"
    p ["Pub. L. 117–263, div. E, title LIX, § 5947(a)(5)" -> "/us/pl/117/263/dE/tLIX/s5947/a/5"] ", Dec. 23, 2022, " ["136 Stat. 3482" -> "/us/stat/136/3482"] ", provided that:"
    quoted "/us/pl/117/263/dE/tLIX/s5947/a/5" {
      p "“Not later than 180 days after the date of the enactment of this Act [Dec. 23, 2022], the President, through the Secretary of State, shall promulgate such rules and regulations as may be necessary to carry out " ["section 112b of title 1" -> "/us/usc/t1/s112b"] ", United States Code, as amended by paragraph (1).”"
    }
    hash "2aa630f9f2b5d6424ea80735b1bfab0f46c2201b14e6edce68825cb22060663a"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/pl.117.263/mechanism-for-reporting" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Mechanism for Reporting"
    p ["Pub. L. 117–263, div. E, title LIX, § 5947(a)(4)" -> "/us/pl/117/263/dE/tLIX/s5947/a/4"] ", Dec. 23, 2022, " ["136 Stat. 3481" -> "/us/stat/136/3481"] ", provided that:"
    quoted "/us/pl/117/263/dE/tLIX/s5947/a/4" {
      p "“Not later than 270 days after the date of the enactment of this Act [Dec. 23, 2022], the Secretary of State shall establish a mechanism for personnel of the Department of State who become aware or who have reason to believe that the requirements under " ["section 112b of title 1" -> "/us/usc/t1/s112b"] ", United States Code, as amended by paragraph (1), have not been fulfilled with respect to an international agreement or qualifying non-binding instrument (as such terms are defined in such section) to report such instances to the Secretary.”"
    }
    hash "799f61548235108dbb5608421437af9e271abe17d8a13c68535e4bfff02f79fd"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/pl.117.263/consultation-and-briefing-requirement" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Consultation and Briefing Requirement"
    p ["Pub. L. 117–263, div. E, title LIX, § 5947(a)(6)" -> "/us/pl/117/263/dE/tLIX/s5947/a/6"] ", Dec. 23, 2022, " ["136 Stat. 3482" -> "/us/stat/136/3482"] ", provided that:"
    quoted "/us/pl/117/263/dE/tLIX/s5947/a/6" {
      level subparagraph {
        num "A" "“(A)"
        heading "Consultation.—"
        content "The Secretary of State shall consult with the Committee on Foreign Relations of the Senate and the Committee on Foreign Affairs of the House of Representatives on matters related to the implementation of this section [amending this section, " ["section 112a of this title" -> "/us/usc/t1/s112a"] ", and " ["section 195c of Title 6" -> "/us/usc/t6/s195c"] ", Domestic Security, and enacting provisions set out as notes under this section and " ["section 112a of this title" -> "/us/usc/t1/s112a"] "] and the amendments made by this section before and after the effective date described in subsection (c) [see Effective Date of 2022 Amendment note set out under " ["section 112a of this title" -> "/us/usc/t1/s112a"] "]."
      }
      level subparagraph {
        num "B" "“(B)"
        heading "Briefing.—"
        content "Not later than 90 days after the date of the enactment of this Act [Dec. 23, 2022], and once every 90 days thereafter for 1 year, the Secretary shall brief the Committee on Foreign Relations of the Senate, the Committee on Appropriations of the Senate, the Committee on Foreign Affairs of the House of Representatives, and the Committee on Appropriations of the House of Representatives regarding the status of efforts to implement this section and the amendments made by this section.”"
      }
    }
    hash "2b895ced01a4faccbbe87c9f2720e4eb6315ded080354f153108ececd0867a3b"
  }
  note "/us/usc/t1/s112b/note/statutoryNotes/pl.100.204/enforcement" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Enforcement"
    p ["Pub. L. 100–204, title I, § 139" -> "/us/pl/100/204/tI/s139"] ", Dec. 22, 1987, " ["101 Stat. 1347" -> "/us/stat/101/1347"] ", as amended by " ["Pub. L. 108–458, title VII, § 7121(e)" -> "/us/pl/108/458/tVII/s7121/e"] ", Dec. 17, 2004, " ["118 Stat. 3808" -> "/us/stat/118/3808"] ", restricted the use of funds during fiscal years 2005, 2006, and 2007 to implement international agreements whose text was not transmitted to Congress within 60 days pursuant to former section 112b."
    hash "2692bb3dacb375ff22454fb0ea849f1ec7980f67d9a2e507ec68e728a55c0203"
  }
