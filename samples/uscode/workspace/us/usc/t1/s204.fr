edition 2
module "/us/usc/t1/s204" {
  within "/us/usc/t1/ch3"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s204" section {
    num "204" "§ 204."
    heading "Codes and Supplements as evidence of the laws of United States and District of Columbia; citation of Codes and Supplements"
    chapeau "In all courts, tribunals, and public offices of the United States, at home or abroad, of the District of Columbia, and of each State, Territory, or insular possession of the United States—"
    provision "/us/usc/t1/s204/a" subsection {
      num "a" "(a)"
      heading "United States Code.—"
      content "The matter set forth in the edition of the Code of Laws of the United States current at any time shall, together with the then current supplement, if any, establish prima facie the laws of the United States, general and permanent in their nature, in force on the day preceding the commencement of the session following the last session the legislation of which is included: Provided, however, That whenever titles of such Code shall have been enacted into positive law the text thereof shall be legal evidence of the laws therein contained, in all the courts of the United States, the several States, and the Territories and insular possessions of the United States."
      hash "998dc398fba2285a6ffec899bada0823581f7d8ac59725f285246a087f83c922"
    }
    provision "/us/usc/t1/s204/b" subsection {
      num "b" "(b)"
      heading "District of Columbia Code.—"
      content "The matter set forth in the edition of the Code of the District of Columbia current at any time shall, together with the then current supplement, if any, establish prima facie the laws, general and permanent in their nature, relating to or in force in the District of Columbia on the day preceding the commencement of the session following the last session the legislation of which is included, except such laws as are of application in the District of Columbia by reason of being laws of the United States general and permanent in their nature."
      hash "c886fc8992585c654041fc5fc2a7532b375d76368cc837457b8fef607e8a0905"
    }
    provision "/us/usc/t1/s204/c" subsection {
      num "c" "(c)"
      heading "District of Columbia Code; citation.—"
      content "The Code of the District of Columbia may be cited as “D.C. Code”."
      hash "2bfd94f57c0f819eb07b7cd5421095eed6edfce4d06ae31224c2ad25be4ab4f2"
    }
    provision "/us/usc/t1/s204/d" subsection {
      num "d" "(d)"
      heading "Supplements to Codes; citation.—"
      content "Supplements to the Code of Laws of the United States and to the Code of the District of Columbia may be cited, respectively, as “U.S.C., Sup. ”, and “D.C. Code, Sup. ”, the blank in each case being filled with Roman figures denoting the number of the supplement."
      hash "8b1948461182c5955abac2745e37ea88977dede7d7eeb93a43c3a49aa1095e96"
    }
    provision "/us/usc/t1/s204/e" subsection {
      num "e" "(e)"
      heading "New edition of Codes; citation.—"
      content "New editions of each of such codes may be cited, respectively, as “U.S.C., ed.”, and “D.C. Code, ed.”, the blank in each case being filled with figures denoting the last year the legislation of which is included in whole or in part."
      hash "8b3a7e0faba80e9dedfd6137aa3b956e189d48be987d31a75294ba8019ddaa41"
    }
    hash "d91ae81ffbd7c693771c4f0d3e79991d5a9f4de7c33ab64d0b9f0afcc872db40"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 638" -> "/us/stat/61/638"] ".)"
  note "/us/usc/t1/s204/note/editorialNotes/act.1947-07-30.ch388/united-states-code-titles-as-positive-law" editorial {
    group editorialNotes
    topic "miscellaneous"
    heading "United States Code Titles as Positive Law"
    p "The following titles of the United States Code were enacted into positive law by the acts enumerated below:"
    p "Title 1, General Provisions—" ["Act July 30, 1947, ch. 388, § 1" -> "/us/act/1947-07-30/ch388/s1"] ", " ["61 Stat. 633" -> "/us/stat/61/633"] "."
    p "Title 3, The President—" ["Act June 25, 1948, ch. 644, § 1" -> "/us/act/1948-06-25/ch644/s1"] ", " ["62 Stat. 672" -> "/us/stat/62/672"] "."
    p "Title 4, Flag and Seal, Seat of Government, and the States—" ["Act July 30, 1947, ch. 389, § 1" -> "/us/act/1947-07-30/ch389/s1"] ", " ["61 Stat. 641" -> "/us/stat/61/641"] "."
    p "Title 5, Government Organization and Employees—" ["Pub. L. 89–554, § 1" -> "/us/pl/89/554/s1"] ", Sept. 6, 1966, " ["80 Stat. 378" -> "/us/stat/80/378"] "; " ["Pub. L. 117–286, § 3" -> "/us/pl/117/286/s3"] ", Dec. 27, 2022, " ["136 Stat. 4197" -> "/us/stat/136/4197"] "."
    p "Title 9, Arbitration—" ["Act July 30, 1947, ch. 392, § 1" -> "/us/act/1947-07-30/ch392/s1"] ", " ["61 Stat. 669" -> "/us/stat/61/669"] "."
    p "Title 10, Armed Forces—" ["Act Aug. 10, 1956, ch. 1041, § 1" -> "/us/act/1956-08-10/ch1041/s1"] ", " ["70 Stat. 1126" -> "/us/stat/70/1126"] ", set out beginning at " ["70A Stat. 1" -> "/us/stat/70A/1"] "."
    p "Title 11, Bankruptcy—" ["Pub. L. 95–598, title I, § 101" -> "/us/pl/95/598/tI/s101"] ", Nov. 6, 1978, " ["92 Stat. 2549" -> "/us/stat/92/2549"] "."
    p "Title 13, Census—" ["Act Aug. 31, 1954, ch. 1158" -> "/us/act/1954-08-31/ch1158"] ", " ["68 Stat. 1012" -> "/us/stat/68/1012"] "."
    p "Title 14, Coast Guard—" ["Act Aug. 4, 1949, ch. 393, § 1" -> "/us/act/1949-08-04/ch393/s1"] ", " ["63 Stat. 495" -> "/us/stat/63/495"] "."
    p "Title 17, Copyrights—" ["Act July 30, 1947, ch. 391, § 1" -> "/us/act/1947-07-30/ch391/s1"] ", " ["61 Stat. 652" -> "/us/stat/61/652"] ", as amended Oct. 19, 1976, " ["Pub. L. 94–553, title I, § 101" -> "/us/pl/94/553/tI/s101"] ", " ["90 Stat. 2541" -> "/us/stat/90/2541"] "."
    p "Title 18, Crimes and Criminal Procedure—" ["Act June 25, 1948, ch. 645, § 1" -> "/us/act/1948-06-25/ch645/s1"] ", " ["62 Stat. 683" -> "/us/stat/62/683"] "."
    p "Title 23, Highways—" ["Pub. L. 85–767, § 1" -> "/us/pl/85/767/s1"] ", Aug. 27, 1958, " ["72 Stat. 885" -> "/us/stat/72/885"] "."
    p "Title 28, Judiciary and Judicial Procedure—" ["Act June 25, 1948, ch. 646, § 1" -> "/us/act/1948-06-25/ch646/s1"] ", " ["62 Stat. 869" -> "/us/stat/62/869"] "."
    p "Title 31, Money and Finance—" ["Pub. L. 97–258, § 1" -> "/us/pl/97/258/s1"] ", Sept. 13, 1982, " ["96 Stat. 877" -> "/us/stat/96/877"] "."
    p "Title 32, National Guard—" ["Act Aug. 10, 1956, ch. 1041, § 2" -> "/us/act/1956-08-10/ch1041/s2"] ", " ["70A Stat. 596" -> "/us/stat/70A/596"] "."
    p "Title 34, Navy—See Title 10, Armed Forces."
    p "Title 35, Patents—" ["Act July 19, 1952, ch. 950, § 1" -> "/us/act/1952-07-19/ch950/s1"] ", " ["66 Stat. 792" -> "/us/stat/66/792"] "."
    p "Title 36, Patriotic and National Observances, Ceremonies, and Organizations—" ["Pub. L. 105–225, § 1" -> "/us/pl/105/225/s1"] ", Aug. 12, 1998, " ["112 Stat. 1253" -> "/us/stat/112/1253"] "."
    p "Title 37, Pay and Allowances of the Uniformed Services—" ["Pub. L. 87–649, § 1" -> "/us/pl/87/649/s1"] ", Sept. 7, 1962. " ["76 Stat. 451" -> "/us/stat/76/451"] "."
    p "Title 38, Veterans’ Benefits—" ["Pub. L. 85–857, § 1" -> "/us/pl/85/857/s1"] ", Sept. 2, 1958, " ["72 Stat. 1105" -> "/us/stat/72/1105"] "."
    p "Title 39, Postal Service—" ["Pub. L. 86–682, § 1" -> "/us/pl/86/682/s1"] ", Sept. 2, 1960, " ["74 Stat. 578" -> "/us/stat/74/578"] ", as revised " ["Pub. L. 91–375, § 2" -> "/us/pl/91/375/s2"] ", Aug. 12, 1970, " ["84 Stat. 719" -> "/us/stat/84/719"] "."
    p "Title 40, Public Buildings, Property, and Works—" ["Pub. L. 107–217, § 1" -> "/us/pl/107/217/s1"] ", Aug. 21, 2002, " ["116 Stat. 1062" -> "/us/stat/116/1062"] "."
    p "Title 41, Public Contracts—" ["Pub. L. 111–350, § 3" -> "/us/pl/111/350/s3"] ", Jan. 4, 2011, " ["124 Stat. 3677" -> "/us/stat/124/3677"] "."
    p "Title 44, Public Printing and Documents—" ["Pub. L. 90–620, § 1" -> "/us/pl/90/620/s1"] ", Oct. 22, 1968, " ["82 Stat. 1238" -> "/us/stat/82/1238"] "."
    p "Title 46, Shipping—" ["Pub. L. 98–89, § 1" -> "/us/pl/98/89/s1"] ", Aug. 26, 1983, " ["97 Stat. 500" -> "/us/stat/97/500"] "; " ["Pub. L. 99–509, title V" -> "/us/pl/99/509/tV"] ", subtitle B, § 5101, Oct. 21, 1986, " ["100 Stat. 1913" -> "/us/stat/100/1913"] "; " ["Pub. L. 100–424, § 6" -> "/us/pl/100/424/s6"] ", Sept. 9, 1988, " ["102 Stat. 1591" -> "/us/stat/102/1591"] "; " ["Pub. L. 100–710, title I, § 102" -> "/us/pl/100/710/tI/s102"] ", Nov. 23, 1988, " ["102 Stat. 4738" -> "/us/stat/102/4738"] "; " ["Pub. L. 109–304" -> "/us/pl/109/304"] ", Oct. 6, 2006, " ["120 Stat. 1485" -> "/us/stat/120/1485"] "."
    p "Title 49, Transportation—" ["Pub. L. 95–473, § 1" -> "/us/pl/95/473/s1"] ", Oct. 17, 1978, " ["92 Stat. 1337" -> "/us/stat/92/1337"] "; " ["Pub. L. 97–449, § 1" -> "/us/pl/97/449/s1"] ", Jan. 12, 1983, " ["96 Stat. 2413" -> "/us/stat/96/2413"] "; " ["Pub. L. 103–272, § 1" -> "/us/pl/103/272/s1"] ", July 5, 1994, " ["108 Stat. 745" -> "/us/stat/108/745"] "."
    p "Title 51, National and Commercial Space Programs—" ["Pub. L. 111–314, § 3" -> "/us/pl/111/314/s3"] ", Dec. 18, 2010, " ["124 Stat. 3328" -> "/us/stat/124/3328"] "."
    p "Title 54, National Park Service and Related Programs—" ["Pub. L. 113–287, § 3" -> "/us/pl/113/287/s3"] ", Dec. 19, 2014, " ["128 Stat. 3094" -> "/us/stat/128/3094"] "."
    hash "bef824dd07afb1e192d1f1d516fe86ab76c53ebc16227907f9272e96d5df6357"
  }
  note "/us/usc/t1/s204/note/editorialNotes/act.1954-08-16.ch736/title-26-internal-revenue-code" editorial {
    group editorialNotes
    topic "miscellaneous"
    heading "Title 26, Internal Revenue Code"
    p "The Internal Revenue Code of 1954 was enacted in the form of a separate code by " ["act Aug. 16, 1954, ch. 736" -> "/us/act/1954-08-16/ch736"] ", " ["68A Stat. 1" -> "/us/stat/68A/1"] ". " ["Pub. L. 99–514, § 2(a)" -> "/us/pl/99/514/s2/a"] ", Oct. 22, 1986, " ["100 Stat. 2095" -> "/us/stat/100/2095"] ", provided that the Internal Revenue Title enacted Aug. 16, 1954, as heretofore, hereby, or hereafter amended, may be cited as the “Internal Revenue Code of 1986”. The sections of Title 26, United States Code, are identical to the sections of the Internal Revenue Code."
    hash "9a7d0e4779804144e762e2bf6f00e246a191a93432d3b3e7958c1608c7420a78"
  }
  layers {
    operative "d91ae81ffbd7c693771c4f0d3e79991d5a9f4de7c33ab64d0b9f0afcc872db40"
