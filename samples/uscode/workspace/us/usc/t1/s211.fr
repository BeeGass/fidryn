edition 2
module "/us/usc/t1/s211" {
  within "/us/usc/t1/ch3"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s211" section {
    num "211" "§ 211."
    heading "Copies to Members of Congress"
    content "In addition to quotas provided for by " ["section 210 of this title" -> "/us/usc/t1/s210"] " there shall be printed, published, and distributed of the Code of Laws relating to the District of Columbia with tables, index, and other ancillaries, suitably bound and with thumb inserts and other convenient devices to distinguish the parts, and of the supplements to both codes as provided for by sections 202, 203 of this title, ten copies of each for each Member of the Senate and House of Representatives of the Congress in which the original authorized publication is made, for his use and distribution, and in addition for the Committee on the Judiciary of the House of Representatives and the Committee on the Judiciary of the Senate a number of bound copies of each equal to ten times the number of members of such committees, and one bound copy of each for the use of each committee of the Senate and House of Representatives."
    hash "b2393f849024e45a73ae5e3e0a102f5973524dff02f5ef81ae3e0aacc32bdbea"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 640" -> "/us/stat/61/640"] ".)"
  note "/us/usc/t1/s211/note/statutoryNotes/pl.92.342/limitation-on-copies-of-new-editions-for-house-of-representa" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Limitation on Copies of New Editions for House of Representatives"
    p ["Pub. L. 92–342, § 101" -> "/us/pl/92/342/s101"] ", July 10, 1972, " ["86 Stat. 447" -> "/us/stat/86/447"] ", provided that:"
    quoted "/us/pl/92/342/s101" {
      p "“Hereafter, appropriations for authorized printing and binding for the Congress shall not be available under the authority of the Act of July 30, 1947 (" ["1 U.S.C. 211" -> "/us/usc/t1/s211"] ") for the printing, publication, and distribution of more than two copies of new editions of the Code of Laws of the United States and of the Code of the District of Columbia for each Member of the House of Representatives.”"
    }
    hash "fc20cff4ad830c95ffca7d6354893e1db781f67961116b10520a0b43aece3a9c"
  }
  note "/us/usc/t1/s211/note/statutoryNotes/pl.94.59/written-requests-for-documents" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Written Requests for Documents"
    p "Copies of District of Columbia Code and Supplements not available to Senators or Representatives unless specifically requested by them, in writing, see " ["Pub. L. 94–59, title VIII, § 801" -> "/us/pl/94/59/tVIII/s801"] ", July 25, 1975, " ["89 Stat. 296" -> "/us/stat/89/296"] ", set out as a note under " ["section 1317 of Title 44" -> "/us/usc/t44/s1317"] ", Public Printing and Documents."
    hash "3d170b9901377bfee4b063d06e36fbcb09c7bc8f60765c5f21d52bc311038346"
  }
  layers {
    operative "b2393f849024e45a73ae5e3e0a102f5973524dff02f5ef81ae3e0aacc32bdbea"
    enacted "c532f28627b5d0ff3cffdaace827f0ba0c8133a45130d4c3bec67c1178cd6feb"
    editorial "e1585c608dc3e65eaa50b07b345ca87d98fd4bee399ed00e9e511e20f35c44ed"
  }
}
