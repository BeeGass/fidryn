edition 2
module "/us/usc/t1/s111" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s111" section {
    num "111" "§ 111."
    heading "Repeals as evidence of prior effectiveness"
    content "No inference shall be raised by the enactment of the Act of March 3, 1933 (ch. 202, " ["47 Stat. 1431" -> "/us/stat/47/1431"] "), that the sections of the Revised Statutes repealed by such Act were in force or effect at the time of such enactment: Provided, however, That any rights or liabilities existing under such repealed sections shall not be affected by their repeal."
    hash "a4928170eb051ee102b10bcbd1c16dac26583dcc80eb7f2958a11f2d41176f6d"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 635" -> "/us/stat/61/635"] ".)"
  note "/us/usc/t1/s111/note/editorialNotes/nolaw/references-in-text" editorial {
    group editorialNotes
    topic "referencesInText"
    heading "References in Text"
    p "Act of March 3, 1933, referred to in text, was repealed by section 2 of act July 30, 1947, section 1 of which enacted this title."
    hash "82994a3c49e2bfac7d0ed0b1eac4115b402e51f81d5cecc3fdc5873904bc1c7a"
  }
  layers {
    operative "a4928170eb051ee102b10bcbd1c16dac26583dcc80eb7f2958a11f2d41176f6d"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "519c5e960df832c2d9a6039cc05ef7bb002eae04758b7552361514f18370e5ea"
  }
}
