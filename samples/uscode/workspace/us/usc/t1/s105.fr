edition 2
module "/us/usc/t1/s105" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s105" section {
    num "105" "§ 105."
    heading "Title of appropriation Acts"
    content "The style and title of all Acts making appropriations for the support of Government shall be as follows: “An Act making appropriations (here insert the object) for the year ending September 30 (here insert the calendar year).”"
    hash "df4f26cce642f040b5a784e7df4e6c5a5cbe69d4bbf60fb61b69b10178590e94"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 634" -> "/us/stat/61/634"] "; " ["Pub. L. 93–344, title V, § 506(a)" -> "/us/pl/93/344/tV/s506/a"] ", July 12, 1974, " ["88 Stat. 322" -> "/us/stat/88/322"] ".)"
  note "/us/usc/t1/s105/note/editorialNotes/pl.93.344/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1974—" ["Pub. L. 93–344" -> "/us/pl/93/344"] " substituted “September 30” for “June 30”."
    hash "15871b2a6121cd935f94e3430472a8d258277e206e8c99bf9a268beb9ea76eb2"
  }
  note "/us/usc/t1/s105/note/statutoryNotes/pl.93.344/effective-date-of-1974-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1974 Amendment"
    p ["Pub. L. 93–344, title V, § 506(b)" -> "/us/pl/93/344/tV/s506/b"] ", July 12, 1974, " ["88 Stat. 322" -> "/us/stat/88/322"] ", which provided that the amendment of this section by " ["Pub. L. 93–344" -> "/us/pl/93/344"] " was effective with respect to Acts making appropriations for the support of the Government for any fiscal year commencing on or after Oct. 1, 1976, was omitted in the complete revision of title V of " ["Pub. L. 93–344" -> "/us/pl/93/344"] " by " ["Pub. L. 101–508, title XIII, § 13201(a)" -> "/us/pl/101/508/tXIII/s13201/a"] ", Nov. 5, 1990, " ["104 Stat. 1388–609" -> "/us/stat/104/1388-609"] "."
    hash "8442dfa5fcc1c6e86ce09db07f581da3f24a472fefe1b8810d4ba750223fd7cb"
  }
