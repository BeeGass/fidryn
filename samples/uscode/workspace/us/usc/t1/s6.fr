edition 2
module "/us/usc/t1/s6" {
  within "/us/usc/t1/ch1"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s6" section {
    num "6" "§ 6."
    heading "Limitation of term “products of American fisheries”"
    content "Wherever, in the statutes of the United States or in the rulings, regulations, or interpretations of various administrative bureaus and agencies of the United States there appears or may appear the term “products of American fisheries” said term shall not include fresh or frozen fish fillets, fresh or frozen fish steaks, or fresh or frozen slices of fish substantially free of bone (including any of the foregoing divided into sections), produced in a foreign country or its territorial waters, in whole or in part with the use of the labor of persons who are not residents of the United States."
    hash "4cab01d78866678ac056ccd48e02f98e061962c8a04fcce42d79af4ba445b4b7"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 634" -> "/us/stat/61/634"] ".)"
  layers {
