edition 2
module "/us/usc/t1/s201" {
  within "/us/usc/t1/ch3"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s201" section {
    num "201" "§ 201."
    heading "Publication and distribution of Code of Laws of United States and Supplements and District of Columbia Code and Supplements"
    chapeau "In order to avoid duplication and waste—"
    provision "/us/usc/t1/s201/a" subsection {
      num "a" "(a)"
      heading "Publishing in slip or pamphlet form or in Statutes at Large.—"
      content "Publication in slip or pamphlet form or in the Statutes at Large of any of the volumes or publications enumerated in sections 202 and 203 of this title, shall, in event of enactment, be dispensed with whenever the Committee on the Judiciary of the House of Representatives so directs the Archivist of the United States;"
      hash "ff773831092c8920aaf77e1322605792ffd77649349beb3e34b5ab4071b3af8a"
    }
    provision "/us/usc/t1/s201/b" subsection {
      num "b" "(b)"
      heading "Curtailing number of copies published.—"
      content "Curtailment of the number provided by law to be printed and distributed of the volumes or publications enumerated in sections 202 and 203 of this title may be directed by such committee, except that the Director of the Government Publishing Office shall print such numbers as are necessary for depository library distribution and for sale; and"
      hash "8835e57f47cd1c4cc5bb52f829cc19a84009e9cf508226ba8cf358165878ccfd"
    }
    provision "/us/usc/t1/s201/c" subsection {
      num "c" "(c)"
      heading "Dispensing with publication of more than one Supplement for each Congress.—"
      content "Such committee may direct that the printing and distribution of any supplement to the Code of Laws of the United States or to the Code of the District of Columbia be dispensed with entirely, except that there shall be printed and distributed for each Congress at least one supplement to each such code, containing the legislation of such Congress."
      hash "82c1d78930e997e32a4ec4ac211d3739eb262b874b5dc618bed148a604d5e630"
    }
    hash "aa46151723bedab3a10e01af42051e0522d2ddd694a818563a276537ae549c17"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 637" -> "/us/stat/61/637"] "; " ["Sept. 3, 1954, ch. 1263, § 1" -> "/us/act/1954-09-03/ch1263/s1"] ", " ["68 Stat. 1226" -> "/us/stat/68/1226"] "; " ["Pub. L. 98–497, title I, § 107(d)" -> "/us/pl/98/497/tI/s107/d"] ", Oct. 19, 1984, " ["98 Stat. 2291" -> "/us/stat/98/2291"] "; " ["Pub. L. 113–235, div. H, title I, § 1301(d)" -> "/us/pl/113/235/dH/tI/s1301/d"] ", Dec. 16, 2014, " ["128 Stat. 2537" -> "/us/stat/128/2537"] ".)"
  note "/us/usc/t1/s201/note/editorialNotes/pl.98.497/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1984—Subsec. (a). " ["Pub. L. 98–497" -> "/us/pl/98/497"] " substituted “Archivist of the United States” for “Administrator of General Services”."
    p "1954—Subsec. (a). Act Sept. 3, 1954, substituted “Administrator of General Services” for “Secretary of State”."
    hash "ad0348c314474b48caee283ad3b108d658d64efb2f07e1aa078817a50cfe56a6"
  }
  note "/us/usc/t1/s201/note/statutoryNotes/pl.113.235/change-of-name" editorial {
    group statutoryNotes
    topic "changeOfName"
    heading "Change of Name"
    p "“Director of the Government Publishing Office” substituted for “Public Printer” in subsec. (b) on authority of " ["section 1301(d) of Pub. L. 113–235" -> "/us/pl/113/235/s1301/d"] ", set out as a note under " ["section 301 of Title 44" -> "/us/usc/t44/s301"] ", Public Printing and Documents."
    hash "60666fc0c929a0fb68f6e17abad3e7a17ec91d802759667716641af0093adaec"
  }
  note "/us/usc/t1/s201/note/statutoryNotes/pl.98.497/effective-date-of-1984-amendment" editorial {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1984 Amendment"
    p "Amendment by " ["Pub. L. 98–497" -> "/us/pl/98/497"] " effective Apr. 1, 1985, see " ["section 301 of Pub. L. 98–497" -> "/us/pl/98/497/s301"] ", set out as a note under " ["section 2102 of Title 44" -> "/us/usc/t44/s2102"] ", Public Printing and Documents."
    hash "89065e2a47007e935df4515dd4ad84b0d8f25811ae6e917d553a89432b5b40a5"
  }
  layers {
    operative "aa46151723bedab3a10e01af42051e0522d2ddd694a818563a276537ae549c17"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "dee7b03da076dca4a4c800be1d86ea1f804062cb904310d83169671fde1e1eed"
  }
}
