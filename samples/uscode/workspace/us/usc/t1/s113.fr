edition 2
module "/us/usc/t1/s113" {
  within "/us/usc/t1/ch2"
  source "usc01.xml"
  positive_law true
  provision "/us/usc/t1/s113" section {
    num "113" "§ 113."
    heading "“Little and Brown’s” edition of laws and treaties; slip laws; Treaties and Other International Acts Series; admissibility in evidence"
    content "The edition of the laws and treaties of the United States, published by Little and Brown, and the publications in slip or pamphlet form of the laws of the United States issued under the authority of the Archivist of the United States, and the Treaties and Other International Acts Series issued under the authority of the Secretary of State shall be competent evidence of the several public and private Acts of Congress, and of the treaties, international agreements other than treaties, and proclamations by the President of such treaties and international agreements other than treaties, as the case may be, therein contained, in all the courts of law and equity and of maritime jurisdiction, and in all the tribunals and public offices of the United States, and of the several States, without any further proof or authentication thereof."
    hash "a94c18ffaf9dba8a5cfa860d58e0a5f5f2b4f4c9a8da04c1a0ed42e5f37f2223"
  }
  credit "(" ["July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 636" -> "/us/stat/61/636"] "; " ["Pub. L. 89–497, § 1" -> "/us/pl/89/497/s1"] ", July 8, 1966, " ["80 Stat. 271" -> "/us/stat/80/271"] "; " ["Pub. L. 98–497, title I, § 107(d)" -> "/us/pl/98/497/tI/s107/d"] ", Oct. 19, 1984, " ["98 Stat. 2291" -> "/us/stat/98/2291"] ".)"
  note "/us/usc/t1/s113/note/editorialNotes/pl.98.497/amendments" editorial {
    group editorialNotes
    topic "amendments"
    heading "Amendments"
    p "1984—" ["Pub. L. 98–497" -> "/us/pl/98/497"] " substituted “Archivist of the United States” for “Administrator of General Services”."
    p "1966—" ["Pub. L. 89–497" -> "/us/pl/89/497"] " made slip laws and the Treaties and Other International Acts Series competent legal evidence of the several acts of Congress and the treaties and other international agreements contained therein."
    hash "8945b25cdd7b7e7c1c8cf92e0c8b1bbff85f9bc0cbeecfdf5926498f147978c2"
  }
  note "/us/usc/t1/s113/note/statutoryNotes/pl.98.497/effective-date-of-1984-amendment" enacted {
    group statutoryNotes
    topic "effectiveDateOfAmendment"
    heading "Effective Date of 1984 Amendment"
    p "Amendment by " ["Pub. L. 98–497" -> "/us/pl/98/497"] " effective Apr. 1, 1985, see " ["section 301 of Pub. L. 98–497" -> "/us/pl/98/497/s301"] ", set out as a note under " ["section 2102 of Title 44" -> "/us/usc/t44/s2102"] ", Public Printing and Documents."
    hash "89065e2a47007e935df4515dd4ad84b0d8f25811ae6e917d553a89432b5b40a5"
  }
  layers {
    operative "a94c18ffaf9dba8a5cfa860d58e0a5f5f2b4f4c9a8da04c1a0ed42e5f37f2223"
    enacted "a72d6a85f5b778f36e2399ca1d79a0bfe70076eaa639d5de73401ff00ccc7df2"
    editorial "2b291a5c0408f85322b7ff84bd2fff14003456167785fe3ce5c9bc03cecab179"
  }
}
