edition 2
module "/us/usc/ptIII/rule3010" {
  within "/us/usc/ptIII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIII/rule3010" courtRule {
    num "3010" "Rule 3010."
    heading "Chapter 7, Subchapter V of Chapter 11, Chapter 12, and Chapter 13— Limits on Small Dividends and Payments"
    provision "/us/usc/ptIII/rule3010/a" subsection {
      num "a" "(a)"
      heading "Chapter 7."
      content "In a Chapter 7 case, the trustee must not distribute to a creditor any dividend less than $5 unless authorized to do so by local rule or court order. A dividend not distributed must be treated in the same manner as unclaimed funds under § 347."
      hash "459d1b08665632c026abdcfc0377cd4d30a9d3540d675fd8301d0c4d74126802"
    }
    provision "/us/usc/ptIII/rule3010/b" subsection {
      num "b" "(b)"
      heading "Subchapter V of Chapter 11, Chapter 12, and Chapter 13."
      content "In a case under Subchapter V of Chapter 11, or under Chapter 12 or 13, the trustee must not distribute to a creditor any payment less than $15 unless authorized to do so by local rule or court order. Distribution must be made when accumulated funds total $15 or more. Any remaining funds must be distributed with the final payment."
      hash "74d31d714eea756476b74a22e994b29016ea2bbf2da48a98203a6de312f04136"
    }
    hash "d091b9062a6004a97eb43dc0cc85f2cf88707184f9c13f1f28e0e4e9c84b1da7"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 11, 2022, eff. Dec. 1, 2022; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIII/rule3010/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule permits a court to eliminate the disproportionate expense and inconvenience incurred by the issuance of a dividend check of less than $5 (or $15 in a chapter 13 case). Creditors are more irritated than pleased to receive such small dividends, but the money is held subject to their specific request as are unclaimed dividends under § 347(a) of the Code. When the trustee deposits undistributed dividends pursuant to a direction in accordance with this rule the trustee should file with the clerk a list of the names and addresses, so far as known, of the persons entitled to the money so deposited and the respective amounts payable to them pursuant to Rule 3011. In a chapter 13 case, the small dividend will accumulate and will be payable at the latest, with the final dividend. Local rule or order may change the practice permitted in this rule and, in that connection, the order may be incorporated in the order confirming a chapter 13 plan."
    hash "e726b95a7de76f96f03554d1509ceea79fb96dc4e2a03b6e11307bcb2a6d0784"
  }
  note "/us/usc/ptIII/rule3010/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "Subdivision (b) is amended to include chapter 12 cases."
    hash "b934ad7595121d868cb02a5c33150c42d3a339c4ac7d95a6a204298656527a28"
  }
  note "/us/usc/ptIII/rule3010/note/ungrouped/nolaw/committee-notes-on-rules-2022-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2022 Amendment"
    p "The rule is amended in response to the enactment of the Small Business Reorganization Act of 2019, Pub. L. No. 116–54, " ["133 Stat. 1079" -> "/us/stat/133/1079"] ". That law gives a small business debtor the option of electing to be a debtor under subchapter V of chapter 11. To avoid the undue cost and inconvenience of distributing small payments, the title and subdivision (b) are amended to include subchapter V cases."
    hash "6767d9eeb55c332678a09d5036cc5f008bc60740e8ee5e8ac30a95aaf54017c7"
  }
  note "/us/usc/ptIII/rule3010/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 3010 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "1a275bbe6996d2d31614da1bc4a59895c004564a2ba7407ae3fdd949630cc3f7"
  }
  layers {
    operative "d091b9062a6004a97eb43dc0cc85f2cf88707184f9c13f1f28e0e4e9c84b1da7"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "cc070add8df7961cfa1a8136dd45b2dcf3dcb9588b7d1bf35471060681cbd0a4"
  }
}
