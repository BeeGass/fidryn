edition 2
module "/us/usc/ptII/rule2009" {
  within "/us/usc/ptII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptII/rule2009" courtRule {
    num "2009" "Rule 2009."
    heading "Trustees for Jointly Administered Estates"
    provision "/us/usc/ptII/rule2009/a" subsection {
      num "a" "(a)"
      heading "Creditors’ Right to Elect a Single Trustee."
      content "Except in a case under Subchapter V of Chapter 7 or Subchapter V of Chapter 11, if the court orders that 2 or more estates be jointly administered under Rule 1015(b), the creditors may elect a single trustee for those estates."
      hash "bf5049e6641016b88a4bf2b484679a2a3424103ccb406aa60332d9631f2890a1"
    }
    provision "/us/usc/ptII/rule2009/b" subsection {
      num "b" "(b)"
      heading "Creditors’ Right to Elect a Separate Trustee."
      content "Except in a case under Subchapter V of Chapter 7 or Subchapter V of Chapter 11, any debtor’s creditors may elect a separate trustee for the debtor’s estate under § 702—even if the court orders joint administration under Rule 1015(b)."
      hash "fac7b51f030dfd03b82547880b262edf7e5b5215f7076f738591fa66eedecded"
    }
    provision "/us/usc/ptII/rule2009/c" subsection {
      num "c" "(c)"
      heading "United States Trustee’s Right to Appoint Interim Trustees in Cases with Jointly Administered Estates."
      provision "/us/usc/ptII/rule2009/c/1" paragraph {
        num "1" "(1)"
        content "Chapter 7. Except in a case under Subchapter V of Chapter 7, the United States trustee may appoint one or more interim trustees for estates being jointly administered in Chapter 7."
        hash "a7e0eae922a2879aff07f10fa430d9ab3b69a7c30b0e46b09673988539658013"
      }
      provision "/us/usc/ptII/rule2009/c/2" paragraph {
        num "2" "(2)"
        content "Chapter 11. If the court orders or the Code requires the appointment of a trustee, the United States trustee may appoint one or more trustees for estates being jointly administered in Chapter 11."
        hash "6d5d77666a43ee8b5d2426c91897581944651447ec2f28bf25b4ed4a79185bda"
      }
      provision "/us/usc/ptII/rule2009/c/3" paragraph {
        num "3" "(3)"
        content "Chapter 12 or 13. The United States trustee may appoint one or more trustees for estates being jointly administered in Chapter 12 or 13."
        hash "c9374eb296a3b634f5b3c325f1952ccbc240ff1a3d643d7431ab4d7ae6af2e11"
      }
      hash "28148211176f3ebc53c042bfdb2dc1c4dc3f6a23afbd32610222d444fae1036c"
    }
    provision "/us/usc/ptII/rule2009/d" subsection {
      num "d" "(d)"
      heading "Conflicts of Interest."
      content "On a showing that a common trustee’s conflicts of interest will prejudice creditors or equity security holders of jointly administered estates, the court must order the selection of separate trustees for the estates."
      hash "c889734e4ec2f6c7b01480323962ca7ff9c2b2299a4ba886567388e3a7c015db"
    }
    provision "/us/usc/ptII/rule2009/e" subsection {
      num "e" "(e)"
      heading "Keeping Separate Accounts."
      content "A trustee of jointly administered estates must keep separate accounts of each estate’s property and distribution."
      hash "86d2db1e179ee74bca68a6ff352174596165074079ca3b758023316c3325c7e7"
    }
    hash "92384a40321384d5f4e21a3f35f37698fcb9b9c50fd5ecfb2f18042fd0695b0f"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Mar. 27, 2003, eff. Dec. 1, 2003; Apr. 11, 2022, eff. Dec. 1, 2022; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptII/rule2009/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule is applicable in chapter 7 cases and, in part, in chapter 11 and 13 cases. The provisions in subdivisions (a) and (b) concerning creditor election of a trustee apply only in a chapter 7 case because it is only pursuant to § 702 of the Code that creditors may elect a trustee. Subdivision (c) of the rule applies in chapter 11 and 13 as well as chapter 7 cases; pursuant to § 1104 of the Code, the court may order the appointment of a trustee on application of a party in interest and, pursuant to § 1163 of the Code, the court must appoint a trustee in a railroad reorganization case. Subdivision (c) should not be taken as an indication that more than one trustee may be appointed for a single debtor. Section 1104(c) [now 1104(d)] permits only one trustee for each estate. In a chapter 13 case, if there is no standing trustee, the court is to appoint a person to serve as trustee pursuant to § 1302 of the Code. There is no provision for a trustee in a chapter 9 case, except for a very limited purpose; see § 926 of the Code."
    p "This rule recognizes that economical and expeditious administration of two or more estates may be facilitated not only by the selection of a single trustee for a partnership and its partners, but by such selection whenever estates are being jointly administered pursuant to Rule 1015. See In the Matter of International Oil Co., 427 F.2d 186, 187 (2d Cir. 1970). The rule is derived from former § 5c of the Act and former Bankruptcy Rule 210. The premise of § 5c of the Act was that notwithstanding the potentiality of conflict between the interests of the creditors of the partners and those of the creditors of the partnership, the conflict is not sufficiently serious or frequent in most cases to warrant the selection of separate trustees for the firm and the several partners. Even before the proviso was added to § 5c of the Act in 1938 to permit the creditors of a general partner to elect their separate trustee for his estate, it was held that the court had discretion to permit such an election or to make a separate appointment when a conflict of interest was recognized. In re Wood, 248 Fed. 246, 249–50 (6th Cir.), cert. denied, 247 U.S. 512 (1918); 4 Collier, Bankruptcy ¶ 723.04 (15th ed. 1980). The rule retains in subdivision (e) the features of the practice respecting the selection of a trustee that was developed under § 5 of the Act. Subdivisions (a) and (c) permit the court to authorize election of a single trustee or to make a single appointment when joint administration of estates of other kinds of debtors is ordered, but subdivision (d) requires the court to make a preliminary evaluation of the risks of conflict of interest. If after the election or appointment of a common trustee a conflict of interest materializes, the court must take appropriate action to deal with it."
    p "Subdivision (f) is derived from § 5e of the Act and former Bankruptcy Rule 210(f) and requires that the common trustee keep a separate account for each estate in all cases that are jointly administered."
    hash "5ea6fa6c075780e3542f520d3e033d89e315f44f733fa3302f751a292718d2f7"
  }
  note "/us/usc/ptII/rule2009/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "One or more trustees may be appointed for estates being jointly administered in chapter 12 cases."
    p "The amendments to this rule are derived from Rule X–1005 and are necessary because the United States trustee, rather than the court, has responsibility for appointing trustees pursuant to §§ 701, 1104, 1202, and 1302 of the Code."
    p "If separate trustees are ordered for chapter 7 estates pursuant to subdivision (d), separate and successor trustees should be chosen as prescribed in § 703 of the Code. If the occasion for another election arises, the United States trustee should call a meeting of creditors for this purpose. An order to select separate trustees does not disqualify an appointed or elected trustee from serving for one of the estates."
    p "Subdivision (e) is abrogated because the exercise of discretion by the United States trustee, who is in the Executive Branch, is not subject to advance restriction by rule of court. United States v. Cox, 342 F.2d 167 (5th Cir. 1965), cert. denied, 365 U.S. 863 (1965); United States v. Frumento, 409 F.Supp. 136, 141 (E.D.Pa.), aff’d, 563 F.2d 1083 (3d Cir. 1977), cert. denied, 434 U.S. 1072 (1977); see, Smith v. United States, 375 F.2d 243 (5th Cir. 1967); House Report No. 95–595, 95th Cong., 1st Sess. 110 (1977). However, a trustee appointed by the United States trustee may be removed by the court for cause. See § 324 of the Code. Subdivision (d) of this rule, as amended, is consistent with § 324. Subdivision (f) is redesignated as subdivision (e)."
    hash "cc4b52776c6b36782f1f606bb24bfc5d7ec1de850a1db7112fb510c725afd812"
  }
  note "/us/usc/ptII/rule2009/note/ungrouped/nolaw/committee-notes-on-rules-2003-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2003 Amendment"
    p "The rule is amended to reflect the enactment of subchapter V of chapter 7 of the Code governing multilateral clearing organization liquidations. Section 782 of the Code provides that the designation of a trustee or alternative trustee for the case is made by the Federal Reserve Board. Therefore, neither the United States trustee nor the creditors can appoint or elect a trustee in these cases."
    p "Other amendments are stylistic."
    p "Changes Made After Publication and Comments. No changes since publication."
    hash "c992c89f47c28c73dc1435831b9ce4677126c01b2d4081165af38e6f2c652ce3"
  }
  note "/us/usc/ptII/rule2009/note/ungrouped/nolaw/committee-notes-on-rules-2022-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2022 Amendment"
    p "The rule is amended in response to the enactment of the Small Business Reorganization Act of 2019, Pub. L. No. 116–54, " ["133 Stat. 1079" -> "/us/stat/133/1079"] ". That law gives a small business debtor the option of electing to be a debtor under subchapter V of chapter 11. In a case under that subchapter, § 1183 of the Code requires the United States trustee to appoint a trustee, so there will be no election. Accordingly, subdivisions (a) and (b) of the rule are amended to except cases under subchapter V from their coverage. Subdivision (c)(2), which addresses the appointment of trustees in jointly administered chapter 11 cases, is amended to make it applicable to cases under subchapter V."
    hash "4097860bb27256b178abae184f6b72bab95440e6bed32fbf073797402d144e57"
  }
  note "/us/usc/ptII/rule2009/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 2009 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "e82aa53cc8400324d68369f7ae374f4da4d6916b3f1ca21650740f029826e0e0"
  }
  layers {
    operative "92384a40321384d5f4e21a3f35f37698fcb9b9c50fd5ecfb2f18042fd0695b0f"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "b93d80ce972926cf0db2fa4c9ac7643ad2db37a0b39f8facffd8771063043e9d"
  }
}
