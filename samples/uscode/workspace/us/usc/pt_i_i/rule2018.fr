edition 2
module "/us/usc/ptII/rule2018" {
  within "/us/usc/ptII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptII/rule2018" courtRule {
    num "2018" "Rule 2018."
    heading "Intervention by an Interested Entity; Right to Be Heard"
    provision "/us/usc/ptII/rule2018/a" subsection {
      num "a" "(a)"
      heading "In General."
      content "After hearing on such notice as the court orders and for cause, the court may permit an interested entity to intervene generally or in any specified matter."
      hash "3d96b0ccc06c09f7677b2b841da849887ef8a7b677aa57fba46a7aaad83c9261"
    }
    provision "/us/usc/ptII/rule2018/b" subsection {
      num "b" "(b)"
      heading "Intervention by a State Attorney General."
      content "In a Chapter 7, 11, 12, or 13 case, a state attorney general may appear and be heard on behalf of consumer creditors if the court determines that the appearance is in the public interest. But the state attorney general may not appeal from any judgment, order, or decree entered in the case."
      hash "982177201613ea919f085ea3f2559f0f110faaa0a0c2e7d5660a2d27d90b8ac1"
    }
    provision "/us/usc/ptII/rule2018/c" subsection {
      num "c" "(c)"
      heading "Intervention by the United States Secretary of the Treasury or a State Representative."
      chapeau "In a Chapter 9 case:"
      provision "/us/usc/ptII/rule2018/c/1" paragraph {
        num "1" "(1)"
        content "the United States Secretary of the Treasury may—and if requested by the court must—intervene; and"
        hash "cb3be4041214f8de405c29a390a7b325083a9af4febbeeae28a0aca91387747e"
      }
      provision "/us/usc/ptII/rule2018/c/2" paragraph {
        num "2" "(2)"
        content "a representative of the state where the debtor is located may intervene in any matter the court specifies."
        hash "fb07158fa2ed97e0e7b58abcc1e4e092a47760091de1f0cde5d134b997c6426c"
      }
      hash "f283e8da2a215ee0f0bb32430945e5c29eb67e32fb0686fb6bfc37b3f48b1d36"
    }
    provision "/us/usc/ptII/rule2018/d" subsection {
      num "d" "(d)"
      heading "Intervention by a Labor Union or an Association Representing the Debtor’s Employees."
      content "In a Chapter 9, 11, or 12 case, a labor union or an association representing the debtor’s employees has the right to be heard on the economic soundness of a plan affecting the employees’ interests. Unless otherwise permitted by law, the labor union or employees’ association exercising that right may not appeal any judgment, order, or decree related to the plan."
      hash "77d0e3631adf925ba824507675c554f702cb42f995ee57a09fbf9fbb3dd10470"
    }
    provision "/us/usc/ptII/rule2018/e" subsection {
      num "e" "(e)"
      heading "Serving Entities Covered by This Rule."
      content "The court may issue orders governing the service of notice and documents on entities permitted to intervene or be heard under this Rule 2018."
      hash "613bd2de63ae1696d0d19cd41d053068a308afe39afb69aaad0bfa2dc125c16d"
    }
    hash "5a672646be51ee24648675e195d20b18fbfb86a8dd24e0585326d9bbfc1677d0"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptII/rule2018/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule is derived from former Rules 8–210, 9–15 and 10–210 and it implements §§ 1109 and 1164 of the Code."
    p "Pursuant to § 1109 of the Code, parties in interest have a right to be heard and the Securities and Exchange Commission may raise and be heard on any issue but it may not take an appeal. That section is applicable in chapter 9 cases (§ 901 of the Code) and in chapter 11 cases, including cases under subchapter IV thereof for the reorganization of a railroad."
    p "In a railroad reorganization case under subchapter IV of chapter 11, § 1164 also gives the right to be heard to the Interstate Commerce Commission, the Department of Transportation and any state or local regulatory commission with jurisdiction over the debtor, but these entities may not appeal."
    p "This rule does not apply in adversary proceedings. For intervention in adversary proceedings, see Rule 7024. The rules do not provide any right of compensation to or reimbursement of expenses for intervenors or others covered by this rule. Section 503(b)(3)(D) and (4) is not applicable to the entities covered by this rule."
    p "Subdivision (a) is derived from former Chapter VIII Rule 8–210 and former Chapter X Rule 10–210. It permits intervention of an entity (see § 101(14), (21) [now 101(15), (27)] of the Code) not otherwise entitled to do so under the Code or this rule. Such a party seeking to intervene must show cause therefor."
    p "Subdivision (b) specifically grants the appropriate state’s Attorney General the right to appear and be heard on behalf of consumer creditors when it is in the public interest. See House Rep. No. 95–595, 95th Cong., 1st Sess. (1977) 189. While “consumer creditor” is not defined in the Code or elsewhere, it would include the type of individual entitled to priority under § 507(a)(5) [now 507(a)(7)] of the Code, that is, an individual who has deposited money for the purchase, lease or rental of property or the purchase of services for the personal, family, or household use of the individual. It would also include individuals who purchased or leased property for such purposes in connection with which there may exist claims for breach of warranty."
    p "This subdivision does not grant the Attorney General the status of party in interest. In other contexts, the Attorney General will, of course, be a party in interest as for example, in representing a state in connection with a tax claim."
    p "Subdivision (c) recognizes the possible interests of the Secretary of the Treasury or of the state of the debtor’s locale when a municipality is the debtor. It is derived from former Chapter IX Rule 9–15 and § 85(d) of the Act."
    p "Subdivision (d) is derived from former Chapter X Rule 10–210 which, in turn, was derived from § 206 of the Act. Section 206 has no counterpart in the Code."
    p "Subdivision (e) is derived from former Chapter VIII Rule 8–210(d). It gives the court flexibility in directing the type of future notices to be given intervenors."
    hash "7979d3ca35e2592f3a2dd56685d756a6d92a65e14812f5d133689918001cd765"
  }
  note "/us/usc/ptII/rule2018/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1987-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1987 Amendment"
    p "Subdivision (d) is amended to make it clear that the prohibition against appeals by labor unions is limited only to their participation in connection with the hearings on the plan as provided in subdivision (d). If a labor union would otherwise have the right to file an appeal or to be a party to an appeal, this rule does not preclude the labor union from exercising that right."
    hash "66063540de5e22009ba3e81dfc7ed9dc9bc963f0cec8c4941367b8b1af5927db"
  }
  note "/us/usc/ptII/rule2018/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "Subdivisions (b) and (d) are amended to include chapter 12."
    hash "360495b91c9e5691d49ed1a6071da5b90721aa4daa17bb7d4fa69a602f72f0b8"
  }
  note "/us/usc/ptII/rule2018/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 2018 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "43e5e198e4f41dc9b2a4064e75dd6304609270e9100a76025d490bee0f61c31c"
  }
  layers {
    operative "5a672646be51ee24648675e195d20b18fbfb86a8dd24e0585326d9bbfc1677d0"
    enacted "daf56bda98637faa634ae388c7c078a8840f28bdfb9852d7fedaae701036e21c"
    editorial "f23a9f002e0a31303737fe5a8f6a72b414e9cd8c703c525b11b3dae4820eb255"
  }
}
