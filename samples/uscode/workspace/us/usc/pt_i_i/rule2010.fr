edition 2
module "/us/usc/ptII/rule2010" {
  within "/us/usc/ptII"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptII/rule2010" courtRule {
    num "2010" "Rule 2010."
    heading "Blanket Bond; Proceedings on the Bond"
    provision "/us/usc/ptII/rule2010/a" subsection {
      num "a" "(a)"
      heading "Authorizing a Blanket Bond."
      chapeau "The United States trustee may authorize a blanket bond in the United States’ favor—conditioned on the faithful performance of a trustee’s official duties—to cover:"
      provision "/us/usc/ptII/rule2010/a/1" paragraph {
        num "1" "(1)"
        content "a person who qualifies as trustee in multiple cases; or"
        hash "480e4836cdb36ed9ba44f7b6c65ec0796462e1e3b7acc9877e3bc7e2408f3787"
      }
      provision "/us/usc/ptII/rule2010/a/2" paragraph {
        num "2" "(2)"
        content "multiple trustees who qualify in a different case."
        hash "5aa4a11e46662dd0051806db2309047f03cbaa64c9323e3d64ce33997fe7ad27"
      }
      hash "dcc37a5681e37975d78cd1ea584f51951ba73c511d6bcda94d1b853bde8b9721"
    }
    provision "/us/usc/ptII/rule2010/b" subsection {
      num "b" "(b)"
      heading "Proceedings on the Bond."
      content "A party in interest may bring a proceeding in the United States’ name on a trustee’s bond for the use of the entity injured by the trustee’s breach of the condition."
      hash "e3ea969b4f4594a4038c6df92f021691fc2d9f39d52c1f4af9fe6ce5e8b39974"
    }
    hash "0df6bf5552c4d645dfc2bfa16f910a80b44f0ccfb46238b6e52b307658e55b2c"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptII/rule2010/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Subdivisions (a) and (b). Subdivision (a) gives authority for approval by the court of a single bond to cover (1) a person who qualifies as trustee in a number of cases, and (2) a number of trustees each of whom qualifies in a different case. The cases need not be related in any way. Substantial economies can be effected if a single bond covering a number of different cases can be issued and approved at one time. When a blanket bond is filed, the trustee qualifies under subdivision (b) of the rule by filing an acceptance of the office."
    p "Subdivision (c) prescribes the evidentiary effect of a certified copy of an order approving the trustee’s bond given by a trustee under this rule or, when a blanket bond has been authorized, of a certified copy of acceptance. This rule supplements the Federal Rules of Evidence, which apply in bankruptcy cases. See Rule 1101 of the Federal Rules of Evidence. The order of approval should conform to Official Form No. 25. See, however, § 549(c) of the Code which provides only for the filing of the petition in the real estate records to serve as constructive notice of the pendency of the case. See also Rule 2011 which prescribes the evidentiary effect of a certificate that the debtor is a debtor in possession."
    p "Subdivision (d) is derived from former Bankruptcy Rule 212(f). Reference should be made to § 322(a) and (d) of the Code which requires the bond to be filed with the bankruptcy court and places a two year limitation for the commencement of a proceeding on the bond. A bond filed under this rule should conform to Official Form No. 25. A proceeding on the bond of a trustee is governed by the rules in Part VII. See the Note accompanying Rule 7001. See also Rule 9025."
    hash "d57d74b6eb3fc9356459ef67c7845e7274b9e4db74c780f45f84547e8b1bacd4"
  }
  note "/us/usc/ptII/rule2010/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1987-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1987 Amendment"
    p "Subdivision (b) is deleted because of the amendment to Rule 2008."
    hash "49f4b7e8e463da93b1fd9c7cbf22d532ca715673070a187a4d5da737c8af86a1"
  }
  note "/us/usc/ptII/rule2010/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "This rule is amended to conform to the 1986 amendment of § 322 of the Code. The United States trustee determines the amount and sufficiency of the trustee’s bond. The amendment to subdivision (a) is derived from Rule X–1004(b)."
    p "Subdivision (b) is abrogated because an order approving a bond is no longer necessary in view of the 1986 amendments to § 322 of the Code. Subdivision (c) is redesignated as subdivision (b)."
    hash "f8674e8b6e2734a60b5f3a86c78cc6b4126cbef2f550c7f7496788c12d7cf650"
  }
  note "/us/usc/ptII/rule2010/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 2010 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "ace5c99359aaaa313b5d4e487eacbf42ecfba16a3fd413653f927c841bd1d8c7"
  }
  layers {
    operative "0df6bf5552c4d645dfc2bfa16f910a80b44f0ccfb46238b6e52b307658e55b2c"
    enacted "8d768774d10ce413e49b93ee721c2cd8a04d19c9044671ef3daa4bcacea68ffc"
    editorial "f23a9f002e0a31303737fe5a8f6a72b414e9cd8c703c525b11b3dae4820eb255"
  }
}
