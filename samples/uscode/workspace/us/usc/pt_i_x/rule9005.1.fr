edition 2
module "/us/usc/ptIX/rule9005.1" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9005.1" courtRule {
    num "9005.1" "Rule 9005.1."
    heading "Constitutional Challenge to a Statute—Notice, Certification, and Intervention"
    content "Fed. R. Civ. P. 5.1 applies in a bankruptcy case."
    hash "ce5c127bf2f781b698cc118c5e08e73949a72a835e003977fcd65c58288bbd35"
  }
  credit "(Added Apr. 30, 2007, eff. Dec. 1, 2007; amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9005.1/note/ungrouped/nolaw/committee-notes-on-rules-2007" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2007"
    p "The rule is added to adopt the new rule added to the Federal Rules of Civil Procedure. The new Civil Rule replaces Rule 24(c) F. R. Civ. P., so the cross reference to Civil Rule 24 contained in Rule 7024 is no longer sufficient to bring the provisions of new Civil Rule 5.1 into adversary proceedings. This rule also makes Civil Rule 5.1 applicable to all contested matters and other proceedings within the bankruptcy case."
    p "Changes After Publication. No changes were made after publication."
    hash "8e91dc0d51a51983279f88aef21dae5a61cbb1acabf2b3d609856e71d556cee9"
  }
  note "/us/usc/ptIX/rule9005.1/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9005.1 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "f76fd9879bb59e05112427a7fa902780e8d3eb112cef7347c53de7380e12cd61"
  }
  note "/us/usc/ptIX/rule9005.1/note/ungrouped/nolaw/references-in-text" enacted {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "ce5c127bf2f781b698cc118c5e08e73949a72a835e003977fcd65c58288bbd35"
    enacted "a6073eb412e32ce678df6c0edc135d31aa90a176584246088db196f8e5e57446"
    editorial "ad9de9be8ec8e04417369d8ac29be4c3b33723755f7f27a4c3817b06479d3845"
  }
}
