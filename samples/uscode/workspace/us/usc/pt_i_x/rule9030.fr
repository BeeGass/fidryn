edition 2
module "/us/usc/ptIX/rule9030" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9030" courtRule {
    num "9030" "Rule 9030."
    heading "Jurisdiction and Venue Not Extended or Limited"
    content "These rules must not be construed to extend or limit the courts’ jurisdiction or the venue of any matters."
    hash "8800a775d164d4025d90ac7790c26cf5de15d37116442284426ffa844c342f36"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9030/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "The rule is an adaptation of Rule 82 F.R.Civ.P."
    hash "c76cd6a3e4f9f2677b1cda40044817a4885579d338fe1f327e87b88dd7933531"
  }
  note "/us/usc/ptIX/rule9030/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9030 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "c6543f9556511f65a67428de8527182801173f59000f71c8d88ef9333dfc767f"
  }
  layers {
    operative "8800a775d164d4025d90ac7790c26cf5de15d37116442284426ffa844c342f36"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "35a6957e56ea00157164393d37f12e5f5f2f438e0cfb459d3d46045a4899f963"
