edition 2
module "/us/usc/ptIX/rule9005" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9005" courtRule {
    num "9005" "Rule 9005."
    heading "Harmless Error"
    content "Fed. R. Civ. P. 61 applies in a bankruptcy case. When appropriate, the court may order the correction of any error or defect—or the cure of any omission—that does not affect a substantial right."
    hash "e8825f42bce5db5beb1a12a1913dad76171033a4e4706d10f53868dbf71f2a18"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9005/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9005 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "c25fc2026e7e72c57bb661750661d9d6a40a89aaa24e7cc0df3ccd222a4ffd06"
  }
  note "/us/usc/ptIX/rule9005/note/ungrouped/nolaw/references-in-text" enacted {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "e8825f42bce5db5beb1a12a1913dad76171033a4e4706d10f53868dbf71f2a18"
    enacted "1f4de4c17f6459039ae7db53ed88d258342b93087946973b2d3e67167a842ca7"
    editorial "7424425484156cb33d7e54622a74d4e9e7dda7b20dac6b931a21df90aab41aea"
  }
}
