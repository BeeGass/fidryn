edition 2
module "/us/usc/ptIX/rule9019" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9019" courtRule {
    num "9019" "Rule 9019."
    heading "Compromise or Settlement; Arbitration"
    provision "/us/usc/ptIX/rule9019/a" subsection {
      num "a" "(a)"
      heading "Approving a Compromise or Settlement."
      content {
        p "On the trustee’s motion and after notice and a hearing, the court may approve a compromise or settlement. Notice must be given to:"
        p "• all creditors;"
        p "• the United States trustee;"
        p "• the debtor;"
        p "• all indenture trustees as provided in Rule 2002; and"
        p "• any other entity the court designates."
      }
      hash "ccd16262c30860a32badcab16aeeba8f54d26f4597ef70d2d8fc50d009cde1b0"
    }
    provision "/us/usc/ptIX/rule9019/b" subsection {
      num "b" "(b)"
      heading "Compromising or Settling Controversies in Classes."
      chapeau "After a hearing on such notice as the court may order, the court may:"
      provision "/us/usc/ptIX/rule9019/b/1" paragraph {
        num "1" "(1)"
        content "designate a class or classes of controversies; and"
        hash "bfe561820b40760bf99f7337f7035459390b743a9277b085c363b96d7300472a"
      }
      provision "/us/usc/ptIX/rule9019/b/2" paragraph {
        num "2" "(2)"
        content "authorize the trustee to compromise or settle controversies within the class or classes without further hearing or notice."
        hash "f8ae59a4112de54e7057c28861ab324a02fb645f559ecdcb92d2311c9ce8afcb"
      }
      hash "a44979d4eb6d020f980515bb73148b3c3d2d4e01103e678aea92854db7ff0269"
    }
    provision "/us/usc/ptIX/rule9019/c" subsection {
      num "c" "(c)"
      heading "Arbitration of Controversies Affecting an Estate."
      content "If the parties so stipulate, the court may authorize a controversy affecting an estate to be submitted to final and binding arbitration."
      hash "ab8f25dee24cb32ebf3f50eff986f547ba294f7ea0daba550da1f1400cfd2500"
    }
    hash "5ff10848d2d1e329b94464052e5008cd2a472ec148fcc531cdfae5021d6608c0"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 22, 1993, eff. Aug. 1, 1993; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9019/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Subdivisions (a) and (c) of this rule are essentially the same as the provisions of former Bankruptcy Rule 919 and subdivision (b) is the same as former Rule 8–514(b), which was applicable to railroad reorganizations. Subdivision (b) permits the court to deal efficiently with a case in which there may be a large number of settlements."
    hash "bb4eee4cbb26d00017bccb4a8b9544882440759b93f4da45e45c32e31fc01109"
  }
  note "/us/usc/ptIX/rule9019/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "This rule is amended to enable the United States trustee to object or otherwise be heard in connection with a proposed compromise or settlement and otherwise to monitor the progress of the case."
    hash "53f9ae0125a32ea4ed73f15bb1c46ca176b5b4ddf9999f78195ce76fb4cf7e4d"
  }
  note "/us/usc/ptIX/rule9019/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1993-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1993 Amendment"
    p "Subdivision (a) is amended to conform to the language of § 102(1) of the Code. Other amendments are stylistic and make no substantive change."
    hash "6eb5c04456f9846ef765f37fb144283ee9c9ca77b20f5cd521f2a18a372b6b9d"
  }
  note "/us/usc/ptIX/rule9019/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9019 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "d79173ba9ba2ce925df44667055c7cf8ebd1a9f2fee5e03a177ff35c02d2b86f"
  }
  layers {
    operative "5ff10848d2d1e329b94464052e5008cd2a472ec148fcc531cdfae5021d6608c0"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "341b84fc4e437c9ad952d426d757225ac5c406900eb44564f2b25e5ebcbecd2c"
  }
}
