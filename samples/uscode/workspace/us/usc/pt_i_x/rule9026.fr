  provision "/us/usc/ptIX/rule9026" courtRule {
    num "9026" "Rule 9026."
    heading "Objecting to a Ruling or Order"
    content "Fed. R. Civ. P. 46 applies in a bankruptcy case."
    hash "3ea4ddc8d59b0c39cc996e34a26626b31452ec9e5ce5ac3a810e3c0b63100673"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9026/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9026 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "96ee44a2482f92075542c74f76e4fa61f9be95432b80ed5a604b6c016c200861"
  }
  note "/us/usc/ptIX/rule9026/note/ungrouped/nolaw/references-in-text" enacted {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
