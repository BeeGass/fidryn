edition 2
module "/us/usc/ptIX/rule9008" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9008" courtRule {
    num "9008" "Rule 9008."
    heading "Service or Notice by Publication"
    content "When these rules require or authorize service or notice by publication, and to the extent that they do not provide otherwise, the court must determine the form and manner of publication—including the newspaper or other medium to be used and the number of publications."
    hash "600dec1885e13eb1bf11784e2c2720fcab4779b8cce0e75d234db4f6e0eff9e1"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9008/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9008 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "1d44c62aa5a38393629cb5694dfd12f174c5eac0b271399124077e5a92a6b8c1"
  }
  layers {
    operative "600dec1885e13eb1bf11784e2c2720fcab4779b8cce0e75d234db4f6e0eff9e1"
    enacted "3e0a50307f5733c848155be883338b8bfd02eb5a4c464b988990d992fd1af862"
    editorial "7424425484156cb33d7e54622a74d4e9e7dda7b20dac6b931a21df90aab41aea"
  }
}
