edition 2
module "/us/usc/ptIX/rule9031" {
  within "/us/usc/ptIX"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptIX/rule9031" courtRule {
    num "9031" "Rule 9031."
    heading "Using Masters Not Authorized"
    content "Fed. R. Civ. P. 53 does not apply in a bankruptcy case."
    hash "991a37d8b0f736dc83595d4750acbb6f830f2095853b85f54dc8a2e6a94b1f06"
  }
  credit "(As amended Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptIX/rule9031/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule precludes the appointment of masters in cases and proceedings under the Code."
    hash "7f03baf474417c1f6d8b5115453408098dbbb4dd6bf1c1f1b20a93ba923d6452"
  }
  note "/us/usc/ptIX/rule9031/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 9031 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "43f60df2b96addacf49f92ad6dc2cd79040e73c0a309d13b19aa8deadfe4d7df"
  }
  note "/us/usc/ptIX/rule9031/note/ungrouped/nolaw/references-in-text" editorial {
    group ungrouped
    topic "referencesInText"
    heading "References in Text"
    p "The Federal Rules of Civil Procedure, referred to in text, are set out in the Appendix to Title 28, Judiciary and Judicial Procedure."
    hash "4a8b0d14404030ae6cd9802bba522a79598c37d8f345183f04aac21d3f850d80"
  }
  layers {
    operative "991a37d8b0f736dc83595d4750acbb6f830f2095853b85f54dc8a2e6a94b1f06"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "7173ee5c631bee2c09356a79df94938039dcb9745016a36a2c72f4bce171d1fd"
  }
}
