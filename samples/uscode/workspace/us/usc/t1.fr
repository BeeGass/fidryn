  note "/us/usc/t1/note/ungrouped/act.1947-07-30.ch388/noheading" editorial {
    group ungrouped
    topic "enacting"
    p "This title was enacted by " ["act July 30, 1947, ch. 388, § 1" -> "/us/act/1947-07-30/ch388/s1"] ", " ["61 Stat. 633" -> "/us/stat/61/633"]
    hash "82b1ba57cf3593bc646a9c31f741241ab1d81f83d4454deeef33ec139a0fed2a"
  }
  note "/us/usc/t1/note/statutoryNotes/act.1947-07-30.ch388/positive-law-citation" enacted {
    group statutoryNotes
    topic "codification"
    heading "Positive Law; Citation"
    p "This title has been made positive law by section 1 of " ["act July 30, 1947, ch. 388" -> "/us/act/1947-07-30/ch388"] ", " ["61 Stat. 633" -> "/us/stat/61/633"] ", which provided in part that:"
    quoted "/us/act/1947-07-30/ch388" {
      p "“Title 1 of the United States Code entitled ‘General Provisions’, is codified and enacted into positive law and may be cited as ‘1 U. S. C., § ——.’ ”"
    }
    hash "3b99f40cf45341fc6ecf21b72ee445db974b081c3b2c4ce6afe8d1c00b0e75fe"
  }
  note "/us/usc/t1/note/statutoryNotes/act.1947-07-30.ch388/repeals" editorial {
    group statutoryNotes
    topic "repeals"
    heading "Repeals"
    p ["Act July 30, 1947, ch. 388, § 2" -> "/us/act/1947-07-30/ch388/s2"] ", " ["61 Stat. 640" -> "/us/stat/61/640"] ", provided that the sections or parts thereof of the Statutes at Large or the Revised Statutes covering provisions codified in this Act are repealed insofar as the provisions appeared in former Title 1, and provided that any rights or liabilities now existing under the repealed sections or parts thereof shall not be affected by the repeal."
    hash "c20d9723d6195e6be3db3d3983ec7453d02f868108a5059649f432383fb921c9"
  }
  note "/us/usc/t1/note/statutoryNotes/act.1948-06-25.ch646/writs-of-error" enacted {
    group statutoryNotes
    topic "miscellaneous"
    heading "Writs of Error"
    p ["Act June 25, 1948, ch. 646, § 23" -> "/us/act/1948-06-25/ch646/s23"] ", " ["62 Stat. 990" -> "/us/stat/62/990"] ", provided that:"
    quoted "/us/act/1948-06-25/ch646/s23" {
      p "“All Acts of Congress referring to writs of error shall be construed as amended to the extent necessary to substitute appeal for writ of error.”"
    }
    hash "33ea15c5d867a3d0a16eeacc89704e923702837932ba12a7b8b23ea60c8b25d8"
  }
