edition 2
module "/us/usc/ptI/rule1006" {
  within "/us/usc/ptI"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptI/rule1006" courtRule {
    num "1006" "Rule 1006."
    heading "Filing Fee"
    provision "/us/usc/ptI/rule1006/a" subsection {
      num "a" "(a)"
      heading "In General."
      chapeau "Unless (b) or (c) applies, every petition must be accompanied by the filing fee. In this rule" mark "1" 1 " “filing fee” means:"
      provision "/us/usc/ptI/rule1006/a/1" paragraph {
        num "1" "(1)"
        content "the filing fee required by 28 U.S.C. § 1930(a)(1)–(5); and"
        hash "0984874339abf55bda92f6f3bc476fde1fd7c08d619a8cdd3dea7664e6aec3a5"
      }
      provision "/us/usc/ptI/rule1006/a/2" paragraph {
        num "2" "(2)"
        content "any other fee that the Judicial Conference of the United States requires under 28 U.S.C. § 1930(b) to be paid upon filing."
        hash "88e3f7bf7ae1026a2faeab73683b7097dedd253a2c789a106f93ed50e92da1bf"
      }
      hash "4080ae331e014178acb92b24224844fbc4f7fb3e4a92960cf1ba4af98ce3bfcd"
    }
    provision "/us/usc/ptI/rule1006/b" subsection {
      num "b" "(b)"
      heading "Paying by Installment."
      provision "/us/usc/ptI/rule1006/b/1" paragraph {
        num "1" "(1)"
        content "Application to Pay by Installment. The clerk must accept for filing an individual’s voluntary petition, regardless of whether any part of the filing fee is paid, if it is accompanied by a completed and signed application to pay in installments (Form 103A)."
        hash "48fbee8b8ebcf0b528b1b527f451b3e5d82feb5ebb420a72911d8f8ee37802bb"
      }
      provision "/us/usc/ptI/rule1006/b/2" paragraph {
        num "2" "(2)"
        content "Court Decision on Installments. Before the meeting of creditors, the court may order payment of the entire filing fee or may order the debtor to pay it in installments, designating the number of installments (not to exceed 4), the amount of each one, and payment dates. All payments must be made within 120 days after the petition is filed. The court may, for cause, extend the time to pay an installment, but the last one must be paid within 180 days after the petition is filed."
        hash "813dbd3d371eae9253b637bc09307c955004beb8eb3b6376e414e1c74ec3a7e0"
      }
      provision "/us/usc/ptI/rule1006/b/3" paragraph {
        num "3" "(3)"
        content "Postponing Other Payments. Until the filing fee has been paid in full, the debtor or Chapter 13 trustee must not make any further payment to an attorney or any other person who provides services to the debtor in connection with the case."
        hash "e6da7d33943a4dde8251fa0b5aa2a2128897d9f21813efcdc645f0d477d736c6"
      }
      hash "cce92bef420997bee83cf6a47a677e1de5c5ce207044dd8216608ea91aed5257"
    }
    provision "/us/usc/ptI/rule1006/c" subsection {
      num "c" "(c)"
      heading "Waiving the Filing Fee."
      content "The clerk must accept for filing an individual’s voluntary Chapter 7 petition if it is accompanied by a completed and signed application to waive the filing fee (Form 103B)."
      hash "b65d175c1fd60d22c59536b6caf9a1e50a7c2d1489fa068a10abc0ae3fb15898"
    }
    hash "889193464847fc930da04f4703de9140f899b11ac0f8fb6524fb74c6eee70ea2"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 23, 1996, eff. Dec. 1, 1996; Apr. 23, 2008, eff. Dec. 1, 2008; Apr. 27, 2017, eff. Dec. 1, 2017; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "28 U.S.C. § 1930 specifies the filing fees for petitions under chapters 7, 9, 11 and 13 of the Code. It also permits the payment in installments by individual debtors."
    p "Subdivision (b) is adapted from former Bankruptcy Rule 107. The administrative cost of installments in excess of four is disproportionate to the benefits conferred. Prolonging the period beyond 180 days after the commencement of the case causes undesirable delays in administration. Paragraph (2) accordingly continues the imposition of a maximum of four on the number of installments and retains the maximum period of installment payments allowable on an original application at 120 days. Only in extraordinary cases should it be necessary to give an applicant an extension beyond the four months. The requirement of paragraph (3) that filing fees be paid in full before the debtor may pay an attorney for services in connection with the case codifies the rule declared in In re Latham, 271 Fed. 538 (N.D.N.Y. 1921), and In re Darr, 232 Fed. 415 (N.D. Cal. 1916)."
    hash "ef6f550fba07d785f96734ca3f459faa75ab4084ae79b67c3b49848ed2068bf2"
  }
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1987-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1987 Amendment"
    p "Subdivision (b)(3) is expanded to prohibit payments by the debtor or the chapter 13 trustee not only to attorneys but to any person who renders services to the debtor in connection with the case."
    hash "506d328b8a1ad1c51149db9561af48d5dc2ae90c1db9ff64a58e9f925d446a4c"
  }
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1996-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1996 Amendment"
    p "The Judicial Conference prescribes miscellaneous fees pursuant to 28 U.S.C. § 1930(b). In 1992, a $30 miscellaneous administrative fee was prescribed for all chapter 7 and chapter 13 cases. The Judicial Conference fee schedule was amended in 1993 to provide that an individual debtor may pay this fee in installments."
    p "Subdivision (a) of this rule is amended to clarify that every petition must be accompanied by any fee prescribed under 28 U.S.C. § 1930(b) that is required to be paid when a petition is filed, as well as the filing fee prescribed by 28 U.S.C. § 1930(a). By defining “filing fee” to include Judicial Conference fees, the procedures set forth in subdivision (b) for paying the filing fee in installments will also apply with respect to any Judicial Conference fee required to be paid at the commencement of the case."
    p "GAP Report on Rule 1006. No changes since publication, except for a stylistic change in subdivision (a)."
    hash "478482a7a38bdca0cf9bc81f5e8deb0ed4556ec7776896d22c3593a3aac35a10"
  }
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/committee-notes-on-rules-2008-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2008 Amendment"
    p "Subdivision (a) is amended to include a reference to new subdivision (c), which deals with fee waivers under 28 U.S.C. § 1930(f), which was added in 2005."
    p "Subdivision (b)(1) is amended to delete the sentence requiring a disclosure that the debtor has not paid an attorney or other person in connection with the case. Inability to pay the filing fee in installments is one of the requirements for a fee waiver under the 2005 revisions to 28 U.S.C. § 1930(f). If the attorney payment prohibition were retained, payment of an attorney’s fee would render many debtors ineligible for installment payments and thus enhance their eligibility for the fee waiver. The deletion of this prohibition from the rule, which was not statutorily required, ensures that debtors who have the financial ability to pay the fee in installments will do so rather than request a waiver."
    p "Subdivision (b)(3) is amended in conformance with the changes to subdivision (b)(1) to reflect the 2005 amendments. The change is meant to clarify that subdivision (b)(3) refers to payments made after the debtor has filed the bankruptcy case and after the debtor has received permission to pay the fee in installments. Otherwise, the subdivision may conflict with the intent and effect of the amendments to subdivision (b)(1)."
    p "Changes Made After Publication. No changes were made after publication."
    hash "59437f5b1753f36bd34eb7e2c72ba6c94fabc28f4b8af908fea256e5669a6a8e"
  }
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/committee-notes-on-rules-2017-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2017 Amendment"
    p "Subdivision (b)(1) is amended to clarify that an individual debtor’s voluntary petition, accompanied by an application to pay the filing fee in installments, must be accepted for filing, even if the court requires the initial installment to be paid at the time the petition is filed and the debtor fails to make that payment. Because the debtor’s bankruptcy case is commenced upon the filing of the petition, dismissal of the case due to the debtor’s failure to make the initial or a subsequent installment payment is governed by Rule 1017(b)(1)."
    hash "7ac8875f18c32ca3d5a15880c6654a9129d5b107070d91030c544e3a58d01e28"
  }
  note "/us/usc/ptI/rule1006/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 1006 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "eb02987c67d2940ff8e833aa4a476b2d3ab9ab1364a43c2d745b1c5d75ac0cc5"
  }
  footnote 1 "1" {
    p "So in original. Probably should be followed by a comma."
  }
  layers {
    operative "889193464847fc930da04f4703de9140f899b11ac0f8fb6524fb74c6eee70ea2"
    enacted "5811a6ed7265799e2cc255c27c7f046f7ddcd2555544b49962458bbc15e94c6f"
    editorial "95ee73d6c0a0e98f3be6fd7cc7b759234053634d419ff2ed4d046b7216beb81b"
  }
}
