edition 2
module "/us/usc/ptI/rule1008" {
  within "/us/usc/ptI"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptI/rule1008" courtRule {
    num "1008" "Rule 1008."
    heading "Requirement to Verify Petitions and Accompanying Documents"
    content "A petition, list, schedule, statement, and any amendment must be verified or must contain an unsworn declaration under 28 U.S.C. § 1746."
    hash "6d34ca39a55d4c55570a28c0f73930ae8ef9485e0cd4787b701334b4af0507a9"
  }
  credit "(As amended Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptI/rule1008/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "This rule retains the requirement under the Bankruptcy Act and rules that petitions and accompanying papers must be verified. Only the original need be signed and verified, but the copies must be conformed to the original. See Rule 9011(c)."
    p "The verification may be replaced by an unsworn declaration as provided in 28 U.S.C. § 1746. See also, Official Form No. 1 and Advisory Committee Note."
    hash "8979bf1d2585d1d3584cb332b4c7736f7907698337d6c868e5efc47c41027956"
  }
  note "/us/usc/ptI/rule1008/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "The amendments to this rule are stylistic."
    hash "2425a4d71ea8cdce368d466213246b8c860960338c0a2940947629e608d503e0"
  }
  note "/us/usc/ptI/rule1008/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 1008 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "161a0475091559e9f8a4aceae6c2f9424a1c15b2dc0e524a4611d3713113b3b2"
  }
  layers {
    operative "6d34ca39a55d4c55570a28c0f73930ae8ef9485e0cd4787b701334b4af0507a9"
    enacted "bdbd5df228fa9e2951f0b6ef776c0e0c61b0a3b5e8a790f68bfcf74e337f3ff2"
    editorial "5294806948e70538b2d93f4a344b817f7f741f982f11569a0c200b5fd3fc0df0"
  }
}
