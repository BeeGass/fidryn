edition 2
module "/us/usc/ptI/rule1002" {
  within "/us/usc/ptI"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptI/rule1002" courtRule {
    num "1002" "Rule 1002."
    heading "Commencing a Bankruptcy Case"
    provision "/us/usc/ptI/rule1002/a" subsection {
      num "a" "(a)"
      heading "In General."
      content "A bankruptcy case is commenced by filing a petition with the clerk."
      hash "f26f13586246f32dc4d7cf2615c90a8b2045c169a194fc85de14f0ccaa1c1632"
    }
    provision "/us/usc/ptI/rule1002/b" subsection {
      num "b" "(b)"
      heading "Copy to the United States Trustee."
      content "The clerk must promptly send a copy of the petition to the United States trustee."
      hash "dab82604e8cdc53f6c08a01ea3377964aa3be0a7c4aeae9530e17e5c99ccc7f4"
    }
    hash "d553ee180cdd2714caba52765bd888350fa13f5c249302d1f0f0f5c2c58576dc"
  }
  credit "(As amended Mar. 30, 1987, eff. Aug. 1, 1987; Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptI/rule1002/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Under §§ 301–303 of the Code, a voluntary or involuntary case is commenced by filing a petition with the bankruptcy court. The voluntary petition may request relief under chapter 7, 9, 11, or 13 whereas an involuntary petition may be filed only under chapter 7 or 11. Section 109 of the Code specifies the types of debtors for whom the different forms of relief are available and § 303(a) indicates the persons against whom involuntary petitions may be filed."
    p "The rule in subdivision (a) is in harmony with the Code in that it requires the filing to be with the bankruptcy court."
    p "The number of copies of the petition to be filed is specified in this rule but a local rule may require additional copies. This rule provides for filing sufficient copies for the court’s files and for the trustee in a chapter 7 or 13 case."
    p "Official Form No. 1 may be used to seek relief voluntarily under any of the chapters. Only the original need be signed and verified, but the copies must be conformed to the original. See Rules 1008 and 9011(c). As provided in § 362(a) of the Code, the filing of a petition acts as a stay of certain acts and proceedings against the debtor, property of the debtor, and property of the estate."
    hash "3e8e3ffe9254da30c075e6c94d2d94e4cdcf4a4cdb8a1f32f775861b38fe6f57"
  }
  note "/us/usc/ptI/rule1002/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1987-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1987 Amendment"
    p "Rules 1002(a), governing a voluntary petition, 1003(a), governing an involuntary petition, and 1003(e), governing a petition in a case ancillary to a foreign proceeding, are combined into this Rule 1002. If a bankruptcy clerk has been appointed for the district, the petition is filed with the bankruptcy clerk. Otherwise, the petition is filed with the clerk of the district court."
    p "The elimination of the reference to the Official Forms of the petition is not intended to change the practice. Rule 9009 provides that the Official Forms “shall be observed and used” in cases and proceedings under the Code."
    p "Subdivision (b) which provided for the distribution of copies of the petition to agencies of the United States has been deleted. Some of these agencies no longer wish to receive copies of the petition, while others not included in subdivision (b) have now requested copies. The Director of the Administrative Office will determine on an ongoing basis which government agencies will be provided a copy of the petition."
    p "The number of copies of a petition that must be filed is a matter for local rule."
    hash "dc1e3f67326036ee47fc4d44b685a3c8c88750bf0ee118ee604811eb24dbee92"
  }
  note "/us/usc/ptI/rule1002/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1991-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1991 Amendment"
    p "Subdivision (b) is derived from Rule X–1002(a). The duties of the United States trustee pursuant to the Code and 28 U.S.C. § 586(a) require that the United States trustee be apprised of the commencement of every case under chapters 7, 11, 12 and 13 and this is most easily accomplished by providing that office with a copy of the petition. Although 28 U.S.C. § 586(a) does not give the United States trustee an administrative role in chapter 9 cases, § 1102 of the Code requires the United States trustee to appoint committees and that section is applicable in chapter 9 cases pursuant to § 901(a). It is therefore appropriate that the United States trustee receive a copy of every chapter 9 petition."
    p "Notwithstanding subdivision (b), pursuant to Rule 5005(b)(3), the clerk is not required to transmit a copy of the petition to the United States trustee if the United States trustee requests that it not be transmitted. Many rules require the clerk to transmit a certain document to the United States trustee, but Rule 5005(b)(3) relieves the clerk of that duty under this or any other rule if the United States trustee requests that such document not be transmitted."
    hash "385cd1eaa4bee944c7ebfbbdc95acf967d3b6273975d8d5b94a1f783fb0c14bb"
  }
  note "/us/usc/ptI/rule1002/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" enacted {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 1002 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "613467104a2c408c2f3e865d1e54afd20579af874a424ec7224626a392a26c1b"
  }
  layers {
    operative "d553ee180cdd2714caba52765bd888350fa13f5c249302d1f0f0f5c2c58576dc"
    enacted "a26821b7971a95cd70778fb00cfe2b1207b070bf5d725ef36a3c0aec11bcb2ea"
    editorial "f23a9f002e0a31303737fe5a8f6a72b414e9cd8c703c525b11b3dae4820eb255"
  }
}
