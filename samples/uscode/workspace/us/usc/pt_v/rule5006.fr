edition 2
module "/us/usc/ptV/rule5006" {
  within "/us/usc/ptV"
  source "usc11a.xml"
  positive_law false
  provision "/us/usc/ptV/rule5006" courtRule {
    num "5006" "Rule 5006."
    heading "Providing Certified Copies"
    content "Upon payment of the prescribed fee, the clerk must issue a certified copy of the record of any proceeding or any paper filed with the clerk."
    hash "a7579468d512ea07496111e31d5377af2e9920d578ffef4ba302fce83afe9aca"
  }
  credit "(As amended Apr. 30, 1991, eff. Aug. 1, 1991; Apr. 2, 2024, eff. Dec. 1, 2024.)"
  note "/us/usc/ptV/rule5006/note/ungrouped/nolaw/notes-of-advisory-committee-on-rules-1983" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Notes of Advisory Committee on Rules—1983"
    p "Fees for certification and copying are fixed by the Judicial Conference under 28 U.S.C. § 1930(b)."
    p "Rule 1101 F. R. Evid. makes the Federal Rules of Evidence applicable to cases under the Code. Rule 1005 F. R. Evid. allows the contents of an official record or of a paper filed with the court to be proved by a duly certified copy. A copy certified and issued in accordance with Rule 5006 is accorded authenticity by Rule 902(4) F. R. Evid."
    hash "4cc5c16d51d02e892a6de20d173a2ca9c7f21d640aeac4dd625a08fa27ee7ab0"
  }
  note "/us/usc/ptV/rule5006/note/ungrouped/nolaw/committee-notes-on-rules-2024-amendment" editorial {
    group ungrouped
    topic "miscellaneous"
    heading "Committee Notes on Rules—2024 Amendment"
    p "The language of Rule 5006 has been amended as part of the general restyling of the Bankruptcy Rules to make them more easily understood and to make style and terminology consistent throughout the rules. These changes are intended to be stylistic only."
    hash "f0ff0c1e710b0d6ccbe3eccfeff18e47dcffff300a5c44d9562f5d166a268d4b"
  }
  layers {
    operative "a7579468d512ea07496111e31d5377af2e9920d578ffef4ba302fce83afe9aca"
    enacted "a396bac23ba81b30cb34dbf808cf06deeaeb4b87e010b66646faadc6accfc6ff"
    editorial "0a8a2cced52c465138bc7aea3fd50252c87e761156b99d38ddbba5cbb972971f"
  }
}
