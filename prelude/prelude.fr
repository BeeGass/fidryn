module Fidryn.Prelude version "0.1.0" {
    jurisdiction Fidryn
    source_snapshot "2026-08-23-prelude"
    source_manifest "prelude.manifest.json"
    effective_at 2026-08-23
    recorded_at 2026-08-23T12:00:00Z

    outside_scope {
        live_government_filing
        tax_engines
        general_recursion
        user_defined_effects
        complete_conflict_oracle
    }

    import Fidryn.Procedure version "0.1.0"
    import Fidryn.Argument version "0.1.0"
    import Fidryn.Tax version "0.1.0"

    type TraceId = String
    type OpenIssue = String
    type ArgumentGraph = String
    type UnsatCore = String
    type SourceRef = String
    type LegalPersonRef = LegalPerson
    type NormContent = String
    type PropTerm = Prop
    type PropPattern = Prop
    type LegalStatusPattern = Prop
    type LegalEffectPattern = LegalEffect
    type Outcome<T> = Determinate | Contingent | Suspended | NormConflict | OutsideCompetence | Inconsistent
    type OpenRequest = NeedEvidence | NeedJudgment | NeedChoice | NeedInterpretation
    type Digest = String

    type CapacityPurpose = Administer | Execute
    type LicensedPhysician = NaturalPerson
    type CertificateConclusion = Supports | Opposes
    record_type Distribution {
        beneficiary: LegalPerson
        amount: Money<USD>
        purpose: String
    }
    record_type TrustAmendment {
        text: String
        signed_at: Time
    }

    type Provision = ClauseRef
    type PropertyClassification = ClassifiedAsSeparate | ClassifiedAsCommunity | Unclassified
    type EnforcementResult = Enforced | PreventedAsTo | Unenforceable | SuspendedEnforcement
    record_type DisclosedAsset {
        description: String
        owner: NaturalPerson
    }
    record_type DisclosedObligation {
        description: String
        bearer: NaturalPerson
    }
    record_type WrittenAgreement {
        text: String
        signed_at: Time
    }

    type FederalAgency = LegalPerson
    type AgencyComponent = LegalPerson
    type MediaType = String
    type FOIAExemption = Exemption1 | Exemption2 | Exemption3 | Exemption4 | Exemption5 | Exemption6 | Exemption7 | Exemption8 | Exemption9
    type LegalInterest = DeliberativeProcessInterest | OtherProtectedInterest
    record_type RecordPart {
        id: String
        content: String
    }
    record_type AgencyRecord {
        parts: FiniteSet<RecordPart>
    }
    record_type Exemption3 {
        qualifying_statute: SourceRef
    }
    record_type HarmBased {
        exemption: FOIAExemption
        protected_interest: LegalInterest
    }
    record_type ValidExemption3 {
        exemption: Exemption3
        qualifying_statute: SourceRef
    }
    record_type OtherwiseProhibitedByLaw {
        prohibiting_source: SourceRef
    }
    type WithholdingBasis = HarmBased | ValidExemption3 | OtherwiseProhibitedByLaw
    record_type Withholding {
        part: RecordPart
        basis: WithholdingBasis
    }
    record_type FOIADisposition {
        released: FiniteSet<RecordPart>
        withheld: FiniteSet<Withholding>
    }
    record_type CitedWithholdingBasis {
        withholding: Withholding
    }
    record_type HarmAnalysis {
        part: RecordPart
        protected_interest: LegalInterest
    }
    record_type SegregabilityAnalysis {
        record: AgencyRecord
    }

    type DomesticCorporation = LegalPerson
    type LLCName = String
    type EIN = String
    type EntityStatus = FormedLLC | NotFormedLLC
    record_type StreetAddress {
        line1: String
        city: String
        state: String
        postal_code: String
    }
    record_type SignedConsent {
        signatory: LegalPerson
        signed_at: Time
    }
    record_type NamedPersonAddress {
        person: LegalPerson
        address: StreetAddress
    }
    record_type CertificateOfOrganization {
        name: LLCName
        commonwealth_office: StreetAddress
        resident_agent: LegalPerson
        resident_agent_address: StreetAddress
        resident_agent_consent: SignedConsent
        dissolution_date: Option<Date>
        managers: FiniteSet<NamedPersonAddress>
        authorized_filers: FiniteSet<NamedPersonAddress>
        real_property_signers: FiniteSet<NamedPersonAddress>
        business_character: String
        requested_effective_time: Option<Time>
        federal_ein_if_available: Option<EIN>
        executed_by: NonEmptySet<LegalPerson>
    }
    record_type FilingPacket {
        certificate: CertificateOfOrganization
        fee: Money<USD>
        destination: Authority
    }
    record_type OperatingAgreement {
        members: FiniteSet<LegalPerson>
        terms: String
    }

    type PleadingKind = Complaint | Answer | Reply | Motion
    record_type Pleading {
        kind: PleadingKind
        proceeding: Proceeding
        filer: LegalPerson
        text: String
        filed_at: Time
    }
    type Burden = Production | Persuasion
    record_type AllocatedBurden {
        issue: Prop
        bearer: LegalPerson
        kind: Burden
    }
    type NoticeKind = ProcessNotice | HearingNotice | JudgmentNotice
    record_type Notice {
        kind: NoticeKind
        recipient: LegalPerson
        content: String
        given_at: Time
    }
    record_type JudgmentEntry {
        proceeding: Proceeding
        court: Authority
        entered_at: Time
        disposition: String
        finality: Finality
    }
    record_type Appeal {
        from_judgment: JudgmentEntry
        appellant: LegalPerson
        noticed_at: Time
    }
    type Stay = Stayed | NotStayed
    type Remand = Remanded | NotRemanded
    type Finality = Interlocutory | Final

    proposition Citation(decision: SourceRef, holding: Prop)
    proposition Holding(decision: SourceRef, proposition: Prop)
    proposition Distinguishes(
        later: SourceRef,
        earlier: SourceRef,
        proposition: Prop
    )
    proposition Overrules(later: SourceRef, earlier: SourceRef)
    proposition Follows(later: SourceRef, earlier: SourceRef)

    type TaxYear = Int
    type FilingStatus =
        Single
      | MarriedFilingJointly
      | MarriedFilingSeparately
      | HeadOfHousehold
    type ReportingCompanyKind = DomesticEntity | ForeignEntityRegisteredInUS
    type BOIStatus = BOIRequired | ExemptFromBOI
    record_type TaxableIncome {
        amount: Money<USD>
        year: TaxYear
        status: FilingStatus
    }
    record_type BeneficialOwnershipReport {
        company: LegalPerson
        year: TaxYear
    }
}
