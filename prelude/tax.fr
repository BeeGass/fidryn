module Fidryn.Tax version "0.1.0" {
    jurisdiction Fidryn
    source_snapshot "2026-08-14-prelude-tax"
    source_manifest "prelude.manifest.json"
    effective_at 2026-08-14
    recorded_at 2026-08-14T00:00:00Z

    outside_scope {
        tax_engines
        live_government_filing
        complete_IRC
        state_tax
        international_tax
    }

    type TaxYear = Int
    type FilingStatus =
        Single
      | MarriedFilingJointly
      | MarriedFilingSeparately
      | HeadOfHousehold
    type ReportingCompanyKind = DomesticEntity | ForeignEntityRegisteredInUS
    type BOIStatus = BOIRequired | ExemptFromBOI

    record_type TaxableIncome {
        amount: Money<USD>
        year: TaxYear
        status: FilingStatus
    }

    record_type BeneficialOwnershipReport {
        company: LegalPerson
        year: TaxYear
    }

    calc ordinary_income_tax_formula(amount: Money<USD>) -> Money<USD> {
        if amount <= 11925.00 {
            amount * 0.10
        } else {
            if amount <= 48475.00 {
                11925.00 * 0.10 + (amount - 11925.00) * 0.12
            } else {
                if amount <= 103350.00 {
                    11925.00 * 0.10 + (48475.00 - 11925.00) * 0.12 + (amount - 48475.00) * 0.22
                } else {
                    17651.00 + (amount - 103350.00) * 0.24
                }
            }
        }
    }
}
