<title identifier="/us/usc/t99"><num value="99">Title 99</num><heading>Invented</heading>
<section identifier="/us/usc/t99/s1"><num value="1">§ 1.</num><heading>Widgets</heading>
<chapeau>For the purposes of this section—</chapeau>
<subsection identifier="/us/usc/t99/s1/a"><num value="a">(a)</num><heading>Small widgets</heading><content>A small widget is red.</content></subsection>
<subsection identifier="/us/usc/t99/s1/b"><num value="b">(b)</num><chapeau>A large widget is—</chapeau>
<paragraph identifier="/us/usc/t99/s1/b/1"><num value="1">(1)</num><content>blue; or</content></paragraph>
<paragraph identifier="/us/usc/t99/s1/b/2"><num value="2">(2)</num><content>green.</content></paragraph>
</subsection>
<subsection identifier="/us/usc/t99/s1/c"><num value="c">(c)</num><content>No widget is both.</content></subsection>
</section>
