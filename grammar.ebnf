(* Fidryn 0.2 grammar. The parser enforces closed field sets only for source blocks, rule bodies and judgment request blocks; see docs/implementation-status.md. *)

File            ::= Module EOF

Module          ::= "module" QName TypeParameters? "version" String "{" ModuleItem* "}"

ModuleItem      ::= HeaderDecl
                  | SourceDecl
                  | ImportDecl
                  | EntityDecl
                  | TypeDecl
                  | RecordTypeDecl
                  | OfficeDecl
                  | PropositionDecl
                  | ObservationDecl
                  | NominationDecl
                  | FunctionDecl
                  | EffectDecl
                  | QuantifierDecl
                  | RuleDecl
                  | PowerDecl
                  | DutyDecl
                  | JudgmentDecl
                  | DecisionDecl
                  | LegalActDecl
                  | ClauseDecl
                  | InterpretationDecl
                  | ConflictDoctrineDecl
                  | QueryDecl
                  | ScenarioDecl
                  | VerifyDecl

(* ----- headers ----- *)

HeaderDecl      ::= "jurisdiction" QName End
                  | "source_snapshot" String End
                  | "source_manifest" String End
                  | "effective_at" Date End
                  | "recorded_at" DateTime End
                  | "outside_scope" "{" IdentList "}"

IdentList       ::= Ident (","? Ident)*

(* ----- sources and imports ----- *)

SourceDecl      ::= "source" Ident "{" SourceField* "}"
SourceField     ::= "kind" Ident End
                  | "authority" AuthorityExpr End
                  | "citation" String End
                  | "artifact" String End
                  | "digest" Expr End
                  | "effective" IntervalExpr End
                  | "retrieved_at" DateTime End
                  | "provision_intervals" "from" String End
                  | "amendment" Expr End

ImportDecl      ::= "import" QName TypeArgs? "version" Value
                    ("{" ImportField* "}")? End
ImportField     ::= "digest" Expr End
                  | "alias" Ident End

AuthorityExpr   ::= Expr ("as" Expr)?
                  | "{" ExprList "}"

(* ----- entities, types, records, offices ----- *)

EntityDecl      ::= "entity" Ident ":" Type End

TypeDecl        ::= "type" Ident TypeParameters? "=" TypeBody End
TypeParameters  ::= "<" Ident ("," Ident)* ">"
TypeBody        ::= Type
                  | VariantType
VariantType     ::= Variant ("|" Variant)+
Variant         ::= Ident ("{" FieldDecl* "}")?

RecordTypeDecl  ::= ("record_type" | "evidence_type") Ident
                    "{" FieldDecl* "}"
FieldDecl       ::= Ident ":" Type End

OfficeDecl      ::= "office" Signature "occupied_by" Type
                    "{" OfficeField* "}"
OfficeField     ::= "cardinality" Cardinality End
                  | "acquired_by" Expr End
                  | "suspended_by" Expr End
                  | "lost_by" SetExpr End
                  | "competence" SetExpr End
Cardinality     ::= Int ".." (Int | "*")

PropositionDecl ::= "proposition" Signature End

ObservationDecl ::= "observation" Signature
                    "establishes" Expr SourceRef? "{" ObservationField* "}"
ObservationField::= "authenticate" Expr End
                  | "require" Expr End
                  | "valid_time" IntervalExpr End
                  | "record_time" IntervalExpr End

NominationDecl  ::= "nomination" Expr "for" Expr "rank" Int SourceRef? End

FunctionDecl    ::= ("fn" | "calc") Signature "->" Type EffectRow? FuelClause? Block
FuelClause      ::= "fuel" "=" Int
FuelStmt        ::= "fuel" "=" Int End

EffectDecl      ::= "effect" Ident "{" EffectField* "}"
EffectField     ::= "request" "(" ParameterList? ")" "->" Type End

QuantifierDecl  ::= QuantifierField
QuantifierField ::= ("for_all" | "exists") Ident "in" Expr (":" Expr End | Block)
QuantifierExpr  ::= ("for_all" | "exists") Ident "in" Expr ":" Expr

(* ----- powers, duties, acts, clauses ----- *)

PowerDecl       ::= "power" Ident Signature? SourceRef? "{" PowerField* "}"
PowerField      ::= "holder" Expr End
                  | "subject" Expr End
                  | "effect" Expr End
                  | "active_while" Expr End
                  | "exercise_by" Expr End
                  | "source" Expr End
                  | "to" "constitute" Expr Block

DutyDecl        ::= "duty" Ident Signature? SourceRef? "{" DutyField* "}"
DutyField       ::= "bearer" Expr End
                  | "claimant" Expr End
                  | "attaches" "when" Expr End
                  | "content" (Expr | Block) End?
                  | "due" Expr End
                  | "exclude_from_count" SetExpr End
                  | "discharge_by" Expr End
                  | "violation_when" Expr End
                  | "source" Expr End

ClauseDecl      ::= "clause" Ident Signature? SourceRef? "{" ClauseField* "}"
ClauseField     ::= "when" Expr End
                  | "then" ConsequenceStmt
                  | "purport_to" ConsequenceStmt
                  | "purports_to" ConsequenceStmt
                  | "enforcement" "requires" Expr End
                  | "subject_to" Expr End
                  | "source" Expr End

LegalActDecl    ::= "legal_act" Signature "{" ActField* "}"
ActField        ::= "performer" Expr End
                  | "performers" SetExpr End
                  | "recipient" Expr End
                  | "exercises" Expr End
                  | "validity" "requires" Expr ("using" Ident)? End
                  | "active_while" Expr End
                  | "effect" ConsequenceStmt
                  | "physical_effect" Expr End
                  | "does_not_establish" Expr End
                  | "defects" Block
                  | "source" Expr End

(* ----- rules ----- *)

RuleDecl        ::= "rule" Ident ("(" ParameterList? ")")?
                    ":" RuleKind SourceRef? "{" RuleStatement* "}"
RuleKind        ::= "derive" | "constitutive" | "prescriptive"
RuleStatement   ::= "when" Expr End
                  | "then" ConsequenceStmt
                  | "otherwise" ConsequenceStmt
                  | "require" Expr End
                  | "select" Selection
                  | "source" Expr End
                  | "valid_time" IntervalExpr End
                  | "record_time" IntervalExpr End

(* The parser rejects text in a rule that is none of these statements, and
   a when, a require or a source with no Expr after it. It accepts the
   valid_time and record_time statements, each with an interval that has
   both of its bounds, and the interpreter does not apply them: the
   consequences of a rule hold at every time. *)

Selection       ::= "unique"? Ident "from" Expr
                    ("where" Expr)?
                    ("order_by" OrderKey ("," OrderKey)*)? End
OrderKey        ::= Ident ("ascending" | "descending")?

ConsequenceStmt ::= ConsequenceOp Expr ("as_to" Expr)? End
ConsequenceOp   ::= "establish" | "terminate" | "suspend"
                  | "constitute" | "create" | "derive" | "activate"
                  | "defeat" | "make"

(* The Expr of a consequence names a proposition. A consequence whose Expr
   is a number, a string, a sum or the name of an entity, for example, is
   rejected with E210. *)

(* ----- judgments and decisions ----- *)

JudgmentDecl    ::= "judgment" Signature "decides" Expr SourceRef?
                    "{" JudgmentField* "}"
JudgmentField   ::= "authority" Expr End
                  | "primary_authority" Expr End
                  | "record" "requires" RecordBind End
                  | "record" "may_include" Expr End
                  | "where" Expr End
                  | "establish" "when" Expr End
                  | "reject" "when" Expr End
                  | "otherwise" Expr End
                  | "on" Ident Block
                  | "review" ReviewClause End
                  | "burden_of_persuasion" Block
                  | "court_finding" Expr End
                  | "court" Expr End
                  | "standard" Expr End
                  | "decision_rule" Block
                  | "constitutive_effect" Block
                  | "duration" Expr End
                  | "source" Expr End
RecordBind      ::= Ident ":" Type

DecisionDecl    ::= "decision" Signature ("->" Type)? "{" DecisionField* "}"
DecisionField   ::= "authority" Expr End
                  | "options" Expr End
                  | "must_consider" SetExpr End
                  | "must_not_consider" SetExpr End
                  | "record" "requires" Expr End
                  | "standard" Expr End
                  | "output" Expr End
                  | "returns" Expr ("when" Expr)? End
                  | "review" ReviewClause End
                  | "for" "each" Ident "in" Expr ":" DecisionField*
                  | "when" Expr ":" DecisionField*
                  | "require" Expr End
                  | "source" Expr End
                  | "choice_space" Expr End
                  | "competent_when" Expr End
ReviewClause    ::= "by" Expr ("under" Expr)?

(* ----- interpretation and conflict ----- *)

InterpretationDecl ::= "interpretation_family" Ident "for" Expr
                       "{" InterpretationField* "}"
InterpretationField::= "alternative" Ident Block
                  | "admissibility" Expr End
                  | "selector" Expr End
                  | "defines" Expr "as" Expr End

ConflictDoctrineDecl ::= "conflict_doctrine" Ident SourceRef?
                         "{" ConflictField* "}"
ConflictField   ::= "when" Expr End
                  | "then" "defeat" Expr ("as_to" Expr)? End
                  | "reason" Ident End

(* ----- queries, scenarios, verify ----- *)

QueryDecl       ::= "query" "automatic"? Signature "->" Type EffectRow?
                    "{" QueryBody "}"
QueryBody       ::= QueryStatement*
QueryStatement  ::= "goal" QueryPlan Block
                  | "require" Expr ("using" Ident)? End
                  | "return" Expr End
                  | TransactionExpr End?
                  | QuantifierField
TransactionExpr ::= "transaction" Block
                  | "transaction" "(" ArgList? ")"
EffectRow       ::= "!" "{" Ident ("," Ident)* "}"

QueryPlan       ::= "UniqueOccupant"
                  | "EvaluateClause"
                  | "RunDecision"
                  | "StatusOf"
                  | "Evaluate"

ScenarioDecl    ::= "scenario" Ident "{" ScenarioField* "}"
ScenarioField   ::= "assume" Expr End
                  | "at" DateTime End

VerifyDecl      ::= "verify" Ident "{" VerifyField* "}"
VerifyField     ::= "interpretations" Expr End
                  | "judgments" Expr End
                  | "choices" Expr End
                  | "bounds" RecordExpr End
                  | "assuming" Expr End
                  | "assert" Expr End
                  | QuantifierField
                  | "for" "every" Expr ":" Expr End

(* ----- shared ----- *)

Signature       ::= Ident "(" ParameterList? ")"
ParameterList   ::= Parameter ("," Parameter)*
Parameter       ::= Ident ":" Type
SourceRef       ::= "from" Expr
Block           ::= "{" Statement* "}"
Statement       ::= Expr End | DeclStatement | FuelStmt
DeclStatement   ::= ModuleItem

Type            ::= QName TypeArgs?
                  | "FiniteSet" "<" Type ">"
                  | "NonEmptySet" "<" Type ">"
                  | "Option" "<" Type ">"
                  | "Map" "<" Type "," Type ">"
                  | "Duration" "<" Ident ">"
                  | "Money" "<" Ident ">"
                  | "Interval" "<" Type ">"
TypeArgs        ::= "<" Type ("," Type)* ">"

Expr            ::= Implication
Implication     ::= Or ("=>" Or)*
Or              ::= And ("or" And)*
And             ::= Compare ("and" Compare)*
Compare         ::= Add (CompareOp Add)?
CompareOp       ::= "==" | "!=" | "<" | "<=" | ">" | ">="
Add             ::= Mul (("+" | "-") Mul)*
Mul             ::= Unary (("*" | "/") Unary)*
Unary           ::= "not" Unary | Postfix
Postfix         ::= Primary (CallSuffix | MemberSuffix)*
CallSuffix      ::= "(" ArgList? ")"
MemberSuffix    ::= "." Ident
Primary         ::= literal
                  | QName
                  | SetExpr
                  | RecordExpr
                  | IntervalExpr
                  | "(" Expr ")"
                  | MoneyLiteral
                  | QuantifierExpr
                  | TransactionExpr
                  | IfExpr
ArgList         ::= Arg ("," Arg)*
Arg             ::= (Ident "=")? Expr
                  | "..." Expr

IfExpr          ::= "if" Expr Block ("else" (IfExpr | Block))?

(* In the condition of an if, in the domain of a quantifier and in the
   header of a rule, a judgment or an observation, a name followed by "{"
   is the name alone. It is not applied to the block: the "{" opens the
   block of the if, the quantifier or the declaration. A record constructor
   written with its name, as in R { x: 1 }, therefore needs parentheses in
   such an expression. Between parentheses, brackets or braces a name
   followed by "{" takes its block as it does elsewhere.

   The parser also accepts a branch written without braces. After else it
   is an expression in the same statement, as in if c { 1 } else 2. After
   the condition of an if it is an expression that begins with a word the
   condition does not take, such as not or operative, as in
   if c not a else not b. In if c 1 else 2 the 1 is read as part of the
   condition, and the if is rejected because no branch is left. An if or
   an else with no branch is rejected. *)

SetExpr         ::= "{" ExprList? "}"
ExprList        ::= Expr ("," Expr)*
RecordExpr      ::= "{" FieldAssign ("," FieldAssign)* ","? "}"
FieldAssign     ::= Ident (":" | "=") Expr
IntervalExpr    ::= "[" Expr "," Expr ("]" | ")")
MoneyLiteral    ::= Ident "(" Decimal ")"   (* currency constructor, e.g. USD(500.00) *)

QName           ::= Ident ("." Ident)*
Ident           ::= [A-Za-z_] [A-Za-z0-9_]*
String          ::= JSON-string
Int             ::= "-"? [0-9]+
Decimal         ::= "-"? [0-9]+ "." [0-9]+
Date            ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}
DateTime        ::= Date "T" TimeOfDay Offset?
TimeOfDay       ::= [0-9]{2} ":" [0-9]{2} ":" [0-9]{2}
Offset          ::= ("+" | "-") [0-9]{2} ":" [0-9]{2} | "Z"
DurationLit     ::= Int DurationUnit
DurationUnit    ::= "days" | "working_days" | "counted_days"
                  | "calendar_days" | "hours" | "minutes" | "seconds"
Infinity        ::= "+inf" | "-inf"
End             ::= inserted-newline | ";"

(* Automatic semicolon insertion: the parser inserts End at a newline when
   the last token before the newline can end a statement and the first
   token after it is not a continuation.

   The tokens that can end a statement are a name or word, a literal, ")",
   "]", "}", "*" and ">". The prefix words are the exception: after not,
   operative, effective, established, determined, always, active, every,
   unique or closed a newline does not end the statement.

   The continuations are the words and, or, where, then, else, from,
   decides, occupied_by, establishes, using, for, rank, as, to, version,
   fuel and in, and the tokens ".", ",", "->", "=>", ":", "!", "=", "|",
   "<", "{", "(" and "[".

   A blank line and a line that holds only a comment have no token, so the
   first token after the newline is then the first token of the next line
   that has one. Across such lines it counts as a continuation only when
   it is and, or or in, or one of ".", ",", "->", "=>", ":", "=", "|" and
   "<": no statement begins with one of those. Each of the other
   continuations can begin a line in its own right.

   Delimiter depth is not tested. Inside parentheses, brackets and braces a
   newline ends the expression before it by the same rule, and what follows
   must be what the enclosing form allows next. In the arguments of a call
   and in the elements of a braced collection that can be another argument
   or element, so g(a <newline> b) has two arguments. In a parenthesized
   expression it must be the closing parenthesis, so (1 <newline> + 2) is
   rejected, and inside brackets it must be a comma or the closing
   delimiter.

   The parser does not test for End everywhere. In some places where it
   expects the next part of a form it reads on across any newlines: for
   example before else after the block of an if, before the block that
   follows the domain of a quantifier, and before the block that follows the
   word transaction. It does test after the condition of an if and after the
   word else: a branch does not follow an End.

   Text the parser steps over without reading it (the body of a
   declaration it does not interpret, a verify field it does not read, a
   clause it keeps as text) ends differently. Parentheses, brackets and
   braces are counted there, and a newline inside them never ends the
   text. Outside them a newline ends it by the rule above, except that a
   prefix word ends a line as any other word does. The text also ends
   after a ";" outside them, and after the "}" that closes its outermost
   brace unless a continuation follows that brace.

   A declaration does not go on into the declaration below it. A keyword
   that takes a name is rejected when its statement ends with it: the name
   is not read from the next line. It is rejected as well when the token
   after it is not a name. The header keywords jurisdiction, effective_at,
   recorded_at and outside_scope are rejected when the statement ends with
   the keyword: the value is not read from the next line. source_snapshot
   and source_manifest do read a String that stands on the next line, and
   are rejected when none stands there. And the header of a declaration
   whose line ends in ":", "->" or "=", outside parentheses, brackets
   and braces, is rejected when the first token after the newline is a
   declaration keyword, although no End is inserted there by the rule
   above. There is one exception: below the header of a for_all or an
   exists that ends in ":", a line that begins with for_all or exists is
   the body of the quantifier. *)

(* Reserved words: module, version, fn, calc, type, query, rule, when,
   then, otherwise, and, or, not, in, from, for, return, returns.
   All other declaration introducers are contextual keywords.
   `transaction` is contextual in expressions: `transaction { … }` is a
   block of steps; `transaction(...)` remains a call. Both lower to
   Apply("transaction", steps). *)

(* "_" is legal only inside checked Prop / status / effect patterns. *)
