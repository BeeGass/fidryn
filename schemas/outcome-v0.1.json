{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fidryn.dev/schemas/outcome-v0.1.json",
  "title": "fidryn.outcome/v0.1",
  "type": "object",
  "required": ["schema", "module", "sourceSnapshot", "query", "asOf", "modelBoundary", "outcome"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "fidryn.outcome/v0.1" },
    "module": { "type": "string" },
    "sourceSnapshot": { "type": "string" },
    "query": { "type": "string" },
    "asOf": {
      "type": "object",
      "required": ["validTime", "recordTime"],
      "additionalProperties": false,
      "properties": {
        "validTime": { "type": "string", "format": "date-time" },
        "recordTime": { "type": "string", "format": "date-time" }
      }
    },
    "modelBoundary": {
      "type": "object",
      "required": ["outsideScope", "admissibleCompletions"],
      "additionalProperties": false,
      "properties": {
        "outsideScope": { "type": "array", "items": { "type": "string" } },
        "admissibleCompletions": { "type": "object" }
      }
    },
    "outcome": { "$ref": "#/$defs/outcome" }
  },
  "$defs": {
    "hexId": {
      "$comment": "16-byte hashed id as 32 hex characters (TraceId, CompletionProofId).",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "value": {
      "$comment": "Tagged Value {kind, data} or a JSON literal. A tagged bool must carry a boolean.",
      "if": {
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "const": "bool" } }
      },
      "then": {
        "type": "object",
        "required": ["kind", "data"],
        "properties": {
          "kind": { "const": "bool" },
          "data": { "type": "boolean" }
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["kind", "trace"],
      "properties": {
        "kind": {
          "enum": [
            "determinate",
            "contingent",
            "suspended",
            "normConflict",
            "outsideCompetence",
            "inconsistent"
          ]
        },
        "trace": {
          "$comment": "Hex string TraceId.",
          "$ref": "#/$defs/hexId"
        },
        "value": { "$ref": "#/$defs/value" },
        "convergenceCertificate": {
          "$comment": "Hex string CompletionProofId when present.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{32}$"
        },
        "ignoredOpenIssues": { "type": "array" },
        "alternatives": { "type": "object" },
        "pivots": { "type": "array" },
        "requests": { "type": "array" },
        "doctrines": { "type": "array" },
        "request": { "type": "object" },
        "reason": { "type": "string" },
        "core": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "determinate" } },
            "required": ["kind"]
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "determinate" },
              "ignoredOpenIssues": { "type": "array", "minItems": 1 }
            },
            "required": ["kind", "ignoredOpenIssues"]
          },
          "then": {
            "required": ["convergenceCertificate"],
            "properties": {
              "convergenceCertificate": { "$ref": "#/$defs/hexId" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "contingent" } },
            "required": ["kind"]
          },
          "then": { "required": ["alternatives", "pivots"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "suspended" } },
            "required": ["kind"]
          },
          "then": { "required": ["requests"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "normConflict" } },
            "required": ["kind"]
          },
          "then": { "required": ["doctrines"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "outsideCompetence" } },
            "required": ["kind"]
          },
          "then": { "required": ["request", "reason"] }
        },
        {
          "if": {
            "properties": { "kind": { "const": "inconsistent" } },
            "required": ["kind"]
          },
          "then": { "required": ["core"] }
        }
      ]
    }
  }
}
