{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fidryn.dev/schemas/evaluation-report-v0.2.json",
  "title": "fidryn.evaluation-report/v0.2",
  "$comment": "Envelope for qualifications fidryn.outcome/v0.1 cannot carry. outcomeDocument is that compatibility projection. Mill transport is {ok, report}; ok is not a field of this schema. Scenario requires assumptions (empty array allowed). Operative forbids a nonempty assumptions array. finiteReplay requires a coverage object.",
  "type": "object",
  "required": [
    "schema",
    "executionMode",
    "sourceTrust",
    "verificationMethod",
    "outcomeDocument",
    "invocation",
    "invocationId",
    "engineVersion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "executionMode": {
            "const": "scenario"
          }
        },
        "required": [
          "executionMode"
        ]
      },
      "then": {
        "$comment": "CLI --scenario with no hypotheses still serializes assumptions: [].",
        "required": [
          "assumptions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "executionMode": {
            "const": "operative"
          }
        },
        "required": [
          "executionMode"
        ]
      },
      "then": {
        "properties": {
          "assumptions": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verificationMethod": {
            "const": "finiteReplay"
          }
        },
        "required": [
          "verificationMethod"
        ]
      },
      "then": {
        "required": [
          "coverage"
        ],
        "properties": {
          "coverage": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "fidryn.evaluation-report/v0.2"
    },
    "executionMode": {
      "type": "string",
      "enum": [
        "operative",
        "scenario"
      ]
    },
    "sourceTrust": {
      "type": "string",
      "enum": [
        "fixture",
        "byteVerified",
        "policyAccepted",
        "unauthenticated"
      ]
    },
    "verificationMethod": {
      "type": "string",
      "enum": [
        "none",
        "structural",
        "finiteReplay"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "payload": true
        }
      }
    },
    "coverage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        },
        "answer": true,
        "branches": {
          "type": "array"
        }
      }
    },
    "outcomeDocument": {
      "$comment": "fidryn.outcome/v0.1 projection of report.outcome. Do not put envelope qualifications on this object.",
      "$ref": "outcome-v0.1.json",
      "type": "object",
      "required": [
        "schema",
        "module",
        "sourceSnapshot",
        "query",
        "asOf",
        "modelBoundary",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "fidryn.outcome/v0.1"
        },
        "module": {
          "type": "string"
        },
        "sourceSnapshot": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "asOf": {
          "type": "object"
        },
        "modelBoundary": {
          "type": "object"
        },
        "outcome": {
          "type": "object"
        }
      }
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBundle": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticsVersion",
        "program",
        "query",
        "args",
        "case",
        "validAt",
        "knownAt",
        "mode",
        "budget",
        "operation"
      ],
      "properties": {
        "semanticsVersion": {
          "const": "0.2"
        },
        "program": {
          "type": "object",
          "required": [
            "moduleId",
            "fingerprint"
          ],
          "additionalProperties": false,
          "properties": {
            "moduleId": true,
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "query": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "case": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validAt": {
          "type": "string",
          "format": "date-time"
        },
        "knownAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "operative",
            "scenario"
          ]
        },
        "budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "operation": {
          "enum": [
            "run",
            "explore"
          ]
        }
      }
    },
    "traceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "nodes"
      ],
      "properties": {
        "trace": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "provenanceRoot": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "kind": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "parents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            }
          }
        }
      }
    },
    "searchEvidence": {
      "type": "object",
      "required": [
        "examined",
        "total",
        "incomplete",
        "branches"
      ],
      "properties": {
        "examined": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "boolean"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bindings",
              "outcome"
            ],
            "properties": {
              "bindings": {
                "type": "object"
              },
              "outcome": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "engineArtifact": {
      "type": "object",
      "required": [
        "algorithm",
        "digest",
        "bytes",
        "packageVersion",
        "semanticsVersion",
        "arch",
        "os",
        "captureMethod"
      ],
      "properties": {
        "algorithm": {
          "const": "blake3"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "packageVersion": {
          "type": "string"
        },
        "semanticsVersion": {
          "const": "0.2"
        },
        "arch": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "captureMethod": {
          "enum": [
            "running_process_inode",
            "current_executable_file"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
