module Programs.TransactionAtomic version "0.1.0" {
    jurisdiction Test
    source_snapshot "2026-09-17-transaction-atomic"
    effective_at 2026-09-17
    recorded_at 2026-09-17T12:00:00Z

    outside_scope { complete_instruments }

    entity Payer : NaturalPerson
    entity Payee : NaturalPerson

    duty pay {
        bearer Payer
        claimant Payee
        content USD(100.00)
    }

    query q() -> Bool {
        transaction {
            duty_step(pay, attach);
            duty_step(pay, discharge)
        }
    }
}
