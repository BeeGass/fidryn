module Programs.TwoOffices version "0.1.0" {
    jurisdiction Test
    source_snapshot "2026-09-17-two-offices"
    effective_at 2026-09-17
    recorded_at 2026-09-17T12:00:00Z

    outside_scope { complete_instruments }

    entity Alice : NaturalPerson
    entity Bob : NaturalPerson
    entity Dana : NaturalPerson
    entity Eve : NaturalPerson
    entity Pat : NaturalPerson

    proposition Eligible(person: NaturalPerson, office: Office)

    interpretation_family TrusteeEligibility {
        alternative HighRank {
            defines Eligible(Alice, TrusteeOf(BRT)) as established
            defines Eligible(Bob, TrusteeOf(BRT)) as not_established
        }
    }

    interpretation_family ExecutorEligibility {
        alternative NextOfKin {
            defines Eligible(Dana, ExecutorOf(Est)) as established
            defines Eligible(Eve, ExecutorOf(Est)) as not_established
        }
    }

    nomination Alice for TrusteeOf(BRT) rank 1
    nomination Bob for TrusteeOf(BRT) rank 2
    nomination Dana for ExecutorOf(Est) rank 1
    nomination Eve for ExecutorOf(Est) rank 2

    query acting_trustee() -> LegalPerson ! {Observe, Determine, Interpret} {
        goal UniqueOccupant { office TrusteeOf(BRT) }
    }

    query acting_executor() -> LegalPerson ! {Observe, Determine, Interpret} {
        goal UniqueOccupant { office ExecutorOf(Est) }
    }
}
